+def dependency_layers(graph):
+    """Compute dependency layers for a directed acyclic graph.
+
+    *graph* is a mapping of nonempty string IDs to iterables of
+    prerequisite IDs. Returns a list of lists: each layer contains all
+    currently dependency-free IDs in original mapping insertion order,
+    starting with the IDs that have no prerequisites.
+
+    >>> dependency_layers({'a': [], 'b': ['a'], 'c': ['a'], 'd': ['b', 'c']})
+    [['a'], ['b', 'c'], ['d']]
+    >>> dependency_layers({})
+    []
+
+    Malformed IDs, non-iterable prerequisite values, string/bytes
+    prerequisite iterables, unknown prerequisites, self edges and
+    cycles all raise :exc:`ValueError`. The whole graph is validated
+    before any layers are returned and the caller's data is never
+    mutated.
+    """
+    if not isinstance(graph, Mapping):
+        raise ValueError('expected a mapping of IDs to prerequisites, not: %r'
+                         % type(graph).__name__)
+    order = list(graph.keys())
+    id_set = set()
+    for node in order:
+        if not isinstance(node, str) or not node:
+            raise ValueError('expected nonempty string IDs, not: %r' % (node,))
+        if node in id_set:
+            raise ValueError('duplicate ID: %r' % (node,))
+        id_set.add(node)
+    deps = {}
+    for node in order:
+        raw = graph[node]
+        if isinstance(raw, (str, bytes)):
+            raise ValueError('prerequisite iterable for %r must not be a'
+                             ' string, got: %r' % (node, raw))
+        try:
+            items = list(raw)
+        except TypeError:
+            raise ValueError('expected an iterable of prerequisites for %r, '
+                             'not: %r' % (node, type(raw).__name__))
+        seen = set()
+        node_deps = []
+        for dep in items:
+            if not isinstance(dep, str) or not dep:
+                raise ValueError('expected nonempty string prerequisite IDs '
+                                 'for %r, not: %r' % (node, dep))
+            if dep not in id_set:
+                raise ValueError('unknown prerequisite %r for %r' % (dep, node))
+            if dep == node:
+                raise ValueError('self edge on %r' % (node,))
+            if dep not in seen:
+                seen.add(dep)
+                node_deps.append(dep)
+        deps[node] = node_deps
+
+    placed = set()
+    layers = []
+    while len(placed) < len(order):
+        layer = [node for node in order
+                 if node not in placed
+                 and all(dep in placed for dep in deps[node])]
+        if not layer:
+            raise ValueError('cycle detected in dependency graph')
+        placed.update(layer)
+        layers.append(layer)
+    return layers
+
