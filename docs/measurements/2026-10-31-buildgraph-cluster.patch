+import hashlib
+import json
+import unittest
+
+from boltons.buildgraphutils import BuildGraph
+
+
+def _digest(obj):
+    text = json.dumps(obj, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False)
+    return hashlib.sha256(text.encode('utf-8')).hexdigest()
+
+KEY = 'a' * 64
+
+
+def _spec(deps=(), version='v', resources=None):
+    return {'deps': list(deps), 'version': version,
+            'resources': {} if resources is None else dict(resources)}
+
+
+class TestBuildGraphR3(unittest.TestCase):
+    def setUp(self):
+        self.tasks = {
+            'test': _spec([], 'v1', {'cpu': 1}),
+            'build': _spec(['test', 'test'], 'v2', {'cpu': 2}),
+            'other': _spec([], 'v1', {'io': 1}),
+            'pack': _spec(['build', 'other'], 'v3'),
+        }
+        self.graph = BuildGraph(self.tasks)
+
+    def test_r3_ids_layers_spec(self):
+        self.assertEqual(self.graph.ids, ('test', 'build', 'other', 'pack'))
+        self.assertEqual(self.graph.layers(),
+                         [['test', 'other'], ['build'], ['pack']])
+        with self.subTest(task='build'):
+            self.assertEqual(self.graph.spec('build'),
+                             {'deps': ['test', 'test'], 'version': 'v2',
+                              'resources': {'cpu': 2}})
+        with self.subTest(task='pack'):
+            self.assertEqual(self.graph.spec('pack'),
+                             {'deps': ['build', 'other'], 'version': 'v3',
+                              'resources': {}})
+
+    def test_r3_affected(self):
+        table = [((), []), (['test'], ['test', 'build', 'pack']),
+                 (['build'], ['build', 'pack']),
+                 (['other', 'test'], ['test', 'build', 'other', 'pack']),
+                 (['pack', 'pack'], ['pack'])]
+        for changed, expected in table:
+            with self.subTest(changed=changed):
+                self.assertEqual(self.graph.affected(changed), expected)
+
+    def test_r3_fingerprint(self):
+        expected = _digest({'id': 'pack', 'version': 'v3', 'resources': {},
+                            'dependencies': [['build', KEY],
+                                             ['other', KEY]]})
+        got = self.graph.fingerprint('pack', {'other': KEY, 'build': KEY})
+        self.assertEqual(got, expected)
+        self.assertEqual(len(got), 64)
+        self.assertEqual(got, got.lower())
+        build = self.graph.fingerprint('build', {'test': KEY})
+        self.assertEqual(build, _digest({
+            'id': 'build', 'version': 'v2', 'resources': {'cpu': 2},
+            'dependencies': [['test', KEY]]}))
+        self.assertNotEqual(build, self.graph.fingerprint('test', {}))
+
+    def test_r3_defensive_and_snapshot(self):
+        self.tasks['pack']['version'] = 'MUTATED'
+        self.tasks['build']['deps'].append('other')
+        self.tasks['build']['resources']['cpu'] = 9
+        self.assertEqual(self.graph.spec('pack')['version'], 'v3')
+        self.assertEqual(self.graph.dependencies('build'), ('test',))
+        spec = self.graph.spec('build')
+        spec['resources']['cpu'] = 100
+        self.assertEqual(self.graph.spec('build')['resources'], {'cpu': 2})
+        layers = self.graph.layers()
+        layers[0].append('junk')
+        self.assertEqual(self.graph.layers(),
+                         [['test', 'other'], ['build'], ['pack']])
+
+    def test_r3_fingerprint_invalid_keys(self):
+        bad = [{}, {'test': KEY, 'other': KEY},
+               {'test': 'A' * 64}, {'test': 'a' * 63}, {'test': 'g' * 64},
+               {'test': 123}]
+        for keys in bad:
+            with self.subTest(keys=keys):
+                self.assertRaises(ValueError,
+                                  self.graph.fingerprint, 'build', keys)
+
+    def test_r3_unknown_ids(self):
+        for method, args in [('spec', ('nope',)), ('dependencies', ('nope',)),
+                             ('fingerprint', ('nope', {})),
+                             ('affected', (['nope'],)),
+                             ('affected', ('test',))]:
+            with self.subTest(method=method, args=args):
+                self.assertRaises(ValueError, getattr(self.graph, method), *args)
+
+    def test_r3_empty_graph(self):
+        g = BuildGraph({})
+        self.assertEqual(g.ids, ())
+        self.assertEqual(g.layers(), [])
+        self.assertEqual(g.affected([]), [])
+
+    def test_r3_invalid_tasks(self):
+        good = _spec(['test'])
+        cases = [
+            None, [], {'test': good},
+            {'': good}, {1: good},
+            {'a': {'deps': [], 'version': 'v'}},
+            {'a': dict(good, extra=1)},
+            {'a': {'deps': 'test', 'version': 'v', 'resources': {}}},
+            {'a': {'deps': [], 'version': '', 'resources': {}}},
+            {'a': {'deps': [], 'version': 1, 'resources': {}}},
+            {'a': {'deps': [], 'version': 'v',
+                   'resources': {'cpu': True}}},
+            {'a': {'deps': [], 'version': 'v', 'resources': {'cpu': 0}}},
+            {'a': {'deps': [], 'version': 'v', 'resources': {'': 1}}},
+            {'a': {'deps': ['missing'], 'version': 'v', 'resources': {}}},
+            {'a': {'deps': ['a'], 'version': 'v', 'resources': {}}},
+            {'a': {'deps': ['b'], 'version': 'v', 'resources': {}},
+             'b': {'deps': ['a'], 'version': 'v', 'resources': {}}},
+        ]
+        for tasks in cases:
+            with self.subTest(tasks=tasks):
+                self.assertRaises(ValueError, BuildGraph, tasks)
+
+
+if __name__ == '__main__':
+    unittest.main()
