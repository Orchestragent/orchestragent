+class _SingleFlight(object):
+    """Internal bookkeeping for one in-flight computation in
+    :class:`SingleFlightCache`."""
+    __slots__ = ('event', 'owner_ident', 'owner_thread', 'done',
+                 'success', 'value', 'exc')
+
+    def __init__(self, owner_ident, owner_thread):
+        self.event = _threading.Event()
+        self.owner_ident = owner_ident
+        self.owner_thread = owner_thread
+        self.done = False
+        self.success = False
+        self.value = None
+        self.exc = None
+
+    def finish(self):
+        self.owner_thread = None
+        self.done = True
+        self.event.set()
+
+
+class SingleFlightCache:
+    """A thread-safe, size-bounded memoizing cache where concurrent
+    misses for the same key share a single in-flight computation.
+
+    Completed values are stored in an internal :class:`LRU`, so an
+    evicted key is simply recomputed on its next access. Computation
+    of distinct keys can proceed concurrently, and no internal lock is
+    held while a user ``factory`` runs or while a caller waits on
+    another thread's computation.
+
+    Args:
+        max_size (int): Maximum number of completed values to retain.
+            Must be a positive integer (booleans rejected).
+
+    >>> cache = SingleFlightCache(max_size=8)
+    >>> cache.get_or_compute('a', lambda: 1)
+    1
+    >>> len(cache)
+    1
+    """
+    def __init__(self, max_size=DEFAULT_MAX_SIZE):
+        if isinstance(max_size, bool) or not isinstance(max_size, int):
+            raise ValueError('expected max_size to be an int >= 1, not %r'
+                             % (max_size,))
+        if max_size < 1:
+            raise ValueError('expected max_size >= 1, not %r' % (max_size,))
+        self.max_size = max_size
+        self._cache = LRU(max_size=max_size)
+        # guards _flights only; never held while running user code or waiting
+        self._lock = _threading.Lock()
+        self._flights = {}
+
+    def __len__(self):
+        with self._lock:
+            return len(self._cache)
+
+    def __contains__(self, key):
+        with self._lock:
+            return key in self._cache
+
+    def _lookup(self, key):
+        with self._lock:
+            try:
+                return True, self._cache[key]
+            except KeyError:
+                return False, None
+
+    def get(self, key, default=None):
+        """Return the completed cached value for *key*, or *default*
+        if it is absent. Never waits and never computes."""
+        hit, value = self._lookup(key)
+        return value if hit else default
+
+    def get_or_compute(self, key, factory):
+        """Return the cached value for *key*, or compute it via
+        *factory* (a zero-argument callable) exactly once per flight.
+        """
+        hash(key)
+        if not callable(factory):
+            raise TypeError('expected factory to be callable, not %r'
+                            % (factory,))
+        hit, value = self._lookup(key)
+        if hit:
+            return value
+
+        ident = _threading.get_ident()
+        thread = _threading.current_thread()
+        with self._lock:
+            # Re-check under the lock in case it was cached meanwhile
+            try:
+                return self._cache[key]
+            except KeyError:
+                pass
+            flight = self._flights.get(key)
+            if flight is not None:
+                if flight.owner_ident == ident:
+                    raise RuntimeError(
+                        'recursive get_or_compute for key %r' % (key,))
+                owner = False
+            else:
+                flight = _SingleFlight(ident, thread)
+                self._flights[key] = flight
+                owner = True
+
+        if not owner:
+            flight.event.wait()
+            if not flight.success:
+                raise flight.exc
+            return flight.value
+
+        try:
+            value = factory()
+        except BaseException as exc:
+            with self._lock:
+                if self._flights.get(key) is flight:
+                    del self._flights[key]
+                flight.exc = exc
+                flight.finish()
+            raise
+
+        try:
+            with self._lock:
+                if self._flights.get(key) is flight:
+                    del self._flights[key]
+                    self._cache[key] = value
+                flight.value = value
+                flight.success = True
+                flight.finish()
+        except BaseException:
+            with self._lock:
+                if self._flights.get(key) is flight:
+                    del self._flights[key]
+            raise
+        return value
+
+    def invalidate(self, key):
+        """Remove any cached value and detach any in-flight computation
+        for *key*. Detached in-flight results will not be cached, though
+        their current waiters still receive them. Returns whether the
+        key existed in either state."""
+        with self._lock:
+            existed = False
+            try:
+                del self._cache[key]
+            except KeyError:
+                pass
+            else:
+                existed = True
+            if self._flights.pop(key, None) is not None:
+                existed = True
+            return existed
+
+    def clear(self):
+        """Invalidate every cached and in-flight key."""
+        with self._lock:
+            self._cache.clear()
+            self._flights.clear()
+        return
+
+    def __repr__(self):
+        return ('%s(max_size=%r, cached=%d, in_flight=%d)'
+                % (self.__class__.__name__, self.max_size,
+                   len(self._cache), len(self._flights)))
+
