new file mode 100644
index 0000000..8ef7b71
--- /dev/null
+++ b/boltons/buildcacheutils.py
@@ -0,0 +1,133 @@
+"""Experimental persistent JSON result store for build graphs, written
+with :func:`boltons.fileutils.atomic_save`.
+"""
+
+import json
+import os
+import re
+from typing import Any, Dict, Iterable, Union
+
+from boltons.fileutils import atomic_save
+
+
+SCHEMA_VERSION = 1
+
+_KEY_RE = re.compile(r'[0-9a-f]{64}')
+
+
+def _is_valid_key(key):
+    return isinstance(key, str) and _KEY_RE.fullmatch(key) is not None
+
+
+def _reject_constant(name):
+    raise ValueError(f'invalid JSON constant: {name}')
+
+
+def _loads(text, what):
+    try:
+        return json.loads(text, parse_constant=_reject_constant)
+    except (ValueError, RecursionError) as exc:
+        raise ValueError(f'invalid JSON {what}: {exc}') from exc
+
+
+def _check_string_keys(value):
+    # json.dumps silently stringifies non-string dict keys; reject those.
+    stack = [value]
+    while stack:
+        cur = stack.pop()
+        if isinstance(cur, dict):
+            for k, v in cur.items():
+                if not isinstance(k, str):
+                    raise ValueError(f'JSON object keys must be strings, not {k!r}')
+                stack.append(v)
+        elif isinstance(cur, (list, tuple)):
+            stack.extend(cur)
+
+
+def _dumps(value):
+    try:
+        text = json.dumps(value, allow_nan=False)
+    except (TypeError, ValueError, RecursionError) as exc:
+        raise ValueError(f'value is not JSON serializable: {exc}') from exc
+    _check_string_keys(value)
+    return text
+
+
+class ResultStore:
+    """Mapping of lowercase 64-hex cache keys to JSON values, loaded from
+    and explicitly saved to a single UTF-8 JSON file.
+    """
+
+    def __init__(self, path: Union[str, os.PathLike]) -> None:
+        self.path = os.fspath(path)
+        self._values: Dict[str, Any] = {}
+        if not os.path.exists(self.path):
+            return
+        with open(self.path, 'rb') as f:
+            raw = f.read()
+        try:
+            text = raw.decode('utf-8')
+        except UnicodeDecodeError as exc:
+            raise ValueError(f'{self.path!r} is not valid UTF-8: {exc}') from exc
+        data = _loads(text, 'store state')
+        if not isinstance(data, dict) or set(data) != {'schema_version', 'values'}:
+            raise ValueError('store state must be an object with exactly '
+                             '"schema_version" and "values"')
+        version = data['schema_version']
+        if isinstance(version, bool) or not isinstance(version, int) \
+                or version != SCHEMA_VERSION:
+            raise ValueError(f'unsupported schema_version: {version!r}')
+        values = data['values']
+        if not isinstance(values, dict):
+            raise ValueError('"values" must be a JSON object')
+        for key in values:
+            if not _is_valid_key(key):
+                raise ValueError(f'invalid store key: {key!r}')
+        self._values = values
+
+    def __contains__(self, key: object) -> bool:
+        return bool(_is_valid_key(key) and key in self._values)
+
+    def get(self, key: str) -> Any:
+        """Return a JSON round-trip copy of the value or raise KeyError."""
+        if not _is_valid_key(key) or key not in self._values:
+            raise KeyError(key)
+        return json.loads(json.dumps(self._values[key]))
+
+    def put(self, key: str, value: Any) -> None:
+        """Validate and store a JSON round-trip copy of *value*."""
+        if not _is_valid_key(key):
+            raise ValueError(f'invalid store key: {key!r}')
+        text = _dumps(value)
+        self._values[key] = _loads(text, 'value')
+
+    def invalidate(self, keys: Iterable[str]) -> int:
+        """Remove *keys* and return how many were actually present."""
+        if isinstance(keys, (str, bytes)):
+            raise ValueError('keys must be a non-string iterable of keys')
+        try:
+            items = list(keys)
+        except TypeError as exc:
+            raise ValueError('keys must be a non-string iterable of keys') from exc
+        to_remove = set()
+        for key in items:
+            if not _is_valid_key(key):
+                raise ValueError(f'invalid store key: {key!r}')
+            to_remove.add(key)
+        removed = 0
+        for key in to_remove:
+            if key in self._values:
+                del self._values[key]
+                removed += 1
+        return removed
+
+    def save(self) -> None:
+        """Atomically write the complete state to the path."""
+        try:
+            text = json.dumps({'schema_version': SCHEMA_VERSION, 'values': self._values},
+                              sort_keys=True, ensure_ascii=False, allow_nan=False)
+            payload = text.encode('utf-8')
+        except (TypeError, ValueError, RecursionError) as exc:
+            raise ValueError(f'cannot serialize store state: {exc}') from exc
+        with atomic_save(self.path, text_mode=False, overwrite=True) as fo:
+            fo.write(payload)
diff --git a/boltons/buildgraphutils.py b/boltons/buildgraphutils.py
new file mode 100644
index 0000000..8c50862
--- /dev/null
+++ b/boltons/buildgraphutils.py
@@ -0,0 +1,164 @@
+"""Experimental validated build-graph descriptions with deterministic
+content fingerprints, layered via :func:`boltons.iterutils.dependency_layers`.
+"""
+
+import hashlib
+import json
+import re
+from collections.abc import Mapping as ABCMapping
+from typing import Any, Dict, Iterable, List, Mapping, Tuple
+
+
+_SPEC_KEYS = frozenset(('deps', 'version', 'resources'))
+_HEX64_RE = re.compile(r'[0-9a-f]{64}\Z')
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _check_id(value, what='task id'):
+    if not isinstance(value, str) or not value:
+        raise ValueError('invalid %s: %r' % (what, value))
+    return value
+
+
+class BuildGraph:
+    """Immutable snapshot of an insertion-ordered mapping of task IDs to
+    ``{'deps': [...], 'version': str, 'resources': {name: int}}`` specs.
+    """
+
+    def __init__(self, tasks: Mapping[str, Mapping[str, Any]]) -> None:
+        if not isinstance(tasks, ABCMapping):
+            raise ValueError('tasks must be a mapping, not %r' % (type(tasks),))
+        snapshot = {}
+        for task_id, raw in tasks.items():
+            _check_id(task_id)
+            if not isinstance(raw, ABCMapping):
+                raise ValueError('spec for %r must be a mapping' % (task_id,))
+            if set(raw.keys()) != _SPEC_KEYS:
+                raise ValueError('spec for %r must have exactly %r'
+                                 % (task_id, sorted(_SPEC_KEYS)))
+            deps_raw = raw['deps']
+            if not isinstance(deps_raw, (list, tuple)):
+                raise ValueError('deps for %r must be a list or tuple'
+                                 % (task_id,))
+            deps = []
+            for dep in deps_raw:
+                _check_id(dep, 'prerequisite id')
+                deps.append(dep)
+            version = raw['version']
+            if not isinstance(version, str) or not version:
+                raise ValueError('version for %r must be a nonempty str'
+                                 % (task_id,))
+            res_raw = raw['resources']
+            if not isinstance(res_raw, ABCMapping):
+                raise ValueError('resources for %r must be a mapping'
+                                 % (task_id,))
+            resources = {}
+            for name, amount in res_raw.items():
+                _check_id(name, 'resource name')
+                if not _is_int(amount) or amount < 1:
+                    raise ValueError('resource %r for %r must be a positive '
+                                     'int' % (name, task_id))
+                resources[name] = amount
+            snapshot[task_id] = {'deps': deps, 'version': version,
+                                 'resources': resources}
+
+        # Validate full graph structure (cycles, unknowns, self edges) using
+        # dependency_layers; imported lazily to avoid import cycles.
+        from boltons.iterutils import dependency_layers
+        dependency_layers({tid: list(s['deps'])
+                           for tid, s in snapshot.items()})
+
+        self._ids = tuple(snapshot.keys())
+        self._specs = snapshot
+        self._deps = {}
+        self._dependents = {tid: [] for tid in self._ids}
+        for tid in self._ids:
+            seen = set()
+            dedup = []
+            for dep in snapshot[tid]['deps']:
+                if dep not in seen:
+                    seen.add(dep)
+                    dedup.append(dep)
+            self._deps[tid] = tuple(dedup)
+            for dep in dedup:
+                self._dependents[dep].append(tid)
+
+    @property
+    def ids(self) -> Tuple[str, ...]:
+        """Task IDs in original insertion order."""
+        return self._ids
+
+    def layers(self) -> List[List[str]]:
+        """Fresh dependency layers, as returned by dependency_layers."""
+        from boltons.iterutils import dependency_layers
+        return dependency_layers({tid: self._deps[tid] for tid in self._ids})
+
+    def _get_spec(self, task_id):
+        _check_id(task_id)
+        try:
+            return self._specs[task_id]
+        except (KeyError, TypeError):
+            raise ValueError('unknown task id: %r' % (task_id,))
+
+    def spec(self, task_id: str) -> Dict[str, Any]:
+        """Defensive copy of the snapshotted spec for *task_id*."""
+        snap = self._get_spec(task_id)
+        return {'deps': list(snap['deps']), 'version': snap['version'],
+                'resources': dict(snap['resources'])}
+
+    def dependencies(self, task_id: str) -> Tuple[str, ...]:
+        """Direct prerequisites, deduplicated in first-occurrence order."""
+        self._get_spec(task_id)
+        return self._deps[task_id]
+
+    def affected(self, changed: Iterable[str]) -> List[str]:
+        """Changed IDs plus all transitive dependents, in insertion order."""
+        if isinstance(changed, (str, bytes)):
+            raise ValueError('changed must be an iterable of ids, not a str')
+        try:
+            changed_list = list(changed)
+        except TypeError:
+            raise ValueError('changed must be an iterable of ids')
+        marked = set()
+        for task_id in changed_list:
+            _check_id(task_id)
+            if task_id not in self._specs:
+                raise ValueError('unknown task id: %r' % (task_id,))
+            marked.add(task_id)
+        # Propagate to transitive dependents (topological-safe BFS).
+        stack = list(marked)
+        while stack:
+            cur = stack.pop()
+            for dep in self._dependents[cur]:
+                if dep not in marked:
+                    marked.add(dep)
+                    stack.append(dep)
+        return [tid for tid in self._ids if tid in marked]
+
+    def fingerprint(self, task_id: str,
+                    dependency_keys: Mapping[str, str]) -> str:
+        """Lowercase SHA-256 hex digest of the node's canonical JSON."""
+        snap = self._get_spec(task_id)
+        if not isinstance(dependency_keys, ABCMapping):
+            raise ValueError('dependency_keys must be a mapping')
+        deps = self._deps[task_id]
+        if set(dependency_keys.keys()) != set(deps):
+            raise ValueError('dependency_keys must match prerequisites of %r'
+                             % (task_id,))
+        for dep in deps:
+            key = dependency_keys[dep]
+            if not isinstance(key, str) or not _HEX64_RE.match(key):
+                raise ValueError('invalid dependency key for %r: %r'
+                                 % (dep, key))
+        payload = {
+            'id': task_id,
+            'version': snap['version'],
+            'resources': dict(snap['resources']),
+            'dependencies': [[dep, dependency_keys[dep]] for dep in deps],
+        }
+        text = json.dumps(payload, sort_keys=True, separators=(',', ':'),
+                          ensure_ascii=False, allow_nan=False)
+        return hashlib.sha256(text.encode('utf-8')).hexdigest()
diff --git a/boltons/buildrunutils.py b/boltons/buildrunutils.py
new file mode 100644
index 0000000..78d0e8f
--- /dev/null
+++ b/boltons/buildrunutils.py
@@ -0,0 +1,360 @@
+"""Experimental synchronous, incremental, resource-aware execution of a
+:class:`boltons.buildgraphutils.BuildGraph`.
+"""
+
+import json
+import queue
+import threading
+from collections.abc import Mapping as ABCMapping
+from typing import Any, Callable, Dict, Iterable, Mapping, Optional
+
+from boltons.buildcacheutils import ResultStore
+from boltons.buildgraphutils import BuildGraph
+from boltons.cacheutils import SingleFlightCache
+from boltons.queueutils import HeapPriorityQueue
+
+
+_SENTINEL = object()
+
+
+def _copy_value(value):
+    """JSON round-trip copy of a normalized (JSON-compatible) value."""
+    return json.loads(json.dumps(value, allow_nan=False))
+
+
+def _is_exact_int(value):
+    return type(value) is int
+
+
+def _check_nonempty_str(value):
+    return isinstance(value, str) and bool(value)
+
+
+def _format_error(exc):
+    name = type(exc).__name__
+    if len(exc.args) == 1:
+        msg = str(exc.args[0])
+    else:
+        msg = str(exc)
+    return '%s: %s' % (name, msg)
+
+
+class _ActivityTracker(object):
+    """Lock-protected counter of concurrently active callbacks."""
+
+    def __init__(self):
+        self._lock = threading.Lock()
+        self.active = 0
+        self.peak = 0
+
+    def enter(self):
+        with self._lock:
+            self.active += 1
+            if self.active > self.peak:
+                self.peak = self.active
+
+    def leave(self):
+        with self._lock:
+            self.active -= 1
+
+
+class BuildRunner:
+    """Runs BuildGraph callbacks concurrently under worker and resource
+    limits, reusing results from memory and an optional ResultStore.
+    """
+
+    def __init__(self, graph: BuildGraph,
+                 functions: Mapping[str, Callable[[Dict[str, Any]], Any]],
+                 store: Optional[ResultStore] = None,
+                 max_workers: int = 4,
+                 capacities: Optional[Mapping[str, int]] = None,
+                 retries: int = 0) -> None:
+        if not isinstance(graph, BuildGraph):
+            raise ValueError('graph must be a BuildGraph, not %r'
+                             % (type(graph),))
+        if not isinstance(functions, ABCMapping):
+            raise ValueError('functions must be a mapping')
+        if set(functions.keys()) != set(graph.ids):
+            raise ValueError('functions must map exactly the graph ids')
+        for tid, fn in functions.items():
+            if not callable(fn):
+                raise ValueError('function for %r is not callable' % (tid,))
+        if store is not None and not isinstance(store, ResultStore):
+            raise ValueError('store must be None or a ResultStore')
+        if not _is_exact_int(max_workers) or max_workers < 1:
+            raise ValueError('max_workers must be a positive int')
+        if not _is_exact_int(retries) or retries < 0:
+            raise ValueError('retries must be a nonnegative int')
+        if capacities is None:
+            capacities = {}
+        if not isinstance(capacities, ABCMapping):
+            raise ValueError('capacities must be a mapping')
+        caps = {}
+        for name, amount in capacities.items():
+            if not _check_nonempty_str(name):
+                raise ValueError('invalid resource capacity name: %r'
+                                 % (name,))
+            if not _is_exact_int(amount) or amount < 1:
+                raise ValueError('capacity for %r must be a positive int'
+                                 % (name,))
+            caps[name] = amount
+
+        ids = tuple(graph.ids)
+        deps = {}
+        resources = {}
+        for tid in ids:
+            snap = graph.spec(tid)
+            deps[tid] = tuple(graph.dependencies(tid))
+            res = dict(snap['resources'])
+            for name, amount in res.items():
+                if name not in caps:
+                    raise ValueError('undeclared resource %r required by %r'
+                                     % (name, tid))
+                if not _is_exact_int(amount) or amount < 1:
+                    raise ValueError('invalid resource amount for %r' % (tid,))
+                if amount > caps[name]:
+                    raise ValueError('task %r requires %r of %r exceeds '
+                                     'capacity %r'
+                                     % (tid, amount, name, caps[name]))
+            resources[tid] = res
+
+        dependents = {tid: [] for tid in ids}
+        for tid in ids:
+            for dep in deps[tid]:
+                dependents[dep].append(tid)
+        all_deps = {}
+        visited = set()
+        for tid in ids:
+            stack = list(deps[tid])
+            closure = set()
+            while stack:
+                cur = stack.pop()
+                if cur in closure:
+                    continue
+                closure.add(cur)
+                stack.extend(deps[cur])
+            all_deps[tid] = closure
+
+        self._graph = graph
+        self._ids = ids
+        self._index = {tid: i for i, tid in enumerate(ids)}
+        self._functions = {tid: functions[tid] for tid in ids}
+        self._store = store
+        self._max_workers = max_workers
+        self._retries = retries
+        self._capacities = dict(caps)
+        self._deps = deps
+        self._resources = resources
+        self._dependents = dependents
+        self._all_deps = all_deps
+        self._memory = SingleFlightCache(max_size=max(128, len(ids)))
+
+    def _select(self, targets):
+        if targets is None:
+            return set(self._ids)
+        if isinstance(targets, (str, bytes)):
+            raise ValueError('targets must be an iterable of ids, not a str')
+        try:
+            items = list(targets)
+        except TypeError:
+            raise ValueError('targets must be an iterable of ids')
+        for tid in items:
+            if not isinstance(tid, str) or tid not in self._index:
+                raise ValueError('unknown target id: %r' % (tid,))
+        selected = set(items)
+        stack = list(items)
+        while stack:
+            cur = stack.pop()
+            for dep in self._deps[cur]:
+                if dep not in selected:
+                    selected.add(dep)
+                    stack.append(dep)
+        return selected
+
+    def run(self, targets: Optional[Iterable[str]] = None) -> Dict[str, Any]:
+        """Build the selected closure; return results/states/errors/
+        attempts/max_active.
+        """
+        selected = self._select(targets)
+        ordered = [tid for tid in self._ids if tid in selected]
+        if not ordered:
+            return {'results': {}, 'states': {}, 'errors': {},
+                    'attempts': {}, 'max_active': 0}
+
+        ordered_set = set(ordered)
+        ids = self._ids
+        index = self._index
+        deps = self._deps
+        resources = self._resources
+        dependents = self._dependents
+        all_deps = self._all_deps
+        functions = self._functions
+        store = self._store
+        memory = self._memory
+        max_workers = self._max_workers
+        retries = self._retries
+        capacities = self._capacities
+
+        keys = {}
+        for tid in ids:
+            keys[tid] = self._graph.fingerprint(
+                tid, {d: keys[d] for d in deps[tid]})
+
+        states = {}
+        values = {}
+        errors = {}
+        attempts = {tid: 0 for tid in ordered}
+        failed = set()
+        done = set()
+
+        def mark_blocked(failed_tid):
+            for other in ordered:
+                if other in states:
+                    continue
+                if failed_tid in all_deps[other]:
+                    states[other] = 'blocked'
+
+        def is_ready(tid):
+            for dep in deps[tid]:
+                if dep not in done:
+                    return False
+            return True
+
+        ready = HeapPriorityQueue()
+        tracker = _ActivityTracker()
+        completions = queue.Queue()
+
+        def make_worker(tid, inputs):
+            def worker():
+                tracker.enter()
+                try:
+                    result = functions[tid](inputs)
+                    text = json.dumps(result, allow_nan=False)
+                    return True, json.loads(text)
+                except BaseException as exc:  # noqa: BLE001 - report any failure
+                    return False, _format_error(exc)
+                finally:
+                    tracker.leave()
+            return worker
+
+        def admit(tid):
+            key = keys[tid]
+            hit = memory.get(key, _SENTINEL)
+            if hit is not _SENTINEL:
+                values[tid] = _copy_value(hit)
+                states[tid] = 'cached'
+                done.add(tid)
+                cascade(tid)
+                return
+            if store is not None:
+                try:
+                    stored = store.get(key)
+                except KeyError:
+                    stored = _SENTINEL
+                if stored is not _SENTINEL:
+                    values[tid] = _copy_value(stored)
+                    states[tid] = 'cached'
+                    done.add(tid)
+                    memory.invalidate(key)
+                    memory.get_or_compute(key, lambda v=stored: _copy_value(v))
+                    cascade(tid)
+                    return
+            ready.add(tid, -index[tid])
+
+        def cascade(tid):
+            for child in dependents[tid]:
+                if child not in ordered_set or child in states:
+                    continue
+                if is_ready(child):
+                    admit(child)
+
+        for tid in ordered:
+            if is_ready(tid):
+                admit(tid)
+
+        from concurrent.futures import ThreadPoolExecutor
+
+        pool = ThreadPoolExecutor(max_workers=max_workers)
+        active = 0
+        demand = {name: 0 for name in capacities}
+        try:
+            while True:
+                deferred = []
+                while len(ready) > 0 and active < max_workers:
+                    tid = ready.pop()
+                    if tid in states:
+                        continue
+                    fits = True
+                    for name, amount in resources[tid].items():
+                        if demand[name] + amount > capacities[name]:
+                            fits = False
+                            break
+                    if not fits:
+                        deferred.append(tid)
+                        continue
+                    for name, amount in resources[tid].items():
+                        demand[name] += amount
+                    active += 1
+                    tracker.peak = tracker.peak
+                    attempts[tid] += 1
+                    inputs = {}
+                    for dep in deps[tid]:
+                        inputs[dep] = _copy_value(values[dep])
+                    future = pool.submit(make_worker(tid, inputs))
+                    future.add_done_callback(
+                        lambda fut, t=tid: completions.put((t, fut)))
+                for tid in deferred:
+                    ready.add(tid, -index[tid])
+                if active == 0:
+                    break
+                done_tid, future = completions.get()
+                active -= 1
+                for name, amount in resources[done_tid].items():
+                    demand[name] -= amount
+                try:
+                    ok, payload = future.result()
+                except BaseException as exc:  # defensive
+                    ok, payload = False, _format_error(exc)
+                if ok:
+                    key = keys[done_tid]
+                    values[done_tid] = _copy_value(payload)
+                    memory.invalidate(key)
+                    memory.get_or_compute(
+                        key, lambda v=payload: _copy_value(v))
+                    if store is not None:
+                        store.put(key, _copy_value(payload))
+                    states[done_tid] = 'done'
+                    done.add(done_tid)
+                    cascade(done_tid)
+                elif attempts[done_tid] < 1 + retries:
+                    ready.add(done_tid, -index[done_tid])
+                else:
+                    states[done_tid] = 'failed'
+                    errors[done_tid] = payload
+                    failed.add(done_tid)
+                    mark_blocked(done_tid)
+        finally:
+            pool.shutdown(wait=True)
+
+        for tid in ordered:
+            if tid not in states:
+                states[tid] = 'blocked'
+
+        if store is not None:
+            store.save()
+
+        results = {}
+        out_states = {}
+        out_errors = {}
+        out_attempts = {}
+        for tid in ordered:
+            state = states[tid]
+            out_states[tid] = state
+            out_attempts[tid] = attempts[tid]
+            if state in ('done', 'cached'):
+                results[tid] = _copy_value(values[tid])
+            elif state == 'failed':
+                out_errors[tid] = errors[tid]
+        return {'results': results, 'states': out_states,
+                'errors': out_errors, 'attempts': out_attempts,
+                'max_active': tracker.peak}
diff --git a/boltons/cacheutils.py b/boltons/cacheutils.py
index 976f3ce..b427452 100644
--- a/boltons/cacheutils.py
+++ b/boltons/cacheutils.py
