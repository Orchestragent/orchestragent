diff --git a/boltons/taskqueueutils.py b/boltons/taskqueueutils.py
new file mode 100644
index 0000000..0949781
--- /dev/null
+++ b/boltons/taskqueueutils.py
@@ -0,0 +1,242 @@
+"""Resumable, deduplicating work queue fed by append-only JSONL input
+files and persisted atomically to a JSON checkpoint file.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from typing import Any, BinaryIO
+
+from boltons.fileutils import atomic_save_json
+from boltons.jsonutils import JSONLCheckpointIterator
+from boltons.queueutils import PriorityQueue
+
+__all__ = ['CheckpointQueue']
+
+SCHEMA_VERSION = 1
+
+_QUEUE_BACKEND = PriorityQueue
+
+
+def _validate_task_id(task_id):
+    if not isinstance(task_id, str) or not task_id:
+        raise ValueError('task_id expected a nonempty str, not %r'
+                         % (task_id,))
+
+
+def _validate_priority(priority):
+    if type(priority) not in (int, float):
+        raise ValueError('priority expected an int or float, not %r'
+                         % (priority,))
+    try:
+        finite = math.isfinite(priority)
+    except (OverflowError, TypeError):
+        finite = False
+    if not finite:
+        raise ValueError('priority expected a finite number, not %r'
+                         % (priority,))
+
+
+def _validate_payload(payload):
+    try:
+        json.dumps(payload, allow_nan=False)
+    except (TypeError, ValueError, OverflowError) as e:
+        raise ValueError('payload must be JSON-serializable with '
+                         'allow_nan=False: %s' % (e,)) from e
+
+
+class CheckpointQueue:
+    """Durable priority work queue with pending, in-flight and completed
+    task tracking, persisted to the JSON checkpoint at *path*.
+    """
+
+    def __init__(self, path: str | os.PathLike) -> None:
+        """Load state from *path* if it exists, else start empty."""
+        self.path = os.fspath(path)
+        self._queue = _QUEUE_BACKEND()
+        self._tasks = {}
+        self._inflight = {}
+        self._completed = set()
+        self._next_seq = 0
+        self._offsets = {}
+        try:
+            with open(self.path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+        try:
+            text = raw.decode('utf-8')
+            state = json.loads(text)
+        except (UnicodeDecodeError, ValueError) as e:
+            raise ValueError('error loading checkpoint %r: %s'
+                             % (self.path, e)) from e
+        self._load_state(state)
+
+    def _load_state(self, state):
+        if not isinstance(state, dict):
+            raise ValueError('checkpoint expected a JSON object')
+        version = state.get('schema_version')
+        if type(version) is not int or version != SCHEMA_VERSION:
+            raise ValueError('unsupported checkpoint schema_version: %r'
+                             % (version,))
+        next_seq = state.get('next_seq')
+        if type(next_seq) is not int or next_seq < 0:
+            raise ValueError('invalid next_seq: %r' % (next_seq,))
+        tasks = state.get('tasks')
+        if not isinstance(tasks, list):
+            raise ValueError('invalid tasks: %r' % (tasks,))
+        completed = state.get('completed')
+        if not isinstance(completed, list):
+            raise ValueError('invalid completed: %r' % (completed,))
+        offsets = state.get('offsets')
+        if not isinstance(offsets, dict):
+            raise ValueError('invalid offsets: %r' % (offsets,))
+
+        seen = set()
+        loaded = []
+        for rec in tasks:
+            if not isinstance(rec, dict):
+                raise ValueError('invalid task record: %r' % (rec,))
+            keys = set(rec)
+            if keys != {'id', 'payload', 'priority', 'seq'}:
+                raise ValueError('invalid task record keys: %r' % (keys,))
+            task_id = rec['id']
+            _validate_task_id(task_id)
+            if task_id in seen:
+                raise ValueError('duplicate task id in checkpoint: %r'
+                                 % (task_id,))
+            seen.add(task_id)
+            _validate_priority(rec['priority'])
+            _validate_payload(rec['payload'])
+            seq = rec['seq']
+            if type(seq) is not int or seq < 0 or seq >= next_seq:
+                raise ValueError('invalid task seq: %r' % (seq,))
+            loaded.append((seq, task_id, rec['payload'], rec['priority']))
+
+        completed_set = set()
+        for task_id in completed:
+            _validate_task_id(task_id)
+            if task_id in completed_set or task_id in seen:
+                raise ValueError('invalid completed entry: %r' % (task_id,))
+            completed_set.add(task_id)
+
+        offsets_map = {}
+        for source_id, value in offsets.items():
+            _validate_task_id(source_id)
+            if type(value) is not int or value < 0:
+                raise ValueError('invalid offset for %r: %r'
+                                 % (source_id, value))
+            offsets_map[source_id] = value
+
+        # everything validated; now replace state
+        loaded.sort(key=lambda r: r[0])
+        queue = _QUEUE_BACKEND()
+        tasks_map = {}
+        for seq, task_id, payload, priority in loaded:
+            tasks_map[task_id] = {'payload': payload,
+                                  'priority': priority,
+                                  'seq': seq}
+            queue.add(task_id, priority)
+        self._queue = queue
+        self._tasks = tasks_map
+        self._inflight = {}
+        self._completed = completed_set
+        self._next_seq = next_seq
+        self._offsets = offsets_map
+
+    def enqueue(self, task_id: str, payload: Any,
+                priority: int | float = 0) -> bool:
+        """Add a pending task. Return False for already-known IDs."""
+        _validate_task_id(task_id)
+        _validate_payload(payload)
+        _validate_priority(priority)
+        if (task_id in self._tasks or task_id in self._inflight
+                or task_id in self._completed):
+            return False
+        seq = self._next_seq
+        self._next_seq = seq + 1
+        self._tasks[task_id] = {'payload': payload,
+                                'priority': priority,
+                                'seq': seq}
+        self._queue.add(task_id, priority)
+        return True
+
+    def peek(self, count: int | None = None) -> list[str]:
+        """Return pending task IDs in pop order without consuming."""
+        return list(self._queue.peek_many(count))
+
+    def pop(self) -> dict[str, Any]:
+        """Move the top pending task to in-flight and return it."""
+        try:
+            task_id = self._queue.pop()
+        except IndexError:
+            raise IndexError('pop on empty queue') from None
+        record = self._tasks.pop(task_id)
+        self._inflight[task_id] = record
+        return {'id': task_id,
+                'payload': record['payload'],
+                'priority': record['priority']}
+
+    def ack(self, task_id: str) -> None:
+        """Mark an in-flight task as completed."""
+        if task_id not in self._inflight:
+            raise KeyError(task_id)
+        del self._inflight[task_id]
+        self._completed.add(task_id)
+
+    def save(self) -> None:
+        """Atomically persist the full queue state to the checkpoint."""
+        records = []
+        for task_id, record in self._tasks.items():
+            records.append({'id': task_id,
+                            'payload': record['payload'],
+                            'priority': record['priority'],
+                            'seq': record['seq']})
+        for task_id, record in self._inflight.items():
+            records.append({'id': task_id,
+                            'payload': record['payload'],
+                            'priority': record['priority'],
+                            'seq': record['seq']})
+        records.sort(key=lambda r: r['seq'])
+        state = {'schema_version': SCHEMA_VERSION,
+                 'next_seq': self._next_seq,
+                 'tasks': records,
+                 'completed': sorted(self._completed),
+                 'offsets': dict(self._offsets)}
+        atomic_save_json(self.path, state)
+        return None
+
+    def ingest(self, file_obj: BinaryIO, source_id: str) -> int:
+        """Enqueue new JSONL records from *file_obj* starting at the
+        saved offset for *source_id*; return the count newly enqueued.
+        """
+        _validate_task_id(source_id)
+        iterator = JSONLCheckpointIterator(
+            file_obj, self._offsets.get(source_id, 0))
+        count = 0
+        while True:
+            try:
+                record = next(iterator)
+            except StopIteration:
+                break
+            if not isinstance(record, dict):
+                raise ValueError('record at byte %r expected a JSON object, '
+                                 'not %r' % (iterator.byte_offset, record))
+            if set(record) != {'id', 'payload', 'priority'}:
+                raise ValueError('record at byte %r expected exactly keys '
+                                 "'id', 'payload', 'priority', not %r"
+                                 % (iterator.byte_offset,
+                                    sorted(record)))
+            task_id = record['id']
+            payload = record['payload']
+            priority = record['priority']
+            _validate_task_id(task_id)
+            _validate_payload(payload)
+            _validate_priority(priority)
+            if self.enqueue(task_id, payload, priority):
+                count += 1
+            self._offsets[source_id] = iterator.byte_offset
+        self._offsets[source_id] = iterator.byte_offset
+        return count
diff --git a/test_orch_t_001.py b/test_orch_t_001.py
new file mode 100644
index 0000000..36b7560
--- /dev/null
+++ b/test_orch_t_001.py
@@ -0,0 +1,119 @@
+import unittest
+
+from boltons.queueutils import (BasePriorityQueue, HeapPriorityQueue,
+                                SortedPriorityQueue)
+
+BACKENDS = (HeapPriorityQueue, SortedPriorityQueue)
+
+
+class TestPeekMany(unittest.TestCase):
+    def setUp(self):
+        self.calls = []
+
+    def _key(self, priority):
+        self.calls.append(priority)
+        return priority
+
+    def _build(self, cls, key=None):
+        pq = cls(priority_key=key) if key is not None else cls()
+        return pq
+
+    def test_r1_peek_many_count_none_returns_pop_order(self):
+        for cls in BACKENDS:
+            with self.subTest(cls=cls.__name__):
+                pq = cls()
+                for p, task in [(1, 'a'), (3, 'c'), (2, 'b'), (3, 'd')]:
+                    pq.add(task, p)
+                expected = ['c', 'd', 'b', 'a']
+                self.assertEqual(pq.peek_many(), expected)
+                self.assertEqual([pq.pop() for _ in range(4)], expected)
+
+    def test_r1_peek_many_count_nonmutating_and_matches_pops(self):
+        for cls in BACKENDS:
+            with self.subTest(cls=cls.__name__):
+                pq = cls()
+                for p, task in [(5, 'x'), (7, 'y'), (6, 'z')]:
+                    pq.add(task, p)
+                before = len(pq)
+                self.assertEqual(pq.peek_many(2), ['y', 'z'])
+                self.assertEqual(pq.peek_many(0), [])
+                self.assertEqual(pq.peek_many(99), ['y', 'z', 'x'])
+                self.assertEqual(len(pq), before)
+                self.assertEqual(pq.peek(), 'y')
+                self.assertEqual([pq.pop() for _ in range(3)], ['y', 'z', 'x'])
+
+    def test_r1_peek_many_skips_removed_and_superseded(self):
+        for cls in BACKENDS:
+            with self.subTest(cls=cls.__name__):
+                pq = cls()
+                pq.add('t1', 1)
+                pq.add('t2', 2)
+                pq.add('t3', 3)
+                pq.add('t1', 10)
+                pq.remove('t2')
+                self.assertEqual(pq.peek_many(), ['t1', 't3'])
+                self.assertEqual(pq.compact(), 2)
+                self.assertEqual(pq.peek_many(), ['t1', 't3'])
+                self.assertEqual(pq.compact(), 0)
+
+    def test_r1_peek_many_custom_priority_key_not_recalled(self):
+        for cls in BACKENDS:
+            with self.subTest(cls=cls.__name__):
+                pq = self._build(cls, self._key)
+                pq.add('a', 1)
+                pq.add('b', 5)
+                pq.add('c', 3)
+                call_count = len(self.calls)
+                self.assertEqual(pq.peek_many(), ['a', 'c', 'b'])
+                self.assertEqual(len(self.calls), call_count)
+
+    def test_r1_peek_many_invalid_counts(self):
+        for cls in BACKENDS:
+            with self.subTest(cls=cls.__name__):
+                pq = cls()
+                pq.add('a', 1)
+                for bad in (True, False, -1, 1.0, '2', None.__class__):
+                    with self.subTest(bad=bad):
+                        with self.assertRaises(ValueError):
+                            pq.peek_many(bad)
+                self.assertEqual(len(pq), 1)
+
+
+class TestCompact(unittest.TestCase):
+    def test_r1_compact_preserves_backend_and_order(self):
+        for cls in BACKENDS:
+            with self.subTest(cls=cls.__name__):
+                pq = cls()
+                for i in range(6):
+                    pq.add('task%d' % i, i % 3)
+                pq.remove('task0')
+                pq.add('task3', 99)
+                second = cls()
+                expected = pq.peek_many()
+                removed = pq.compact()
+                self.assertIsInstance(removed, int)
+                self.assertGreaterEqual(removed, 1)
+                self.assertIs(type(pq), cls)
+                self.assertEqual(pq.peek_many(), expected)
+                self.assertEqual(len(pq), len(expected))
+                second.add('x', 0)
+                pq.add('new', -1)
+                self.assertEqual(pq.pop(), 'task3')
+
+    def test_r1_compact_is_idempotent(self):
+        for cls in BACKENDS:
+            with self.subTest(cls=cls.__name__):
+                pq = cls()
+                pq.add('a', 1)
+                pq.add('b', 2)
+                pq.remove('a')
+                self.assertEqual(pq.compact(), 1)
+                self.assertEqual(pq.compact(), 0)
+                pq.add('c', 3)
+                self.assertEqual(pq.compact(), 0)
+                self.assertEqual(pq.pop(), 'c')
+                self.assertEqual(pq.pop(), 'b')
+                with self.assertRaises(IndexError):
+                    pq.pop()
+                self.assertEqual(pq.peek_many(), [])
+                self.assertEqual(pq.compact(), 0)
