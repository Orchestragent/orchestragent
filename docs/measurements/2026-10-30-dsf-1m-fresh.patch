+import json
+import os
+import pathlib
+import tempfile
+import unittest
+import unittest.mock
+
+from boltons import fileutils
+
+
+class TestAtomicSaveJson(unittest.TestCase):
+    def setUp(self):
+        self._tmpdir = tempfile.TemporaryDirectory()
+        self.tmpdir = pathlib.Path(self._tmpdir.name)
+        self.dest = self.tmpdir / "data.json"
+
+    def tearDown(self):
+        self._tmpdir.cleanup()
+
+    def _parts(self):
+        return sorted(p.name for p in self.tmpdir.iterdir())
+
+    def _seed(self):
+        sentinel = b'{"existing":true,' + b'"x":"\xc3\xa9"}\n'
+        self.dest.write_bytes(sentinel)
+        return sentinel
+
+    def test_r3_writes_deterministic_document(self):
+        cases = [
+            ({"b": 1, "a": 2}, '{"a":2,"b":1}\n'),
+            ({'k': 'caf\u00e9'}, '{"k":"caf\u00e9"}\n'),
+            ([[1, 2], {"z": [3, {"y": 4}]}], '[[1,2],{"z":[3,{"y":4}]}]\n'),
+            (None, 'null\n'),
+            ({"a": 1.5, "m": True}, '{"a":1.5,"m":true}\n'),
+        ]
+        for value, expected in cases:
+            with self.subTest(value=value):
+                self.dest.unlink(missing_ok=True)
+                ret = fileutils.atomic_save_json(self.dest, value)
+                self.assertIsNone(ret)
+                raw = self.dest.read_bytes()
+                self.assertEqual(raw, expected.encode("utf-8"))
+                self.assertEqual(json.loads(raw.decode("utf-8")), value)
+                self.assertEqual(self._parts(), ["data.json"])
+
+    def test_r3_matches_explicit_dumps(self):
+        value = {"z": "\u00e9\u4e2d", "a": [1, False, None], "m": {"k": 2}}
+        fileutils.atomic_save_json(self.dest, value)
+        expected = json.dumps(value, sort_keys=True, separators=(",", ":"),
+                              ensure_ascii=False, allow_nan=False) + "\n"
+        self.assertEqual(self.dest.read_bytes(), expected.encode("utf-8"))
+
+    def test_r3_accepts_str_and_pathlike(self):
+        for kind in ("str", "path"):
+            with self.subTest(kind=kind):
+                self.dest.unlink(missing_ok=True)
+                target = str(self.dest) if kind == "str" else pathlib.Path(self.dest)
+                self.assertIsNone(fileutils.atomic_save_json(target, {"x": 1}))
+                self.assertEqual(self.dest.read_bytes(), b'{"x":1}\n')
+
+    def test_r3_invalid_data_preserves_destination(self):
+        class Weird:
+            pass
+
+        bad_values = [
+            ({"v": float("nan")}, (TypeError, ValueError)),
+            ({"v": float("inf")}, (TypeError, ValueError)),
+            ([1, float("-inf")], (TypeError, ValueError)),
+            ({"v": object()}, TypeError),
+            ({"v": Weird()}, TypeError),
+            ({"v": {1, 2}}, TypeError),
+        ]
+        for value, excs in bad_values:
+            with self.subTest(value=repr(value)):
+                sentinel = self._seed()
+                with self.assertRaises(excs):
+                    fileutils.atomic_save_json(self.dest, value)
+                self.assertEqual(self.dest.read_bytes(), sentinel)
+                self.assertEqual(self._parts(), ["data.json"])
+
+    def test_r3_write_failure_preserves_destination(self):
+        class ExplodingFile:
+            def __init__(self, fh):
+                self._fh = fh
+
+            def write(self, data):
+                raise OSError("disk full")
+
+            def __getattr__(self, name):
+                return getattr(self._fh, name)
+
+        sentinel = self._seed()
+        orig = fileutils.atomic_save
+
+        class Patched:
+            def __init__(self, *a, **kw):
+                self._cm = orig(*a, **kw)
+
+            def __enter__(self):
+                return ExplodingFile(self._cm.__enter__())
+
+            def __exit__(self, *exc):
+                return self._cm.__exit__(*exc)
+
+        def fake_atomic_save(*a, **kw):
+            return Patched(*a, **kw)
+
+        with unittest.mock.patch.object(fileutils, "atomic_save", fake_atomic_save):
+            with self.assertRaises(OSError):
+                fileutils.atomic_save_json(self.dest, {"x": 1})
+        self.assertEqual(self.dest.read_bytes(), sentinel)
+        self.assertEqual(self._parts(), ["data.json"])
