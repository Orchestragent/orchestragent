+class JSONLCheckpointIterator:
+    """A forward iterator over JSON Lines data in a seekable binary
+    stream, with a resumable byte checkpoint.
+
+    Unlike :class:`JSONLIterator`, this iterator never realigns its
+n    position to a line boundary: the caller supplies absolute byte
+    checkpoints and the stream is read verbatim from that point. This
+    makes it suitable for crash-safe ingestion of append-only JSONL
+    files, where ``byte_offset`` can be persisted and used to resume.
+
+    Args:
+        file_obj (file): An open seekable binary file object. It is
+            never closed by this iterator.
+        offset (int): Absolute byte position to start reading from.
+            Must be an exact nonnegative ``int`` no greater than the
+            stream length.
+        ignore_errors (bool): Whether to skip lines that fail to decode
+            or deserialize as JSON, advancing past them. Defaults to
+            ``False``, which raises :exc:`ValueError`.
+
+    The public attribute ``byte_offset`` is the byte position just after
+    the last fully consumed newline-terminated line. An incomplete final
+    line (one without a trailing newline) is never consumed, so
+    ``byte_offset`` remains at its start.
+
+    """
+    def __init__(self, file_obj, offset=0, ignore_errors=False):
+        if type(offset) is not int:
+            raise ValueError('offset expected an int, not %r' % (offset,))
+        if offset < 0:
+            raise ValueError('offset expected a nonnegative int, not %r'
+                             % (offset,))
+        file_obj.seek(0, os.SEEK_END)
+        size = file_obj.tell()
+        if offset > size:
+            raise ValueError('offset %r exceeds stream length %r'
+                             % (offset, size))
+        file_obj.seek(offset, os.SEEK_SET)
+        self._file_obj = file_obj
+        self.ignore_errors = bool(ignore_errors)
+        self.byte_offset = offset
+
+    def __iter__(self):
+        return self
+
+    def next(self):
+        """Yields the next complete JSON value after ``byte_offset``.
+
+        Raises :exc:`StopIteration` at EOF or when only an incomplete
+        final line remains. Raises :exc:`ValueError` for malformed
+        lines when ``ignore_errors`` is false.
+        """
+        while 1:
+            cur_pos = self.byte_offset
+            self._file_obj.seek(cur_pos)
+            line = self._file_obj.readline()
+            if not line:
+                raise StopIteration
+            if not line.endswith(b'\n'):
+                # incomplete trailing line: leave it unconsumed
+                self._file_obj.seek(cur_pos)
+                raise StopIteration
+            end = cur_pos + len(line)
+            if not line.strip():
+                self.byte_offset = end
+                continue
+            try:
+                value = json.loads(line.decode('utf-8'))
+            except ValueError as e:
+                if self.ignore_errors:
+                    self.byte_offset = end
+                    continue
+                self._file_obj.seek(cur_pos)
+                raise ValueError('error loading JSON from line at byte %s: %s'
+                                 % (cur_pos, e)) from e
+            self.byte_offset = end
+            return value
+
+    __next__ = next
+
+
 if __name__ == '__main__':
     def _main():
         import sys
