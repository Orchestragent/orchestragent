+def atomic_save_json(dest_path, value):
+    """Atomically write *value* to *dest_path* as a single UTF-8 JSON
+    document, using :func:`atomic_save`.
+
+    The document is serialized deterministically (sorted keys, compact
+    separators, non-ASCII characters retained) and terminated by one
+    newline. Data that cannot be serialized raises before any file is
+    touched; on write failure the existing destination is left
+    unchanged and the temporary part file is removed.
+
+    Args:
+        dest_path (str or pathlib.Path): The path where the document
+            will be written.
+        value: Any JSON-serializable value.
+    """
+    serialized = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                            ensure_ascii=False, allow_nan=False)
+    data = (serialized + '\n').encode('utf-8')
+    path = os.fspath(dest_path)
+    with atomic_save(path) as f:
+        f.write(data)
+    return None
+
