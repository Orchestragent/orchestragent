+    def peek_many(self, count=None):
+        """Return up to *count* tasks in the order they would be returned
+        by repeated :meth:`pop` calls, without removing anything.
+        ``None`` (the default) means all tasks. Does not call
+        *priority_key* or mutate the queue. Raises :exc:`ValueError`
+        for invalid *count* values.
+        """
+        if count is not None:
+            if isinstance(count, bool) or not isinstance(count, int):
+                raise ValueError('count must be None or an int, not %r'
+                                 % (count,))
+            if count < 0:
+                raise ValueError('count must be nonnegative, not %r'
+                                 % (count,))
+        if not count and count is not None:
+            return []
+        result = []
+        if isinstance(self._pq, list) and not isinstance(self, SortedPriorityQueue):
+            import heapq
+            backend = list(self._pq)
+            while backend:
+                _, _, task = heappop(backend)
+                if task is _REMOVED:
+                    continue
+                result.append(task)
+                if count is not None and len(result) >= count:
+                    break
+            return result
+        entries = sorted(self._pq)
+        for explicit_index, entry in enumerate(entries):
+            del explicit_index
+            _, _, task = entry
+            if task is _REMOVED:
+                continue
+            result.append(task)
+            if count is not None and len(result) >= count:
+                break
+        return result
+
+    def compact(self):
+        """Remove tombstone entries left behind by :meth:`remove` from the
+        underlying backend, returning the number removed. Active
+        ordering is preserved and the backend object is reused.
+        """
+        active = []
+        removed = 0
+        for entry in self._pq:
+            if entry[-1] is _REMOVED:
+                removed += 1
+            else:
+                active.append(entry)
+        if not removed:
+            return 0
+        del self._pq[:]
+        entries = sorted(active) if not isinstance(self, HeapPriorityQueue) else active
+        if isinstance(self, HeapPriorityQueue):
+            import heapq
+            entries = list(active)
+        for entry in entries:
+            self._push_entry(self._pq, entry)
+        return removed
+
