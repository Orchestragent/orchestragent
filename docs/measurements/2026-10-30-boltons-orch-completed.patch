+def atomic_save_json(dest_path, value):
+    """Atomically write *value* as a deterministic JSON document to
+    *dest_path*, using :func:`atomic_save` under the hood.
+
+    The document is serialized with sorted keys, compact separators
+    ``(',', ':')``, non-ASCII characters preserved (not escaped), and
+    ``allow_nan=False``, then encoded as UTF-8 with exactly one
+    trailing newline.
+
+    Args:
+        dest_path (str or os.PathLike): The path where the completed
+            file will be written.
+        value (object): Any JSON-serializable object.
+
+    Serialization happens before any file is touched, so invalid or
+    nonserializable *value* raises the original ``TypeError`` or
+    ``ValueError`` while leaving any existing destination unchanged.
+    If the write fails, the destination is also left unchanged and no
+    part file is left behind.
+    """
+    dest_path = os.fspath(dest_path)
+    data = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False) + '\n'
+    encoded = data.encode('utf-8')
+    with atomic_save(dest_path) as f:
+        f.write(encoded)
+    return None
+
+
