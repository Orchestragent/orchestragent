@@ -234,6 +234,67 @@ class JSONLIterator:
     __next__ = next
 
 
+class JSONLCheckpointIterator:
+    """Iterate forward over JSON Lines records in a seekable binary
+    stream, tracking an absolute byte offset so iteration can be
+    checkpointed and resumed.
+
+    Args:
+        file_obj (file): An open, seekable binary file object.
+        offset (int): Exact non-negative byte offset to start reading
+            from. Must not exceed the stream length.
+        ignore_errors (bool): Whether to skip malformed lines instead
+            of raising :exc:`ValueError`.
+    """
+    def __init__(self, file_obj, offset=0, ignore_errors=False):
+        if isinstance(offset, bool) or not isinstance(offset, int):
+            raise ValueError('offset must be an int, not %r' % (offset,))
+        file_obj.seek(0, os.SEEK_END)
+        length = file_obj.tell()
+        if not 0 <= offset <= length:
+            raise ValueError('offset %r out of range [0, %r]'
+                             % (offset, length))
+        self._file_obj = file_obj
+        self.ignore_errors = bool(ignore_errors)
+        self.byte_offset = offset
+        file_obj.seek(offset, os.SEEK_SET)
+
+    def __iter__(self):
+        return self
+
+    def next(self):
+        fo = self._file_obj
+        while 1:
+            start = self.byte_offset
+            fo.seek(start, os.SEEK_SET)
+            line = fo.readline()
+            if not line.endswith(b'\n'):
+                # incomplete trailing line: do not consume it
+                fo.seek(start, os.SEEK_SET)
+                raise StopIteration
+            end = start + len(line)
+            if line.endswith(b'\r\n'):
+                content = line[:-2]
+            else:
+                content = line[:-1]
+            self.byte_offset = end
+            if not content.strip():
+                continue
+            try:
+                obj = json.loads(content.decode('utf-8'))
+            except ValueError:
+                self.byte_offset = start
+                if not self.ignore_errors:
+                    fo.seek(start, os.SEEK_SET)
+                    raise ValueError('error parsing JSON at byte offset %r'
+                                     % (start,))
+                self.byte_offset = end
+                continue
+            return obj
+
+    __next__ = next
+
+
 if __name__ == '__main__':
     def _main():
         import sys
