diff --git a/boltons/taskqueueutils.py b/boltons/taskqueueutils.py
new file mode 100644
index 0000000..01002aa
--- /dev/null
+++ b/boltons/taskqueueutils.py
@@ -0,0 +1,211 @@
+"""Resumable, deduplicating JSONL task queue with atomic JSON checkpoints.
+
+Integrates :mod:`boltons.queueutils`, :mod:`boltons.jsonutils` and
+:mod:`boltons.fileutils`. Experimental.
+"""
+
+import json
+import math
+import os
+from typing import Any, BinaryIO, Dict, List, Optional, Union
+
+from .fileutils import atomic_save_json
+from .jsonutils import JSONLCheckpointIterator
+from .queueutils import HeapPriorityQueue
+
+__all__ = ['CheckpointQueue']
+
+SCHEMA_VERSION = 1
+
+
+def _validate_priority(priority):
+    if isinstance(priority, bool) or not isinstance(priority, (int, float)):
+        raise ValueError('priority must be an int or float, not bool')
+    if not math.isfinite(priority):
+        raise ValueError('priority must be finite')
+
+
+def _validate_seq(seq):
+    if isinstance(seq, bool) or not isinstance(seq, int):
+        raise ValueError('seq must be an int')
+
+
+def _validate_task_entry(entry):
+    if not isinstance(entry, dict) or set(entry) != {'id', 'payload', 'priority', 'seq'}:
+        raise ValueError('invalid task entry')
+    task_id = entry['id']
+    if not isinstance(task_id, str) or not task_id:
+        raise ValueError('invalid task id')
+    _validate_priority(entry['priority'])
+    _validate_seq(entry['seq'])
+    try:
+        json.dumps(entry['payload'], allow_nan=False)
+    except (TypeError, ValueError):
+        raise ValueError('invalid payload')
+
+
+class CheckpointQueue:
+    """Durable priority work queue backed by a JSON checkpoint file.
+
+    Larger priority pops first; ties pop in original insertion order.
+    Mutations are in-memory only until :meth:`save` is called.
+    """
+
+    def __init__(self, path: Union[str, os.PathLike]) -> None:
+        """Load state from *path* if it exists, else start empty.
+
+        Raises ValueError for malformed or unsupported state.
+        """
+        self.path = path
+        pq = HeapPriorityQueue()
+        tasks = {}
+        in_flight = {}
+        completed = set()
+        next_seq = 0
+        offsets = {}
+        if os.path.exists(path):
+            try:
+                with open(path, 'rb') as f:
+                    raw = f.read()
+                state = json.loads(raw)
+            except Exception as exc:
+                raise ValueError('could not load checkpoint: %r' % (exc,))
+            if not isinstance(state, dict):
+                raise ValueError('checkpoint must be a dict')
+            if state.get('schema_version') != SCHEMA_VERSION or \
+                    isinstance(state.get('schema_version'), bool):
+                raise ValueError('unsupported schema version')
+            if set(state) != {'schema_version', 'pending', 'in_flight',
+                              'completed', 'next_seq', 'offsets'}:
+                raise ValueError('checkpoint missing required keys')
+            pending = state['pending']
+            inflight = state['in_flight']
+            completed_raw = state['completed']
+            next_seq = state['next_seq']
+            offsets = state['offsets']
+            if not isinstance(pending, list) or not isinstance(inflight, list):
+                raise ValueError('pending/in_flight must be lists')
+            if not isinstance(completed_raw, list):
+                raise ValueError('completed must be a list')
+            if not isinstance(offsets, dict):
+                raise ValueError('offsets must be a dict')
+            _validate_seq(next_seq)
+            if next_seq < 0:
+                raise ValueError('next_seq must be nonnegative')
+            entries = list(pending) + list(inflight)
+            for entry in entries:
+                _validate_task_entry(entry)
+            for c in completed_raw:
+                if not isinstance(c, str):
+                    raise ValueError('completed ids must be strings')
+            for sid, off in offsets.items():
+                if not isinstance(sid, str):
+                    raise ValueError('offset keys must be strings')
+                if isinstance(off, bool) or not isinstance(off, int) or off < 0:
+                    raise ValueError('offsets must be nonnegative ints')
+            entries.sort(key=lambda e: e['seq'])
+            for entry in entries:
+                task_id = entry['id']
+                if task_id in tasks:
+                    raise ValueError('duplicate task id')
+                tasks[task_id] = (entry['payload'], entry['priority'], entry['seq'])
+                pq.add(task_id, entry['priority'])
+            completed = set(completed_raw)
+        self._pq = pq
+        self._tasks = tasks
+        self._in_flight = in_flight
+        self._completed = completed
+        self._next_seq = next_seq
+        self._offsets = offsets
+
+    def _validate(self, task_id: str, payload: Any,
+                  priority: Union[int, float]) -> None:
+        if not isinstance(task_id, str) or not task_id:
+            raise ValueError('task_id must be a nonempty string')
+        try:
+            json.dumps(payload, allow_nan=False)
+        except (TypeError, ValueError):
+            raise ValueError('payload must be JSON-serializable with finite numbers')
+        _validate_priority(priority)
+
+    def enqueue(self, task_id: str, payload: Any,
+                priority: Union[int, float] = 0) -> bool:
+        """Add a pending task; return False if the ID is already known."""
+        self._validate(task_id, payload, priority)
+        if task_id in self._tasks or task_id in self._completed:
+            return False
+        seq = self._next_seq
+        self._tasks[task_id] = (payload, priority, seq)
+        self._pq.add(task_id, priority)
+        self._next_seq += 1
+        return True
+
+    def peek(self, count: Optional[int] = None) -> List[str]:
+        """Return pending task IDs in pop order without consuming them."""
+        return list(self._pq.peek_many(count))
+
+    def pop(self) -> Dict[str, Any]:
+        """Move the top pending task to in-flight and return
+        ``{'id': ..., 'payload': ..., 'priority': ...}``.
+
+        Raises IndexError when no task is pending.
+        """
+        if len(self._pq) == 0:
+            raise IndexError('no pending tasks')
+        task_id = self._pq.pop()
+        payload, priority, seq = self._tasks[task_id]
+        self._in_flight[task_id] = seq
+        return {'id': task_id, 'payload': payload, 'priority': priority}
+
+    def ack(self, task_id: str) -> None:
+        """Mark an in-flight task completed; KeyError otherwise."""
+        if task_id not in self._in_flight:
+            raise KeyError(task_id)
+        del self._in_flight[task_id]
+        del self._tasks[task_id]
+        self._completed.add(task_id)
+
+    def save(self) -> None:
+        """Atomically persist the full queue state to the checkpoint path."""
+        pending = []
+        for task_id in self._pq.peek_many():
+            payload, priority, seq = self._tasks[task_id]
+            pending.append({'id': task_id, 'payload': payload,
+                            'priority': priority, 'seq': seq})
+        in_flight = []
+        for task_id, seq in sorted(self._in_flight.items(), key=lambda kv: kv[1]):
+            payload, priority, _ = self._tasks[task_id]
+            in_flight.append({'id': task_id, 'payload': payload,
+                              'priority': priority, 'seq': seq})
+        state = {
+            'schema_version': SCHEMA_VERSION,
+            'pending': pending,
+            'in_flight': in_flight,
+            'completed': sorted(self._completed),
+            'next_seq': self._next_seq,
+            'offsets': dict(self._offsets),
+        }
+        atomic_save_json(self.path, state)
+
+    def ingest(self, file_obj: BinaryIO, source_id: str) -> int:
+        """Enqueue complete JSONL records from *file_obj* starting at the
+        saved offset for *source_id*; return the number newly enqueued.
+        """
+        if not isinstance(source_id, str) or not source_id:
+            raise ValueError('source_id must be a nonempty string')
+        offset = self._offsets.get(source_id, 0)
+        pos = file_obj.tell()
+        size = file_obj.seek(0, os.SEEK_END)
+        file_obj.seek(pos)
+        if offset > size:
+            return 0
+        it = JSONLCheckpointIterator(file_obj, offset)
+        added = 0
+        for record in it:
+            if not isinstance(record, dict) or set(record) != {'id', 'payload', 'priority'}:
+                raise ValueError('invalid record in source %r' % (source_id,))
+            if self.enqueue(record['id'], record['payload'], record['priority']):
+                added += 1
+            self._offsets[source_id] = it.byte_offset
+        self._offsets[source_id] = it.byte_offset
+        return added
