+def atomic_save_json(dest_path, value):
+    """Atomically write *value* to *dest_path* as a single UTF-8 JSON
+    document, built on :func:`atomic_save`.
+
+    The document is serialized with sorted keys, compact separators,
+    retained Unicode characters, and no NaN/Infinity values, followed
+    by exactly one trailing newline. *dest_path* may be a :class:`str`
+    or :class:`os.PathLike` (e.g., :class:`pathlib.Path`).
+
+    Serialization errors (:exc:`TypeError`, :exc:`ValueError`) are
+    raised before any file is touched. On any failure, an existing
+    destination is left byte-for-byte unchanged and the temporary
+    part file is removed.
+
+    >>> atomic_save_json('out.json', {'b': 1, 'a': 2})
+    >>> open('out.json', 'rb').read()
+    b'{"a":2,"b":1}\\n'
+
+    Returns ``None``.
+    """
+    data = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False)
+    data = (data + '\n').encode('utf-8')
+    with atomic_save(os.fspath(dest_path)) as f:
+        f.write(data)
+    return
+
+
