+class JSONLCheckpointIterator:
+    """The ``JSONLCheckpointIterator`` iterates over JSON Lines records of a
+    seekable binary stream, starting at an absolute byte offset, while
+    tracking exactly how far it has consumed.
+
+    Unlike :class:`JSONLIterator`, this iterator keeps a public
+    :attr:`byte_offset` marking the position just past the last consumed
+    complete line. That position can be persisted and passed back as
+    ``offset`` to resume reading an append-only file later, after more
+    lines have been written to it.
+
+    Args:
+        file_obj (file): A seekable binary file object. It is never closed
+            by the iterator.
+        offset (int): The exact byte offset to start reading from. Must be
+            an ``int`` between 0 and the stream length, inclusive.
+        ignore_errors (bool): When true, lines that fail UTF-8 decoding or
+            JSON parsing are skipped (advancing ``byte_offset`` past them).
+            When false, such a line raises :exc:`ValueError` and
+            ``byte_offset`` is left at the start of the bad line.
+    """
+    def __init__(self, file_obj, offset=0, ignore_errors=False):
+        if type(offset) is not int:
+            raise ValueError('offset expected an int, not %r' % (offset,))
+        file_obj.seek(0, os.SEEK_END)
+        length = file_obj.tell()
+        if offset < 0 or offset > length:
+            raise ValueError('offset expected between 0 and stream length (%d),'
+                             ' not %r' % (length, offset))
+        self._file_obj = file_obj
+        self.ignore_errors = bool(ignore_errors)
+        self._byte_offset = offset
+        file_obj.seek(offset, os.SEEK_SET)
+
+    @property
+    def byte_offset(self):
+        "The byte position after the last consumed complete line."
+        return self._byte_offset
+
+    def __iter__(self):
+        return self
+
+    def next(self):
+        """Returns the next decoded JSON value, or raises
+        :exc:`StopIteration` at the end of (or an incomplete tail of) the
+        stream. Raises :exc:`ValueError` on a malformed line.
+        """
+        fo = self._file_obj
+        while 1:
+            start = self._byte_offset
+            fo.seek(start, os.SEEK_SET)
+            line = fo.readline()
+            if not line.endswith(b'\n'):
+                # EOF or incomplete trailing line; never consume it
+                raise StopIteration
+            new_offset = start + len(line)
+            if not line.strip():
+                self._byte_offset = new_offset
+                continue
+            if line.endswith(b'\r\n'):
+                payload = line[:-2]
+            else:
+                payload = line[:-1]
+            try:
+                text = payload.decode('utf-8')
+                value = json.loads(text)
+            except UnicodeDecodeError as ude:
+                if not self.ignore_errors:
+                    raise ValueError('invalid UTF-8 at byte %s: %s'
+                                     % (start, ude))
+                self._byte_offset = new_offset
+                continue
+            except ValueError as ve:
+                if not self.ignore_errors:
+                    raise ValueError('invalid JSON at byte %s: %s'
+                                     % (start, ve))
+                self._byte_offset = new_offset
+                continue
+            self._byte_offset = new_offset
+            return value
+
+    __next__ = next
+
+
