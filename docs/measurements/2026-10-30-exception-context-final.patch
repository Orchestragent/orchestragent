+class JSONLCheckpointIterator:
+    """The ``JSONLCheckpointIterator`` iterates forward over a seekable
+    binary stream in `JSON Lines format`_, starting from an absolute
+    byte offset and tracking a resumable :attr:`byte_offset`.
+
+    Only complete, newline-terminated lines are consumed. A trailing
+    line without a newline is left unconsumed, so ``byte_offset``
+    stays at that line's start; a new iterator at that offset picks the
+    line up once more bytes have been appended. Blank (whitespace-only)
+    lines are skipped but still advance :attr:`byte_offset`.
+
+    Args:
+        file_obj (file): An open, seekable binary file object. It is
+            never closed by the iterator.
+        offset (int): The absolute byte offset to start reading from
+            (e.g., a previously saved ``byte_offset``).
+        ignore_errors (bool): Whether to skip lines that fail UTF-8
+            decoding or :func:`json.loads`, instead of raising.
+
+    .. _JSON Lines format: http://jsonlines.org/
+    """
+    def __init__(self, file_obj, offset=0, ignore_errors=False):
+        if type(offset) is not int or offset < 0:
+            raise ValueError("'offset' expected a non-negative int, not %r"
+                             % (offset,))
+        end = file_obj.seek(0, os.SEEK_END)
+        if end is None:
+            end = file_obj.tell()
+        if offset > end:
+            raise ValueError("'offset' (%r) exceeds stream length (%r)"
+                             % (offset, end))
+        file_obj.seek(offset, os.SEEK_SET)
+        self._file_obj = file_obj
+        self.ignore_errors = ignore_errors
+        self.byte_offset = offset
+
+    def __iter__(self):
+        return self
+
+    def next(self):
+        """Yields the next decoded JSON value, advancing
+        :attr:`byte_offset` past each consumed line. Raises
+        :exc:`StopIteration` at the end of the stream (including when
+        only an incomplete trailing line remains). Raises
+        :exc:`ValueError` on a malformed line unless ``ignore_errors``
+        is set.
+        """
+        fo = self._file_obj
+        while 1:
+            fo.seek(self.byte_offset, os.SEEK_SET)
+            line = fo.readline()
+            if not line.endswith(b'\n'):
+                # incomplete or missing final line: leave it unconsumed
+                fo.seek(self.byte_offset, os.SEEK_SET)
+                raise StopIteration
+            next_offset = self.byte_offset + len(line)
+            stripped = line.strip()
+            if not stripped:
+                self.byte_offset = next_offset
+                continue
+            try:
+                obj = json.loads(stripped.decode('utf-8'))
+            except Exception:
+                if not self.ignore_errors:
+                    fo.seek(self.byte_offset, os.SEEK_SET)
+                    raise ValueError('could not decode JSON line at'
+                                     ' byte offset %s' % self.byte_offset)
+                self.byte_offset = next_offset
+                continue
+            self.byte_offset = next_offset
+            return obj
+
+    __next__ = next
+
+
 if __name__ == '__main__':
     def _main():
         import sys
