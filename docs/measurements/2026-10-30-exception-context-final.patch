+    def peek_many(self, count=None):
+        """Read up to *count* tasks in the order they would be returned by
+        repeated :meth:`pop` calls, without removing them or invoking
+        the *priority_key*. *count* of ``None`` means all tasks; an
+        exact nonnegative integer limits the result length. Invalid
+        *count* values raise :exc:`ValueError`.
+        """
+        if count is not None:
+            if type(count) is not int:
+                raise ValueError('count must be None or an exact int,'
+                                 ' not %r' % (count,))
+            if count < 0:
+                raise ValueError('count must be nonnegative, not %r'
+                                 % (count,))
+        active = [entry for entry in self._pq if entry[2] is not _REMOVED]
+        active.sort(key=lambda entry: (entry[0], entry[1]))
+        tasks = [entry[2] for entry in active]
+        if count is None:
+            return tasks
+        return tasks[:count]
+
+    def compact(self):
+        """Remove tombstoned entries from the backend, preserving the
+        active ordering and backend type. Returns the number of
+        entries removed.
+        """
+        old = self._pq
+        active = [entry for entry in old if entry[2] is not _REMOVED]
+        removed = len(old) - len(active)
+        new = self._backend_type()
+        for entry in sorted(active, key=lambda e: (e[0], e[1])):
+            self._push_entry(new, entry)
+        self._pq = new
+        return removed
+
     def __len__(self):
         "Return the number of tasks in the queue."
         return len(self._entry_map)
diff --git a/boltons/taskqueueutils.py b/boltons/taskqueueutils.py
new file mode 100644
index 0000000..d6cca8f
--- /dev/null
+++ b/boltons/taskqueueutils.py
@@ -0,0 +1,218 @@
+"""Resumable, deduplicating work queue fed from append-only JSONL files.
+
+:class:`CheckpointQueue` combines :mod:`boltons.queueutils` priority
+queues, :class:`boltons.jsonutils.JSONLCheckpointIterator` and
+:func:`boltons.fileutils.atomic_save_json` into a durable queue whose
+state is only persisted on explicit :meth:`CheckpointQueue.save`.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from typing import IO, Any
+
+from boltons.fileutils import atomic_save_json
+from boltons.jsonutils import JSONLCheckpointIterator
+from boltons.queueutils import PriorityQueue
+
+__all__ = ['CheckpointQueue']
+
+SCHEMA_VERSION = 1
+
+_TASK_KEYS = frozenset(['id', 'payload', 'priority'])
+_STATE_KEYS = frozenset(['schema_version', 'next_seq', 'tasks',
+                         'inflight', 'completed', 'offsets'])
+_STATE_TASK_KEYS = frozenset(['id', 'payload', 'priority', 'seq'])
+
+
+def _is_exact_int(value):
+    return type(value) is int
+
+
+def _check_task_id(task_id):
+    if not isinstance(task_id, str) or not task_id:
+        raise ValueError('task_id must be a nonempty str, not %r' % (task_id,))
+
+
+def _check_payload(payload):
+    try:
+        text = json.dumps(payload, allow_nan=False)
+    except (TypeError, ValueError, RecursionError) as exc:
+        raise ValueError('payload is not JSON-serializable: %s' % (exc,))
+    return json.loads(text)
+
+
+def _check_priority(priority):
+    if type(priority) not in (int, float):
+        raise ValueError('priority must be an int or float, not %r'
+                         % (priority,))
+    if type(priority) is float and not math.isfinite(priority):
+        raise ValueError('priority must be finite, not %r' % (priority,))
+
+
+def _new_queue():
+    # priorities are (-priority, seq) tuples: larger priority first,
+    # original insertion order for ties
+    return PriorityQueue(priority_key=lambda p: p)
+
+
+class CheckpointQueue:
+    """Durable priority work queue checkpointed to a JSON file at *path*.
+
+    Missing checkpoint files yield an empty queue; existing ones are
+    loaded (schema_version 1) with in-flight work recovered as pending.
+    Unsupported or malformed state raises ValueError.
+    """
+
+    def __init__(self, path: str | os.PathLike[str]) -> None:
+        self.path = os.fspath(path)
+        self._queue = _new_queue()
+        self._tasks = {}  # id -> {'payload', 'priority', 'seq'}
+        self._inflight = []
+        self._completed = []
+        self._known = set()
+        self._offsets = {}
+        self._next_seq = 0
+        try:
+            with open(self.path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+        self._load(raw)
+
+    def _load(self, raw):
+        try:
+            state = json.loads(raw.decode('utf-8'))
+        except (UnicodeDecodeError, ValueError) as exc:
+            raise ValueError('malformed checkpoint state: %s' % (exc,))
+        if not isinstance(state, dict):
+            raise ValueError('checkpoint state must be a JSON object')
+        version = state.get('schema_version')
+        if not _is_exact_int(version) or version != SCHEMA_VERSION:
+            raise ValueError('unsupported schema_version: %r' % (version,))
+        if set(state) != _STATE_KEYS:
+            raise ValueError('checkpoint state keys must be exactly %r'
+                             % (sorted(_STATE_KEYS),))
+        next_seq = state['next_seq']
+        if not _is_exact_int(next_seq) or next_seq < 0:
+            raise ValueError('invalid next_seq: %r' % (next_seq,))
+        tasks_raw = state['tasks']
+        if not isinstance(tasks_raw, list):
+            raise ValueError('tasks must be a list')
+        tasks, seqs = {}, set()
+        for item in tasks_raw:
+            if not isinstance(item, dict) or set(item) != _STATE_TASK_KEYS:
+                raise ValueError('invalid task entry: %r' % (item,))
+            tid, seq = item['id'], item['seq']
+            _check_task_id(tid)
+            _check_priority(item['priority'])
+            if not _is_exact_int(seq) or not 0 <= seq < next_seq:
+                raise ValueError('invalid task seq: %r' % (seq,))
+            if tid in tasks or seq in seqs:
+                raise ValueError('duplicate task entry: %r' % (tid,))
+            tasks[tid] = {'payload': item['payload'],
+                          'priority': item['priority'], 'seq': seq}
+            seqs.add(seq)
+        inflight = state['inflight']
+        if (not isinstance(inflight, list)
+                or not all(isinstance(t, str) and t in tasks for t in inflight)
+                or len(set(inflight)) != len(inflight)):
+            raise ValueError('invalid inflight list')
+        completed = state['completed']
+        if (not isinstance(completed, list)
+                or not all(isinstance(t, str) and t for t in completed)
+                or len(set(completed)) != len(completed)
+                or set(completed) & set(tasks)):
+            raise ValueError('invalid completed list')
+        offsets = state['offsets']
+        if not isinstance(offsets, dict):
+            raise ValueError('offsets must be an object')
+        for key, value in offsets.items():
+            if not key or not _is_exact_int(value) or value < 0:
+                raise ValueError('invalid offset %r: %r' % (key, value))
+
+        self._tasks = tasks
+        self._next_seq = next_seq
+        self._completed = list(completed)
+        self._known = set(tasks) | set(completed)
+        self._offsets = dict(offsets)
+        # in-flight work is recovered as pending with its original seq
+        for tid, task in sorted(tasks.items(), key=lambda kv: kv[1]['seq']):
+            self._queue.add(tid, (-task['priority'], task['seq']))
+
+    def enqueue(self, task_id: str, payload: Any, priority: int | float = 0) -> bool:
+        """Queue a task; return False if *task_id* was already seen."""
+        _check_task_id(task_id)
+        payload = _check_payload(payload)
+        _check_priority(priority)
+        if task_id in self._known:
+            return False
+        seq = self._next_seq
+        self._next_seq += 1
+        self._tasks[task_id] = {'payload': payload, 'priority': priority,
+                                'seq': seq}
+        self._known.add(task_id)
+        self._queue.add(task_id, (-priority, seq))
+        return True
+
+    def peek(self, count: int | None = None) -> list[str]:
+        """Return pending task IDs in pop order without consuming them."""
+        return list(self._queue.peek_many(count))
+
+    def pop(self) -> dict[str, Any]:
+        """Move the next pending task to in-flight and return it."""
+        try:
+            tid = self._queue.pop()
+        except IndexError:
+            raise IndexError('pop from empty CheckpointQueue')
+        self._inflight.append(tid)
+        task = self._tasks[tid]
+        return {'id': tid, 'payload': task['payload'],
+                'priority': task['priority']}
+
+    def ack(self, task_id: str) -> None:
+        """Mark an in-flight task as completed."""
+        if not isinstance(task_id, str) or task_id not in self._inflight:
+            raise KeyError(task_id)
+        self._inflight.remove(task_id)
+        del self._tasks[task_id]
+        self._completed.append(task_id)
+
+    def save(self) -> None:
+        """Atomically persist the queue state to the checkpoint path."""
+        tasks = [{'id': tid, 'payload': task['payload'],
+                  'priority': task['priority'], 'seq': task['seq']}
+                 for tid, task in sorted(self._tasks.items(),
+                                         key=lambda kv: kv[1]['seq'])]
+        state = {
+            'schema_version': SCHEMA_VERSION,
+            'next_seq': self._next_seq,
+            'tasks': tasks,
+            'inflight': list(self._inflight),
+            'completed': list(self._completed),
+            'offsets': dict(self._offsets),
+        }
+        self._queue.compact()
+        atomic_save_json(self.path, state)
+
+    def ingest(self, file_obj: IO[bytes], source_id: str) -> int:
+        """Enqueue new JSONL records from *file_obj* past the saved offset."""
+        if not isinstance(source_id, str) or not source_id:
+            raise ValueError('source_id must be a nonempty str, not %r'
+                             % (source_id,))
+        iterator = JSONLCheckpointIterator(
+            file_obj, offset=self._offsets.get(source_id, 0))
+        accepted = 0
+        for record in iterator:
+            if not isinstance(record, dict) or set(record) != _TASK_KEYS:
+                raise ValueError('JSONL record must be an object with exactly'
+                                 ' id, payload and priority: %r' % (record,))
+            if self.enqueue(record['id'], record['payload'],
+                            record['priority']):
+                accepted += 1
+            self._offsets[source_id] = iterator.byte_offset
+        # covers trailing blank lines consumed after the last record
+        self._offsets[source_id] = iterator.byte_offset
+        return accepted
