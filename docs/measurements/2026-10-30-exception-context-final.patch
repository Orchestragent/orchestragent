+def atomic_save_json(dest_path, value):
+    """Atomically write *value* as a single UTF-8 JSON document to
+    *dest_path*, using :func:`atomic_save`.
+
+    The document uses sorted keys, compact separators, retained
+    (non-escaped) unicode, rejects non-finite floats, and ends with a
+    single trailing newline. If *value* is not serializable, the
+    exception is raised before the destination is touched. If writing
+    fails, an existing destination is left unchanged and the temporary
+    part file is removed. Returns ``None``.
+    """
+    dest_path = os.fspath(dest_path)
+    text = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False) + '\n'
+    data = text.encode('utf-8')
+    saver = atomic_save(dest_path, overwrite=True)
+    fo = saver.__enter__()
+    try:
+        fo.write(data)
+    except BaseException:
+        saver.__exit__(*sys.exc_info())
+        raise
+    saver.__exit__(None, None, None)
+    return
+
