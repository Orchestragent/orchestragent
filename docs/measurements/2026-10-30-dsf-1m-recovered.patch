+def atomic_save_json(dest_path, value):
+    """Atomically write *value* as a single UTF-8 JSON document to
+    *dest_path*. Keys are sorted, separators are compact, non-ASCII
+    characters are retained, and NaN/Infinity values are rejected. The
+    output is followed by exactly one trailing newline.
+
+    Serialization is performed before any file is opened, so a failing
+    serialization leaves the destination untouched. Write failures are
+    handled by :class:`AtomicSaver`, which preserves any existing
+    destination and cleans up the temporary part file.
+
+    Args:
+        dest_path (str or os.PathLike): The path where the document
+            will be written.
+        value: Any JSON-serializable object.
+
+    Returns:
+        None
+    """
+    data = json.dumps(value,
+                      sort_keys=True,
+                      separators=(',', ':'),
+                      ensure_ascii=False,
+                      allow_nan=False) + '\n'
+    data = data.encode('utf-8')
+    with atomic_save(os.fspath(dest_path)) as f:
+        f.write(data)
+    return
+
