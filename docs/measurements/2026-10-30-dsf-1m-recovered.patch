--- /dev/null
+++ b/boltons/taskqueueutils.py
@@ -0,0 +1,218 @@
+"""Resumable, deduplicating work queue fed from append-only JSONL inputs.
+
+:class:`CheckpointQueue` combines :mod:`boltons.queueutils` priority
+queues, :class:`boltons.jsonutils.JSONLCheckpointIterator` and
+:func:`boltons.fileutils.atomic_save_json` to provide durable,
+explicitly-saved queue state.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from typing import IO, Any, Dict, List, Optional, Union
+
+from boltons.queueutils import HeapPriorityQueue
+from boltons.jsonutils import JSONLCheckpointIterator
+from boltons.fileutils import atomic_save_json
+
+__all__ = ['CheckpointQueue', 'SCHEMA_VERSION']
+
+SCHEMA_VERSION = 1
+
+
+class CheckpointQueue:
+    """Durable priority work queue with pending, in-flight and completed
+    task IDs and per-source JSONL input byte offsets.
+
+    State is only written to *path* when :meth:`save` is called.
+    """
+
+    def __init__(self, path: Union[str, os.PathLike]) -> None:
+        """Load state from *path* if it exists, else start empty.
+
+        Raises ValueError for unsupported or malformed state.
+        """
+        self.path = os.fspath(path)
+        self._pending = HeapPriorityQueue()
+        self._records = {}
+        self._in_flight = {}
+        self._completed = set()
+        self._offsets = {}
+        self._next_seq = 0
+        if not os.path.exists(self.path):
+            return
+        with open(self.path, 'rb') as f:
+            data = f.read()
+        try:
+            state = json.loads(data.decode('utf-8'))
+        except (UnicodeDecodeError, ValueError):
+            raise ValueError('checkpoint state is not valid JSON')
+        self._load_state(state)
+
+    @staticmethod
+    def _check_id(task_id):
+        if type(task_id) is not str or task_id == '':
+            raise ValueError('task id must be a nonempty str, not %r'
+                             % (task_id,))
+
+    @staticmethod
+    def _check_payload(payload):
+        try:
+            json.dumps(payload, allow_nan=False)
+        except (TypeError, ValueError, RecursionError, OverflowError):
+            raise ValueError('payload is not JSON-serializable: %r'
+                             % (payload,))
+
+    @staticmethod
+    def _check_priority(priority):
+        if type(priority) not in (int, float):
+            raise ValueError('priority must be an int or float, not %r'
+                             % (priority,))
+        try:
+            finite = math.isfinite(float(priority))
+        except OverflowError:
+            raise ValueError('priority is not finite: %r' % (priority,))
+        if not finite:
+            raise ValueError('priority is not finite: %r' % (priority,))
+
+    def _load_state(self, state):
+        if type(state) is not dict:
+            raise ValueError('checkpoint state must be a JSON object')
+        version = state.get('schema_version')
+        if type(version) is not int or version != SCHEMA_VERSION:
+            raise ValueError('unsupported schema version: %r' % (version,))
+        for key in ('next_seq', 'pending', 'in_flight', 'completed', 'offsets'):
+            if key not in state:
+                raise ValueError('checkpoint state missing %r' % (key,))
+        next_seq = state['next_seq']
+        if type(next_seq) is not int or next_seq < 0:
+            raise ValueError('invalid next_seq: %r' % (next_seq,))
+        items = []
+        for key in ('pending', 'in_flight'):
+            group = state[key]
+            if type(group) is not list:
+                raise ValueError('%r must be a list' % (key,))
+            for item in group:
+                if type(item) is not dict or set(item) != {'id', 'payload',
+                                                           'priority', 'seq'}:
+                    raise ValueError('malformed %r entry: %r' % (key, item))
+                self._check_id(item['id'])
+                self._check_payload(item['payload'])
+                self._check_priority(item['priority'])
+                if type(item['seq']) is not int or item['seq'] < 0:
+                    raise ValueError('invalid seq: %r' % (item['seq'],))
+                items.append(item)
+        completed = state['completed']
+        if type(completed) is not list:
+            raise ValueError("'completed' must be a list")
+        for task_id in completed:
+            self._check_id(task_id)
+        offsets = state['offsets']
+        if type(offsets) is not dict:
+            raise ValueError("'offsets' must be a JSON object")
+        for source_id, offset in offsets.items():
+            self._check_id(source_id)
+            if type(offset) is not int or offset < 0:
+                raise ValueError('invalid offset for %r: %r'
+                                 % (source_id, offset))
+        seen = set()
+        for item in items:
+            if item['id'] in seen:
+                raise ValueError('duplicate id in state: %r' % (item['id'],))
+            seen.add(item['id'])
+        for task_id in completed:
+            if task_id in seen:
+                raise ValueError('duplicate id in state: %r' % (task_id,))
+            seen.add(task_id)
+        items.sort(key=lambda it: it['seq'])
+        for item in items:
+            self._records[item['id']] = {'payload': item['payload'],
+                                         'priority': item['priority'],
+                                         'seq': item['seq']}
+            self._pending.add(item['id'], item['priority'])
+        self._completed = set(completed)
+        self._offsets = dict(offsets)
+        max_seq = max([it['seq'] for it in items] + [-1]) + 1
+        self._next_seq = max(next_seq, max_seq)
+
+    def enqueue(self, task_id: str, payload: Any,
+                priority: Union[int, float] = 0) -> bool:
+        """Add a pending task; False if the ID is already known."""
+        self._check_id(task_id)
+        self._check_payload(payload)
+        self._check_priority(priority)
+        if (task_id in self._records or task_id in self._in_flight
+                or task_id in self._completed):
+            return False
+        seq = self._next_seq
+        self._next_seq = seq + 1
+        self._records[task_id] = {'payload': payload,
+                                  'priority': priority,
+                                  'seq': seq}
+        self._pending.add(task_id, priority)
+        return True
+
+    def peek(self, count: Optional[int] = None) -> List[str]:
+        """Return pending task IDs in pop order without consuming them."""
+        return list(self._pending.peek_many(count))
+
+    def pop(self) -> Dict[str, Any]:
+        """Move the next pending task to in-flight and return
+        ``{'id': ..., 'payload': ..., 'priority': ...}``.
+        """
+        task_id = self._pending.pop()
+        record = self._records.pop(task_id)
+        self._in_flight[task_id] = record
+        return {'id': task_id,
+                'payload': record['payload'],
+                'priority': record['priority']}
+
+    def ack(self, task_id: str) -> None:
+        """Mark an in-flight task completed; KeyError otherwise."""
+        if task_id not in self._in_flight:
+            raise KeyError(task_id)
+        del self._in_flight[task_id]
+        self._completed.add(task_id)
+
+    def save(self) -> None:
+        """Atomically persist the full queue state to the checkpoint path."""
+        pending = []
+        for task_id, record in self._records.items():
+            pending.append({'id': task_id, 'payload': record['payload'],
+                            'priority': record['priority'],
+                            'seq': record['seq']})
+        in_flight = []
+        for task_id, record in self._in_flight.items():
+            in_flight.append({'id': task_id, 'payload': record['payload'],
+                              'priority': record['priority'],
+                              'seq': record['seq']})
+        state = {'schema_version': SCHEMA_VERSION,
+                 'next_seq': self._next_seq,
+                 'pending': pending,
+                 'in_flight': in_flight,
+                 'completed': sorted(self._completed),
+                 'offsets': dict(self._offsets)}
+        atomic_save_json(self.path, state)
+        return
+
+    def ingest(self, file_obj: IO[bytes], source_id: str) -> int:
+        """Enqueue JSONL records from *file_obj* starting at the saved
+        offset for *source_id*; return the number newly enqueued.
+        """
+        self._check_id(source_id)
+        iterator = JSONLCheckpointIterator(file_obj,
+                                           offset=self._offsets.get(source_id, 0))
+        count = 0
+        for value in iterator:
+            if type(value) is not dict or set(value) != {'id', 'payload',
+                                                         'priority'}:
+                raise ValueError('JSONL record must be a dict with exactly '
+                                 'id, payload and priority')
+            if self.enqueue(value['id'], value['payload'],
+                            value['priority']):
+                count += 1
+            self._offsets[source_id] = iterator.byte_offset
+        self._offsets[source_id] = iterator.byte_offset
+        return count
