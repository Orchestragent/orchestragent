+class JSONLCheckpointIterator:
+    """Iterate over `JSON Lines`_ records in a seekable binary stream,
+    tracking an absolute byte offset suitable for checkpointing and
+    resumption. Unlike :class:`JSONLIterator`, only complete
+    newline-terminated lines are consumed.
+
+    Args:
+        file_obj (file): A seekable binary stream. It is never closed.
+        offset (int): Absolute byte offset at which to begin. Must be an
+            exact nonnegative ``int`` (``bool`` rejected) no greater than
+            the stream length. No line-boundary rounding is performed.
+        ignore_errors (bool): If ``True``, malformed UTF-8 or JSON lines
+            are skipped and the offset advances past them. Otherwise a
+            :exc:`ValueError` is raised and ``byte_offset`` remains at the
+            start of the bad line.
+
+    The public ``byte_offset`` attribute is the absolute byte position
+    after the last consumed complete line, including blank lines and
+    ignored malformed lines. An incomplete final line is left unconsumed.
+
+    .. _JSON Lines: http://jsonlines.org/
+    """
+    def __init__(self, file_obj, offset=0, ignore_errors=False):
+        self._file_obj = file_obj
+        self.ignore_errors = bool(ignore_errors)
+        if type(offset) is not int:
+            raise ValueError("'offset' expected a nonnegative int, not %r" % (offset,))
+        if offset < 0:
+            raise ValueError("'offset' expected a nonnegative int, not %r" % (offset,))
+        file_obj.seek(0, os.SEEK_END)
+        length = file_obj.tell()
+        if offset > length:
+            raise ValueError("'offset' of %r exceeds stream length of %r"
+                             % (offset, length))
+        file_obj.seek(offset, os.SEEK_SET)
+        self.byte_offset = offset
+
+    def __iter__(self):
+        return self
+
+    def next(self):
+        """Return the next complete JSON value, advancing the file and
+        ``byte_offset``. Raises :exc:`StopIteration` at an incomplete
+        trailing line or end of stream.
+        """
+        fo = self._file_obj
+        while True:
+            fo.seek(self.byte_offset, os.SEEK_SET)
+            line = fo.readline()
+            if not line or not line.endswith(b'\n'):
+                fo.seek(self.byte_offset, os.SEEK_SET)
+                raise StopIteration
+            new_offset = self.byte_offset + len(line)
+            content = line[:-1]
+            if content.endswith(b'\r'):
+                content = content[:-1]
+            if not content.strip():
+                self.byte_offset = new_offset
+                continue
+            try:
+                if not isinstance(content, bytes):
+                    raise UnicodeDecodeError('utf-8', b'', 0, 0, 'expected bytes')
+                obj = json.loads(content.decode('utf-8'))
+            except (UnicodeDecodeError, ValueError):
+                if not self.ignore_errors:
+                    raise ValueError('could not decode JSONL record at byte %r'
+                                     % (self.byte_offset,))
+                self.byte_offset = new_offset
+                continue
+            self.byte_offset = new_offset
+            return obj
+
+    __next__ = next
+
+
