+def atomic_save_json(dest_path, value):
+    """Atomically write *value* to *dest_path* as a single UTF-8 JSON
+    document, with sorted keys, compact separators, and a trailing
+    newline. Built on :func:`atomic_save`, so an existing file at
+    *dest_path* is left untouched if *value* cannot be serialized
+    (including NaN and infinite floats) or the write fails.
+
+    >>> import tempfile
+    >>> path = os.path.join(tempfile.mkdtemp(), 'state.json')
+    >>> atomic_save_json(path, {'b': [1, 2], 'a': 'caf\\xe9'})
+    >>> with open(path, 'rb') as f:
+    ...     f.read() == '{"a":"caf\\xe9","b":[1,2]}\\n'.encode('utf-8')
+    True
+    """
+    # serialize up front, so bad values never get as far as a part file
+    data = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False)
+    data = (data + '\n').encode('utf-8')
+    with atomic_save(dest_path) as f:
+        f.write(data)
+    return
+
+
