+class JSONLCheckpointIterator:
+    """The ``JSONLCheckpointIterator`` reads `JSON Lines`_ forward from
+    an absolute byte offset of a seekable binary stream, tracking a
+    resumable checkpoint as it goes. This suits append-only JSONL
+    inputs which are consumed incrementally across restarts.
+
+    Only complete, newline-terminated UTF-8 lines are consumed. Blank
+    lines are skipped, and ``\\r\\n`` line endings are supported. An
+    incomplete final line is left for a later read, after more bytes
+    have been appended.
+
+    Args:
+        file_obj (file): An open, seekable binary file object. It is
+            not closed by the iterator.
+        offset (int): Absolute byte offset to start reading from,
+            usually a previously saved :attr:`byte_offset`. Defaults
+            to ``0``. Must not exceed the length of the stream.
+        ignore_errors (bool): Whether to skip over lines that are not
+            valid UTF-8 JSON. Defaults to ``False``, in which case a
+            :exc:`ValueError` is raised, and the bad line is not
+            consumed.
+
+    >>> bio = io.BytesIO(b'{"a": 1}\\n\\n[2]\\r\\n{"partial"')
+    >>> jci = JSONLCheckpointIterator(bio)
+    >>> list(jci)
+    [{'a': 1}, [2]]
+    >>> jci.byte_offset
+    15
+    >>> _ = bio.seek(0, os.SEEK_END)
+    >>> _ = bio.write(b': 3}\\n')
+    >>> list(JSONLCheckpointIterator(bio, offset=jci.byte_offset))
+    [{'partial': 3}]
+
+    .. _JSON Lines: http://jsonlines.org/
+    """
+    def __init__(self, file_obj, offset=0, ignore_errors=False):
+        if type(offset) is not int or offset < 0:
+            raise ValueError('expected a nonnegative int offset, not %r'
+                             % (offset,))
+        seekable = getattr(file_obj, 'seekable', None)
+        if seekable is not None and not seekable():
+            raise ValueError('expected a seekable file object')
+        if not isinstance(file_obj.read(0), bytes):
+            raise ValueError('expected a file object opened in binary mode')
+        file_obj.seek(0, os.SEEK_END)
+        size = file_obj.tell()
+        if offset > size:
+            raise ValueError('offset %r is past the end of the stream'
+                             ' (%r bytes)' % (offset, size))
+        file_obj.seek(offset, os.SEEK_SET)
+        self._file_obj = file_obj
+        self._byte_offset = offset
+        self.ignore_errors = ignore_errors
+
+    @property
+    def byte_offset(self):
+        """The byte position following the last consumed complete line,
+        suitable as the *offset* for a later iterator."""
+        return self._byte_offset
+
+    def __iter__(self):
+        return self
+
+    def next(self):
+        """Returns the next JSON value, decoded from the next complete
+        nonblank line. Raises :exc:`StopIteration` at the end of the
+        stream, or before an incomplete final line.
+        """
+        fo = self._file_obj
+        while 1:
+            # seek every time, in case the stream was used in between
+            fo.seek(self._byte_offset, os.SEEK_SET)
+            line = fo.readline()
+            if not line.endswith(b'\n'):
+                fo.seek(self._byte_offset, os.SEEK_SET)
+                raise StopIteration()
+            next_offset = self._byte_offset + len(line)
+            text = line.strip(_JSON_WHITESPACE)
+            if not text:
+                self._byte_offset = next_offset
+                continue
+            try:
+                obj = json.loads(text.decode('utf-8'),
+                                 parse_constant=_reject_json_constant)
+            except ValueError as ve:
+                if not self.ignore_errors:
+                    fo.seek(self._byte_offset, os.SEEK_SET)
+                    raise ValueError('invalid JSON line at byte offset %s: %s'
+                                     % (self._byte_offset, ve)) from ve
+                self._byte_offset = next_offset
+                continue
+            self._byte_offset = next_offset
+            return obj
+
+    __next__ = next
+
+
 if __name__ == '__main__':
     def _main():
         import sys
