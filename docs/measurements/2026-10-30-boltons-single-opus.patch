+    def test_r4_rejects_bad_state(self):
+        good = CheckpointQueue(self.path)
+        good.enqueue('a', None)
+        good.save()
+        valid = json.loads(self.read().decode('utf-8'))
+
+        def variant(**kw):
+            state = dict(valid)
+            state.update(kw)
+            return json.dumps(state).encode('utf-8')
+
+        bad_docs = [
+            b'', b'not json', b'[]', b'null', b'{}', b'\xff\n',
+            b'{"schema_version": 1}',
+            variant(schema_version=2), variant(schema_version='1'),
+            variant(schema_version=True), variant(schema_version=1.0),
+            variant(pending={}), variant(completed=[1]),
+            variant(offsets={'s': -1}), variant(offsets={'s': 1.5}),
+            variant(next_seq=-1),
+            variant(pending=[{'id': 'a'}]),
+            variant(pending=[{'id': 'a', 'payload': None, 'priority': True,
+                              'seq': 0}]),
+            variant(completed=['a']),
+            variant(extra=1),
+            self.read().replace(b'"payload":null', b'"payload":NaN'),
+        ]
+        for doc in bad_docs:
+            self.write(doc)
+            with self.assertRaises(ValueError, msg=doc):
+                CheckpointQueue(self.path)
+            self.assertEqual(self.read(), doc)
+            self.assertEqual(os.listdir(self.tmpdir), ['queue.json'])
