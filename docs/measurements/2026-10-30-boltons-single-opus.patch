+"""``taskqueueutils`` provides :class:`CheckpointQueue`, a durable,
+deduplicating work queue fed by append-only `JSON Lines`_ files.
+
+It ties together :class:`~boltons.queueutils.HeapPriorityQueue` for
+ordering, :class:`~boltons.jsonutils.JSONLCheckpointIterator` for
+resumable input, and :func:`~boltons.fileutils.atomic_save_json` for
+crash-safe checkpoints.
+
+>>> import io, os, tempfile
+>>> path = os.path.join(tempfile.mkdtemp(), 'queue.json')
+>>> cq = CheckpointQueue(path)
+>>> cq.ingest(io.BytesIO(b'{"id": "a", "payload": [1], "priority": 1}\\n'), 'src')
+1
+>>> cq.enqueue('b', {'x': 2}, priority=5)
+True
+>>> cq.enqueue('a', None)  # already known
+False
+>>> cq.peek()
+['b', 'a']
+>>> task = cq.pop()
+>>> task == {'id': 'b', 'payload': {'x': 2}, 'priority': 5}
+True
+>>> cq.ack('b')
+>>> cq.save()
+>>> CheckpointQueue(path).enqueue('b', {'x': 2})  # completed IDs persist
+False
+
+.. _JSON Lines: http://jsonlines.org/
+"""
+
+
+import copy
+import json
+import math
+import os
+
+from . import fileutils, jsonutils, queueutils
+
+
+__all__ = ['CheckpointQueue']
+
+
+SCHEMA_VERSION = 1
+
+_STATE_KEYS = frozenset(['schema_version', 'next_seq', 'pending',
+                         'in_flight', 'completed', 'offsets'])
+_TASK_KEYS = frozenset(['id', 'payload', 'priority', 'seq'])
+_RECORD_KEYS = frozenset(['id', 'payload', 'priority'])
+
+
+def _task_priority_key(priority_seq):
+    # larger priorities first, then original insertion order
+    priority, seq = priority_seq
+    return (-priority, seq)
+
+
+def _reject_json_constant(name):
+    raise ValueError('invalid JSON constant: %r' % name)
+
+
+def _check_id(value, name):
+    if not isinstance(value, str) or not value:
+        raise ValueError('expected %s to be a nonempty str, not %r'
+                         % (name, value))
+    try:
+        value.encode('utf-8')
+    except UnicodeEncodeError:
+        raise ValueError('expected %s to be encodable as UTF-8, not %r'
+                         % (name, value))
+    return value
+
+
+def _check_priority(priority):
+    if type(priority) not in (int, float):
+        raise ValueError('expected priority to be an int or float, not %r'
+                         % (priority,))
+    if type(priority) is float and not math.isfinite(priority):
+        raise ValueError('expected a finite priority, not %r' % (priority,))
+    try:
+        json.dumps(priority)
+    except ValueError:  # e.g., ints beyond sys.get_int_max_str_digits()
+        raise ValueError('expected a JSON-serializable priority')
+    return priority
+
+
+def _normalize_payload(payload):
+    "Returns a private copy of *payload*, as it will load from a checkpoint."
+    try:
+        text = json.dumps(payload, ensure_ascii=False, allow_nan=False)
+        text.encode('utf-8')
+    except (TypeError, ValueError, OverflowError, RecursionError) as e:
+        raise ValueError('expected a JSON-serializable payload: %s' % e)
+    return json.loads(text)
+
+
+def _check_count(value, name):
+    if type(value) is not int or value < 0:
+        raise ValueError('expected %s to be a nonnegative int, not %r'
+                         % (name, value))
+    return value
+
+
+class CheckpointQueue:
+    """A priority work queue of JSON payloads, keyed by unique task ID,
+    which can be checkpointed to and restored from a JSON file at
+    *path*. Tasks move from pending, to in-flight via :meth:`pop`, to
+    completed via :meth:`ack`. Task IDs are never accepted twice, even
+    after completion.
+
+    Changes are only persisted by :meth:`save`. When loading a
+    checkpoint, in-flight tasks are treated as pending again, so work
+    is redelivered unless it was acknowledged before the save.
+
+    Args:
+        path (str): Path of the checkpoint file. If it does not exist,
+            the queue starts out empty. Otherwise its state is loaded,
+            raising :exc:`ValueError` if the file is malformed or of an
+            unsupported version.
+    """
+    def __init__(self, path):
+        self.path = os.fspath(path)
+        self._pq = queueutils.HeapPriorityQueue(priority_key=_task_priority_key)
+        self._tasks = {}  # pending and in-flight IDs -> (payload, priority, seq)
+        self._in_flight = {}  # IDs, in pop order
+        self._completed = {}  # IDs, in ack order
+        self._offsets = {}  # source IDs -> input byte offsets
+        self._next_seq = 0
+        self._load()
+
+    def _load(self):
+        try:
+            with open(self.path, 'rb') as f:
+                data = f.read()
+        except FileNotFoundError:
+            return
+        try:
+            state = json.loads(data.decode('utf-8'),
+                               parse_constant=_reject_json_constant)
+        except ValueError as ve:
+            raise ValueError('invalid checkpoint file %r: %s' % (self.path, ve))
+        try:
+            self._load_state(state)
+        except ValueError as ve:
+            raise ValueError('invalid checkpoint file %r: %s' % (self.path, ve))
+
+    def _load_state(self, state):
+        if not isinstance(state, dict):
+            raise ValueError('expected a JSON object')
+        version = state.get('schema_version')
+        if type(version) is not int or version != SCHEMA_VERSION:
+            raise ValueError('unsupported schema_version: %r' % (version,))
+        if set(state) != _STATE_KEYS:
+            raise ValueError('expected keys %s, not %s'
+                             % (sorted(_STATE_KEYS), sorted(state)))
+        next_seq = _check_count(state['next_seq'], 'next_seq')
+
+        tasks, seqs = {}, set()
+        for list_name in ('pending', 'in_flight'):
+            task_list = state[list_name]
+            if not isinstance(task_list, list):
+                raise ValueError('expected %s to be a list' % list_name)
+            for task in task_list:
+                if not isinstance(task, dict) or set(task) != _TASK_KEYS:
+                    raise ValueError('expected %s task with keys %s, not %r'
+                                     % (list_name, sorted(_TASK_KEYS), task))
+                task_id = _check_id(task['id'], 'task id')
+                payload = _normalize_payload(task['payload'])
+                priority = _check_priority(task['priority'])
+                seq = _check_count(task['seq'], 'task seq')
+                if task_id in tasks:
+                    raise ValueError('duplicate task id: %r' % task_id)
+                if seq >= next_seq or seq in seqs:
+                    raise ValueError('invalid task seq: %r' % seq)
+                tasks[task_id] = (payload, priority, seq)
+                seqs.add(seq)
+
+        completed = {}
+        if not isinstance(state['completed'], list):
+            raise ValueError('expected completed to be a list')
+        for task_id in state['completed']:
+            _check_id(task_id, 'completed task id')
+            if task_id in tasks or task_id in completed:
+                raise ValueError('duplicate task id: %r' % task_id)
+            completed[task_id] = None
+
+        offsets = {}
+        if not isinstance(state['offsets'], dict):
+            raise ValueError('expected offsets to be an object')
+        for source_id, offset in state['offsets'].items():
+            _check_id(source_id, 'source id')
+            offsets[source_id] = _check_count(offset, 'offset')
+
+        # in-flight work is recovered as pending, in original order
+        for task_id, (_, priority, seq) in sorted(tasks.items(),
+                                                  key=lambda t: t[1][2]):
+            self._pq.add(task_id, (priority, seq))
+        self._tasks = tasks
+        self._completed = completed
+        self._offsets = offsets
+        self._next_seq = next_seq
+
+    def enqueue(self, task_id, payload, priority=0):
+        """Add a pending task, returning ``True`` if it was accepted, or
+        ``False`` if *task_id* is already pending, in-flight, or
+        completed. Raises :exc:`ValueError` without changing the queue
+        if *task_id* is not a nonempty str, *payload* is not
+        JSON-serializable, or *priority* is not a finite int or
+        float. Larger priorities are popped first, with ties popped in
+        insertion order.
+        """
+        _check_id(task_id, 'task_id')
+        payload = _normalize_payload(payload)
+        _check_priority(priority)
+        if task_id in self._tasks or task_id in self._completed:
+            return False
+        seq = self._next_seq
+        self._next_seq += 1
+        self._tasks[task_id] = (payload, priority, seq)
+        self._pq.add(task_id, (priority, seq))
+        return True
+
+    def peek(self, count=None):
+        """Return a list of up to *count* pending task IDs, in the order
+        :meth:`pop` would return them. *count* defaults to ``None``,
+        meaning all pending tasks.
+        """
+        return self._pq.peek_many(count)
+
+    def pop(self):
+        """Move the next pending task to in-flight and return it as a
+        :class:`dict` with ``id``, ``payload``, and ``priority``
+        keys. Raises :exc:`IndexError` if no tasks are pending.
+        """
+        try:
+            task_id = self._pq.pop()
+        except IndexError:
+            raise IndexError('pop from empty queue')
+        self._in_flight[task_id] = None
+        payload, priority, _ = self._tasks[task_id]
+        return {'id': task_id,
+                'payload': copy.deepcopy(payload),
+                'priority': priority}
+
+    def ack(self, task_id):
+        """Mark the in-flight task *task_id* as completed. Raises
+        :exc:`KeyError` if *task_id* is not in-flight.
+        """
+        if not isinstance(task_id, str) or task_id not in self._in_flight:
+            raise KeyError(task_id)
+        del self._in_flight[task_id]
+        del self._tasks[task_id]
+        self._completed[task_id] = None
+
+    def ingest(self, file_obj, source_id):
+        """Enqueue the tasks in JSON Lines *file_obj*, a seekable binary
+        file object, starting after the records previously ingested
+        from *source_id*. Each record must be an object with exactly
+        ``id``, ``payload``, and ``priority`` keys, valid for
+        :meth:`enqueue`.
+
+        Returns the number of tasks newly enqueued. Records with known
+        IDs are skipped, but count as ingested. On an invalid record,
+        :exc:`ValueError` is raised, keeping the records before it, so
+        that ingestion resumes from the invalid record next time. An
+        incomplete final line is left for a later call.
+        """
+        _check_id(source_id, 'source_id')
+        records = jsonutils.JSONLCheckpointIterator(
+            file_obj, offset=self._offsets.get(source_id, 0))
+        count = 0
+        while 1:
+            record_start = records.byte_offset
+            try:
+                record = next(records)
+            except StopIteration:
+                break
+            except ValueError:
+                self._offsets[source_id] = records.byte_offset
+                raise
+            try:
+                count += self._enqueue_record(record)
+            except ValueError as ve:
+                self._offsets[source_id] = record_start
+                raise ValueError('invalid record in source %r after byte'
+                                 ' offset %s: %s' % (source_id, record_start, ve))
+            self._offsets[source_id] = records.byte_offset
+        self._offsets[source_id] = records.byte_offset
+        return count
+
+    def _enqueue_record(self, record):
+        if not isinstance(record, dict) or set(record) != _RECORD_KEYS:
+            raise ValueError('expected an object with keys %s, not %r'
+                             % (sorted(_RECORD_KEYS), record))
+        return self.enqueue(record['id'], record['payload'], record['priority'])
+
+    def save(self):
+        "Atomically write the queue's current state to its checkpoint file."
+        fileutils.atomic_save_json(self.path, self._get_state())
+
+    def _get_task_state(self, task_id):
+        payload, priority, seq = self._tasks[task_id]
+        return {'id': task_id, 'payload': payload,
+                'priority': priority, 'seq': seq}
+
+    def _get_state(self):
+        return {'schema_version': SCHEMA_VERSION,
+                'next_seq': self._next_seq,
+                'pending': [self._get_task_state(task_id)
+                            for task_id in self._pq.peek_many()],
+                'in_flight': [self._get_task_state(task_id)
+                              for task_id in self._in_flight],
+                'completed': list(self._completed),
+                'offsets': dict(self._offsets)}
+
+    def __repr__(self):
+        cn = self.__class__.__name__
+        return ('%s(%r, pending=%r, in_flight=%r, completed=%r)'
+                % (cn, self.path, len(self._pq), len(self._in_flight),
+                   len(self._completed)))
