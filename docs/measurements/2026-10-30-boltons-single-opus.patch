@@ -0,0 +1,221 @@
+import doctest
+import random
+import unittest
+
+from boltons import queueutils
+from boltons.listutils import BList
+from boltons.queueutils import (BasePriorityQueue, HeapPriorityQueue,
+                                SortedPriorityQueue)
+
+
+QUEUE_TYPES = (HeapPriorityQueue, SortedPriorityQueue)
+
+
+def drain(pq):
+    ret = []
+    while len(pq):
+        ret.append(pq.pop())
+    return ret
+
+
+class TestR1PeekMany(unittest.TestCase):
+    def test_r1_matches_pop_order_with_fifo_ties(self):
+        for qt in QUEUE_TYPES:
+            pq = qt()
+            for i, prio in enumerate([1, 3, 1, 2, 3, 0, 1, 2.5, -1, 3]):
+                pq.add('t%s' % i, prio)
+            peeked = pq.peek_many()
+            self.assertEqual(len(pq), 10)
+            self.assertEqual(peeked, ['t1', 't4', 't9', 't7', 't3',
+                                      't0', 't2', 't6', 't5', 't8'])
+            self.assertEqual(peeked, drain(pq), qt)
+
+    def test_r1_randomized_against_pop(self):
+        rng = random.Random(1234)
+        for qt in QUEUE_TYPES:
+            for _ in range(30):
+                pq = qt()
+                for _ in range(rng.randint(0, 60)):
+                    task = rng.randint(0, 25)
+                    action = rng.random()
+                    if action < 0.6:
+                        pq.add(task, rng.choice([0, 1, 2, 2.5, -3, None]))
+                    elif action < 0.8 and task in pq._entry_map:
+                        pq.remove(task)
+                    elif action < 0.9 and len(pq):
+                        pq.pop()
+                    elif rng.random() < 0.5:
+                        pq.compact()
+                n = rng.randint(0, 10)
+                self.assertEqual(pq.peek_many(n), pq.peek_many()[:n])
+                expected = pq.peek_many()
+                self.assertEqual(expected, drain(pq))
+
+    def test_r1_count_limits(self):
+        for qt in QUEUE_TYPES:
+            pq = qt()
+            for task in 'abcde':
+                pq.add(task)
+            self.assertEqual(pq.peek_many(0), [])
+            self.assertEqual(pq.peek_many(2), ['a', 'b'])
+            self.assertEqual(pq.peek_many(5), list('abcde'))
+            self.assertEqual(pq.peek_many(50), list('abcde'))
+            self.assertEqual(pq.peek_many(None), list('abcde'))
+            self.assertEqual(qt().peek_many(), [])
+            self.assertEqual(qt().peek_many(3), [])
+
+    def test_r1_invalid_counts(self):
+        class MyInt(int):
+            pass
+
+        for qt in QUEUE_TYPES:
+            pq = qt()
+            pq.add('a')
+            for bad in (True, False, -1, 1.0, '1', MyInt(1), [1]):
+                with self.assertRaises(ValueError):
+                    pq.peek_many(bad)
+            self.assertEqual(pq.peek_many(), ['a'])
+
+    def test_r1_excludes_removed_and_replaced(self):
+        for qt in QUEUE_TYPES:
+            pq = qt()
+            pq.add('a', 1)
+            pq.add('b', 2)
+            pq.add('c', 3)
+            pq.remove('c')
+            pq.add('a', 5)  # replaced priority leaves a tombstone
+            self.assertEqual(pq.peek_many(), ['a', 'b'])
+            self.assertEqual(pq.peek_many(1), ['a'])
+            self.assertEqual(drain(pq), ['a', 'b'])
+
+    def test_r1_no_mutation_or_priority_key_calls(self):
+        calls = []
+
+        def key(p):
+            calls.append(p)
+            return p
+
+        for qt in QUEUE_TYPES:
+            pq = qt(priority_key=key)
+            pq.add('x', 3)
+            pq.add('y', 1)
+            pq.add('z', 2)
+            pq.remove('z')
+            del calls[:]
+            backend = pq._pq
+            before = list(backend)
+            self.assertEqual(pq.peek_many(), ['y', 'x'])
+            self.assertEqual(pq.peek_many(1), ['y'])
+            self.assertEqual(calls, [])
+            self.assertIs(pq._pq, backend)
+            self.assertEqual(list(pq._pq), before)
+            self.assertEqual(len(pq), 2)
+            self.assertEqual(pq.peek(), 'y')
+            self.assertEqual(drain(pq), ['y', 'x'])
+
+    def test_r1_custom_priority_key_tuples(self):
+        for qt in QUEUE_TYPES:
+            pq = qt(priority_key=lambda p: (p[0], -p[1]))
+            pq.add('a', (1, 1))
+            pq.add('b', (0, 5))
+            pq.add('c', (1, 2))
+            pq.add('d', (0, 5))
+            self.assertEqual(pq.peek_many(), ['b', 'd', 'c', 'a'])
+            self.assertEqual(drain(pq), ['b', 'd', 'c', 'a'])
+
+    def test_r1_unorderable_tasks_with_ties(self):
+        for qt in QUEUE_TYPES:
+            pq = qt()
+            tasks = [frozenset([1]), 3, 'x', (1,)]
+            for t in tasks:
+                pq.add(t, 1)
+            self.assertEqual(pq.peek_many(), tasks)
+
+
+class TestR1Compact(unittest.TestCase):
+    def test_r1_compact_removes_tombstones(self):
+        for qt in QUEUE_TYPES:
+            pq = qt()
+            for i in range(10):
+                pq.add(i, i % 3)
+            pq.remove(4)
+            pq.remove(7)
+            pq.add(0, 10)
+            pq.add(0, 11)
+            backend = pq._pq
+            expected = pq.peek_many()
+            self.assertEqual(len(backend), 12)
+            self.assertEqual(pq.compact(), 4)
+            self.assertIs(pq._pq, backend)
+            self.assertEqual(len(pq._pq), 8)
+            self.assertEqual(pq.compact(), 0)
+            self.assertEqual(pq.compact(), 0)
+            self.assertEqual(len(pq), 8)
+            self.assertEqual(pq.peek_many(), expected)
+            self.assertEqual(drain(pq), expected)
+
+    def test_r1_compact_preserves_backend_type(self):
+        pq = SortedPriorityQueue()
+        pq.add('a')
+        pq.remove('a')
+        pq.add('b')
+        self.assertEqual(pq.compact(), 1)
+        self.assertIsInstance(pq._pq, BList)
+        hq = HeapPriorityQueue()
+        hq.add('a')
+        hq.remove('a')
+        self.assertEqual(hq.compact(), 1)
+        self.assertIs(type(hq._pq), list)
+        self.assertEqual(hq.peek_many(), [])
+        self.assertRaises(IndexError, hq.pop)
+
+    def test_r1_compact_then_add_keeps_fifo(self):
+        for qt in QUEUE_TYPES:
+            pq = qt()
+            pq.add('a')
+            pq.add('gone')
+            pq.add('b')
+            pq.remove('gone')
+            self.assertEqual(pq.compact(), 1)
+            pq.add('c')
+            pq.add('d', 1)
+            self.assertEqual(pq.peek_many(), ['d', 'a', 'b', 'c'])
+            self.assertEqual(drain(pq), ['d', 'a', 'b', 'c'])
+
+    def test_r1_empty_and_base(self):
+        for qt in QUEUE_TYPES:
+            self.assertEqual(qt().compact(), 0)
+        self.assertEqual(BasePriorityQueue().compact(), 0)
+
+
+class TestR1Docs(unittest.TestCase):
+    def test_r1_peek_many_doctest(self):
+        finder = doctest.DocTestFinder(recurse=False)
+        runner = doctest.DocTestRunner()
+        for test in finder.find(BasePriorityQueue.peek_many,
+                                globs=vars(queueutils)):
+            runner.run(test)
+        failed, attempted = runner.summarize(verbose=False)
+        self.assertEqual(failed, 0)
+        self.assertGreater(attempted, 0)
+
+
+class TestR1ExistingSemantics(unittest.TestCase):
+    def test_r1_add_remove_peek_pop(self):
+        for qt in QUEUE_TYPES:
+            pq = qt()
+            pq.add('low', 0)
+            pq.add('high', 2)
+            pq.add('mid', 1)
+            self.assertEqual(pq.peek(), 'high')
+            self.assertEqual(pq.pop(), 'high')
+            pq.remove('mid')
+            self.assertRaises(KeyError, pq.remove, 'mid')
+            self.assertEqual(pq.pop(), 'low')
+            self.assertEqual(pq.pop(None), None)
+            self.assertEqual(pq.peek('dflt'), 'dflt')
+            self.assertRaises(IndexError, pq.peek)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/test_r2_jsonutils.py b/test_r2_jsonutils.py
new file mode 100644
index 0000000..5118a19
--- /dev/null
+++ b/test_r2_jsonutils.py
@@ -0,0 +1,138 @@
+import doctest
+import io
+import os
+import shutil
+import tempfile
+import unittest
+
+from boltons import jsonutils
+from boltons.jsonutils import JSONLCheckpointIterator
+
+
+class TestR2CheckpointIterator(unittest.TestCase):
+    def test_r2_reads_records_and_tracks_offset(self):
+        data = b'{"a": 1}\n\n[1, 2]\r\n  \r\n"caf\xc3\xa9"\n'
+        bio = io.BytesIO(data)
+        it = JSONLCheckpointIterator(bio)
+        self.assertEqual(it.byte_offset, 0)
+        self.assertEqual(next(it), {'a': 1})
+        self.assertEqual(it.byte_offset, 9)
+        self.assertEqual(next(it), [1, 2])
+        self.assertEqual(it.byte_offset, 18)
+        self.assertEqual(next(it), u'caf\xe9')
+        self.assertEqual(it.byte_offset, len(data))
+        self.assertRaises(StopIteration, next, it)
+        self.assertEqual(it.byte_offset, len(data))
+        self.assertFalse(bio.closed)
+
+    def test_r2_trailing_blank_lines_advance(self):
+        bio = io.BytesIO(b'1\n\n\r\n')
+        it = JSONLCheckpointIterator(bio)
+        self.assertEqual(list(it), [1])
+        self.assertEqual(it.byte_offset, 5)
+
+    def test_r2_incomplete_tail_left_unconsumed(self):
+        bio = io.BytesIO(b'1\n{"b": ')
+        it = JSONLCheckpointIterator(bio)
+        self.assertEqual(list(it), [1])
+        self.assertEqual(it.byte_offset, 2)
+        bio.seek(0, os.SEEK_END)
+        bio.write(b'2}\n3')
+        it2 = JSONLCheckpointIterator(bio, offset=it.byte_offset)
+        self.assertEqual(list(it2), [{'b': 2}])
+        self.assertEqual(it2.byte_offset, 11)
+
+    def test_r2_incomplete_crlf_and_blank_tail(self):
+        bio = io.BytesIO(b'1\r\n2\r')
+        it = JSONLCheckpointIterator(bio)
+        self.assertEqual(list(it), [1])
+        self.assertEqual(it.byte_offset, 3)
+        bio = io.BytesIO(b'1\n   ')
+        it = JSONLCheckpointIterator(bio)
+        self.assertEqual(list(it), [1])
+        self.assertEqual(it.byte_offset, 2)
+
+    def test_r2_start_offset(self):
+        data = b'1\n2\n3\n'
+        it = JSONLCheckpointIterator(io.BytesIO(data), offset=2)
+        self.assertEqual(list(it), [2, 3])
+        it = JSONLCheckpointIterator(io.BytesIO(data), offset=len(data))
+        self.assertEqual(list(it), [])
+        self.assertEqual(it.byte_offset, len(data))
+
+    def test_r2_offset_is_not_rounded(self):
+        # a mid-line offset is honored exactly, not realigned
+        it = JSONLCheckpointIterator(io.BytesIO(b'123\n4\n'), offset=1)
+        self.assertEqual(list(it), [23, 4])
+
+    def test_r2_seeks_to_offset_at_construction(self):
+        bio = io.BytesIO(b'1\n2\n')
+        JSONLCheckpointIterator(bio, offset=2)
+        self.assertEqual(bio.tell(), 2)
+
+    def test_r2_invalid_offsets(self):
+        class MyInt(int):
+            pass
+
+        bio = io.BytesIO(b'1\n')
+        for bad in (-1, 3, 1.0, True, False, None, '0', MyInt(0)):
+            with self.assertRaises(ValueError):
+                JSONLCheckpointIterator(bio, offset=bad)
+
+    def test_r2_malformed_raises_without_advancing(self):
+        for bad in (b'{"a": \n', b'\xff\xfe\n', b'NaN\n', b'[1,]\n'):
+            bio = io.BytesIO(b'1\n\n' + bad + b'2\n')
+            it = JSONLCheckpointIterator(bio)
+            self.assertEqual(next(it), 1)
+            with self.assertRaises(ValueError):
+                next(it)
+            self.assertEqual(it.byte_offset, 3)
+            with self.assertRaises(ValueError):
+                next(it)  # still stuck on the bad line
+            self.assertEqual(it.byte_offset, 3)
+
+    def test_r2_ignore_errors_skips_and_advances(self):
+        data = b'1\n{bad\n\xc3\x28\n2\n'
+        it = JSONLCheckpointIterator(io.BytesIO(data), ignore_errors=True)
+        self.assertEqual(list(it), [1, 2])
+        self.assertEqual(it.byte_offset, len(data))
+        it = JSONLCheckpointIterator(io.BytesIO(b'1\n{bad\n'),
+                                     ignore_errors=True)
+        self.assertEqual(list(it), [1])
+        self.assertEqual(it.byte_offset, 7)
+
+    def test_r2_real_file_append(self):
+        tmpdir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmpdir)
+        path = os.path.join(tmpdir, 'in.jsonl')
+        with open(path, 'wb') as f:
+            f.write(b'{"n": 1}\n{"n": ')
+        with open(path, 'rb') as f:
+            it = JSONLCheckpointIterator(f)
+            self.assertEqual(list(it), [{'n': 1}])
+            offset = it.byte_offset
+            self.assertFalse(f.closed)
+        with open(path, 'ab') as f:
+            f.write(b'2}\n')
+        with open(path, 'rb') as f:
+            it = JSONLCheckpointIterator(f, offset=offset)
+            self.assertEqual(list(it), [{'n': 2}])
+            self.assertEqual(it.byte_offset, os.path.getsize(path))
+
+    def test_r2_doctest(self):
+        finder = doctest.DocTestFinder(recurse=False)
+        runner = doctest.DocTestRunner()
+        for test in finder.find(JSONLCheckpointIterator,
+                                globs=vars(jsonutils)):
+            runner.run(test)
+        failed, attempted = runner.summarize(verbose=False)
+        self.assertEqual(failed, 0)
+        self.assertGreater(attempted, 0)
+
+    def test_r2_rejects_text_streams(self):
+        with self.assertRaises(ValueError):
+            JSONLCheckpointIterator(io.StringIO(u'1\n'))
+
+
+if __name__ == '__main__':
+    unittest.main()
