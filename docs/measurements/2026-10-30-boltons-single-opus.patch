+        # pop() exactly and the stored priorities are reused as-is
+        backend = self._backend_type()
+        backend.extend(self._pq)
+        while backend and len(ret) < count:
+            _, _, task = self._pop_entry(backend)
+            if task is not _REMOVED:
+                ret.append(task)
+        return ret
+
+    def compact(self):
+        """Discard the entries left behind by :meth:`remove` and
+        priority changes in :meth:`add`, keeping the existing backend
+        and the order of the remaining tasks. Returns the number of
+        removed entries discarded.
+        """
+        backend = self._pq
+        if len(backend) == len(self._entry_map):
+            return 0
+        active, removed = [], 0
+        while backend:
+            entry = self._pop_entry(backend)
+            if entry[-1] is _REMOVED:
+                removed += 1
+            else:
+                active.append(entry)
+        for entry in active:
+            self._push_entry(backend, entry)
+        return removed
+
