+        cq.pop()
+        cq.pop()
+        cq.save()
+        self.assertEqual(CheckpointQueue(self.path).peek(), list('abcd'))
+        cq.pop()
+        cq.ack('c')
+        cq.save()
+        cq3 = CheckpointQueue(self.path)
+        self.assertEqual(cq3.peek(), ['a', 'b', 'd'])
+        cq3.enqueue('e', None)
