+class TestR4Persistence(CheckpointQueueTestCase):
+    def test_r4_save_and_restore(self):
+        cq = CheckpointQueue(self.path)
+        for task_id, prio in [('a', 1), ('b', 1), ('c', 2), ('d', 1),
+                              ('e', 1), ('f', 0)]:
+            cq.enqueue(task_id, {'id': task_id}, prio)
+        self.assertEqual(cq.pop()['id'], 'c')
+        cq.ack('c')
+        self.assertEqual(cq.pop()['id'], 'a')  # in-flight, recovered
+        self.assertEqual(cq.pop()['id'], 'b')
+        cq.ack('b')
+        self.assertIsNone(cq.save())
+        state = json.loads(self.read().decode('utf-8'))
+        self.assertEqual(state['schema_version'], 1)
+
+        cq2 = CheckpointQueue(pathlib.Path(self.path))
+        self.assertEqual(cq2.peek(), ['a', 'd', 'e', 'f'])
+        self.assertFalse(cq2.enqueue('c', None))
+        self.assertFalse(cq2.enqueue('b', None))
+        self.assertFalse(cq2.enqueue('a', None))
+        cq2.enqueue('g', None, 1)
+        self.assertEqual(cq2.peek(), ['a', 'd', 'e', 'g', 'f'])
+        task = cq2.pop()
+        self.assertEqual(task, {'id': 'a', 'payload': {'id': 'a'},
+                                'priority': 1})
+
+    def test_r4_recovered_inflight_keeps_original_order(self):
+        cq = CheckpointQueue(self.path)
