+class TestR4Ingest(CheckpointQueueTestCase):
+    def test_r4_ingest_basic_and_resume(self):
+        cq = CheckpointQueue(self.path)
+        bio = io.BytesIO(jsonl(rec('a', 1), rec('b', 2, 5)))
+        self.assertEqual(cq.ingest(bio, 'src'), 2)
+        self.assertEqual(cq.peek(), ['b', 'a'])
+        self.assertFalse(bio.closed)
+        self.assertEqual(cq.ingest(bio, 'src'), 0)
+        bio.seek(0, os.SEEK_END)
+        bio.write(jsonl(rec('c', 3)))
+        self.assertEqual(cq.ingest(bio, 'src'), 1)
+        self.assertEqual(cq.peek(), ['b', 'a', 'c'])
+
+    def test_r4_ingest_duplicates_advance(self):
+        cq = CheckpointQueue(self.path)
+        cq.enqueue('a', None)
+        bio = io.BytesIO(jsonl(rec('a'), rec('b'), rec('b')))
+        self.assertEqual(cq.ingest(bio, 'src'), 1)
+        bio.seek(0, os.SEEK_END)
+        bio.write(jsonl(rec('c')))
+        self.assertEqual(cq.ingest(bio, 'src'), 1)
+        self.assertEqual(cq.peek(), ['a', 'b', 'c'])
+
+    def test_r4_ingest_bad_record_is_retried(self):
+        bad_records = [b'{"id": "x", "payload": 1}\n',
+                       b'{"id": "x", "payload": 1, "priority": 0, "z": 1}\n',
+                       b'{"id": "", "payload": 1, "priority": 0}\n',
+                       b'{"id": "x", "payload": 1, "priority": true}\n',
+                       b'{"id": "x", "payload": 1, "priority": "1"}\n',
+                       b'{"id": "x", "payload": NaN, "priority": 0}\n',
+                       b'{"id": "x", "payload": 1, "priority": 1e999}\n',
+                       b'{"id": 1, "payload": 1, "priority": 0}\n',
+                       b'[1, 2]\n', b'"x"\n', b'{"id": \n', b'\xff\n']
+        for bad in bad_records:
+            if os.path.exists(self.path):
+                os.unlink(self.path)
+            cq = CheckpointQueue(self.path)
+            bio = io.BytesIO(jsonl(rec('a')) + b'\n' + bad + jsonl(rec('b')))
+            with self.assertRaises(ValueError, msg=bad):
+                cq.ingest(bio, 'src')
+            self.assertEqual(cq.peek(), ['a'])
+            with self.assertRaises(ValueError, msg=bad):
+                cq.ingest(bio, 'src')  # retried, still bad
+            self.assertEqual(cq.peek(), ['a'])
+            cq.save()
+            cq2 = CheckpointQueue(self.path)
+            with self.assertRaises(ValueError, msg=bad):
+                cq2.ingest(bio, 'src')
+            self.assertEqual(cq2.peek(), ['a'])
+
+    def test_r4_ingest_bad_record_offset(self):
