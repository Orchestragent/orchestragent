@@ -0,0 +1,125 @@
+import doctest
+import json
+import os
+import pathlib
+import shutil
+import tempfile
+import unittest
+from unittest import mock
+
+from boltons import fileutils
+from boltons.fileutils import atomic_save_json
+
+
+class TestR3AtomicSaveJSON(unittest.TestCase):
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmpdir)
+        self.path = os.path.join(self.tmpdir, 'state.json')
+
+    def read(self):
+        with open(self.path, 'rb') as f:
+            return f.read()
+
+    def assert_no_part_file(self):
+        self.assertEqual(os.listdir(self.tmpdir), ['state.json'])
+
+    def test_r3_deterministic_format(self):
+        value = {'z': 1, 'a': {'y': [1, 2.5, None, True], 'b': u'caf\xe9 ☃'}}
+        self.assertIsNone(atomic_save_json(self.path, value))
+        expected = (u'{"a":{"b":"caf\xe9 ☃","y":[1,2.5,null,true]},"z":1}\n'
+                    .encode('utf-8'))
+        self.assertEqual(self.read(), expected)
+        self.assertEqual(json.loads(self.read().decode('utf-8')), value)
+        self.assert_no_part_file()
+
+    def test_r3_scalar_documents(self):
+        atomic_save_json(self.path, [])
+        self.assertEqual(self.read(), b'[]\n')
+        atomic_save_json(self.path, u'x')
+        self.assertEqual(self.read(), b'"x"\n')
+
+    def test_r3_pathlib_destination(self):
+        atomic_save_json(pathlib.Path(self.path), {'k': 'v'})
+        self.assertEqual(self.read(), b'{"k":"v"}\n')
+        self.assert_no_part_file()
+
+    def test_r3_overwrites_existing(self):
+        atomic_save_json(self.path, {'v': 1})
+        atomic_save_json(self.path, {'v': 2})
+        self.assertEqual(self.read(), b'{"v":2}\n')
+        self.assert_no_part_file()
+
+    def test_r3_invalid_data_leaves_destination(self):
+        atomic_save_json(self.path, {'v': 1})
+        original = self.read()
+        circular = []
+        circular.append(circular)
+        for bad in ({'v': float('nan')}, [float('inf')], {'v': object()},
+                    {'v': set()}, {1: 'a', 'b': 2}, circular,
+                    u'\ud800'):
+            with self.assertRaises((TypeError, ValueError)):
+                atomic_save_json(self.path, bad)
+            self.assertEqual(self.read(), original)
+            self.assert_no_part_file()
+
+    def test_r3_invalid_data_no_destination(self):
+        with self.assertRaises(ValueError):
+            atomic_save_json(self.path, float('nan'))
+        self.assertEqual(os.listdir(self.tmpdir), [])
+
+    def test_r3_write_failure_leaves_destination(self):
+        atomic_save_json(self.path, {'v': 1})
+        original = self.read()
+        real_atomic_save = fileutils.atomic_save
+
+        class FailingFile:
+            def __init__(self, f):
+                self.f = f
+
+            def write(self, data):
+                self.f.write(data[:3])
+                raise OSError('disk full')
+
+        class FailingSaver:
+            def __init__(self, saver):
+                self.saver = saver
+
+            def __enter__(self):
+                return FailingFile(self.saver.__enter__())
+
+            def __exit__(self, *exc_info):
+                return self.saver.__exit__(*exc_info)
+
+        def failing_atomic_save(*a, **kw):
+            return FailingSaver(real_atomic_save(*a, **kw))
+
+        with mock.patch.object(fileutils, 'atomic_save', failing_atomic_save):
+            with self.assertRaises(OSError):
+                atomic_save_json(self.path, {'v': 2})
+        self.assertEqual(self.read(), original)
+        self.assert_no_part_file()
+
+    def test_r3_doctest(self):
+        finder = doctest.DocTestFinder(recurse=False)
+        runner = doctest.DocTestRunner()
+        with mock.patch('tempfile.mkdtemp', return_value=self.tmpdir):
+            for test in finder.find(atomic_save_json, globs=vars(fileutils)):
+                runner.run(test)
+        failed, attempted = runner.summarize(verbose=False)
+        self.assertEqual(failed, 0)
+        self.assertGreater(attempted, 0)
+
+    def test_r3_rename_failure_leaves_destination(self):
+        atomic_save_json(self.path, {'v': 1})
+        original = self.read()
+        with mock.patch.object(fileutils, 'atomic_rename',
+                               side_effect=OSError('rename failed')):
+            with self.assertRaises(OSError):
+                atomic_save_json(self.path, {'v': 2})
+        self.assertEqual(self.read(), original)
+        self.assert_no_part_file()
+
+
+if __name__ == '__main__':
+    unittest.main()
