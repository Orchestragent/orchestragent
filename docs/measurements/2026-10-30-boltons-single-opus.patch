+++ b/test_r4_taskqueueutils.py
@@ -0,0 +1,426 @@
+import doctest
+import io
+import json
+import os
+import pathlib
+import shutil
+import tempfile
+import unittest
+from unittest import mock
+
+from boltons import fileutils, taskqueueutils
+from boltons.taskqueueutils import CheckpointQueue
+
+
+def jsonl(*records):
+    return b''.join(json.dumps(r).encode('utf-8') + b'\n' for r in records)
+
+
+def rec(task_id, payload=None, priority=0):
+    return {'id': task_id, 'payload': payload, 'priority': priority}
+
+
+class CheckpointQueueTestCase(unittest.TestCase):
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmpdir)
+        self.path = os.path.join(self.tmpdir, 'queue.json')
+
+    def read(self):
+        with open(self.path, 'rb') as f:
+            return f.read()
+
+    def write(self, data):
+        with open(self.path, 'wb') as f:
+            f.write(data)
+
+
+class TestR4Basics(CheckpointQueueTestCase):
+    def test_r4_new_queue_is_empty_and_not_saved(self):
+        cq = CheckpointQueue(self.path)
+        self.assertEqual(cq.peek(), [])
+        self.assertRaises(IndexError, cq.pop)
+        self.assertTrue(cq.enqueue('a', 1))
+        cq.pop()
+        cq.ack('a')
+        self.assertFalse(os.path.exists(self.path))
+        self.assertEqual(os.listdir(self.tmpdir), [])
+
+    def test_r4_priority_order_and_fifo_ties(self):
+        cq = CheckpointQueue(self.path)
+        for task_id, prio in [('a', 0), ('b', 5), ('c', 0), ('d', 5.0),
+                              ('e', -1), ('f', 2.5), ('g', 10 ** 30)]:
+            self.assertTrue(cq.enqueue(task_id, {'n': task_id}, prio))
+        expected = ['g', 'b', 'd', 'f', 'a', 'c', 'e']
+        self.assertEqual(cq.peek(), expected)
+        self.assertEqual(cq.peek(2), ['g', 'b'])
+        self.assertEqual(cq.peek(0), [])
+        self.assertEqual(cq.peek(), expected)
+        popped = [cq.pop()['id'] for _ in expected]
+        self.assertEqual(popped, expected)
+
+    def test_r4_default_priority(self):
+        cq = CheckpointQueue(self.path)
+        cq.enqueue('a', None)
+        cq.enqueue('b', None, 1)
+        cq.enqueue('c', None, -1)
+        self.assertEqual(cq.peek(), ['b', 'a', 'c'])
+
+    def test_r4_peek_invalid_count(self):
+        cq = CheckpointQueue(self.path)
+        cq.enqueue('a', None)
+        for bad in (True, -1, 1.5, '1'):
+            with self.assertRaises(ValueError):
+                cq.peek(bad)
+
+    def test_r4_pop_returns_exact_dict(self):
