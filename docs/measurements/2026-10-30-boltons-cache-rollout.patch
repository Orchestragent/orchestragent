+++ b/test_orch_t_001.py
@@ -0,0 +1,123 @@
+import unittest
+from boltons.queueutils import HeapPriorityQueue, SortedPriorityQueue, BasePriorityQueue
+
+QUEUES = [HeapPriorityQueue, SortedPriorityQueue]
+
+
+class _Task(object):
+    def __init__(self, name):
+        self.name = name
+
+    def __repr__(self):
+        return self.name
+
+
+class PeekManyCompactTest(unittest.TestCase):
+    def setUp(self):
+        self.qs = {cls: cls() for cls in QUEUES}
+        self.calls = {cls: [0] for cls in QUEUES}
+
+    def _peek(self, q):
+        return [t.name for t in q.peek_many()]
+
+    def test_r1_peek_many_order_and_ties(self):
+        for cls, q in self.qs.items():
+            with self.subTest(queue=cls.__name__):
+                for name, prio in [('a', 1), ('b', 3), ('c', 3), ('d', 2), ('e', 3)]:
+                    q.add(prio, _Task(name))
+                self.assertEqual(self._peek(q), ['b', 'c', 'e', 'd', 'a'])
+                self.assertEqual([t.name for t in q.peek_many(2)], ['b', 'c'])
+                self.assertEqual(q.peek_many(0), [])
+                self.assertEqual(self._peek(q), ['b', 'c', 'e', 'd', 'a'])
+
+    def test_r1_peek_many_matches_pop_and_does_not_mutate(self):
+        for cls, q in self.qs.items():
+            with self.subTest(queue=cls.__name__):
+                for prio, name in [(5, 'x'), (1, 'y'), (5, 'z'), (3, 'w')]:
+                    q.add(prio, _Task(name))
+                expected = self._peek(q)
+                self.assertEqual(expected, ['x', 'z', 'w', 'y'])
+                self.assertEqual(self._peek(q), expected)
+                popped = []
+                while True:
+                    try:
+                        popped.append(q.pop().name)
+                    except IndexError:
+                        break
+                self.assertEqual(popped, expected)
+
+    def test_r1_peek_many_excludes_removed_and_replaced(self):
+        for cls, q in self.qs.items():
+            with self.subTest(queue=cls.__name__):
+                for prio, name in [(2, 'a'), (2, 'b'), (1, 'c')]:
+                    q.add(prio, _Task(name))
+                self.assertTrue(q.remove('a'))
+                self.assertTrue(q.add(9, _Task('b')))
+                self.assertEqual(self._peek(q), ['b', 'c'])
+                self.assertEqual([t.name for t in q.peek_many(1)], ['b'])
+                self.assertEqual([t.name for t in q.peek_many(5)], ['b', 'c'])
+
+    def test_r1_peek_many_count_validation(self):
+        for cls, q in self.qs.items():
+            with self.subTest(queue=cls.__name__):
+                q.add(1, _Task('a'))
+                for bad in [True, False, -1, 1.0, '1', object()]:
+                    with self.subTest(bad=bad):
+                        with self.assertRaises(ValueError):
+                            q.peek_many(bad)
+                self.assertEqual(self._peek(q), ['a'])
+
+    def test_r1_peek_many_custom_priority_key(self):
+        for cls in QUEUES:
+            with self.subTest(queue=cls.__name__):
+                calls = []
+
+                def key(task):
+                    calls.append(task.name)
+                    return task.name
+
+                q = cls(priority_key=key)
+                for name in ['b', 'c', 'a']:
+                    q.add(0, _Task(name))
+                calls[:] = []
+                self.assertEqual([t.name for t in q.peek_many()], ['a', 'b', 'c'])
+                self.assertEqual(calls, [])
+                self.assertEqual([t.name for t in q.peek_many(1)], ['a'])
+                self.assertEqual(calls, [])
+                self.assertEqual(self._peek(q), ['a', 'b', 'c'])
+
+    def test_r1_compact(self):
+        for cls, q in self.qs.items():
+            with self.subTest(queue=cls.__name__):
+                for prio, name in [(1, 'a'), (2, 'b'), (3, 'c'), (4, 'd')]:
+                    q.add(prio, _Task(name))
+                q.remove('a')
+                q.remove('c')
+                q.add(5, _Task('e'))
+                q.remove('e')
+                expected = self._peek(q)
+                self.assertEqual(expected, ['d', 'b'])
+                self.assertEqual(q.compact(), 3)
+                self.assertIsInstance(q, cls)
+                self.assertEqual(self._peek(q), expected)
+                self.assertEqual(q.compact(), 0)
+                self.assertEqual(self._peek(q), expected)
+                self.assertEqual(q.pop().name, 'd')
+                self.assertEqual(q.pop().name, 'b')
+                self.assertRaises(IndexError, q.pop)
+
+    def test_r1_existing_semantics_unchanged(self):
+        for cls, q in self.qs.items():
+            with self.subTest(queue=cls.__name__):
+                self.assertIsInstance(q, BasePriorityQueue)
+                q.add(1, _Task('a'))
+                q.add(1, _Task('b'))
+                self.assertIs(q.peek(), q.peek())
+                self.assertEqual(q.peek().name, 'a')
+                self.assertEqual(q.pop().name, 'a')
+                self.assertTrue(q.add(0, _Task('a')))
+                self.assertEqual(self._peek(q), ['b', 'a'])
+
+
+if __name__ == '__main__':
+    unittest.main()
