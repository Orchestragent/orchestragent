+class JSONLCheckpointIterator:
+    """Iterate over JSON Lines from a seekable binary file object,
+    starting at an absolute byte offset and tracking progress in the
+    public ``byte_offset`` attribute.
+
+    Only complete, newline-terminated lines are consumed. A trailing
+    line without a terminating newline is left in place (and not
+    consumed), so that it can be picked up once more bytes are
+    appended to the file.
+
+    Args:
+        file_obj (file): An open, seekable binary file object. It is
+            never closed by this iterator.
+        offset (int): The absolute byte offset to start reading from.
+            Must be a non-negative ``int`` (not ``bool``) no greater
+            than the length of the stream.
+        ignore_errors (bool): Whether to skip over lines that fail to
+            decode as UTF-8 or parse as JSON. Defaults to ``False``.
+    """
+    def __init__(self, file_obj, offset=0, ignore_errors=False):
+        if type(offset) is not int or offset < 0:
+            raise ValueError("'offset' expected a non-negative int, not %r"
+                             % (offset,))
+        file_obj.seek(0, os.SEEK_END)
+        length = file_obj.tell()
+        if offset > length:
+            raise ValueError("'offset' (%r) exceeds stream length (%r)"
+                             % (offset, length))
+        file_obj.seek(offset, os.SEEK_SET)
+        self._file_obj = file_obj
+        self.ignore_errors = ignore_errors
+        self.byte_offset = offset
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        fo = self._file_obj
+        while True:
+            fo.seek(self.byte_offset, os.SEEK_SET)
+            line = fo.readline()
+            if not line.endswith(b'\n'):
+                # incomplete (or missing) line; do not consume it
+                fo.seek(self.byte_offset, os.SEEK_SET)
+                raise StopIteration
+            if line.endswith(b'\r\n'):
+                content = line[:-2]
+            else:
+                content = line[:-1]
+            if not content:
+                self.byte_offset += len(line)
+                continue
+            try:
+                obj = json.loads(content.decode('utf-8'))
+            except Exception:
+                if not self.ignore_errors:
+                    fo.seek(self.byte_offset, os.SEEK_SET)
+                    raise ValueError('error parsing JSON line at byte %r'
+                                     % (self.byte_offset,))
+                self.byte_offset += len(line)
+                continue
+            self.byte_offset += len(line)
+            return obj
+
+    next = __next__
+
+
