+def atomic_save_json(dest_path, value):
+    """Atomically write *value* as a canonical UTF-8 JSON document to
+    *dest_path*, which may be a :class:`str` or :class:`os.PathLike`.
+
+    The document is serialized with sorted keys, compact separators,
+    non-ASCII characters preserved, NaN/Infinity rejected, and a single
+    trailing newline. Serialization happens before the destination is
+    touched, so invalid or non-serializable *value* leaves any existing
+    destination byte-for-byte unchanged. Writes reuse
+    :func:`atomic_save`, so write failures also leave the existing
+    destination intact and clean up the temporary ``.part`` file.
+    """
+    dest_path = os.fspath(dest_path)
+    text = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False) + '\n'
+    data = text.encode('utf-8')
+    with atomic_save(dest_path) as fo:
+        fo.write(data)
+    return
+
