index 0000000..0ca8187
--- /dev/null
+++ b/boltons/taskqueueutils.py
@@ -0,0 +1,224 @@
+"""Durable, deduplicating, resumable work queue fed from append-only
+JSONL input files. Integrates :mod:`boltons.queueutils`,
+:mod:`boltons.jsonutils` and :mod:`boltons.fileutils`.
+"""
+
+import json
+import math
+import os
+from os import PathLike
+from typing import Any, BinaryIO, Dict, List, Optional, Union
+
+from .fileutils import atomic_save_json
+from .jsonutils import JSONLCheckpointIterator
+from .queueutils import PriorityQueue
+
+__all__ = ['CheckpointQueue']
+
+SCHEMA_VERSION = 1
+
+_RECORD_KEYS = frozenset(['id', 'payload', 'priority'])
+_STATE_RECORD_KEYS = frozenset(['id', 'payload', 'priority', 'seq'])
+_STATE_KEYS = frozenset(['schema_version', 'next_seq', 'pending',
+                         'in_flight', 'completed', 'offsets'])
+
+
+def _is_id(value):
+    return isinstance(value, str) and bool(value)
+
+
+def _is_nonneg_int(value):
+    return type(value) is int and value >= 0
+
+
+def _validate_entry(task_id, payload, priority):
+    if not _is_id(task_id):
+        raise ValueError('task_id must be a nonempty str, not %r'
+                         % (task_id,))
+    try:
+        json.dumps(payload, allow_nan=False)
+    except (TypeError, ValueError, RecursionError) as exc:
+        raise ValueError('payload is not JSON-serializable: %r' % (exc,))
+    if type(priority) not in (int, float) or not math.isfinite(priority):
+        raise ValueError('priority must be a finite int or float, not %r'
+                         % (priority,))
+
+
+def _validate_state(state):
+    if not isinstance(state, dict):
+        raise ValueError('queue state must be a JSON object')
+    version = state.get('schema_version')
+    if type(version) is not int or version != SCHEMA_VERSION:
+        raise ValueError('unsupported schema_version: %r' % (version,))
+    if set(state) != _STATE_KEYS:
+        raise ValueError('queue state has invalid keys: %r'
+                         % (sorted(state),))
+    next_seq = state['next_seq']
+    if not _is_nonneg_int(next_seq):
+        raise ValueError('invalid next_seq: %r' % (next_seq,))
+    seen = set()
+    groups = []
+    for name in ('pending', 'in_flight'):
+        records = state[name]
+        if not isinstance(records, list):
+            raise ValueError('%s must be a list' % name)
+        for record in records:
+            if (not isinstance(record, dict)
+                    or set(record) != _STATE_RECORD_KEYS):
+                raise ValueError('invalid %s record: %r' % (name, record))
+            _validate_entry(record['id'], record['payload'],
+                            record['priority'])
+            if not _is_nonneg_int(record['seq']):
+                raise ValueError('invalid seq: %r' % (record['seq'],))
+            if record['id'] in seen:
+                raise ValueError('duplicate id: %r' % (record['id'],))
+            seen.add(record['id'])
+        groups.append(records)
+    completed = state['completed']
+    if not isinstance(completed, list):
+        raise ValueError('completed must be a list')
+    for task_id in completed:
+        if not _is_id(task_id):
+            raise ValueError('invalid completed id: %r' % (task_id,))
+        if task_id in seen:
+            raise ValueError('duplicate id: %r' % (task_id,))
+        seen.add(task_id)
+    offsets = state['offsets']
+    if not isinstance(offsets, dict):
+        raise ValueError('offsets must be an object')
+    for source_id, offset in offsets.items():
+        if not _is_id(source_id) or not _is_nonneg_int(offset):
+            raise ValueError('invalid offset entry: %r: %r'
+                             % (source_id, offset))
+    return next_seq, groups[0], groups[1], completed, offsets
+
+
+class CheckpointQueue:
+    """Priority work queue whose state is checkpointed to a JSON file
+    at *path* only when :meth:`save` is called.
+    """
+
+    def __init__(self, path: Union[str, PathLike]) -> None:
+        self.path = os.fspath(path)
+        self._pq = PriorityQueue()
+        self._pending = {}
+        self._in_flight = {}
+        self._completed = set()
+        # ids that were in flight at last save; pending again but ackable
+        self._recovered = set()
+        self._next_seq = 0
+        self._offsets = {}
+        self._load()
+
+    def _load(self):
+        try:
+            with open(self.path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+        try:
+            state = json.loads(raw.decode('utf-8'))
+        except (UnicodeDecodeError, ValueError) as exc:
+            raise ValueError('invalid queue state: %r' % (exc,))
+        next_seq, pending, in_flight, completed, offsets = \
+            _validate_state(state)
+        self._completed.update(completed)
+        self._offsets.update(offsets)
+        self._next_seq = next_seq
+        self._recovered.update(r['id'] for r in in_flight)
+        for record in sorted(pending + in_flight, key=lambda r: r['seq']):
+            if record['seq'] >= self._next_seq:
+                self._next_seq = record['seq'] + 1
+            self._pending[record['id']] = dict(record)
+            self._pq.add(record['id'], record['priority'])
+
+    def _add(self, task_id, payload, priority):
+        record = {'id': task_id, 'payload': payload,
+                  'priority': priority, 'seq': self._next_seq}
+        self._next_seq += 1
+        self._pending[task_id] = record
+        self._pq.add(task_id, priority)
+
+    def enqueue(self, task_id: str, payload: Any,
+                priority: Union[int, float] = 0) -> bool:
+        _validate_entry(task_id, payload, priority)
+        if (task_id in self._pending
+                or task_id in self._in_flight
+                or task_id in self._completed):
+            return False
+        self._add(task_id, payload, priority)
+        return True
+
+    def peek(self, count: Optional[int] = None) -> List[str]:
+        return list(self._pq.peek_many(count))
+
+    def pop(self) -> Dict[str, Any]:
+        if not self._pending:
+            raise IndexError('pop from an empty CheckpointQueue')
+        task_id = self._pq.pop()
+        record = self._pending.pop(task_id)
+        self._recovered.discard(task_id)
+        self._in_flight[task_id] = record
+        return {'id': record['id'], 'payload': record['payload'],
+                'priority': record['priority']}
+
+    def ack(self, task_id: str) -> None:
+        if task_id in self._in_flight:
+            del self._in_flight[task_id]
+        elif task_id in self._recovered and task_id in self._pending:
+            # work leased before a restart may still be acknowledged
+            self._recovered.discard(task_id)
+            del self._pending[task_id]
+            self._pq.remove(task_id)
+        else:
+            raise KeyError(task_id)
+        self._completed.add(task_id)
+
+    def save(self) -> None:
+        state = {
+            'schema_version': SCHEMA_VERSION,
+            'next_seq': self._next_seq,
+            'pending': [dict(r) for r in self._pending.values()],
+            'in_flight': [dict(r) for r in self._in_flight.values()],
+            'completed': sorted(self._completed),
+            'offsets': dict(self._offsets),
+        }
+        atomic_save_json(self.path, state)
+
+    def ingest(self, file_obj: BinaryIO, source_id: str) -> int:
+        if not _is_id(source_id):
+            raise ValueError('source_id must be a nonempty str, not %r'
+                             % (source_id,))
+        it = JSONLCheckpointIterator(file_obj,
+                                     offset=self._offsets.get(source_id, 0))
+        count = 0
+        while True:
+            try:
+                record = next(it)
+            except StopIteration:
+                break
+            except ValueError:
+                # the undecodable line was consumed; skip it on retry
+                offset = it.byte_offset
+                file_obj.seek(offset, os.SEEK_SET)
+                line = file_obj.readline()
+                if line.endswith(b'\n'):
+                    offset += len(line)
+                self._offsets[source_id] = offset
+                raise
+            try:
+                if (not isinstance(record, dict)
+                        or set(record) != _RECORD_KEYS):
+                    raise ValueError('invalid record before byte %r'
+                                     % (it.byte_offset,))
+                _validate_entry(record['id'], record['payload'],
+                                record['priority'])
+            except ValueError:
+                self._offsets[source_id] = it.byte_offset
+                raise
+            if self.enqueue(record['id'], record['payload'],
+                            record['priority']):
+                count += 1
+            self._offsets[source_id] = it.byte_offset
+        self._offsets[source_id] = it.byte_offset
+        return count
