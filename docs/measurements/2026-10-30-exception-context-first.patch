+import json
+import pathlib
+import unittest
+from unittest import mock
+
+from boltons import fileutils
+
+
+class AtomicSaveJSONTests(unittest.TestCase):
+    def setUp(self):
+        import tempfile
+        self._td = tempfile.TemporaryDirectory()
+        self.dir = pathlib.Path(self._td.name)
+        self.path = self.dir / 'state.json'
+        self.path.write_bytes(b'ORIGINAL-BYTES')
+
+    def tearDown(self):
+        self._td.cleanup()
+
+    def _read(self, p):
+        return pathlib.Path(p).read_bytes()
+
+    def test_r3_exact_document_bytes(self):
+        value = {'z': 1, 'a': [1, 2], 'u': 'caf\u00e9 \u2603', 'n': None}
+        ret = fileutils.atomic_save_json(self.path, value)
+        self.assertIsNone(ret)
+        expected = ('{"a":[1,2],"n":null,"u":"caf\u00e9 \u2603","z":1}\n'
+                    .encode('utf-8'))
+        self.assertEqual(self._read(self.path), expected)
+        self.assertEqual(json.loads(expected), value)
+        self.assertFalse((self.dir / 'state.json.part').exists())
+
+    def test_r3_accepts_str_and_pathlib(self):
+        cases = [
+            ('str', str(self.dir / 's.json')),
+            ('Path', self.dir / 'p.json'),
+        ]
+        for name, dest in cases:
+            with self.subTest(name=name):
+                ret = fileutils.atomic_save_json(dest, {'k': 1})
+                self.assertIsNone(ret)
+                self.assertEqual(self._read(dest), b'{"k":1}\n')
+
+    def test_r3_empty_containers(self):
+        table = [({}, b'{}\n'), ([], b'[]\n'), (0, b'0\n'), ('', b'""\n')]
+        for i, (value, expected) in enumerate(table):
+            dest = self.dir / ('e%d.json' % i)
+            with self.subTest(value=value):
+                self.assertIsNone(fileutils.atomic_save_json(dest, value))
+                self.assertEqual(self._read(dest), expected)
+
+    def test_r3_invalid_data_leaves_dest_unchanged(self):
+        cases = [
+            ('nan', float('nan')),
+            ('inf', {'x': float('inf')}),
+            ('object', {'x': object()}),
+            ('set', {1, 2}),
+        ]
+        for name, value in cases:
+            with self.subTest(name=name):
+                with self.assertRaises((TypeError, ValueError)):
+                    fileutils.atomic_save_json(self.path, value)
+                self.assertEqual(self._read(self.path), b'ORIGINAL-BYTES')
+                self.assertEqual(sorted(p.name for p in self.dir.iterdir()),
+                                 ['state.json'])
+
+    def test_r3_invalid_data_no_file_created(self):
+        dest = self.dir / 'new.json'
+        with self.assertRaises((TypeError, ValueError)):
+            fileutils.atomic_save_json(dest, {'bad': object()})
+        self.assertFalse(dest.exists())
+        self.assertFalse((self.dir / 'new.json.part').exists())
+
+    def test_r3_write_failure_preserves_dest_and_cleans_part(self):
+        original = fileutils.atomic_save
+        state = {}
+
+        class Wrapper(object):
+            def __init__(self, *a, **kw):
+                self._inner = original(*a, **kw)
+
+            def __enter__(self):
+                state['f'] = self._inner.__enter__()
+                return state['f']
+
+            def __exit__(self, *exc):
+                return self._inner.__exit__(*exc)
+
+        def explode(data):
+            raise OSError('disk gone')
+
+        state['f'] = None
+        real = {}
+
+        class BadFile(object):
+            def __init__(self, f):
+                real['f'] = f
+
+            def write(self, data):
+                raise OSError('disk gone')
+
+            def __getattr__(self, name):
+                return getattr(real['f'], name)
+
+        calls = {'n': 0}
+
+        def factory(*a, **kw):
+            outer = Wrapper(*a, **kw)
+
+            class Ctx(object):
+                def __enter__(self):
+                    return BadFile(outer.__enter__())
+
+                def __exit__(self, *exc):
+                    return outer.__exit__(*exc)
+
+            return Ctx()
+
+        with mock.patch.object(fileutils, 'atomic_save', factory):
+            with self.assertRaises(OSError):
+                fileutils.atomic_save_json(self.path, {'a': 1})
+        self.assertEqual(self._read(self.path), b'ORIGINAL-BYTES')
+        self.assertFalse((self.dir / 'state.json.part').exists())
+
+    def test_r3_overwrites_existing_and_trailing_newline_once(self):
+        self.assertIsNone(fileutils.atomic_save_json(self.path, {'a': 1}))
+        data = self._read(self.path)
+        self.assertEqual(data, b'{"a":1}\n')
+        self.assertTrue(data.endswith(b'\n'))
+        self.assertFalse(data.endswith(b'\n\n'))
+
+
+if __name__ == '__main__':
+    unittest.main()
