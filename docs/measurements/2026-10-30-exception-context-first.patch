+def atomic_save_json(dest_path, value):
+    """Atomically write *value* to *dest_path* as a single UTF-8 JSON
+    document, using :func:`atomic_save`.
+
+    The document is serialized with sorted keys, compact separators,
+    non-ASCII characters retained (not escaped), and NaN/Infinity
+    rejected, followed by exactly one trailing newline. Serialization
+    happens before any file is touched, so unusable data leaves an
+    existing destination unchanged and creates no part file. Write
+    failures are likewise cleaned up by :class:`AtomicSaver`.
+
+    Args:
+        dest_path (str or pathlib.Path): Destination path.
+        value: Any JSON-serializable value.
+    """
+    data = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False) + '\n'
+    path = os.fspath(dest_path)
+    with atomic_save(path) as f:
+        f.write(data.encode('utf-8'))
+    return
+
+
 def path_to_unicode(path):
