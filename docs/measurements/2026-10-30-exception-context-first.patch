+    def peek_many(self, count=None):
+        """Return up to *count* of the next tasks in the queue, in
+        the same order repeated :meth:`pop` calls would return them,
+        without removing anything. *count* defaults to ``None``,
+        meaning all tasks. Raises :exc:`ValueError` for invalid
+        *count* values. Unlike :meth:`peek`, does not call the queue's
+        *priority_key* again.
+        """
+        if count is not None:
+            if type(count) is not int or count < 0:
+                raise ValueError('count must be None or a nonnegative int,'
+                                 ' not %r' % (count,))
+        entries = sorted(e for e in self._entry_map.values()
+                         if e[-1] is not _REMOVED)
+        tasks = [e[-1] for e in entries]
+        if count is not None:
+            tasks = tasks[:count]
+        return tasks
+
+    def compact(self):
+        """Remove any entries marked as removed by previous
+        :meth:`remove` calls (as well as the entries they replaced) from
+        the underlying backend. Returns the number of entries removed.
+        """
+        active = sorted(e for e in self._entry_map.values()
+                        if e[-1] is not _REMOVED)
+        removed = len(self._pq) - len(active)
+        if not removed:
+            return 0
+        backend = self._pq
+        del backend[:]
+        for entry in active:
+            self._push_entry(backend, entry)
+        if isinstance(backend, list) and not isinstance(backend, BList):
+            backend.sort()
+        return removed
+
     def __len__(self):
         "Return the number of tasks in the queue."
         return len(self._entry_map)
diff --git a/boltons/taskqueueutils.py b/boltons/taskqueueutils.py
new file mode 100644
index 0000000..7061485
--- /dev/null
+++ b/boltons/taskqueueutils.py
@@ -0,0 +1,266 @@
+"""Resumable, deduplicating work queue fed from append-only JSONL files.
+
+:class:`CheckpointQueue` combines :mod:`boltons.queueutils` priority
+queues, :class:`boltons.jsonutils.JSONLCheckpointIterator` and
+:func:`boltons.fileutils.atomic_save_json` to provide a durable queue
+whose state (pending, in-flight and completed task IDs, insertion order
+and per-source input byte offsets) is persisted explicitly via
+:meth:`CheckpointQueue.save`.
+"""
+
+import json
+import math
+import os
+from typing import Any, BinaryIO, Dict, List, Optional, Union
+
+from boltons.fileutils import atomic_save_json
+from boltons.jsonutils import JSONLCheckpointIterator
+from boltons.queueutils import HeapPriorityQueue
+
+__all__ = ['CheckpointQueue']
+
+SCHEMA_VERSION = 1
+
+
+class CheckpointQueue:
+    """Durable priority work queue checkpointed to a JSON file at *path*.
+
+    Larger priorities are delivered first; ties are delivered in original
+    insertion order. State is only written by :meth:`save`.
+    """
+
+    def __init__(self, path: Union[str, os.PathLike]) -> None:
+        """Load state from *path* if it exists, else start empty.
+
+        Raises ValueError for unsupported or malformed state without
+        modifying the checkpoint file.
+        """
+        self._path = os.fspath(path)
+        self._pq = HeapPriorityQueue()
+        self._entries = {}
+        self._in_flight = {}
+        self._completed = set()
+        self._offsets = {}
+        self._next_seq = 0
+        if not os.path.exists(self._path):
+            return
+        state = self._load_state()
+        self._apply_state(state)
+
+    def enqueue(self, task_id: str, payload: Any,
+                priority: Union[int, float] = 0) -> bool:
+        """Add a pending task; return False if *task_id* is already known."""
+        self._validate_task(task_id, payload, priority)
+        if (task_id in self._entries or task_id in self._in_flight
+                or task_id in self._completed):
+            return False
+        seq = self._next_seq
+        self._next_seq += 1
+        self._entries[task_id] = {'payload': payload,
+                                  'priority': priority,
+                                  'seq': seq}
+        self._pq.add(task_id, priority)
+        return True
+
+    def peek(self, count: Optional[int] = None) -> List[str]:
+        """Return up to *count* pending IDs in delivery order (all if None)."""
+        return self._pq.peek_many(count)
+
+    def pop(self) -> Dict[str, Any]:
+        """Move the next pending task to in-flight and return
+        ``{'id': ..., 'payload': ..., 'priority': ...}``.
+
+        Raises IndexError when no task is pending.
+        """
+        try:
+            task_id = self._pq.pop()
+        except IndexError:
+            raise IndexError('pop from empty queue')
+        entry = self._entries.pop(task_id)
+        in_flight_entry = {'payload': entry['payload'],
+                           'priority': entry['priority'],
+                           'seq': entry['seq']}
+        self._in_flight[task_id] = in_flight_entry
+        return {'id': task_id,
+                'payload': entry['payload'],
+                'priority': entry['priority']}
+
+    def ack(self, task_id: str) -> None:
+        """Mark an in-flight task completed; KeyError for any other ID."""
+        if not isinstance(task_id, str) or task_id not in self._in_flight:
+            raise KeyError(task_id)
+        del self._in_flight[task_id]
+        self._completed.add(task_id)
+
+    def save(self) -> None:
+        """Atomically persist the queue state to the checkpoint path."""
+        pending = []
+        for task_id in self._pq.peek_many():
+            pending.append(self._entry_record(task_id, self._entries[task_id]))
+        in_flight = sorted(self._in_flight.items(), key=lambda kv: kv[1]['seq'])
+        in_flight = [self._entry_record(k, v) for k, v in in_flight]
+        state = {'schema_version': SCHEMA_VERSION,
+                 'next_seq': self._next_seq,
+                 'pending': pending,
+                 'in_flight': in_flight,
+                 'completed': sorted(self._completed),
+                 'offsets': dict(self._offsets)}
+        atomic_save_json(self._path, state)
+        return
+
+    def ingest(self, file_obj: BinaryIO, source_id: str) -> int:
+        """Enqueue complete JSONL records from *file_obj* starting at the
+        saved byte offset for *source_id*; return the number newly enqueued.
+        """
+        if type(source_id) is not str or not source_id:
+            raise ValueError('source_id expected a nonempty str, not %r'
+                             % (source_id,))
+        offset = self._offsets.get(source_id, 0)
+        iterator = JSONLCheckpointIterator(file_obj, offset)
+        count = 0
+        while 1:
+            consumed = iterator.byte_offset
+            try:
+                record = next(iterator)
+            except StopIteration:
+                self._offsets[source_id] = iterator.byte_offset
+                break
+            except ValueError:
+                self._offsets[source_id] = consumed
+                raise
+            self._validate_record(record)
+            if self.enqueue(record['id'], record['payload'],
+                            record['priority']):
+                count += 1
+            self._offsets[source_id] = iterator.byte_offset
+        return count
+
+    # -- state (de)serialization helpers --
+
+    @staticmethod
+    def _entry_record(task_id, entry):
+        return {'id': task_id,
+                'payload': entry['payload'],
+                'priority': entry['priority'],
+                'seq': entry['seq']}
+
+    def _load_state(self):
+        with open(self._path, 'rb') as f:
+            raw = f.read()
+        try:
+            state = json.loads(raw.decode('utf-8'))
+        except Exception as exc:
+            raise ValueError('could not load queue state from %r: %s'
+                             % (self._path, exc))
+        return state
+
+    def _apply_state(self, state):
+        if type(state) is not dict:
+            raise ValueError('queue state expected a JSON object')
+        for key in ('schema_version', 'next_seq', 'pending',
+                    'in_flight', 'completed', 'offsets'):
+            if key not in state:
+                raise ValueError('queue state missing %r' % (key,))
+        schema_version = state['schema_version']
+        if type(schema_version) is not int or schema_version != SCHEMA_VERSION:
+            raise ValueError('unsupported queue state schema_version: %r'
+                             % (schema_version,))
+        next_seq = state['next_seq']
+        if type(next_seq) is not int or next_seq < 0:
+            raise ValueError('invalid next_seq: %r' % (next_seq,))
+        pending = self._parse_entries(state['pending'], 'pending')
+        in_flight = self._parse_entries(state['in_flight'], 'in_flight')
+        completed = self._parse_completed(state['completed'])
+        offsets = self._parse_offsets(state['offsets'])
+        for entries in (pending, in_flight):
+            for entry in entries:
+                if entry['seq'] >= next_seq:
+                    raise ValueError('seq %r not below next_seq %r'
+                                     % (entry['seq'], next_seq))
+        self._next_seq = next_seq
+        self._completed = set(completed)
+        self._offsets = dict(offsets)
+        merged = sorted(in_flight + pending, key=lambda e: e['seq'])
+        for entry in merged:
+            task_id = entry['id']
+            self._entries[task_id] = {'payload': entry['payload'],
+                                      'priority': entry['priority'],
+                                      'seq': entry['seq']}
+            self._pq.add(task_id, entry['priority'])
+        return
+
+    def _parse_entries(self, value, name):
+        if type(value) is not list:
+            raise ValueError('%s expected a list, not %r' % (name, value))
+        entries = []
+        seen = set()
+        for item in value:
+            if type(item) is not dict:
+                raise ValueError('invalid entry in %s: %r' % (name, item))
+            for key in ('id', 'payload', 'priority', 'seq'):
+                if key not in item:
+                    raise ValueError('entry in %s missing %r' % (name, key))
+            task_id = item['id']
+            seq = item['seq']
+            self._validate_task(task_id, item['payload'], item['priority'])
+            if type(seq) is not int or seq < 0:
+                raise ValueError('invalid seq %r for task %r' % (seq, task_id))
+            if seq in seen:
+                raise ValueError('duplicate seq %r in %s' % (seq, name))
+            seen.add(seq)
+            entries.append({'id': task_id, 'payload': item['payload'],
+                            'priority': item['priority'], 'seq': seq})
+        return entries
+
+    def _parse_completed(self, value):
+        if type(value) is not list:
+            raise ValueError('completed expected a list, not %r' % (value,))
+        ids = []
+        seen = set()
+        for task_id in value:
+            if type(task_id) is not str or not task_id:
+                raise ValueError('invalid completed task id: %r' % (task_id,))
+            if task_id in seen:
+                raise ValueError('duplicate completed task id: %r'
+                                 % (task_id,))
+            seen.add(task_id)
+            ids.append(task_id)
+        return ids
+
+    def _parse_offsets(self, value):
+        if type(value) is not dict:
+            raise ValueError('offsets expected an object, not %r' % (value,))
+        offsets = {}
+        for source_id, offset in value.items():
+            if type(source_id) is not str or not source_id:
+                raise ValueError('invalid offset source id: %r' % (source_id,))
+            if type(offset) is not int or offset < 0:
+                raise ValueError('invalid offset %r for source %r'
+                                 % (offset, source_id))
+            offsets[source_id] = offset
+        return offsets
+
+    @staticmethod
+    def _validate_task(task_id, payload, priority):
+        if type(task_id) is not str or not task_id:
+            raise ValueError('task_id expected a nonempty str, not %r'
+                             % (task_id,))
+        try:
+            json.dumps(payload, allow_nan=False)
+        except (TypeError, ValueError) as exc:
+            raise ValueError('payload is not JSON-serializable: %s' % (exc,))
+        if type(priority) not in (int, float):
+            raise ValueError('priority expected an int or float, not %r'
+                             % (priority,))
+        if not math.isfinite(priority):
+            raise ValueError('priority expected a finite number, not %r'
+                             % (priority,))
+        return
+
+    @staticmethod
+    def _validate_record(record):
+        if type(record) is not dict or set(record) != {'id', 'payload',
+                                                      'priority'}:
+            raise ValueError('expected a record with exactly id, payload'
+                             ' and priority, not %r' % (record,))
+        return
diff --git a/test_orch_t_001.py b/test_orch_t_001.py
