index 0000000..2a3972c
--- /dev/null
+++ b/networkx/deployment/journal.py
@@ -0,0 +1,213 @@
+"""Atomic JSON files and an append-only, optimistically versioned event journal.
+
+The journal is a single canonical JSON document ``{"schema": 1, "revision":
+N, "events": [...]}`` that is rewritten atomically on every append. Appends
+from independent :class:`Journal` objects (or processes) are serialized by an
+exclusive ``fcntl`` lock on a ``<path>.lock`` sidecar file.
+"""
+
+import os
+import tempfile
+from collections.abc import Mapping
+
+from networkx.deployment._util import (
+    canonical_json,
+    check_id,
+    check_int,
+    encode,
+    is_id,
+    is_int,
+    loads_strict,
+    normalize,
+)
+
+try:
+    import fcntl
+except ImportError:  # pragma: no cover - non-POSIX platforms
+    fcntl = None
+
+__all__ = ["ConflictError", "Journal", "save_json"]
+
+_SCHEMA = 1
+
+
+class ConflictError(ValueError):
+    """A write conflicts with state recorded by another writer.
+
+    Raised for stale expected revisions, an event ID reused with a different
+    payload, and controller leases or decisions that are no longer valid.
+    """
+
+
+def save_json(path, value):
+    """Atomically write the canonical JSON of `value` to `path` as UTF-8.
+
+    `value` is normalized by a strict JSON round trip first; NaN, infinity
+    and unserializable values raise ValueError. The data is written to a
+    temporary file in the destination directory and moved into place with
+    :func:`os.replace`, so readers see either the old or the new document.
+    On any failure the temporary file is removed and an existing destination
+    is left untouched.
+    """
+    path = os.fspath(path)
+    data = encode(normalize(value))
+    directory = os.path.dirname(os.path.abspath(path))
+    fd, temporary = tempfile.mkstemp(
+        prefix=f".{os.path.basename(path)}.", suffix=".tmp", dir=directory
+    )
+    try:
+        with os.fdopen(fd, "wb") as handle:
+            handle.write(data)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+    except BaseException:
+        try:
+            os.unlink(temporary)
+        except OSError:
+            pass
+        raise
+    _fsync_directory(directory)
+
+
+def _fsync_directory(directory):
+    try:
+        fd = os.open(directory, os.O_RDONLY)
+    except OSError:
+        return
+    try:
+        os.fsync(fd)
+    except OSError:
+        pass
+    finally:
+        os.close(fd)
+
+
+def _check_event(event, what="event"):
+    if not isinstance(event, Mapping) or set(event) != {"id", "payload"}:
+        raise ValueError(f"{what} must be a dict with exactly 'id' and 'payload'")
+    check_id(event["id"], f"{what} id")
+    return normalize({"id": event["id"], "payload": event["payload"]})
+
+
+def _validate_document(document):
+    if not isinstance(document, dict) or set(document) != {
+        "schema",
+        "revision",
+        "events",
+    }:
+        raise ValueError("journal must contain exactly schema, revision and events")
+    if not is_int(document["schema"]) or document["schema"] != _SCHEMA:
+        raise ValueError(f"unsupported journal schema {document['schema']!r}")
+    events = document["events"]
+    if not isinstance(events, list):
+        raise ValueError("journal events must be a list")
+    seen = set()
+    for index, record in enumerate(events, 1):
+        if not isinstance(record, dict) or set(record) != {"revision", "event"}:
+            raise ValueError("journal records must have exactly revision and event")
+        if not is_int(record["revision"]) or record["revision"] != index:
+            raise ValueError(f"journal revision {record['revision']!r} is not {index}")
+        event = record["event"]
+        if not isinstance(event, dict) or set(event) != {"id", "payload"}:
+            raise ValueError("journal events must have exactly id and payload")
+        if not is_id(event["id"]):
+            raise ValueError(f"journal event id {event['id']!r} is invalid")
+        if event["id"] in seen:
+            raise ValueError(f"duplicate journal event id {event['id']!r}")
+        seen.add(event["id"])
+    if not is_int(document["revision"]) or document["revision"] != len(events):
+        raise ValueError("journal revision does not match its events")
+    return document
+
+
+class Journal:
+    """An append-only event journal stored as one JSON file at `path`.
+
+    Each record is ``{"revision": N, "event": {"id": ..., "payload": ...}}``
+    with revisions numbered consecutively from 1. Event IDs are unique.
+    """
+
+    def __init__(self, path):
+        try:
+            path = os.fspath(path)
+        except TypeError:
+            raise ValueError(f"journal path must be path-like, got {path!r}") from None
+        if not isinstance(path, str) or not path:
+            raise ValueError(f"journal path must be a nonempty string, got {path!r}")
+        self._path = path
+        self._lock_path = path + ".lock"
+
+    @property
+    def path(self):
+        return self._path
+
+    def __repr__(self):
+        return f"Journal({self._path!r})"
+
+    def read(self):
+        """Return ``{"schema": 1, "revision": N, "events": [...]}``.
+
+        A missing journal reads as revision 0 and is not created. Malformed
+        or unsupported content raises ValueError.
+        """
+        try:
+            with open(self._path, "rb") as handle:
+                data = handle.read()
+        except FileNotFoundError:
+            return {"schema": _SCHEMA, "revision": 0, "events": []}
+        return _validate_document(loads_strict(data))
+
+    def append(self, expected_revision, event):
+        """Append `event` if the journal is still at `expected_revision`.
+
+        Parameters
+        ----------
+        expected_revision : int
+            The revision the caller last observed.
+        event : dict
+            ``{"id": nonempty_str, "payload": JSON_value}``; it is copied.
+
+        Returns
+        -------
+        int
+            The revision of the new record. If an event with the same ID and
+            normalized payload already exists, its original revision is
+            returned and nothing is written, even for a stale
+            `expected_revision`.
+
+        Raises
+        ------
+        ConflictError
+            If the ID exists with a different payload, or if a new event is
+            appended with a stale `expected_revision`.
+        ValueError
+            For invalid arguments or a malformed journal.
+        """
+        expected_revision = check_int(expected_revision, "expected_revision")
+        event = _check_event(event)
+        if fcntl is None:  # pragma: no cover - non-POSIX platforms
+            raise OSError("journal locking requires fcntl")
+        fd = os.open(self._lock_path, os.O_RDWR | os.O_CREAT, 0o666)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX)
+            document = self.read()
+            for record in document["events"]:
+                if record["event"]["id"] == event["id"]:
+                    if canonical_json(record["event"]) == canonical_json(event):
+                        return record["revision"]
+                    raise ConflictError(
+                        f"event {event['id']!r} already exists with another payload"
+                    )
+            if document["revision"] != expected_revision:
+                raise ConflictError(
+                    f"journal is at revision {document['revision']}, "
+                    f"not {expected_revision}"
+                )
+            revision = expected_revision + 1
+            document["events"].append({"revision": revision, "event": event})
+            document["revision"] = revision
+            save_json(self._path, document)
+            return revision
+        finally:
+            os.close(fd)
