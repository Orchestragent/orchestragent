+++ b/networkx/deployment/model.py
@@ -0,0 +1,201 @@
+"""Validated, immutable description of services, hosts and their network.
+
+A :class:`Model` snapshots and normalizes its input so that later changes to
+the caller's objects cannot affect planning, and so that equal deployments
+share one :attr:`Model.fingerprint`.
+"""
+
+import copy
+from collections.abc import Mapping
+
+import networkx as nx
+from networkx.deployment._util import (
+    canonical_json,
+    check_id,
+    check_int,
+    digest,
+    is_id,
+)
+
+__all__ = ["Model", "canonical_json"]
+
+_SERVICE_KEYS = frozenset({"replicas", "requires", "allowed_zones", "costs"})
+_HOST_KEYS = frozenset({"zone", "slots"})
+
+
+def _check_exact_keys(value, keys, what):
+    if not isinstance(value, Mapping):
+        raise ValueError(f"{what} must be a dict, got {type(value).__name__}")
+    actual = set(value)
+    if actual != keys:
+        missing = sorted(keys - actual)
+        extra = sorted(map(repr, actual - keys))
+        raise ValueError(f"{what} has missing keys {missing} or extra keys {extra}")
+
+
+def _check_id_list(value, what):
+    if not isinstance(value, list | tuple):
+        raise ValueError(f"{what} must be a list or tuple, got {value!r}")
+    return sorted({check_id(item, f"{what} entry") for item in value})
+
+
+def _normalize_hosts(hosts):
+    if not isinstance(hosts, Mapping):
+        raise ValueError("hosts must be a dict")
+    for host in hosts:
+        check_id(host, "host ID")
+    result = {}
+    for host in sorted(hosts):
+        spec = hosts[host]
+        _check_exact_keys(spec, _HOST_KEYS, f"host {host!r}")
+        result[str(host)] = {
+            "zone": check_id(spec["zone"], f"zone of host {host!r}"),
+            "slots": check_int(spec["slots"], f"slots of host {host!r}"),
+        }
+    return result
+
+
+def _normalize_services(services, hosts):
+    if not isinstance(services, Mapping):
+        raise ValueError("services must be a dict")
+    zones = {spec["zone"] for spec in hosts.values()}
+    for service in services:
+        check_id(service, "service ID")
+    result = {}
+    for service in sorted(services):
+        spec = services[service]
+        what = f"service {service!r}"
+        _check_exact_keys(spec, _SERVICE_KEYS, what)
+        replicas = check_int(spec["replicas"], f"replicas of {what}", minimum=1)
+        requires = _check_id_list(spec["requires"], f"requires of {what}")
+        for prerequisite in requires:
+            if prerequisite == service:
+                raise ValueError(f"{what} depends on itself")
+            if prerequisite not in services:
+                raise ValueError(f"{what} requires unknown service {prerequisite!r}")
+        allowed = spec["allowed_zones"]
+        if allowed is not None:
+            allowed = _check_id_list(allowed, f"allowed_zones of {what}")
+            unknown = [zone for zone in allowed if zone not in zones]
+            if unknown:
+                raise ValueError(f"{what} allows unknown zones {unknown}")
+        costs = spec["costs"]
+        if not isinstance(costs, Mapping):
+            raise ValueError(f"costs of {what} must be a dict")
+        if set(costs) != set(hosts):
+            raise ValueError(f"costs of {what} must cover exactly all host IDs")
+        result[str(service)] = {
+            "replicas": replicas,
+            "requires": requires,
+            "allowed_zones": allowed,
+            "costs": {
+                host: check_int(costs[host], f"cost of {what} on host {host!r}")
+                for host in hosts
+            },
+        }
+    dependencies = nx.DiGraph()
+    dependencies.add_nodes_from(result)
+    for service, spec in result.items():
+        dependencies.add_edges_from((p, service) for p in spec["requires"])
+    if not nx.is_directed_acyclic_graph(dependencies):
+        cycle = [u for u, _ in nx.find_cycle(dependencies)]
+        raise ValueError(f"service dependencies contain a cycle: {cycle}")
+    return result
+
+
+def _normalize_network(network, hosts):
+    if not isinstance(network, nx.Graph):
+        raise ValueError("network must be a networkx Graph")
+    if network.is_directed() or network.is_multigraph():
+        raise ValueError("network must be a simple undirected nx.Graph")
+    nodes = []
+    for node in network.nodes:
+        if not is_id(node):
+            raise ValueError(f"network node IDs must be nonempty strings, got {node!r}")
+        nodes.append(str(node))
+    nodes.sort()
+    missing = sorted(set(hosts) - set(nodes))
+    if missing:
+        raise ValueError(f"network is missing hosts {missing}")
+    edges = []
+    for u, v, data in network.edges(data=True):
+        if u == v:
+            raise ValueError(f"network has a self-loop on {u!r}")
+        weight = check_int(data.get("weight"), f"weight of edge {(u, v)!r}", minimum=1)
+        edges.append([min(u, v), max(u, v), weight])
+    edges.sort()
+    return {"nodes": nodes, "edges": edges}
+
+
+def _graph_from(network):
+    graph = nx.Graph()
+    graph.add_nodes_from(network["nodes"])
+    graph.add_weighted_edges_from(network["edges"])
+    return graph
+
+
+class Model:
+    """An immutable deployment model.
+
+    Parameters
+    ----------
+    services : dict
+        Maps service IDs to dicts with exactly the keys ``replicas``
+        (positive int), ``requires`` (list or tuple of prerequisite service
+        IDs), ``allowed_zones`` (None or a list or tuple of zone IDs) and
+        ``costs`` (a dict from every host ID to a nonnegative int).
+    hosts : dict
+        Maps host IDs to dicts with exactly the keys ``zone`` (nonempty str)
+        and ``slots`` (nonnegative int).
+    network : nx.Graph
+        A simple undirected graph whose string nodes include every host and
+        whose edges all carry a positive int ``weight``. Other attributes are
+        ignored.
+
+    Raises
+    ------
+    ValueError
+        If any part of the input is invalid. The input is never modified.
+    """
+
+    __slots__ = ("_services", "_hosts", "_network", "_graph", "_fingerprint")
+
+    def __init__(self, services, hosts, network):
+        hosts = _normalize_hosts(hosts)
+        self._hosts = hosts
+        self._services = _normalize_services(services, hosts)
+        self._network = _normalize_network(network, hosts)
+        self._graph = _graph_from(self._network)
+        self._fingerprint = digest(
+            {
+                "services": self._services,
+                "hosts": self._hosts,
+                "network": self._network,
+            }
+        )
+
+    @property
+    def services(self):
+        """A normalized copy of the services, keyed in lexical order."""
+        return copy.deepcopy(self._services)
+
+    @property
+    def hosts(self):
+        """A normalized copy of the hosts, keyed in lexical order."""
+        return copy.deepcopy(self._hosts)
+
+    @property
+    def network(self):
+        """A new nx.Graph holding only the network nodes and edge weights."""
+        return _graph_from(self._network)
+
+    @property
+    def fingerprint(self):
+        """SHA-256 hex digest of the canonical normalized model."""
+        return self._fingerprint
+
+    def __repr__(self):
+        return (
+            f"<Model services={len(self._services)} hosts={len(self._hosts)} "
+            f"fingerprint={self._fingerprint[:12]}>"
+        )
