@@ -0,0 +1,139 @@
+import itertools
+import unittest
+
+import networkx as nx
+from networkx.deployment.model import Model
+from networkx.deployment.placement import place
+
+
+def build(services, hosts):
+    network = nx.Graph()
+    network.add_nodes_from(hosts)
+    return Model(services, hosts, network)
+
+
+def brute_force(model):
+    services, hosts = model.services, model.hosts
+    options = []
+    for service, spec in services.items():
+        zones = spec["allowed_zones"]
+        choices = [
+            combo
+            for combo in itertools.combinations(sorted(hosts), spec["replicas"])
+            if len({hosts[h]["zone"] for h in combo}) == len(combo)
+            and (zones is None or all(hosts[h]["zone"] in zones for h in combo))
+        ]
+        options.append((service, choices))
+    best = None
+    for pick in itertools.product(*(choices for _, choices in options)):
+        load = {}
+        for combo in pick:
+            for host in combo:
+                load[host] = load.get(host, 0) + 1
+        if any(load[h] > hosts[h]["slots"] for h in load):
+            continue
+        cost = sum(
+            services[s]["costs"][h] for (s, _), combo in zip(options, pick) for h in combo
+        )
+        best = cost if best is None else min(best, cost)
+    return best
+
+
+class TestR2Behavior(unittest.TestCase):
+    def test_global_optimum_beats_greedy(self):
+        hosts = {
+            "a1": {"zone": "a", "slots": 1},
+            "b1": {"zone": "b", "slots": 1},
+        }
+        # Greedy in lexical order would give "x" the cheap host a1.
+        services = {
+            "x": {
+                "replicas": 1,
+                "requires": [],
+                "allowed_zones": None,
+                "costs": {"a1": 0, "b1": 1},
+            },
+            "y": {
+                "replicas": 1,
+                "requires": [],
+                "allowed_zones": None,
+                "costs": {"a1": 0, "b1": 10},
+            },
+        }
+        model = build(services, hosts)
+        result = place(model)
+        self.assertEqual(result, {"placements": {"x": ["b1"], "y": ["a1"]}, "cost": 1})
+
+    def test_zone_spread_capacity_and_brute_force(self):
+        hosts = {
+            "a1": {"zone": "a", "slots": 2},
+            "a2": {"zone": "a", "slots": 1},
+            "b1": {"zone": "b", "slots": 1},
+            "c1": {"zone": "c", "slots": 2},
+        }
+        services = {
+            "s1": {
+                "replicas": 3,
+                "requires": [],
+                "allowed_zones": None,
+                "costs": {"a1": 5, "a2": 1, "b1": 2, "c1": 7},
+            },
+            "s2": {
+                "replicas": 2,
+                "requires": ["s1"],
+                "allowed_zones": ["a", "c"],
+                "costs": {"a1": 1, "a2": 1, "b1": 0, "c1": 3},
+            },
+            "s3": {
+                "replicas": 1,
+                "requires": [],
+                "allowed_zones": ["a"],
+                "costs": {"a1": 0, "a2": 0, "b1": 0, "c1": 0},
+            },
+        }
+        model = build(services, hosts)
+        snapshot = model.services
+        result = place(model)
+        self.assertEqual(list(result["placements"]), ["s1", "s2", "s3"])
+        self.assertEqual(result["cost"], brute_force(model))
+        load = {}
+        for service, chosen in result["placements"].items():
+            self.assertEqual(chosen, sorted(chosen))
+            self.assertEqual(len(chosen), services[service]["replicas"])
+            zones = [hosts[h]["zone"] for h in chosen]
+            self.assertEqual(len(set(zones)), len(zones))
+            for host in chosen:
+                load[host] = load.get(host, 0) + 1
+        for host, used in load.items():
+            self.assertLessEqual(used, hosts[host]["slots"])
+        self.assertEqual(model.services, snapshot)
+
+    def test_infeasible_and_empty(self):
+        hosts = {"a1": {"zone": "a", "slots": 5}, "a2": {"zone": "a", "slots": 5}}
+        spread = {
+            "s": {
+                "replicas": 2,
+                "requires": [],
+                "allowed_zones": None,
+                "costs": {"a1": 0, "a2": 0},
+            }
+        }
+        with self.assertRaises(nx.NetworkXUnfeasible):
+            place(build(spread, hosts))
+        tight = {"a1": {"zone": "a", "slots": 1}, "b1": {"zone": "b", "slots": 0}}
+        services = {
+            name: {
+                "replicas": 1,
+                "requires": [],
+                "allowed_zones": None,
+                "costs": {"a1": 0, "b1": 0},
+            }
+            for name in ("p", "q")
+        }
+        with self.assertRaises(nx.NetworkXUnfeasible):
+            place(build(services, tight))
+        self.assertEqual(place(Model({}, {}, nx.Graph())), {"placements": {}, "cost": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
