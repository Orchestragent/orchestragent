index 0000000..ae1f6a2
--- /dev/null
+++ b/networkx/deployment/cli.py
@@ -0,0 +1,159 @@
+"""Command line interface for planning and driving a rollout.
+
+Every command prints one strict JSON value to stdout and returns 0, or prints
+a diagnostic to stderr and returns 2 for invalid input, conflicts,
+infeasibility and I/O errors::
+
+    plan INPUT OUTPUT
+    status PLAN JOURNAL --now N [--max-attempts N]
+    claim PLAN JOURNAL WORKER --now N --ttl N [--max-attempts N]
+    ack PLAN JOURNAL LEASE --now N (--success | --failure) [--max-attempts N]
+"""
+
+import argparse
+import sys
+from collections.abc import Mapping
+
+import networkx as nx
+from networkx.deployment._util import canonical_json, check_id, loads_strict
+from networkx.deployment.controller import Controller
+from networkx.deployment.journal import ConflictError, Journal, save_json
+from networkx.deployment.model import Model
+from networkx.deployment.planner import compile_plan
+
+__all__ = ["main"]
+
+_INPUT_KEYS = frozenset({"services", "hosts", "network"})
+_CONTROL_KEYS = frozenset({"path_redundancy", "max_parallel"})
+
+
+def _load_json(path):
+    with open(path, "rb") as handle:
+        return loads_strict(handle.read())
+
+
+def _network_from_json(network):
+    if not isinstance(network, Mapping) or set(network) != {"nodes", "edges"}:
+        raise ValueError("network must have exactly 'nodes' and 'edges'")
+    nodes, edges = network["nodes"], network["edges"]
+    if not isinstance(nodes, list) or not isinstance(edges, list):
+        raise ValueError("network nodes and edges must be lists")
+    graph = nx.Graph()
+    for node in nodes:
+        check_id(node, "network node")
+        if node in graph:
+            raise ValueError(f"duplicate network node {node!r}")
+        graph.add_node(node)
+    for edge in edges:
+        if not isinstance(edge, list) or len(edge) != 3:
+            raise ValueError(f"network edge {edge!r} must be [u, v, weight]")
+        u, v, weight = edge
+        for node in (u, v):
+            if not isinstance(node, str) or node not in graph:
+                raise ValueError(f"network edge {edge!r} uses an unknown node")
+        if graph.has_edge(u, v):
+            raise ValueError(f"duplicate network edge {edge!r}")
+        graph.add_edge(u, v, weight=weight)
+    return graph
+
+
+def _plan(args):
+    document = _load_json(args.input)
+    if not isinstance(document, dict) or not (
+        _INPUT_KEYS <= set(document) <= _INPUT_KEYS | _CONTROL_KEYS
+    ):
+        raise ValueError(
+            "input must contain services, hosts and network, and optionally "
+            "path_redundancy and max_parallel"
+        )
+    model = Model(
+        document["services"],
+        document["hosts"],
+        _network_from_json(document["network"]),
+    )
+    plan = compile_plan(
+        model,
+        path_redundancy=document.get("path_redundancy", 1),
+        max_parallel=document.get("max_parallel", 4),
+    )
+    save_json(args.output, plan)
+    return plan
+
+
+def _controller(args):
+    return Controller(
+        _load_json(args.plan), Journal(args.journal), max_attempts=args.max_attempts
+    )
+
+
+def _status(args):
+    return _controller(args).snapshot(args.now)
+
+
+def _claim(args):
+    return _controller(args).claim(args.worker, args.now, args.ttl)
+
+
+def _ack(args):
+    controller = _controller(args)
+    return controller.ack(_load_json(args.lease), args.success, args.now)
+
+
+def _parser():
+    parser = argparse.ArgumentParser(
+        prog="python -m networkx.deployment.cli",
+        description="Plan and drive a failure-domain-aware rollout.",
+    )
+    commands = parser.add_subparsers(dest="command", required=True)
+
+    plan = commands.add_parser("plan", help="compile a model into a plan file")
+    plan.add_argument("input", help="model JSON file")
+    plan.add_argument("output", help="plan JSON file to write")
+    plan.set_defaults(handler=_plan)
+
+    def controller_command(name, handler, summary):
+        command = commands.add_parser(name, help=summary)
+        command.add_argument("plan", help="plan JSON file")
+        command.add_argument("journal", help="journal JSON file")
+        command.set_defaults(handler=handler)
+        return command
+
+    def add_clock(command):
+        command.add_argument("--now", type=int, required=True)
+        command.add_argument("--max-attempts", type=int, default=2)
+
+    status = controller_command("status", _status, "show the rollout state")
+    add_clock(status)
+
+    claim = controller_command("claim", _claim, "lease the next service")
+    claim.add_argument("worker")
+    add_clock(claim)
+    claim.add_argument("--ttl", type=int, required=True)
+
+    ack = controller_command("ack", _ack, "record the outcome of a lease")
+    ack.add_argument("lease", help="lease JSON file")
+    add_clock(ack)
+    outcome = ack.add_mutually_exclusive_group(required=True)
+    outcome.add_argument("--success", dest="success", action="store_true")
+    outcome.add_argument("--failure", dest="success", action="store_false")
+    return parser
+
+
+def main(argv=None):
+    """Run the CLI with `argv` (default ``sys.argv[1:]``) and return the status."""
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as error:
+        return error.code if isinstance(error.code, int) else 2
+    try:
+        output = canonical_json(args.handler(args))
+    except (ValueError, ConflictError, nx.NetworkXException, OSError) as err:
+        print(f"error: {err}", file=sys.stderr)
+        return 2
+    print(output)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
