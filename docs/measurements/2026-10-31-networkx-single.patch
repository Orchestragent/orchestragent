index 0000000..f3bb390
--- /dev/null
+++ b/networkx/deployment/controller.py
@@ -0,0 +1,333 @@
+"""A durable, lease-based rollout controller driven by a :class:`Journal`.
+
+All controller state is reconstructed by replaying the journal, so any
+number of :class:`Controller` objects (in one or several processes) can share
+it. Writes use optimistic compare-and-swap on the journal revision.
+
+Controller events are ordinary journal records. Their IDs are
+``controller/claim/<revision>`` and ``controller/ack/<token>``; their payload
+is a dict pinning the plan id and ``max_attempts``::
+
+    {"controller": 1, "plan": ..., "max_attempts": ..., "action": "claim",
+     "now": ..., "service": ..., "worker": ..., "expires": ...}
+    {"controller": 1, "plan": ..., "max_attempts": ..., "action": "ack",
+     "now": ..., "service": ..., "worker": ..., "token": ..., "expires": ...,
+     "success": ...}
+
+Journal events with other IDs are ignored.
+"""
+
+from collections.abc import Mapping
+
+from networkx.deployment._util import (
+    check_bool,
+    check_id,
+    check_int,
+    is_id,
+    is_int,
+)
+from networkx.deployment.journal import ConflictError, Journal
+from networkx.deployment.planner import _verify_plan
+
+__all__ = ["Controller"]
+
+_PREFIX = "controller/"
+_VERSION = 1
+_CAS_ATTEMPTS = 64
+_LEASE_KEYS = frozenset({"service", "worker", "token", "expires"})
+_CLAIM_KEYS = frozenset({"controller", "plan", "max_attempts", "action", "now"}) | (
+    _LEASE_KEYS - {"token"}
+)
+_ACK_KEYS = _CLAIM_KEYS | {"token", "success"}
+
+
+class _State:
+    """Controller state replayed from a journal document."""
+
+    def __init__(self, revision):
+        self.revision = revision
+        self.clock = None
+        self.attempts = {}
+        self.done = set()
+        self.failed = set()
+        self.leases = {}  # service -> latest unacknowledged lease
+        self.claims = {}  # token -> lease
+        self.acks = {}  # token -> success
+
+
+def _check_lease(lease):
+    if not isinstance(lease, Mapping) or set(lease) != _LEASE_KEYS:
+        raise ValueError("lease must have exactly service, worker, token, expires")
+    check_id(lease["service"], "lease service")
+    check_id(lease["worker"], "lease worker")
+    check_int(lease["token"], "lease token", minimum=1)
+    check_int(lease["expires"], "lease expires")
+    return {key: lease[key] for key in sorted(_LEASE_KEYS)}
+
+
+class Controller:
+    """Hand out and settle rollout work for a compiled plan.
+
+    Parameters
+    ----------
+    plan : dict
+        A plan from :func:`~networkx.deployment.planner.compile_plan`. It is
+        copied and its ``id`` is verified against all other fields.
+    journal : Journal
+        Durable shared state. The constructor only reads it, to reject a
+        journal recorded for a different plan or ``max_attempts``.
+    max_attempts : int
+        How many times a service may be granted before an expired or failed
+        attempt makes it ``failed``.
+    """
+
+    def __init__(self, plan, journal, max_attempts=2):
+        if not isinstance(journal, Journal):
+            raise ValueError(f"expected a Journal, got {type(journal).__name__}")
+        self._max_attempts = check_int(max_attempts, "max_attempts", minimum=1)
+        self._plan = _verify_plan(plan)
+        self._journal = journal
+        self._services = sorted(self._plan["dependencies"])
+        self._load()
+
+    @property
+    def plan(self):
+        return _verify_plan(self._plan)
+
+    @property
+    def max_attempts(self):
+        return self._max_attempts
+
+    # -- replay ---------------------------------------------------------------
+
+    def _load(self):
+        document = self._journal.read()
+        state = _State(document["revision"])
+        state.attempts = dict.fromkeys(self._services, 0)
+        for record in document["events"]:
+            event = record["event"]
+            if event["id"].startswith(_PREFIX):
+                self._apply(state, record["revision"], event)
+        return state
+
+    def _apply(self, state, revision, event):
+        payload = event["payload"]
+        if not isinstance(payload, dict) or payload.get("controller") != _VERSION:
+            raise ValueError(f"malformed controller event at revision {revision}")
+        if payload.get("plan") != self._plan["id"]:
+            raise ValueError("journal was recorded for a different plan")
+        if payload.get("max_attempts") != self._max_attempts:
+            raise ValueError("journal was recorded with a different max_attempts")
+        action = payload.get("action")
+        keys = {"claim": _CLAIM_KEYS, "ack": _ACK_KEYS}.get(action)
+        if keys is None or set(payload) != keys:
+            raise ValueError(f"malformed controller event at revision {revision}")
+        now = payload["now"]
+        service = payload["service"]
+        if (
+            not is_int(now)
+            or now < 0
+            or (state.clock is not None and now < state.clock)
+            or not is_id(service)
+            or service not in state.attempts
+            or not is_id(payload["worker"])
+            or not is_int(payload["expires"])
+        ):
+            raise ValueError(f"inconsistent controller event at revision {revision}")
+        state.clock = now
+        corrupt = ValueError(f"inconsistent controller event at revision {revision}")
+
+        if action == "claim":
+            current = state.leases.get(service)
+            if (
+                event["id"] != f"{_PREFIX}claim/{revision}"
+                or service in state.done
+                or service in state.failed
+                or (current is not None and now < current["expires"])
+                or state.attempts[service] >= self._max_attempts
+            ):
+                raise corrupt
+            lease = {
+                "service": service,
+                "worker": payload["worker"],
+                "token": revision,
+                "expires": payload["expires"],
+            }
+            state.attempts[service] += 1
+            state.leases[service] = lease
+            state.claims[revision] = lease
+        else:
+            token = payload["token"]
+            lease = state.claims.get(token) if is_int(token) else None
+            if (
+                event["id"] != f"{_PREFIX}ack/{token}"
+                or lease is None
+                or token in state.acks
+                or state.leases.get(service) is not lease
+                or lease["worker"] != payload["worker"]
+                or lease["expires"] != payload["expires"]
+                or now >= lease["expires"]
+                or not isinstance(payload["success"], bool)
+            ):
+                raise corrupt
+            state.acks[token] = payload["success"]
+            del state.leases[service]
+            if payload["success"]:
+                state.done.add(service)
+            elif state.attempts[service] >= self._max_attempts:
+                state.failed.add(service)
+
+    def _states(self, state, now):
+        """Return the status of every service at time `now`."""
+        dependencies = self._plan["dependencies"]
+        states = {}
+        for batch in self._plan["batches"]:
+            for service in batch:
+                lease = state.leases.get(service)
+                if service in state.done:
+                    status = "done"
+                elif service in state.failed:
+                    status = "failed"
+                elif lease is not None and now < lease["expires"]:
+                    status = "leased"
+                elif state.attempts[service] >= self._max_attempts:
+                    status = "failed"
+                elif any(
+                    states[p] in ("failed", "blocked") for p in dependencies[service]
+                ):
+                    status = "blocked"
+                else:
+                    status = "pending"
+                states[service] = status
+        return {service: states[service] for service in self._services}
+
+    def _active_leases(self, state, now):
+        return {
+            service: dict(lease)
+            for service, lease in sorted(state.leases.items())
+            if now < lease["expires"]
+        }
+
+    def _check_clock(self, state, now):
+        if state.clock is not None and now < state.clock:
+            raise ValueError(
+                f"now={now} is older than the last controller action at {state.clock}"
+            )
+
+    def _payload(self, action, now, **fields):
+        return {
+            "controller": _VERSION,
+            "plan": self._plan["id"],
+            "max_attempts": self._max_attempts,
+            "action": action,
+            "now": now,
+            **fields,
+        }
+
+    # -- public API -----------------------------------------------------------
+
+    def snapshot(self, now):
+        """Return ``{"states", "attempts", "leases", "revision"}`` at `now`.
+
+        ``states`` and ``attempts`` cover every service in lexical order;
+        ``leases`` maps services to their active, unexpired leases.
+        """
+        now = check_int(now, "now")
+        state = self._load()
+        return {
+            "states": self._states(state, now),
+            "attempts": dict(state.attempts),
+            "leases": self._active_leases(state, now),
+            "revision": state.revision,
+        }
+
+    def claim(self, worker, now, ttl):
+        """Lease the next available service to `worker`, or return None.
+
+        A worker that already holds an unexpired lease gets that same lease
+        back without a write. Otherwise the lexically first available service
+        of the earliest batch with unfinished services is granted until
+        ``now + ttl``; its token is the journal revision of the grant.
+        """
+        worker = check_id(worker, "worker")
+        now = check_int(now, "now")
+        ttl = check_int(ttl, "ttl", minimum=1)
+        dependencies = self._plan["dependencies"]
+        for _ in range(_CAS_ATTEMPTS):
+            state = self._load()
+            self._check_clock(state, now)
+            for lease in self._active_leases(state, now).values():
+                if lease["worker"] == worker:
+                    return lease
+            states = self._states(state, now)
+            service = None
+            for batch in self._plan["batches"]:
+                if all(states[s] in ("done", "failed", "blocked") for s in batch):
+                    continue
+                service = next(
+                    (
+                        s
+                        for s in sorted(batch)
+                        if states[s] == "pending"
+                        and all(states[p] == "done" for p in dependencies[s])
+                    ),
+                    None,
+                )
+                break
+            if service is None:
+                return None
+            expires = now + ttl
+            payload = self._payload(
+                "claim", now, service=service, worker=worker, expires=expires
+            )
+            event = {"id": f"{_PREFIX}claim/{state.revision + 1}", "payload": payload}
+            try:
+                token = self._journal.append(state.revision, event)
+            except ConflictError:
+                continue
+            return {
+                "service": service,
+                "worker": worker,
+                "token": token,
+                "expires": expires,
+            }
+        raise ConflictError("too much contention while claiming; retry")
+
+    def ack(self, lease, success, now):
+        """Record the outcome of a lease.
+
+        Returns True when the decision is recorded, or False when exactly
+        this decision was already recorded for this lease. Stale, forged,
+        expired or contradicting acknowledgements raise ConflictError.
+        """
+        lease = _check_lease(lease)
+        success = check_bool(success, "success")
+        now = check_int(now, "now")
+        token = lease["token"]
+        for _ in range(_CAS_ATTEMPTS):
+            state = self._load()
+            if state.claims.get(token) != lease:
+                raise ConflictError("lease does not match a recorded grant")
+            if token in state.acks:
+                if state.acks[token] == success:
+                    return False
+                raise ConflictError("a different decision was already recorded")
+            self._check_clock(state, now)
+            if now >= lease["expires"]:
+                raise ConflictError("lease has expired")
+            payload = self._payload(
+                "ack",
+                now,
+                service=lease["service"],
+                worker=lease["worker"],
+                token=token,
+                expires=lease["expires"],
+                success=success,
+            )
+            event = {"id": f"{_PREFIX}ack/{token}", "payload": payload}
+            try:
+                revision = self._journal.append(state.revision, event)
+            except ConflictError:
+                continue
+            return revision == state.revision + 1
+        raise ConflictError("too much contention while acknowledging; retry")
