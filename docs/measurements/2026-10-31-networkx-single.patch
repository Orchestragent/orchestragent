index 0000000..e57e296
--- /dev/null
+++ b/test_r8_behavior.py
@@ -0,0 +1,89 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from networkx.deployment.cli import main
+
+INPUT = {
+    "services": {
+        "db": {"replicas": 2, "requires": [], "allowed_zones": None, "costs": {"a": 1, "b": 2}},
+        "web": {"replicas": 1, "requires": ["db"], "allowed_zones": None, "costs": {"a": 0, "b": 0}},
+    },
+    "hosts": {"a": {"zone": "za", "slots": 2}, "b": {"zone": "zb", "slots": 1}},
+    "network": {"nodes": ["a", "b"], "edges": [["a", "b", 3]]},
+    "max_parallel": 2,
+}
+
+
+class TestR8Behavior(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def file(self, name, value=None):
+        path = os.path.join(self.dir, name)
+        if value is not None:
+            with open(path, "w", encoding="utf-8") as handle:
+                json.dump(value, handle)
+        return path
+
+    def run_cli(self, *argv):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            code = main(list(argv))
+        result = json.loads(out.getvalue()) if code == 0 else None
+        return code, result, err.getvalue()
+
+    def test_plan_and_controller_flow(self):
+        model, plan_path = self.file("in.json", INPUT), self.file("plan.json")
+        code, plan, _ = self.run_cli("plan", model, plan_path)
+        self.assertEqual(code, 0)
+        with open(plan_path, encoding="utf-8") as handle:
+            self.assertEqual(json.load(handle), plan)
+        self.assertEqual(plan["placements"], {"db": ["a", "b"], "web": ["a"]})
+        self.assertEqual(plan["batches"], [["db"], ["web"]])
+
+        journal = self.file("journal.json")
+        code, lease, _ = self.run_cli("claim", plan_path, journal, "w1", "--now", "1", "--ttl", "5")
+        self.assertEqual(code, 0)
+        self.assertEqual(lease["service"], "db")
+        lease_path = self.file("lease.json", lease)
+        args = ("ack", plan_path, journal, lease_path, "--now", "2", "--success")
+        self.assertEqual(self.run_cli(*args)[:2], (0, True))
+        self.assertEqual(self.run_cli(*args)[:2], (0, False))
+        code, snap, _ = self.run_cli("status", plan_path, journal, "--now", "3")
+        self.assertEqual(snap["states"], {"db": "done", "web": "pending"})
+        code, _, err = self.run_cli("status", plan_path, journal, "--now", "3", "--max-attempts", "3")
+        self.assertEqual(code, 2)
+        self.assertTrue(err)
+        code, _, _ = self.run_cli(
+            "ack", plan_path, journal, lease_path, "--now", "3", "--failure"
+        )
+        self.assertEqual(code, 2)
+        code, result, _ = self.run_cli("claim", plan_path, journal, "w2", "--now", "4", "--ttl", "1")
+        self.assertEqual(result["service"], "web")
+
+    def test_invalid_input_preserves_output(self):
+        output = self.file("plan.json", {"keep": True})
+        bad = dict(INPUT, max_parallel=0)
+        code, _, err = self.run_cli("plan", self.file("bad.json", bad), output)
+        self.assertEqual(code, 2)
+        self.assertTrue(err)
+        infeasible = dict(INPUT, path_redundancy=2)
+        self.assertEqual(self.run_cli("plan", self.file("x.json", infeasible), output)[0], 2)
+        missing = os.path.join(self.dir, "missing.json")
+        self.assertEqual(self.run_cli("plan", missing, output)[0], 2)
+        with open(output, encoding="utf-8") as handle:
+            self.assertEqual(json.load(handle), {"keep": True})
+        self.assertEqual(self.run_cli("bogus")[0], 2)
+        self.assertEqual(self.run_cli("ack", "p", "j", "l", "--now", "1")[0], 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
