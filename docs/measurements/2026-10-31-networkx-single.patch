@@ -0,0 +1,91 @@
+import hashlib
+import unittest
+
+import networkx as nx
+from networkx.deployment.model import Model, canonical_json
+from networkx.deployment.planner import compile_plan
+from networkx.deployment.routing import route
+
+
+def build_model():
+    hosts = {
+        "a1": {"zone": "a", "slots": 2},
+        "b1": {"zone": "b", "slots": 2},
+        "c1": {"zone": "c", "slots": 2},
+    }
+    zero = dict.fromkeys(hosts, 0)
+    services = {
+        "db": {"replicas": 2, "requires": [], "allowed_zones": ["a", "b"], "costs": zero},
+        "api": {
+            "replicas": 1,
+            "requires": ["db"],
+            "allowed_zones": None,
+            "costs": {"a1": 0, "b1": 5, "c1": 5},
+        },
+        "web": {"replicas": 1, "requires": ["api"], "allowed_zones": ["c"], "costs": zero},
+    }
+    network = nx.Graph()
+    network.add_weighted_edges_from(
+        [("a1", "b1", 1), ("b1", "c1", 1), ("a1", "r", 1), ("r", "c1", 1), ("a1", "c1", 5)]
+    )
+    return Model(services, hosts, network)
+
+
+class TestR6Behavior(unittest.TestCase):
+    def test_plan_fields_and_id(self):
+        model = build_model()
+        plan = compile_plan(model, path_redundancy=2, max_parallel=4)
+        self.assertEqual(
+            set(plan),
+            {
+                "schema",
+                "id",
+                "deployment",
+                "dependencies",
+                "placements",
+                "cost",
+                "batches",
+                "routes",
+                "path_redundancy",
+                "max_parallel",
+            },
+        )
+        rest = {k: v for k, v in plan.items() if k != "id"}
+        self.assertEqual(
+            plan["id"], hashlib.sha256(canonical_json(rest).encode("utf-8")).hexdigest()
+        )
+        self.assertEqual(plan["schema"], 1)
+        self.assertEqual(plan["deployment"], model.fingerprint)
+        self.assertEqual(plan["dependencies"], {"api": ["db"], "db": [], "web": ["api"]})
+        self.assertEqual(plan["placements"], {"api": ["a1"], "db": ["a1", "b1"], "web": ["c1"]})
+        self.assertEqual(plan["cost"], 0)
+        self.assertEqual(plan["batches"], [["db"], ["api"], ["web"]])
+        keys = [(r["producer"], r["consumer"], r["source"], r["target"]) for r in plan["routes"]]
+        self.assertEqual(
+            keys,
+            [("api", "web", "a1", "c1"), ("db", "api", "a1", "a1"), ("db", "api", "b1", "a1")],
+        )
+        for record in plan["routes"]:
+            self.assertEqual(set(record), {"producer", "consumer", "source", "target", "paths"})
+            self.assertEqual(
+                record["paths"], route(model, record["source"], record["target"], k=2)
+            )
+        self.assertEqual(plan["routes"][1]["paths"], [["a1"]])
+        self.assertEqual(compile_plan(model, 2, 4), plan)
+
+    def test_controls_and_infeasibility(self):
+        empty = Model({}, {}, nx.Graph())
+        plan = compile_plan(empty)
+        self.assertEqual(plan["batches"], [])
+        self.assertEqual(plan["routes"], [])
+        for kwargs in ({"path_redundancy": 0}, {"max_parallel": True}, {"max_parallel": 1.5}):
+            with self.assertRaises(ValueError):
+                compile_plan(empty, **kwargs)
+        with self.assertRaises(nx.NetworkXUnfeasible):
+            compile_plan(build_model(), path_redundancy=3)
+        with self.assertRaises(ValueError):
+            compile_plan(build_model(), max_parallel=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
