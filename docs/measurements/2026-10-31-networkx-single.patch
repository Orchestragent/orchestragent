+import unittest
+
+import networkx as nx
+from networkx.deployment.model import Model
+from networkx.deployment.routing import route
+
+
+def model_with(edges):
+    network = nx.Graph()
+    network.add_weighted_edges_from(edges)
+    return Model({}, {}, network)
+
+
+class TestR3Behavior(unittest.TestCase):
+    def test_disjoint_paths_minimize_total_weight(self):
+        # The single shortest path s-a-b-t blocks two disjoint paths if
+        # chosen greedily; the optimal pair is s-a-t and s-b-t.
+        model = model_with(
+            [
+                ("s", "a", 1),
+                ("a", "b", 1),
+                ("b", "t", 1),
+                ("a", "t", 3),
+                ("s", "b", 3),
+            ]
+        )
+        self.assertEqual(route(model, "s", "t"), [["s", "a", "b", "t"]])
+        paths = route(model, "s", "t", k=2)
+        self.assertEqual(paths, [["s", "a", "t"], ["s", "b", "t"]])
+        with self.assertRaises(nx.NetworkXUnfeasible):
+            route(model, "s", "t", k=3)
+
+    def test_paths_are_simple_and_edge_disjoint(self):
+        G = nx.circular_ladder_graph(6)
+        edges = [(f"n{u}", f"n{v}", 1 + (u * v) % 4) for u, v in G.edges]
+        model = model_with(edges)
+        network = model.network
+        paths = route(model, "n0", "n3", k=3)
+        self.assertEqual(paths, sorted(paths))
+        used = set()
+        total = 0
+        for path in paths:
+            self.assertEqual(len(path), len(set(path)))
+            self.assertEqual((path[0], path[-1]), ("n0", "n3"))
+            for u, v in zip(path, path[1:]):
+                edge = frozenset((u, v))
+                self.assertNotIn(edge, used)
+                used.add(edge)
+                total += network.edges[u, v]["weight"]
+        expected = nx.min_cost_flow_cost(self._flow_graph(network, "n0", "n3", 3))
+        self.assertEqual(total, expected)
+
+    @staticmethod
+    def _flow_graph(network, source, target, k):
+        D = nx.DiGraph()
+        for u, v, w in network.edges(data="weight"):
+            D.add_edge(u, v, capacity=1, weight=w)
+            D.add_edge(v, u, capacity=1, weight=w)
+        D.nodes[source]["demand"] = -k
+        D.nodes[target]["demand"] = k
+        return D
+
+    def test_local_route_and_validation(self):
+        model = model_with([("x", "y", 2)])
+        self.assertEqual(route(model, "x", "x", k=5), [["x"]])
+        for k in (0, -1, True, 1.0, "1"):
+            with self.assertRaises(ValueError):
+                route(model, "x", "y", k=k)
+        with self.assertRaises(ValueError):
+            route(model, "x", "missing")
+        with self.assertRaises(ValueError):
+            route(model, None, "x")
+        fingerprint = model.fingerprint
+        route(model, "x", "y")
+        self.assertEqual(model.fingerprint, fingerprint)
+
+    def test_disconnected_is_unfeasible(self):
+        network = nx.Graph()
+        network.add_nodes_from(["p", "q"])
+        with self.assertRaises(nx.NetworkXUnfeasible):
+            route(Model({}, {}, network), "p", "q")
+
+
+if __name__ == "__main__":
+    unittest.main()
