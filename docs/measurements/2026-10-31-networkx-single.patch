+import copy
+import unittest
+
+import networkx as nx
+from networkx.deployment.batches import rollout_batches
+from networkx.deployment.model import Model
+from networkx.deployment.placement import place
+
+
+def service(replicas, requires=(), costs=None):
+    return {
+        "replicas": replicas,
+        "requires": list(requires),
+        "allowed_zones": None,
+        "costs": costs,
+    }
+
+
+def build():
+    hosts = {f"h{i}": {"zone": f"z{i}", "slots": 3} for i in range(1, 5)}
+    zero = dict.fromkeys(hosts, 0)
+    services = {
+        "a": service(2, costs=zero),
+        "b": service(3, costs=zero),
+        "c": service(1, ["a"], zero),
+        "d": service(1, costs=zero),
+        "e": service(2, ["c"], zero),
+    }
+    network = nx.Graph()
+    network.add_nodes_from(hosts)
+    return Model(services, hosts, network)
+
+
+class TestR4Behavior(unittest.TestCase):
+    placements = {
+        "a": ["h1", "h2"],
+        "b": ["h2", "h3", "h4"],
+        "c": ["h1"],
+        "d": ["h4"],
+        "e": ["h1", "h4"],
+    }
+
+    def test_scan_defers_nonfitting_services(self):
+        model = build()
+        placements = copy.deepcopy(self.placements)
+        batches = rollout_batches(model, placements, max_parallel=3)
+        # Batch 1: a (2), b does not fit, d (1). Batch 2: b (3). Then c and e.
+        self.assertEqual(batches, [["a", "d"], ["b"], ["c"], ["e"]])
+        self.assertEqual(placements, self.placements)
+
+    def test_host_conflicts_and_wide_batches(self):
+        model = build()
+        batches = rollout_batches(model, self.placements, max_parallel=10)
+        # b shares h2 with a, so it waits; c (on h1) then joins b.
+        self.assertEqual(batches, [["a", "d"], ["b", "c"], ["e"]])
+
+    def test_accepts_place_result(self):
+        model = build()
+        result = place(model)
+        batches = rollout_batches(model, result)
+        self.assertEqual(sorted(s for batch in batches for s in batch), list("abcde"))
+
+    def test_validation(self):
+        model = build()
+        bad = []
+        for change in (
+            lambda p: p.pop("a"),
+            lambda p: p.update(a=["h1"]),
+            lambda p: p.update(a=["h1", "h1"]),
+            lambda p: p.update(a=["h1", "nope"]),
+            lambda p: p.update(z=["h1"]),
+            lambda p: p.update(a="h1"),
+        ):
+            placements = copy.deepcopy(self.placements)
+            change(placements)
+            bad.append(placements)
+        for placements in bad:
+            with self.assertRaises(ValueError):
+                rollout_batches(model, placements)
+        for max_parallel in (0, True, 2.0):
+            with self.assertRaises(ValueError):
+                rollout_batches(model, self.placements, max_parallel)
+        with self.assertRaises(ValueError):
+            rollout_batches(model, self.placements, max_parallel=2)
+
+        hosts = {
+            "a1": {"zone": "a", "slots": 1},
+            "a2": {"zone": "a", "slots": 1},
+            "b1": {"zone": "b", "slots": 1},
+        }
+        costs = dict.fromkeys(hosts, 0)
+        network = nx.Graph()
+        network.add_nodes_from(hosts)
+        spec = {
+            "s": {
+                "replicas": 2,
+                "requires": [],
+                "allowed_zones": ["a", "b"],
+                "costs": costs,
+            },
+            "t": {"replicas": 1, "requires": [], "allowed_zones": ["b"], "costs": costs},
+        }
+        small = Model(spec, hosts, network)
+        for placements in (
+            {"s": ["a1", "a2"], "t": ["b1"]},  # same zone
+            {"s": ["a1", "b1"], "t": ["b1"]},  # host capacity
+            {"s": ["a1", "b1"], "t": ["a2"]},  # zone not allowed
+        ):
+            with self.assertRaises(ValueError):
+                rollout_batches(small, placements)
+        with self.assertRaises(ValueError):  # wrong cost in a place() result
+            rollout_batches(small, {"placements": {"s": ["a1", "b1"]}, "cost": 0})
+
+    def test_empty(self):
+        self.assertEqual(rollout_batches(Model({}, {}, nx.Graph()), {}), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
