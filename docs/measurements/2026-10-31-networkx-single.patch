+++ b/networkx/deployment/routing.py
@@ -0,0 +1,78 @@
+"""Minimum-weight sets of edge-disjoint network paths."""
+
+import networkx as nx
+from networkx.deployment._util import check_int
+from networkx.deployment.placement import _check_model
+
+__all__ = ["route"]
+
+
+def _check_endpoint(graph, node, what):
+    if not isinstance(node, str) or node not in graph:
+        raise ValueError(f"{what} {node!r} is not a network node")
+
+
+def route(model, source, target, k=1):
+    """Return `k` edge-disjoint `source`-`target` paths of minimum total weight.
+
+    Each undirected network edge becomes two opposite unit-capacity arcs, and
+    :func:`networkx.min_cost_flow` sends `k` units from `source` to `target`.
+    Because all weights are positive, an optimal flow never uses both arcs of
+    an edge and contains no cycles, so it decomposes into `k` simple paths
+    that share no undirected edge.
+
+    Returns
+    -------
+    list of lists
+        The node paths, sorted lexicographically. A local route
+        (``source == target``) is ``[[source]]`` regardless of `k`.
+
+    Raises
+    ------
+    ValueError
+        If an endpoint is not a network node or `k` is not a positive int.
+    NetworkXUnfeasible
+        If fewer than `k` edge-disjoint paths exist.
+    """
+    _check_model(model)
+    k = check_int(k, "k", minimum=1)
+    graph = model._graph
+    _check_endpoint(graph, source, "source")
+    _check_endpoint(graph, target, "target")
+    if source == target:
+        return [[source]]
+
+    G = nx.DiGraph()
+    G.add_nodes_from(graph)
+    for u, v, weight in graph.edges(data="weight"):
+        G.add_edge(u, v, capacity=1, weight=weight)
+        G.add_edge(v, u, capacity=1, weight=weight)
+    G.nodes[source]["demand"] = -k
+    G.nodes[target]["demand"] = k
+    flow = nx.min_cost_flow(G)
+
+    successors = {}
+    for u, targets in flow.items():
+        for v, units in targets.items():
+            if units and not flow[v][u]:
+                successors.setdefault(u, []).append(v)
+    for nodes in successors.values():
+        nodes.sort(reverse=True)
+
+    paths = []
+    for _ in range(k):
+        path = [source]
+        position = {source: 0}
+        while path[-1] != target:
+            node = successors[path[-1]].pop()
+            if node in position:
+                # Optimal flows are acyclic; drop a cycle rather than repeat it.
+                for dropped in path[position[node] + 1 :]:
+                    del position[dropped]
+                del path[position[node] + 1 :]
+            else:
+                position[node] = len(path)
+                path.append(node)
+        paths.append(path)
+    paths.sort()
+    return paths
