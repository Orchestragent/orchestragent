index 0000000..5d62cce
--- /dev/null
+++ b/networkx/deployment/placement.py
@@ -0,0 +1,90 @@
+"""Globally cost-optimal, zone-spread replica placement."""
+
+import networkx as nx
+from networkx.deployment.model import Model
+
+__all__ = ["place"]
+
+_SINK = ("sink",)
+
+
+def _check_model(model):
+    if not isinstance(model, Model):
+        raise ValueError(f"expected a deployment Model, got {type(model).__name__}")
+
+
+def place(model):
+    """Place every service's replicas on hosts at minimum total cost.
+
+    Each service gets exactly ``replicas`` distinct hosts, at most one per
+    failure zone and only in its allowed zones, and no host receives more
+    replicas (over all services) than its slots. The total cost is minimized
+    globally with :func:`networkx.min_cost_flow` on the network::
+
+        service -> (service, zone) -> host -> sink
+
+    where the service/zone arcs have capacity 1 (zone spreading), zone/host
+    arcs cost the service's host cost, and host/sink arcs carry the slots.
+
+    Returns
+    -------
+    dict
+        ``{"placements": {service: sorted_hosts}, "cost": int}`` with every
+        service present in lexical order.
+
+    Raises
+    ------
+    NetworkXUnfeasible
+        If not all replicas can be placed.
+    """
+    _check_model(model)
+    services = model._services
+    hosts = model._hosts
+    if not services:
+        return {"placements": {}, "cost": 0}
+
+    zone_hosts = {}
+    for host, spec in hosts.items():
+        if spec["slots"] > 0:
+            zone_hosts.setdefault(spec["zone"], []).append(host)
+
+    G = nx.DiGraph()
+    total = 0
+    for service, spec in services.items():
+        total += spec["replicas"]
+        G.add_node(("service", service), demand=-spec["replicas"])
+        zones = spec["allowed_zones"]
+        if zones is None:
+            zones = sorted(zone_hosts)
+        for zone in zones:
+            if zone not in zone_hosts:
+                continue
+            spread = ("zone", service, zone)
+            G.add_edge(("service", service), spread, capacity=1, weight=0)
+            for host in zone_hosts[zone]:
+                G.add_edge(
+                    spread, ("host", host), capacity=1, weight=spec["costs"][host]
+                )
+    for host in hosts:
+        if ("host", host) in G:
+            G.add_edge(("host", host), _SINK, capacity=hosts[host]["slots"], weight=0)
+    G.add_node(_SINK, demand=total)
+
+    flow = nx.min_cost_flow(G)
+
+    placements = {}
+    cost = 0
+    for service, spec in services.items():
+        chosen = [
+            host_node[1]
+            for spread, used in flow[("service", service)].items()
+            if used
+            for host_node, units in flow[spread].items()
+            if units
+        ]
+        if len(chosen) != spec["replicas"]:  # pragma: no cover - flow invariant
+            raise nx.NetworkXUnfeasible(f"cannot place service {service!r}")
+        chosen.sort()
+        placements[service] = chosen
+        cost += sum(spec["costs"][host] for host in chosen)
+    return {"placements": placements, "cost": cost}
diff --git a/networkx/deployment/planner.py b/networkx/deployment/planner.py
new file mode 100644
index 0000000..d1a2b2a
--- /dev/null
+++ b/networkx/deployment/planner.py
@@ -0,0 +1,156 @@
+"""Compile a model into a self-verifying deployment plan."""
+
+from collections.abc import Mapping
+
+from networkx.deployment._util import check_int, digest, is_id, is_int, normalize
+from networkx.deployment.batches import rollout_batches
+from networkx.deployment.placement import _check_model, place
+from networkx.deployment.routing import route
+
+__all__ = ["compile_plan"]
+
+_SCHEMA = 1
+_PLAN_KEYS = frozenset(
+    {
+        "schema",
+        "id",
+        "deployment",
+        "dependencies",
+        "placements",
+        "cost",
+        "batches",
+        "routes",
+        "path_redundancy",
+        "max_parallel",
+    }
+)
+
+
+def _plan_id(plan):
+    return digest({key: value for key, value in plan.items() if key != "id"})
+
+
+def compile_plan(model, path_redundancy=1, max_parallel=4):
+    """Return a complete deployment plan for `model`.
+
+    The plan combines :func:`~networkx.deployment.placement.place`,
+    :func:`~networkx.deployment.batches.rollout_batches` and, for every
+    direct dependency and every pair of producer/consumer hosts,
+    :func:`~networkx.deployment.routing.route` with ``k=path_redundancy``.
+
+    Returns
+    -------
+    dict
+        With exactly the keys ``schema`` (1), ``id`` (SHA-256 of the
+        canonical JSON of all other fields), ``deployment`` (the model
+        fingerprint), ``dependencies``, ``placements``, ``cost``,
+        ``batches``, ``routes``, ``path_redundancy`` and ``max_parallel``.
+
+    Raises
+    ------
+    ValueError
+        For invalid controls or a model that cannot be batched.
+    NetworkXUnfeasible
+        If placement or any route is infeasible.
+    """
+    _check_model(model)
+    path_redundancy = check_int(path_redundancy, "path_redundancy", minimum=1)
+    max_parallel = check_int(max_parallel, "max_parallel", minimum=1)
+
+    placed = place(model)
+    placements = placed["placements"]
+    batches = rollout_batches(model, placed, max_parallel)
+    dependencies = {
+        service: list(spec["requires"]) for service, spec in model._services.items()
+    }
+
+    paths = {}
+    routes = []
+    for consumer, producers in dependencies.items():
+        for producer in producers:
+            for source in placements[producer]:
+                for target in placements[consumer]:
+                    if (source, target) not in paths:
+                        paths[source, target] = route(
+                            model, source, target, k=path_redundancy
+                        )
+                    routes.append(
+                        {
+                            "producer": producer,
+                            "consumer": consumer,
+                            "source": source,
+                            "target": target,
+                            "paths": [list(p) for p in paths[source, target]],
+                        }
+                    )
+    routes.sort(
+        key=lambda r: (r["producer"], r["consumer"], r["source"], r["target"])
+    )
+
+    plan = {
+        "schema": _SCHEMA,
+        "deployment": model.fingerprint,
+        "dependencies": dependencies,
+        "placements": placements,
+        "cost": placed["cost"],
+        "batches": batches,
+        "routes": routes,
+        "path_redundancy": path_redundancy,
+        "max_parallel": max_parallel,
+    }
+    plan["id"] = _plan_id(plan)
+    return {key: plan[key] for key in sorted(plan)}
+
+
+def _verify_plan(plan):
+    """Return a normalized copy of a compiled `plan`, checking its integrity.
+
+    Raises ValueError unless `plan` has exactly the plan fields, a matching
+    ``id`` and a consistent dependency/batch structure.
+    """
+    if not isinstance(plan, Mapping) or set(plan) != _PLAN_KEYS:
+        raise ValueError("plan must have exactly the compiled plan fields")
+    plan = normalize(plan)
+    if not is_int(plan["schema"]) or plan["schema"] != _SCHEMA:
+        raise ValueError(f"unsupported plan schema {plan['schema']!r}")
+    if not isinstance(plan["id"], str) or plan["id"] != _plan_id(plan):
+        raise ValueError("plan id does not match its contents")
+    check_int(plan["path_redundancy"], "plan path_redundancy", minimum=1)
+    check_int(plan["max_parallel"], "plan max_parallel", minimum=1)
+    check_int(plan["cost"], "plan cost")
+
+    dependencies = plan["dependencies"]
+    if not isinstance(dependencies, dict):
+        raise ValueError("plan dependencies must be a dict")
+    for service, requires in dependencies.items():
+        if not is_id(service) or not isinstance(requires, list):
+            raise ValueError(f"plan dependencies of {service!r} are malformed")
+        if any(not is_id(p) or p not in dependencies or p == service for p in requires):
+            raise ValueError(f"plan dependencies of {service!r} are inconsistent")
+    if not isinstance(plan["placements"], dict) or set(plan["placements"]) != set(
+        dependencies
+    ):
+        raise ValueError("plan placements do not match its services")
+
+    batches = plan["batches"]
+    if not isinstance(batches, list):
+        raise ValueError("plan batches must be a list")
+    completed = set()
+    for batch in batches:
+        if not isinstance(batch, list) or not batch:
+            raise ValueError("plan batches must be nonempty lists")
+        current = set()
+        for service in batch:
+            if not is_id(service) or service not in dependencies:
+                raise ValueError(f"plan batch entry {service!r} is unknown")
+            if service in completed or service in current:
+                raise ValueError(f"plan batches {service!r} twice")
+            if not completed.issuperset(dependencies[service]):
+                raise ValueError(f"plan batches {service!r} before a prerequisite")
+            current.add(service)
+        completed |= current
+    if completed != set(dependencies):
+        raise ValueError("plan batches do not cover every service")
+    if not isinstance(plan["routes"], list):
+        raise ValueError("plan routes must be a list")
+    return plan
