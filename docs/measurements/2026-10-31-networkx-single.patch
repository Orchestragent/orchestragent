+++ b/networkx/deployment/batches.py
@@ -0,0 +1,125 @@
+"""Dependency- and host-aware grouping of services into rollout batches."""
+
+from collections.abc import Mapping
+
+from networkx.deployment._util import check_int, is_id, is_int
+from networkx.deployment.placement import _check_model
+
+__all__ = ["rollout_batches"]
+
+
+def _unwrap(placements):
+    """Accept either ``{service: hosts}`` or the full result of `place`."""
+    if (
+        isinstance(placements, Mapping)
+        and set(placements) == {"placements", "cost"}
+        and isinstance(placements["placements"], Mapping)
+    ):
+        return placements["placements"], placements["cost"]
+    return placements, None
+
+
+def _validate_placements(model, placements):
+    """Return a normalized copy of a complete, feasible placement."""
+    services = model._services
+    hosts = model._hosts
+    placements, cost = _unwrap(placements)
+    if not isinstance(placements, Mapping):
+        raise ValueError("placements must map service IDs to host lists")
+    if set(placements) != set(services):
+        raise ValueError("placements must contain exactly the model's services")
+    load = dict.fromkeys(hosts, 0)
+    result = {}
+    total = 0
+    for service, spec in services.items():
+        chosen = placements[service]
+        what = f"placement of service {service!r}"
+        if not isinstance(chosen, list | tuple):
+            raise ValueError(f"{what} must be a list of host IDs")
+        for host in chosen:
+            if not is_id(host) or host not in hosts:
+                raise ValueError(f"{what} uses unknown host {host!r}")
+        if len(set(chosen)) != len(chosen):
+            raise ValueError(f"{what} repeats a host")
+        if len(chosen) != spec["replicas"]:
+            raise ValueError(f"{what} must have exactly {spec['replicas']} hosts")
+        zones = [hosts[host]["zone"] for host in chosen]
+        if len(set(zones)) != len(zones):
+            raise ValueError(f"{what} puts two replicas in one zone")
+        allowed = spec["allowed_zones"]
+        if allowed is not None and not set(zones) <= set(allowed):
+            raise ValueError(f"{what} uses a zone that is not allowed")
+        for host in chosen:
+            load[host] += 1
+        total += sum(spec["costs"][host] for host in chosen)
+        result[service] = sorted(chosen)
+    for host, used in load.items():
+        if used > hosts[host]["slots"]:
+            raise ValueError(f"host {host!r} exceeds its {hosts[host]['slots']} slots")
+    if cost is not None and (not is_int(cost) or cost != total):
+        raise ValueError(f"placement cost {cost!r} does not match {total}")
+    return result
+
+
+def rollout_batches(model, placements, max_parallel=4):
+    """Group services into ordered rollout batches.
+
+    All replicas of a service move together. Each batch scans the services
+    whose prerequisites completed in earlier batches, in lexical order, and
+    admits a service if its replica count fits in what remains of
+    `max_parallel` and none of its hosts is already used by the batch.
+    Services that do not fit are deferred without blocking later ones.
+
+    Parameters
+    ----------
+    model : Model
+    placements : dict
+        Either ``{service: hosts}`` or the result of
+        :func:`~networkx.deployment.placement.place`. It must be complete
+        and feasible for `model`.
+    max_parallel : int
+        Positive bound on the number of replicas moved per batch.
+
+    Returns
+    -------
+    list of lists of service IDs
+
+    Raises
+    ------
+    ValueError
+        For an invalid placement or `max_parallel`, or if a service has more
+        replicas than `max_parallel`.
+    """
+    _check_model(model)
+    max_parallel = check_int(max_parallel, "max_parallel", minimum=1)
+    placements = _validate_placements(model, placements)
+    services = model._services
+    for service, spec in services.items():
+        if spec["replicas"] > max_parallel:
+            raise ValueError(
+                f"service {service!r} has {spec['replicas']} replicas, more than "
+                f"max_parallel={max_parallel}"
+            )
+
+    completed = set()
+    remaining = sorted(services)
+    batches = []
+    while remaining:
+        budget = max_parallel
+        busy = set()
+        batch = []
+        for service in remaining:
+            if not completed.issuperset(services[service]["requires"]):
+                continue
+            replicas = services[service]["replicas"]
+            if replicas > budget or busy.intersection(placements[service]):
+                continue
+            batch.append(service)
+            budget -= replicas
+            busy.update(placements[service])
+        # The model is acyclic and every service fits an empty batch, so the
+        # lexically first ready service is always admitted.
+        completed.update(batch)
+        remaining = [service for service in remaining if service not in completed]
+        batches.append(batch)
+    return batches
diff --git a/networkx/deployment/cli.py b/networkx/deployment/cli.py
