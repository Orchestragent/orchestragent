--- /dev/null
+++ b/test_r7_behavior.py
@@ -0,0 +1,164 @@
+import os
+import tempfile
+import threading
+import unittest
+
+import networkx as nx
+from networkx.deployment.controller import Controller
+from networkx.deployment.journal import ConflictError, Journal
+from networkx.deployment.model import Model
+from networkx.deployment.planner import compile_plan
+
+
+def build_plan():
+    hosts = {f"h{i}": {"zone": f"z{i}", "slots": 4} for i in range(4)}
+
+    def service(home, requires=()):
+        costs = {host: 0 if host == home else 1 for host in hosts}
+        return {"replicas": 1, "requires": list(requires), "allowed_zones": None, "costs": costs}
+
+    services = {
+        "a": service("h0"),
+        "b": service("h1"),
+        "c": service("h2", ["a"]),
+        "d": service("h0", ["c"]),
+        "e": service("h3", ["b"]),
+    }
+    network = nx.Graph()
+    network.add_nodes_from(hosts)
+    network.add_weighted_edges_from([("h0", "h1", 1), ("h1", "h2", 1), ("h2", "h3", 1)])
+    return compile_plan(Model(services, hosts, network), max_parallel=4)
+
+
+class TestR7Behavior(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self._tmp.name, "journal.json")
+        self.plan = build_plan()
+        self.assertEqual(self.plan["batches"], [["a", "b"], ["c", "e"], ["d"]])
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def controller(self, max_attempts=2):
+        return Controller(self.plan, Journal(self.path), max_attempts=max_attempts)
+
+    def test_happy_path_and_restart(self):
+        controller = self.controller()
+        self.assertFalse(os.path.exists(self.path))
+        snap = controller.snapshot(0)
+        self.assertEqual(snap["states"], dict.fromkeys("abcde", "pending"))
+        self.assertEqual(snap["revision"], 0)
+        self.assertFalse(os.path.exists(self.path))
+
+        first = controller.claim("w1", 0, 10)
+        self.assertEqual(first, {"service": "a", "worker": "w1", "token": 1, "expires": 10})
+        self.assertEqual(controller.claim("w1", 1, 10), first)  # no write
+        second = controller.claim("w2", 1, 10)
+        self.assertEqual(second["service"], "b")
+        self.assertIsNone(controller.claim("w3", 1, 10))  # c waits for a
+        self.assertEqual(Journal(self.path).read()["revision"], 2)
+
+        self.assertTrue(controller.ack(first, True, 2))
+        self.assertFalse(controller.ack(first, True, 50))  # duplicate after expiry
+        with self.assertRaises(ConflictError):
+            controller.ack(first, False, 3)
+        # Only the earliest unfinished batch is served: b is still leased.
+        self.assertIsNone(controller.claim("w1", 3, 10))
+        self.assertTrue(controller.ack(second, True, 3))
+        third = controller.claim("w1", 4, 10)
+        self.assertEqual(third["service"], "c")
+
+        restarted = self.controller().snapshot(5)
+        self.assertEqual(
+            restarted["states"],
+            {"a": "done", "b": "done", "c": "leased", "d": "pending", "e": "pending"},
+        )
+        self.assertEqual(restarted["attempts"], {"a": 1, "b": 1, "c": 1, "d": 0, "e": 0})
+        self.assertEqual(restarted["leases"], {"c": third})
+        self.assertEqual(restarted["revision"], 5)
+        restarted["leases"]["c"]["token"] = 99
+        self.assertEqual(self.controller().snapshot(5)["leases"]["c"], third)
+
+    def test_expiry_failure_and_blocking(self):
+        controller = self.controller(max_attempts=2)
+        lease = controller.claim("w1", 0, 5)
+        self.assertEqual(lease["service"], "a")
+        with self.assertRaises(ConflictError):
+            controller.ack(lease, True, 5)  # expired: now >= expires
+        self.assertEqual(controller.snapshot(5)["states"]["a"], "pending")
+        retry = controller.claim("w2", 5, 5)
+        self.assertEqual((retry["service"], retry["token"]), ("a", 2))
+        with self.assertRaises(ValueError):
+            controller.claim("w3", 4, 5)  # clock went backwards
+        self.assertTrue(controller.ack(retry, False, 6))
+        self.assertFalse(controller.ack(retry, False, 7))
+        snap = controller.snapshot(7)
+        self.assertEqual(snap["states"]["a"], "failed")
+        self.assertEqual(snap["states"]["c"], "blocked")
+        self.assertEqual(snap["states"]["d"], "blocked")
+        self.assertEqual(snap["attempts"]["a"], 2)
+        # Independent work proceeds.
+        self.assertEqual(controller.claim("w1", 7, 5)["service"], "b")
+
+    def test_rejections(self):
+        controller = self.controller()
+        lease = controller.claim("w1", 0, 10)
+        revision = Journal(self.path).read()["revision"]
+        for forged in (
+            dict(lease, worker="other"),
+            dict(lease, token=lease["token"] + 5),
+            dict(lease, expires=99),
+            dict(lease, service="b"),
+        ):
+            with self.assertRaises(ConflictError):
+                controller.ack(forged, True, 1)
+        for bad in ({"service": "a"}, dict(lease, token=True)):
+            with self.assertRaises(ValueError):
+                controller.ack(bad, True, 1)
+        with self.assertRaises(ValueError):
+            controller.ack(lease, 1, 1)
+        for args in (("", 1, 1), ("w", -1, 1), ("w", 1, 0), ("w", True, 1)):
+            with self.assertRaises(ValueError):
+                controller.claim(*args)
+        self.assertEqual(Journal(self.path).read()["revision"], revision)
+
+        with self.assertRaises(ValueError):
+            self.controller(max_attempts=3)
+        other = compile_plan(Model({}, {}, nx.Graph()))
+        with self.assertRaises(ValueError):
+            Controller(other, Journal(self.path))
+        tampered = dict(self.plan, cost=self.plan["cost"] + 1)
+        with self.assertRaises(ValueError):
+            Controller(tampered, Journal(os.path.join(self._tmp.name, "x.json")))
+        for attempts in (0, True):
+            with self.assertRaises(ValueError):
+                Controller(self.plan, Journal(self.path), max_attempts=attempts)
+
+    def test_concurrent_claimers(self):
+        results = []
+        errors = []
+        barrier = threading.Barrier(4)
+
+        def claimer(worker):
+            controller = self.controller()
+            barrier.wait()
+            try:
+                results.append(controller.claim(worker, 0, 100))
+            except Exception as err:  # pragma: no cover - reported below
+                errors.append(err)
+
+        threads = [threading.Thread(target=claimer, args=(f"w{i}",)) for i in range(4)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+        self.assertEqual(errors, [])
+        leases = [lease for lease in results if lease is not None]
+        self.assertEqual(sorted(lease["service"] for lease in leases), ["a", "b"])
+        self.assertEqual(len({lease["token"] for lease in leases}), 2)
+        self.assertEqual(Journal(self.path).read()["revision"], 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
