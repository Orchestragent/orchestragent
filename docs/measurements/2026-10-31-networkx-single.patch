+++ b/networkx/deployment/_util.py
@@ -0,0 +1,103 @@
+"""Private validation and strict JSON helpers shared by the deployment modules."""
+
+import hashlib
+import json
+
+__all__ = []
+
+
+class JSONValueError(ValueError, TypeError):
+    """A value is not strict JSON.
+
+    Subclasses TypeError as well so callers expecting `json.dumps` semantics
+    for unserializable objects keep working.
+    """
+
+
+def canonical_json(value):
+    """Return the canonical JSON text of `value`.
+
+    Keys are sorted, separators are compact, non-ASCII text is kept and
+    NaN/infinity are rejected. Any serialization failure raises ValueError.
+    """
+    try:
+        return json.dumps(
+            value,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        )
+    except (TypeError, ValueError, RecursionError) as err:
+        raise JSONValueError(f"value is not strict JSON: {err}") from None
+
+
+def _reject_constant(name):
+    raise ValueError(f"non-finite JSON number {name} is not allowed")
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"duplicate JSON object key {key!r}")
+        result[key] = value
+    return result
+
+
+def loads_strict(data):
+    """Parse UTF-8 bytes or text as strict JSON (no NaN, no duplicate keys)."""
+    try:
+        if isinstance(data, bytes | bytearray):
+            data = bytes(data).decode("utf-8")
+        return json.loads(
+            data, parse_constant=_reject_constant, object_pairs_hook=_unique_object
+        )
+    except (TypeError, ValueError, RecursionError) as err:
+        raise ValueError(f"invalid JSON: {err}") from None
+
+
+def encode(value):
+    """Return the UTF-8 bytes of the canonical JSON text of `value`."""
+    text = canonical_json(value)
+    try:
+        return text.encode("utf-8")
+    except UnicodeEncodeError as err:
+        raise ValueError(f"value is not UTF-8 encodable: {err}") from None
+
+
+def normalize(value):
+    """Return a fresh copy of `value` after a strict JSON round trip."""
+    return loads_strict(encode(value))
+
+
+def digest(value):
+    """Return the SHA-256 hex digest of the canonical JSON of `value`."""
+    return hashlib.sha256(encode(value)).hexdigest()
+
+
+def is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def is_id(value):
+    return isinstance(value, str) and value != ""
+
+
+def check_id(value, what):
+    if not is_id(value):
+        raise ValueError(f"{what} must be a nonempty string, got {value!r}")
+    return str(value)
+
+
+def check_int(value, what, minimum=0):
+    if not is_int(value) or value < minimum:
+        kind = "positive" if minimum == 1 else "nonnegative"
+        raise ValueError(f"{what} must be a {kind} integer, got {value!r}")
+    return int(value)
+
+
+def check_bool(value, what):
+    if not isinstance(value, bool):
+        raise ValueError(f"{what} must be a bool, got {value!r}")
+    return value
