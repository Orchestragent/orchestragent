+import copy
+import hashlib
+import json
+import unittest
+
+import networkx as nx
+from networkx.deployment.model import Model, canonical_json
+
+
+def sample_inputs():
+    hosts = {
+        "h2": {"zone": "b", "slots": 2},
+        "h1": {"zone": "a", "slots": 1},
+    }
+    services = {
+        "web": {
+            "replicas": 2,
+            "requires": ("db", "db"),
+            "allowed_zones": ["b", "a", "a"],
+            "costs": {"h1": 1, "h2": 0},
+        },
+        "db": {
+            "replicas": 1,
+            "requires": [],
+            "allowed_zones": None,
+            "costs": {"h1": 3, "h2": 5},
+        },
+    }
+    network = nx.Graph(name="ignored")
+    network.add_node("h1", color="red")
+    network.add_edge("h2", "h1", weight=4, label="ignored")
+    network.add_edge("router", "h2", weight=1)
+    return services, hosts, network
+
+
+class TestR1Behavior(unittest.TestCase):
+    def test_normalizes_and_fingerprints(self):
+        model = Model(*sample_inputs())
+        self.assertEqual(list(model.services), ["db", "web"])
+        self.assertEqual(model.services["web"]["requires"], ["db"])
+        self.assertEqual(model.services["web"]["allowed_zones"], ["a", "b"])
+        self.assertIsNone(model.services["db"]["allowed_zones"])
+        self.assertEqual(list(model.hosts), ["h1", "h2"])
+        normalized = {
+            "services": model.services,
+            "hosts": model.hosts,
+            "network": {
+                "nodes": ["h1", "h2", "router"],
+                "edges": [["h1", "h2", 4], ["h2", "router", 1]],
+            },
+        }
+        text = json.dumps(
+            normalized,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        )
+        expected = hashlib.sha256(text.encode("utf-8")).hexdigest()
+        self.assertEqual(model.fingerprint, expected)
+        self.assertEqual(model.fingerprint, Model(*sample_inputs()).fingerprint)
+        network = model.network
+        self.assertEqual(sorted(network.nodes), ["h1", "h2", "router"])
+        self.assertEqual(network.edges["h1", "h2"], {"weight": 4})
+        self.assertEqual(network.graph, {})
+
+    def test_snapshots_and_defensive_copies(self):
+        services, hosts, network = sample_inputs()
+        before = copy.deepcopy((services, hosts))
+        model = Model(services, hosts, network)
+        self.assertEqual((services, hosts), before)
+        fingerprint = model.fingerprint
+        services["db"]["replicas"] = 9
+        hosts["h1"]["slots"] = 0
+        network.add_edge("h1", "router", weight=1)
+        model.services["db"]["costs"]["h1"] = 99
+        model.hosts["h2"]["zone"] = "z"
+        model.network.add_edge("x", "y", weight=1)
+        self.assertEqual(model.fingerprint, fingerprint)
+        self.assertEqual(model.services["db"]["replicas"], 1)
+        self.assertEqual(model.services["db"]["costs"]["h1"], 3)
+        self.assertEqual(model.hosts["h1"]["slots"], 1)
+        self.assertFalse(model.network.has_edge("h1", "router"))
+
+    def test_unicode_and_empty(self):
+        hosts = {"hôst/1": {"zone": "zöne:α", "slots": 1}}
+        services = {
+            "sërvice.α": {
+                "replicas": 1,
+                "requires": [],
+                "allowed_zones": ["zöne:α"],
+                "costs": {"hôst/1": 0},
+            }
+        }
+        network = nx.Graph()
+        network.add_node("hôst/1")
+        model = Model(services, hosts, network)
+        self.assertIn("sërvice.α", model.services)
+        empty = Model({}, {}, nx.Graph())
+        self.assertEqual(empty.services, {})
+        self.assertEqual(canonical_json({"b": "é", "a": [1]}), '{"a":[1],"b":"é"}')
+
+    def test_rejects_invalid_input(self):
+        def mutate(change):
+            services, hosts, network = sample_inputs()
+            change(services, hosts, network)
+            before = copy.deepcopy((services, hosts))
+            with self.assertRaises(ValueError):
+                Model(services, hosts, network)
+            self.assertEqual((services, hosts), before)
+
+        cases = [
+            lambda s, h, n: s["db"].update(replicas=True),
+            lambda s, h, n: s["db"].update(replicas=0),
+            lambda s, h, n: s["db"].update(requires="web"),
+            lambda s, h, n: s["db"].update(requires=["db"]),
+            lambda s, h, n: s["db"].update(requires=["nope"]),
+            lambda s, h, n: s["db"].update(requires=["web"]),
+            lambda s, h, n: s["db"].update(allowed_zones=["zz"]),
+            lambda s, h, n: s["db"].update(costs={"h1": 1}),
+            lambda s, h, n: s["db"].update(costs={"h1": -1, "h2": 0}),
+            lambda s, h, n: s["db"].update(costs={"h1": False, "h2": 0}),
+            lambda s, h, n: s["db"].update(extra=1),
+            lambda s, h, n: s.update({"": s["db"]}),
+            lambda s, h, n: h["h1"].update(slots=-1),
+            lambda s, h, n: h["h1"].update(zone=""),
+            lambda s, h, n: n.remove_node("h1"),
+            lambda s, h, n: n.add_edge("h1", "h1", weight=1),
+            lambda s, h, n: n.add_edge("h1", "router", weight=0),
+            lambda s, h, n: n.add_edge("h1", "router", weight=True),
+            lambda s, h, n: n.add_edge("h1", "router", weight=1.0),
+            lambda s, h, n: n.add_edge("h1", "router"),
+            lambda s, h, n: n.add_node(7),
+        ]
+        for case in cases:
+            with self.subTest(case=case):
+                mutate(case)
+        services, hosts, _ = sample_inputs()
+        for network in (nx.DiGraph(), nx.MultiGraph(), {"nodes": []}):
+            with self.assertRaises(ValueError):
+                Model(services, hosts, network)
+
+    def test_canonical_json_rejects_nan(self):
+        with self.assertRaises(ValueError):
+            canonical_json(float("nan"))
+
+
+if __name__ == "__main__":
+    unittest.main()
