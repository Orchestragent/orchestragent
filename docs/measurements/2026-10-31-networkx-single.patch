@@ -0,0 +1,115 @@
+import json
+import os
+import tempfile
+import threading
+import unittest
+from unittest import mock
+
+from networkx.deployment.journal import ConflictError, Journal, save_json
+from networkx.deployment.model import canonical_json
+
+
+class TestR5Behavior(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.dir = self._tmp.name
+        self.path = os.path.join(self.dir, "journal.json")
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_save_json_is_canonical_and_atomic(self):
+        target = os.path.join(self.dir, "out.json")
+        save_json(target, {"b": ("x", "é"), "a": 1})
+        with open(target, "rb") as handle:
+            self.assertEqual(handle.read(), canonical_json({"a": 1, "b": ["x", "é"]}).encode())
+        for bad in ({"x": float("nan")}, {"x": float("inf")}, {"x": object()}):
+            with self.assertRaises(ValueError):
+                save_json(target, bad)
+        with mock.patch("os.replace", side_effect=OSError("boom")):
+            with self.assertRaises(OSError):
+                save_json(target, {"new": True})
+        with open(target, "rb") as handle:
+            self.assertEqual(json.loads(handle.read()), {"a": 1, "b": ["x", "é"]})
+        self.assertEqual(os.listdir(self.dir), ["out.json"])
+
+    def test_read_append_and_idempotency(self):
+        journal = Journal(self.path)
+        self.assertEqual(journal.read(), {"schema": 1, "revision": 0, "events": []})
+        self.assertFalse(os.path.exists(self.path))
+        payload = {"n": [1, 2], "s": "ü"}
+        self.assertEqual(journal.append(0, {"id": "e1", "payload": payload}), 1)
+        payload["n"].append(3)
+        self.assertEqual(journal.append(1, {"id": "e2", "payload": None}), 2)
+        other = Journal(self.path)
+        snapshot = other.read()
+        self.assertEqual(
+            snapshot,
+            {
+                "schema": 1,
+                "revision": 2,
+                "events": [
+                    {"revision": 1, "event": {"id": "e1", "payload": {"n": [1, 2], "s": "ü"}}},
+                    {"revision": 2, "event": {"id": "e2", "payload": None}},
+                ],
+            },
+        )
+        snapshot["events"].clear()
+        self.assertEqual(other.read()["revision"], 2)
+        # Idempotent replay returns the original revision even when stale.
+        same = {"id": "e1", "payload": {"s": "ü", "n": (1, 2)}}
+        self.assertEqual(other.append(0, same), 1)
+        with self.assertRaises(ConflictError):
+            other.append(2, {"id": "e1", "payload": {"n": [1]}})
+        with self.assertRaises(ConflictError):
+            other.append(1, {"id": "e3", "payload": 1})
+        self.assertEqual(journal.read()["revision"], 2)
+        for revision in (-1, True, 1.0):
+            with self.assertRaises(ValueError):
+                journal.append(revision, {"id": "e3", "payload": 1})
+        for event in ({"id": "", "payload": 1}, {"id": "x"}, {"id": "x", "payload": float("nan")}):
+            with self.assertRaises(ValueError):
+                journal.append(2, event)
+        self.assertEqual(journal.read()["revision"], 2)
+
+    def test_rejects_malformed_files(self):
+        documents = [
+            b"{not json",
+            b'{"schema":2,"revision":0,"events":[]}',
+            b'{"schema":1,"revision":1,"events":[]}',
+            b'{"schema":1,"revision":1,"events":[{"revision":2,"event":{"id":"a","payload":1}}]}',
+            b'{"schema":1,"revision":2,"events":[{"revision":1,"event":{"id":"a","payload":1}},'
+            b'{"revision":2,"event":{"id":"a","payload":2}}]}',
+            b'{"schema":1,"revision":1,"events":[{"revision":1,"event":{"id":"a","payload":NaN}}]}',
+            b'[]',
+        ]
+        for data in documents:
+            with open(self.path, "wb") as handle:
+                handle.write(data)
+            with self.subTest(data=data), self.assertRaises(ValueError):
+                Journal(self.path).read()
+
+    def test_concurrent_appends_do_not_lose_updates(self):
+        def writer(name):
+            journal = Journal(self.path)
+            for i in range(10):
+                while True:
+                    revision = journal.read()["revision"]
+                    try:
+                        journal.append(revision, {"id": f"{name}-{i}", "payload": i})
+                        break
+                    except ConflictError:
+                        continue
+
+        threads = [threading.Thread(target=writer, args=(f"w{n}",)) for n in range(4)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+        document = Journal(self.path).read()
+        self.assertEqual(document["revision"], 40)
+        self.assertEqual(len({r["event"]["id"] for r in document["events"]}), 40)
+
+
+if __name__ == "__main__":
+    unittest.main()
