new file mode 100644
index 0000000..ef46829
--- /dev/null
+++ b/networkx/algorithms/flow/lowerbound.py
@@ -0,0 +1,179 @@
+"""
+Minimum cost flow with lower bounds on edge flows.
+
+The problem is reduced to an ordinary minimum cost flow problem by shifting
+every mandatory lower bound into the node demands, and is then solved with
+:func:`~networkx.algorithms.flow.network_simplex`.
+"""
+
+import networkx as nx
+
+__all__ = ["solve_bounded_flow"]
+
+
+def _check_name(name, what):
+    """Raise ValueError unless `name` is a nonempty string."""
+    if not isinstance(name, str) or not name:
+        raise ValueError(f"{what} attribute name must be a nonempty string")
+    return name
+
+
+def _exact_int(value, what):
+    """Raise ValueError unless `value` is an exact (non-bool) int."""
+    if type(value) is not int:
+        raise ValueError(f"{what} must be an exact int, got {value!r}")
+    return value
+
+
+def _check_digraph(G):
+    """Raise ValueError unless `G` is a DiGraph or MultiDiGraph."""
+    if not isinstance(G, nx.Graph) or not G.is_directed():
+        raise ValueError("G must be a DiGraph or MultiDiGraph")
+
+
+def _edge_bounds(data, capacity, weight, lower, what):
+    """Validate one edge record and return ``(lower, capacity, weight)``.
+
+    `capacity` is required and must be a nonnegative exact int; `weight`
+    defaults to 0 and `lower` defaults to 0 and must lie in ``[0, capacity]``.
+    """
+    if capacity not in data:
+        raise ValueError(f"{what} has no {capacity!r} attribute")
+    cap = _exact_int(data[capacity], f"capacity of {what}")
+    if cap < 0:
+        raise ValueError(f"capacity of {what} is negative")
+    w = _exact_int(data.get(weight, 0), f"weight of {what}")
+    lo = _exact_int(data.get(lower, 0), f"lower bound of {what}")
+    if not 0 <= lo <= cap:
+        raise ValueError(f"lower bound of {what} is not between 0 and capacity")
+    return lo, cap, w
+
+
+def _edges(G):
+    """Yield ``(u, v, key, data)`` for every edge; DiGraph keys are None."""
+    if G.is_multigraph():
+        yield from G.edges(keys=True, data=True)
+    else:
+        for u, v, data in G.edges(data=True):
+            yield u, v, None, data
+
+
+def _graph_edges(G, capacity, weight, lower):
+    """Return validated ``(u, v, key, lower, capacity, weight)`` edge tuples."""
+    edges = []
+    for u, v, key, data in _edges(G):
+        what = f"edge {(u, v) if key is None else (u, v, key)!r}"
+        edges.append((u, v, key) + _edge_bounds(data, capacity, weight, lower, what))
+    return edges
+
+
+def _check_names(demand, capacity, weight, lower):
+    _check_name(demand, "demand")
+    _check_name(capacity, "capacity")
+    _check_name(weight, "weight")
+    _check_name(lower, "lower")
+
+
+def _solve_indexed(demands, arcs):
+    """Solve a bounded min cost flow problem over integer-indexed nodes.
+
+    `demands` lists the demand of nodes ``0 .. n-1`` and `arcs` lists
+    ``(u, v, lower, capacity, weight)`` tuples. Returns the flow of every arc.
+    Raises NetworkXUnfeasible if no flow satisfies demands and bounds.
+    """
+    if sum(demands) != 0:
+        raise nx.NetworkXUnfeasible("total node demand is not zero")
+    if not demands:
+        return []
+    reduced = list(demands)
+    for u, v, lo, _, _ in arcs:
+        reduced[v] -= lo
+        reduced[u] += lo
+    H = nx.MultiDiGraph()
+    H.add_nodes_from((i, {"demand": d}) for i, d in enumerate(reduced))
+    for i, (u, v, lo, cap, w) in enumerate(arcs):
+        H.add_edge(u, v, key=i, capacity=cap - lo, weight=w)
+    flow_dict = nx.network_simplex(H)[1]
+    return [lo + flow_dict[u][v][i] for i, (u, v, lo, _, _) in enumerate(arcs)]
+
+
+def _index_arcs(G, edges):
+    """Return node index map and indexed arcs for validated `edges` of G."""
+    index = {u: i for i, u in enumerate(G)}
+    arcs = [(index[u], index[v], lo, cap, w) for u, v, _, lo, cap, w in edges]
+    return index, arcs
+
+
+def _flow_dict(G, edges, flows):
+    """Build the usual NetworkX flow dict for `edges` carrying `flows`."""
+    flow_dict = {u: {} for u in G}
+    if G.is_multigraph():
+        for (u, v, key, *_), f in zip(edges, flows):
+            flow_dict[u].setdefault(v, {})[key] = f
+    else:
+        for (u, v, *_), f in zip(edges, flows):
+            flow_dict[u][v] = f
+    return flow_dict
+
+
+def solve_bounded_flow(
+    G, demand="demand", capacity="capacity", weight="weight", lower="lower"
+):
+    """Returns a minimum cost flow satisfying demands and edge lower bounds.
+
+    Parameters
+    ----------
+    G : DiGraph or MultiDiGraph
+        Self-loops, reverse and parallel edges are allowed.
+
+    demand : string
+        Node attribute holding the exact int demand (inflow minus outflow).
+        Missing demands are 0.
+
+    capacity : string
+        Required edge attribute holding the exact nonnegative int capacity.
+
+    weight : string
+        Edge attribute holding the exact int cost per unit of flow
+        (default 0). Negative weights are allowed.
+
+    lower : string
+        Edge attribute holding the exact int lower bound on the flow,
+        between 0 and the capacity (default 0).
+
+    Returns
+    -------
+    (cost, flow_dict) : tuple
+        The minimum cost and a flow dict keyed like ``flow_dict[u][v]``, or
+        ``flow_dict[u][v][key]`` for multigraphs, containing every edge.
+
+    Raises
+    ------
+    ValueError
+        If the graph, attribute names or attribute values are malformed.
+
+    NetworkXUnfeasible
+        If no flow satisfies all demands and edge bounds.
+
+    Examples
+    --------
+    >>> from networkx.algorithms.flow.lowerbound import solve_bounded_flow
+    >>> G = nx.DiGraph()
+    >>> G.add_node("a", demand=-3)
+    >>> G.add_node("b", demand=3)
+    >>> G.add_edge("a", "b", capacity=5, weight=1)
+    >>> G.add_edge("b", "a", capacity=2, weight=1, lower=1)
+    >>> solve_bounded_flow(G)
+    (5, {'a': {'b': 4}, 'b': {'a': 1}})
+    """
+    _check_digraph(G)
+    _check_names(demand, capacity, weight, lower)
+    demands = [
+        _exact_int(d.get(demand, 0), f"demand of node {u!r}")
+        for u, d in G.nodes(data=True)
+    ]
+    edges = _graph_edges(G, capacity, weight, lower)
+    _, arcs = _index_arcs(G, edges)
+    flows = _solve_indexed(demands, arcs)
+    cost = sum(f * e[-1] for e, f in zip(edges, flows))
+    return cost, _flow_dict(G, edges, flows)
