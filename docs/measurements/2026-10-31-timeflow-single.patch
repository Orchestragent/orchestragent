+        G.add_edge("c", "c", capacity=3, weight=2, lower=1)
+        before = _snapshot(G)
+        cost, flow = solve(G)
+        self.assertEqual(cost, 5 - 4 + 2)
+        self.assertEqual(
+            flow,
+            {"a": {"b": 4}, "b": {"a": 1}, "c": {"d": 2, "c": 1}, "d": {"c": 2}},
+        )
+        self.assertEqual(_snapshot(G), before)
+
+        # Custom attribute names and a keyed MultiDiGraph with zero flows.
+        M = nx.MultiDiGraph()
+        M.add_node(1, need=-2)
+        M.add_node((2,), need=2)
+        M.add_edge(1, (2,), key="p", cap=2, cost=3)
+        M.add_edge(1, (2,), key="q", cap=2, cost=1, low=1)
+        M.add_edge((2,), 1, key="r", cap=1, cost=1)
+        cost, flow = solve(M, "need", "cap", "cost", "low")
+        self.assertEqual(cost, 2)
+        self.assertEqual(flow, {1: {(2,): {"p": 0, "q": 2}}, (2,): {1: {"r": 0}}})
+
+        # Randomized comparison with brute force optimisation.
+        rng = random.Random(7)
+        for trial in range(150):
+            G = _random_graph(rng, multigraph=trial % 2 == 1)
+            for u in G:
+                G.nodes[u]["demand"] = 0
+            supplier, receiver = rng.sample(list(G), 2)
+            amount = rng.randint(0, 2)
+            G.nodes[supplier]["demand"] = -amount
+            G.nodes[receiver]["demand"] = amount
+            demands = dict(G.nodes(data="demand"))
+            best = min(
+                (c for fl, c in _feasible_flows(G) if _net_inflow(G, fl) == demands),
+                default=None,
+            )
+            with self.subTest(trial=trial):
+                if best is None:
+                    with self.assertRaises(nx.NetworkXUnfeasible):
+                        solve(G)
+                    continue
