@@ -0,0 +1,178 @@
+"""
+Command line interface for temporal transshipment problems.
+
+Usage::
+
+    python -m networkx.algorithms.flow.timecli solve INPUT --output PATH
+    python -m networkx.algorithms.flow.timecli audit INPUT --output PATH
+
+The input JSON object has ``nodes``, ``edges``, ``horizon`` and ``balances``
+and optionally ``storage`` and ``scenarios``. ``solve`` writes
+``{"schedule": ..., "shipments": ...}`` and ``audit`` writes the outage
+report of :func:`~networkx.algorithms.flow.timeaudit.analyze`.
+"""
+
+import argparse
+import json
+import math
+import sys
+
+import networkx as nx
+from networkx.algorithms.flow.timeaudit import analyze
+from networkx.algorithms.flow.timedecompose import paths
+from networkx.algorithms.flow.timeio import save_json
+from networkx.algorithms.flow.timeschedule import solve
+
+__all__ = ["main"]
+
+_REQUIRED = frozenset({"nodes", "edges", "horizon", "balances"})
+_OPTIONAL = frozenset({"storage", "scenarios"})
+_EDGE_REQUIRED = frozenset({"source", "target", "key", "capacity"})
+_EDGE_OPTIONAL = frozenset({"weight", "lower", "transit"})
+_BALANCE_FIELDS = frozenset({"node", "time", "demand"})
+
+
+def _reject_constant(name):
+    raise ValueError(f"nonfinite number {name} in input")
+
+
+def _finite_float(text):
+    value = float(text)
+    if not math.isfinite(value):
+        raise ValueError(f"nonfinite number {text} in input")
+    return value
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"duplicate key {key!r} in input")
+        result[key] = value
+    return result
+
+
+def _load(text):
+    """Parse strict JSON input text."""
+    return json.loads(
+        text,
+        parse_constant=_reject_constant,
+        parse_float=_finite_float,
+        object_pairs_hook=_unique_object,
+    )
+
+
+def _check_fields(record, required, optional, what):
+    if not isinstance(record, dict):
+        raise ValueError(f"{what} must be an object")
+    missing = required - set(record)
+    if missing:
+        raise ValueError(f"{what} lacks fields {sorted(missing)}")
+    extra = set(record) - required - optional
+    if extra:
+        raise ValueError(f"{what} has unknown fields {sorted(extra)}")
+
+
+def _nonempty_str(value, what):
+    if not isinstance(value, str) or not value:
+        raise ValueError(f"{what} must be a nonempty string, got {value!r}")
+
+
+def _graph(nodes, edges):
+    """Build the physical MultiDiGraph from input node and edge lists."""
+    if not isinstance(nodes, list):
+        raise ValueError("nodes must be a list")
+    for node in nodes:
+        _nonempty_str(node, "node")
+    if len(set(nodes)) != len(nodes):
+        raise ValueError("nodes must be unique")
+    if not isinstance(edges, list):
+        raise ValueError("edges must be a list")
+    G = nx.MultiDiGraph()
+    G.add_nodes_from(nodes)
+    for edge in edges:
+        _check_fields(edge, _EDGE_REQUIRED, _EDGE_OPTIONAL, "edge")
+        u, v, key = edge["source"], edge["target"], edge["key"]
+        for end in (u, v):
+            if not isinstance(end, str) or end not in G:
+                raise ValueError(f"edge endpoint {end!r} is not a node")
+        _nonempty_str(key, "edge key")
+        if G.has_edge(u, v, key):
+            raise ValueError(f"duplicate edge {(u, v, key)!r}")
+        attrs = {f: edge[f] for f in edge if f not in ("source", "target", "key")}
+        G.add_edge(u, v, key=key, **attrs)
+    return G
+
+
+def _balances(records):
+    """Convert input balance records to a ``{(node, time): demand}`` dict."""
+    if not isinstance(records, list):
+        raise ValueError("balances must be a list")
+    balances = {}
+    for record in records:
+        _check_fields(record, _BALANCE_FIELDS, frozenset(), "balance")
+        node, time, demand = record["node"], record["time"], record["demand"]
+        if not isinstance(node, str) or type(time) is not int:
+            raise ValueError(f"balance {record!r} is malformed")
+        if type(demand) is not int:
+            raise ValueError(f"balance {record!r} demand must be an exact int")
+        if (node, time) in balances:
+            raise ValueError(f"duplicate balance for {(node, time)!r}")
+        balances[node, time] = demand
+    return balances
+
+
+def _problem(data):
+    """Validate input data and return ``(G, horizon, balances, storage)``."""
+    _check_fields(data, _REQUIRED, _OPTIONAL, "input")
+    G = _graph(data["nodes"], data["edges"])
+    return G, data["horizon"], _balances(data["balances"]), data.get("storage")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(
+        prog="timecli", description="Solve temporal transshipment problems."
+    )
+    commands = parser.add_subparsers(dest="command", required=True)
+    for name, text in (
+        ("solve", "write a minimum cost schedule and its shipments"),
+        ("audit", "write the cost impact of edge outage scenarios"),
+    ):
+        command = commands.add_parser(name, help=text, description=text)
+        command.add_argument("input", metavar="INPUT", help="input JSON file")
+        command.add_argument(
+            "--output", metavar="PATH", required=True, help="output JSON file"
+        )
+    return parser
+
+
+def main(argv=None):
+    """Run the command line interface and return the exit status.
+
+    Returns 0 on success (and for ``--help``) and 2 after printing an error
+    message to stderr; an existing output file is left unchanged on error.
+    """
+    try:
+        args = _parser().parse_args(argv)
+    except SystemExit as exc:
+        return exc.code if isinstance(exc.code, int) else 2
+    try:
+        with open(args.input, encoding="utf-8") as f:
+            data = _load(f.read())
+        G, horizon, balances, storage = _problem(data)
+        if args.command == "solve":
+            schedule = solve(G, horizon, balances, storage)
+            shipments = paths(G, horizon, balances, schedule, storage)
+            result = {"schedule": schedule, "shipments": shipments}
+        else:
+            scenarios = data.get("scenarios", {})
+            result = analyze(G, horizon, balances, scenarios, storage)
+        save_json(args.output, result)
+    except (OSError, ValueError, RecursionError, nx.NetworkXException) as err:
+        print(f"error: {err}", file=sys.stderr)
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
