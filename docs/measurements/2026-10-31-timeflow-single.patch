+"""Behaviour tests for lower-bounded flow and temporal transshipment."""
+
+import contextlib
+import copy
+import inspect
+import io
+import itertools
+import json
+import os
+import random
+import tempfile
+import unittest
+from unittest import mock
+
+import networkx as nx
+from networkx.algorithms.flow import (
+    lowerbound,
+    lowerbound_max,
+    timeaudit,
+    timecli,
+    timedecompose,
+    timeflow,
+    timeio,
+    timeschedule,
+)
+
+
+def _edge_list(G):
+    if G.is_multigraph():
+        return list(G.edges(keys=True, data=True))
+    return [(u, v, None, d) for u, v, d in G.edges(data=True)]
+
+
+def _flow_of(flow_dict, u, v, k):
+    return flow_dict[u][v] if k is None else flow_dict[u][v][k]
+
+
+def _net_inflow(G, flows):
+    net = dict.fromkeys(G, 0)
+    for (u, v, _, _), f in zip(_edge_list(G), flows):
+        net[u] -= f
+        net[v] += f
+    return net
+
+
+def _feasible_flows(G):
+    """Yield every integral flow vector respecting edge bounds (brute force)."""
+    edges = _edge_list(G)
+    ranges = [range(d.get("lower", 0), d["capacity"] + 1) for *_, d in edges]
+    for flows in itertools.product(*ranges):
+        yield flows, sum(f * d.get("weight", 0) for (*_, d), f in zip(edges, flows))
+
+
+def _random_graph(rng, multigraph):
+    G = nx.MultiDiGraph() if multigraph else nx.DiGraph()
+    nodes = [0, "x", (1, 2), frozenset({3})]
+    G.add_nodes_from(nodes)
+    for i in range(rng.randint(1, 5)):
+        u, v = rng.choice(nodes), rng.choice(nodes)
+        if not multigraph and G.has_edge(u, v):
+            continue
+        cap = rng.randint(0, 2)
+        attrs = {"capacity": cap, "weight": rng.randint(-3, 3)}
+        if rng.random() < 0.5:
+            attrs["lower"] = rng.randint(0, cap)
+        if multigraph:
+            G.add_edge(u, v, key=("k", i), **attrs)
+        else:
+            G.add_edge(u, v, **attrs)
+    return G
+
+
+def _snapshot(G):
+    return (
+        type(G),
+        copy.deepcopy(dict(G.graph)),
+        copy.deepcopy(list(G.nodes(data=True))),
+        copy.deepcopy(_edge_list(G)),
+    )
+
