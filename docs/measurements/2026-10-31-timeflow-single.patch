+
+        bad = [
+            (graph(),),
+            (graph(capacity=-1),),
+            (graph(capacity=1.0),),
+            (graph(capacity=True),),
+            (graph(capacity=1, weight=0.5),),
+            (graph(capacity=1, weight=False),),
+            (graph(capacity=1, lower=2),),
+            (graph(capacity=1, lower=-1),),
+            (graph(capacity=float("inf")),),
+            (nx.Graph([("a", "b", {"capacity": 1})]),),
