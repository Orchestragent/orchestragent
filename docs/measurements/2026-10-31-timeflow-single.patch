@@ -0,0 +1,157 @@
+"""
+Validation and path decomposition of temporal transshipment schedules.
+"""
+
+from networkx.algorithms.flow.timeflow import expand
+from networkx.algorithms.flow.timeio import canonical_json
+from networkx.algorithms.flow.timeschedule import _record, _record_order
+
+__all__ = ["paths"]
+
+_SCHEDULE_FIELDS = frozenset({"cost", "flow"})
+_RECORD_FIELDS = frozenset(
+    {"kind", "source", "target", "key", "depart", "arrive", "amount"}
+)
+
+
+def _arc(H, record):
+    """Return the expanded arc ``(tail, head, hkey)`` of a schedule record."""
+    if not isinstance(record, dict) or set(record) != _RECORD_FIELDS:
+        raise ValueError(f"schedule record {record!r} has invalid fields")
+    kind, source, target = record["kind"], record["source"], record["target"]
+    key, depart, arrive = record["key"], record["depart"], record["arrive"]
+    amount = record["amount"]
+    if not (isinstance(kind, str) and isinstance(source, str)):
+        raise ValueError(f"schedule record {record!r} is malformed")
+    if not (isinstance(target, str) and (key is None or isinstance(key, str))):
+        raise ValueError(f"schedule record {record!r} is malformed")
+    if any(type(x) is not int for x in (depart, arrive, amount)):
+        raise ValueError(f"schedule record {record!r} has non-int numbers")
+    if amount <= 0:
+        raise ValueError(f"schedule record {record!r} has nonpositive amount")
+    if kind == "move":
+        hkey = ("move", source, target, key, depart)
+    elif kind == "hold" and key is None:
+        hkey = ("hold", source, depart)
+    else:
+        raise ValueError(f"schedule record {record!r} has invalid kind or key")
+    arc = ((source, depart), (target, arrive), hkey)
+    if not H.has_edge(*arc):
+        raise ValueError(f"schedule record {record!r} is not an arc")
+    return arc
+
+
+def _schedule_flows(H, schedule):
+    """Validate `schedule` against expanded network `H` and return arc flows."""
+    if not isinstance(schedule, dict) or set(schedule) != _SCHEDULE_FIELDS:
+        raise ValueError("schedule must be a dict with keys 'cost' and 'flow'")
+    if type(schedule["cost"]) is not int:
+        raise ValueError("schedule cost must be an exact int")
+    if not isinstance(schedule["flow"], list):
+        raise ValueError("schedule flow must be a list")
+    flows = {}
+    for record in schedule["flow"]:
+        arc = _arc(H, record)
+        if arc in flows:
+            raise ValueError(f"duplicate schedule record for arc {arc!r}")
+        flows[arc] = record["amount"]
+    net = dict.fromkeys(H, 0)
+    cost = 0
+    for tail, head, hkey, data in H.edges(keys=True, data=True):
+        f = flows.get((tail, head, hkey), 0)
+        if not data["lower"] <= f <= data["capacity"]:
+            raise ValueError(f"flow on arc {(tail, head, hkey)!r} violates bounds")
+        net[tail] -= f
+        net[head] += f
+        cost += f * data["weight"]
+    for node, demand in H.nodes(data="demand"):
+        if net[node] != demand:
+            raise ValueError(f"flow violates the balance of {node!r}")
+    if cost != schedule["cost"]:
+        raise ValueError(f"schedule cost {schedule['cost']} differs from {cost}")
+    return flows
+
+
+def _decompose(H, flows):
+    """Yield ``(amount, arcs)`` shipments decomposing valid `flows` on `H`."""
+    residual = dict(flows)
+    out = {}
+    for arc in sorted(flows, key=lambda arc: _record_order(_record(*arc, 0))):
+        out.setdefault(arc[0], []).append(arc)
+    first = dict.fromkeys(out, 0)
+    supply = {n: -d for n, d in H.nodes(data="demand") if d < 0}
+    demand = {n: d for n, d in H.nodes(data="demand") if d > 0}
+    for source in sorted(supply, key=lambda n: (n[1], n[0])):
+        while supply[source] > 0:
+            arcs = []
+            node = source
+            while demand.get(node, 0) == 0:
+                # Skip arcs exhausted by earlier shipments; flows only shrink.
+                while residual[out[node][first[node]]] == 0:
+                    first[node] += 1
+                arc = out[node][first[node]]
+                arcs.append(arc)
+                node = arc[1]
+            amount = min(
+                supply[source], demand[node], min(residual[arc] for arc in arcs)
+            )
+            supply[source] -= amount
+            demand[node] -= amount
+            for arc in arcs:
+                residual[arc] -= amount
+            yield amount, arcs
+
+
+def paths(G, horizon, balances, schedule, storage=None):
+    """Validates a schedule and decomposes it into shipments.
+
+    Parameters
+    ----------
+    G, horizon, balances, storage
+        As in :func:`~networkx.algorithms.flow.timeflow.expand`.
+
+    schedule : dict
+        A schedule in the form returned by
+        :func:`~networkx.algorithms.flow.timeschedule.solve`; record order
+        is arbitrary and arcs without records carry no flow. The schedule
+        must satisfy every arc bound and node balance and its cost must
+        equal the cost of its flow.
+
+    Returns
+    -------
+    shipments : list
+        Dicts ``{"amount": a, "route": [[node, time], ...],
+        "edges": [{"kind": kind, "key": key}, ...]}`` with one edge per
+        route step, sorted by canonical JSON. Supplies are processed in
+        ``(time, node)`` order; each shipment follows the first positive
+        residual arc in schedule order out of every node until it reaches
+        a node with unfilled demand, and carries as much as the supply,
+        that demand and the path allow.
+
+    Raises
+    ------
+    ValueError
+        If any input or the schedule is invalid.
+
+    Examples
+    --------
+    >>> from networkx.algorithms.flow.timedecompose import paths
+    >>> from networkx.algorithms.flow.timeschedule import solve
+    >>> G = nx.DiGraph()
+    >>> G.add_edge("a", "b", capacity=2, weight=3)
+    >>> balances = {("a", 0): -2, ("b", 1): 2}
+    >>> paths(G, 1, balances, solve(G, 1, balances))
+    [{'amount': 2, 'route': [['a', 0], ['b', 1]], 'edges': [{'kind': 'move', 'key': None}]}]
+    """
+    H = expand(G, horizon, balances, storage)
+    flows = _schedule_flows(H, schedule)
+    shipments = []
+    for amount, arcs in _decompose(H, flows):
+        route = [list(arcs[0][0])] + [list(head) for _, head, _ in arcs]
+        edges = [
+            {"kind": record["kind"], "key": record["key"]}
+            for record in (_record(*arc, amount) for arc in arcs)
+        ]
+        shipments.append({"amount": amount, "route": route, "edges": edges})
+    shipments.sort(key=canonical_json)
+    return shipments
