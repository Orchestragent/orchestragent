+++ b/networkx/algorithms/flow/timeflow.py
@@ -0,0 +1,180 @@
+"""
+Time-expanded networks for temporal transshipment problems.
+
+A physical network whose edges have integer transit times is expanded into
+a :class:`~networkx.MultiDiGraph` over ``(node, time)`` pairs. Movement arcs
+copy each physical edge at every possible departure time and optional hold
+arcs store goods at a node from one tick to the next.
+"""
+
+import networkx as nx
+from networkx.algorithms.flow.lowerbound import _check_digraph, _edge_bounds, _exact_int
+
+__all__ = ["expand"]
+
+_STORAGE_FIELDS = frozenset({"capacity", "weight", "lower"})
+
+
+def _check_label(value, what):
+    """Raise ValueError unless `value` is a nonempty string."""
+    if not isinstance(value, str) or not value:
+        raise ValueError(f"{what} must be a nonempty string, got {value!r}")
+    return value
+
+
+def _check_horizon(horizon):
+    if _exact_int(horizon, "horizon") < 0:
+        raise ValueError("horizon must be nonnegative")
+    return horizon
+
+
+def _physical_edges(G):
+    """Validate physical graph `G` and return its edge tuples.
+
+    Each tuple is ``(u, v, key, lower, capacity, weight, transit)`` where
+    `key` is None for a DiGraph.
+    """
+    _check_digraph(G)
+    for u in G:
+        _check_label(u, "node")
+    multigraph = G.is_multigraph()
+    if multigraph:
+        edges = G.edges(keys=True, data=True)
+    else:
+        edges = ((u, v, None, d) for u, v, d in G.edges(data=True))
+    result = []
+    for u, v, key, data in edges:
+        if multigraph:
+            _check_label(key, "edge key")
+        what = f"edge {(u, v, key)!r}"
+        bounds = _edge_bounds(data, "capacity", "weight", "lower", what)
+        transit = _exact_int(data.get("transit", 1), f"transit of {what}")
+        if transit <= 0:
+            raise ValueError(f"transit of {what} must be positive")
+        result.append((u, v, key) + bounds + (transit,))
+    return result
+
+
+def _check_time(G, horizon, node, time, what):
+    """Raise ValueError unless ``(node, time)`` is a node of the expansion."""
+    if not isinstance(node, str) or node not in G:
+        raise ValueError(f"{what} refers to unknown node {node!r}")
+    if type(time) is not int or not 0 <= time <= horizon:
+        raise ValueError(f"{what} refers to invalid time {time!r}")
+
+
+def _balances(G, horizon, balances):
+    """Validate `balances` and return them as a dict."""
+    if not isinstance(balances, dict):
+        raise ValueError("balances must be a dict")
+    for pair, amount in balances.items():
+        if not isinstance(pair, tuple) or len(pair) != 2:
+            raise ValueError(f"balance key {pair!r} must be a (node, time) pair")
+        _check_time(G, horizon, *pair, f"balance {pair!r}")
+        _exact_int(amount, f"balance of {pair!r}")
+    if sum(balances.values()) != 0:
+        raise ValueError("balances do not sum to zero")
+    return dict(balances)
+
+
+def _storage(G, storage):
+    """Validate `storage` and return ``{node: (lower, capacity, weight)}``."""
+    if storage is None:
+        return {}
+    if not isinstance(storage, dict):
+        raise ValueError("storage must be None or a dict")
+    result = {}
+    for node, record in storage.items():
+        if not isinstance(node, str) or node not in G:
+            raise ValueError(f"storage refers to unknown node {node!r}")
+        if not isinstance(record, dict):
+            raise ValueError(f"storage of {node!r} must be a dict")
+        extra = set(record) - _STORAGE_FIELDS
+        if extra:
+            raise ValueError(f"storage of {node!r} has unknown fields {extra!r}")
+        what = f"storage of {node!r}"
+        result[node] = _edge_bounds(record, "capacity", "weight", "lower", what)
+    return result
+
+
+def _validate(G, horizon, balances, storage):
+    """Validate all inputs of `expand`; return the normalized pieces."""
+    edges = _physical_edges(G)
+    _check_horizon(horizon)
+    return edges, _balances(G, horizon, balances), _storage(G, storage)
+
+
+def expand(G, horizon, balances, storage=None):
+    """Returns the time-expanded network of `G` over ``0 .. horizon``.
+
+    Parameters
+    ----------
+    G : DiGraph or MultiDiGraph
+        Physical network with nonempty string nodes (and nonempty string
+        keys for a MultiDiGraph). Edges require an exact nonnegative int
+        ``capacity`` and may have exact int ``weight`` (default 0), ``lower``
+        (default 0, at most the capacity) and positive ``transit``
+        (default 1). Node attributes are ignored.
+
+    horizon : int
+        Last time step; nodes exist for every time ``0 .. horizon``.
+
+    balances : dict
+        Maps ``(node, time)`` to an exact int demand (inflow minus outflow).
+        Missing pairs have demand 0 and all demands must sum to zero.
+
+    storage : dict or None
+        Maps nodes to ``{"capacity": c, "weight": w, "lower": l}`` records
+        (weight and lower optional) describing per-tick hold arcs.
+
+    Returns
+    -------
+    H : MultiDiGraph
+        Nodes are ``(node, time)`` with a ``demand`` attribute. Movement
+        arcs ``(u, d) -> (v, d + transit)`` have key
+        ``("move", u, v, key, d)`` and hold arcs ``(n, t) -> (n, t + 1)``
+        have key ``("hold", n, t)``; every arc has ``capacity``, ``weight``
+        and ``lower`` attributes. ``H.graph["horizon"]`` is `horizon`.
+
+    Raises
+    ------
+    ValueError
+        If any input is malformed.
+
+    Examples
+    --------
+    >>> from networkx.algorithms.flow.timeflow import expand
+    >>> G = nx.DiGraph()
+    >>> G.add_edge("a", "b", capacity=2, transit=1)
+    >>> H = expand(G, 1, {("a", 0): -1, ("b", 1): 1})
+    >>> list(H.edges(keys=True))
+    [(('a', 0), ('b', 1), ('move', 'a', 'b', None, 0))]
+    """
+    edges, balances, storage = _validate(G, horizon, balances, storage)
+    times = range(horizon + 1)
+    H = nx.MultiDiGraph()
+    H.graph["horizon"] = horizon
+    H.add_nodes_from(
+        ((u, t), {"demand": balances.get((u, t), 0)}) for u in G for t in times
+    )
+    for u, v, key, lo, cap, w, transit in edges:
+        for depart in range(horizon + 1 - transit):
+            H.add_edge(
+                (u, depart),
+                (v, depart + transit),
+                key=("move", u, v, key, depart),
+                capacity=cap,
+                weight=w,
+                lower=lo,
+            )
+    for node, (lo, cap, w) in storage.items():
+        for t in range(horizon):
+            H.add_edge(
+                (node, t),
+                (node, t + 1),
+                key=("hold", node, t),
+                capacity=cap,
+                weight=w,
+                lower=lo,
+            )
+    return H
