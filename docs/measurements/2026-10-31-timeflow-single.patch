index 0000000..251d924
--- /dev/null
+++ b/networkx/algorithms/flow/timeaudit.py
@@ -0,0 +1,98 @@
+"""
+Edge outage analysis for temporal transshipment problems.
+"""
+
+import networkx as nx
+from networkx.algorithms.flow.timeflow import _check_label, _validate
+from networkx.algorithms.flow.timeschedule import solve
+
+__all__ = ["analyze"]
+
+
+def _outages(G, scenarios):
+    """Validate `scenarios` and return ``{name: set of (u, v, key)}``."""
+    if not isinstance(scenarios, dict):
+        raise ValueError("scenarios must be a dict")
+    multigraph = G.is_multigraph()
+    result = {}
+    for name, triples in scenarios.items():
+        _check_label(name, "scenario name")
+        if not isinstance(triples, list | tuple):
+            raise ValueError(f"scenario {name!r} must be a list of edges")
+        edges = set()
+        for triple in triples:
+            if not isinstance(triple, tuple | list) or len(triple) != 3:
+                raise ValueError(f"scenario {name!r} edge {triple!r} is not a triple")
+            u, v, key = triple
+            if not (isinstance(u, str) and isinstance(v, str)):
+                raise ValueError(f"scenario {name!r} edge {triple!r} is not in G")
+            if multigraph:
+                valid = isinstance(key, str) and G.has_edge(u, v, key)
+            else:
+                valid = key is None and G.has_edge(u, v)
+            if not valid:
+                raise ValueError(f"scenario {name!r} edge {triple!r} is not in G")
+            edges.add((u, v, key))
+        result[name] = edges
+    return result
+
+
+def analyze(G, horizon, balances, scenarios, storage=None):
+    """Returns the cost impact of independent physical edge outages.
+
+    Parameters
+    ----------
+    G, horizon, balances, storage
+        As in :func:`~networkx.algorithms.flow.timeflow.expand`.
+
+    scenarios : dict
+        Maps nonempty string names to lists of ``(u, v, key)`` physical
+        edges (tuples or lists) removed together; `key` is None for a
+        DiGraph. Each scenario is evaluated independently.
+
+    Returns
+    -------
+    report : dict
+        ``{"baseline_cost": cost, "scenarios": {name: result}}`` with names
+        sorted, where `result` is ``{"feasible": bool, "cost": c,
+        "delta": c - cost}`` and `c` and the delta are None if the
+        scenario is infeasible.
+
+    Raises
+    ------
+    ValueError
+        If any input is malformed.
+
+    NetworkXUnfeasible
+        If the baseline problem is infeasible.
+
+    Examples
+    --------
+    >>> from networkx.algorithms.flow.timeaudit import analyze
+    >>> G = nx.DiGraph()
+    >>> G.add_edge("a", "b", capacity=2, weight=1)
+    >>> G.add_edge("a", "c", capacity=2, weight=1)
+    >>> G.add_edge("c", "b", capacity=2, weight=1)
+    >>> balances = {("a", 0): -1, ("b", 2): 1}
+    >>> storage = {"b": {"capacity": 1}}
+    >>> scenarios = {"cut": [("a", "b", None)], "none": []}
+    >>> analyze(G, 2, balances, scenarios, storage)
+    {'baseline_cost': 1, 'scenarios': {'cut': {'feasible': True, 'cost': 2, 'delta': 1}, 'none': {'feasible': True, 'cost': 1, 'delta': 0}}}
+    """
+    _validate(G, horizon, balances, storage)
+    outages = _outages(G, scenarios)
+    baseline = solve(G, horizon, balances, storage)["cost"]
+    results = {}
+    for name in sorted(outages):
+        H = G.copy()
+        H.remove_edges_from(
+            outages[name] if H.is_multigraph() else (e[:2] for e in outages[name])
+        )
+        try:
+            cost = solve(H, horizon, balances, storage)["cost"]
+        except nx.NetworkXUnfeasible:
+            results[name] = {"feasible": False, "cost": None, "delta": None}
+        else:
+            delta = cost - baseline
+            results[name] = {"feasible": True, "cost": cost, "delta": delta}
+    return {"baseline_cost": baseline, "scenarios": results}
