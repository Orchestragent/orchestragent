@@ -0,0 +1,105 @@
+"""
+Canonical JSON encoding and atomic JSON output for temporal flow tools.
+"""
+
+import json
+import math
+import os
+import tempfile
+
+__all__ = ["canonical_json", "save_json"]
+
+
+def _check_json(value, active):
+    """Raise ValueError unless `value` is strict JSON data.
+
+    `active` holds the ids of the containers currently being checked, to
+    reject circular references.
+    """
+    if value is None or isinstance(value, bool | int | str):
+        return
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError(f"nonfinite number {value!r} is not valid JSON")
+        return
+    if isinstance(value, list | dict):
+        if id(value) in active:
+            raise ValueError("circular reference is not valid JSON")
+        active.add(id(value))
+        if isinstance(value, dict):
+            for key, item in value.items():
+                if not isinstance(key, str):
+                    raise ValueError(f"JSON object key {key!r} is not a string")
+                _check_json(item, active)
+        else:
+            for item in value:
+                _check_json(item, active)
+        active.remove(id(value))
+        return
+    raise ValueError(f"{type(value).__name__} value {value!r} is not valid JSON")
+
+
+def canonical_json(value):
+    """Returns the canonical JSON text of `value`.
+
+    Object keys are sorted, separators are compact and non-ASCII characters
+    are kept, so the UTF-8 encoding of the text is canonical.
+
+    Raises
+    ------
+    ValueError
+        If `value` is not strict JSON data: only None, bools, ints, finite
+        floats, strings, lists and dicts with string keys are allowed.
+
+    Examples
+    --------
+    >>> from networkx.algorithms.flow.timeio import canonical_json
+    >>> canonical_json({"b": [1, None], "a": "é"})
+    '{"a":"é","b":[1,null]}'
+    """
+    try:
+        _check_json(value, set())
+        return json.dumps(
+            value,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        )
+    except (TypeError, RecursionError) as err:
+        raise ValueError(f"value is not valid JSON: {err}") from err
+
+
+def save_json(path, value):
+    """Atomically write the canonical JSON of `value` and a newline to `path`.
+
+    The text is written to a temporary file in the same directory, which
+    then replaces `path`. On error the temporary file is removed and any
+    existing file at `path` is left unchanged.
+
+    Raises
+    ------
+    ValueError
+        If `value` is not strict JSON data.
+
+    OSError
+        If the file cannot be written.
+    """
+    data = (canonical_json(value) + "\n").encode("utf-8")
+    path = os.fspath(path)
+    directory = os.path.dirname(os.path.abspath(path))
+    fd, tmp = tempfile.mkstemp(
+        dir=directory, prefix=f".{os.path.basename(path)}.", suffix=".tmp"
+    )
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+    except BaseException:
+        try:
+            os.unlink(tmp)
+        except OSError:
+            pass
+        raise
diff --git a/networkx/algorithms/flow/timeschedule.py b/networkx/algorithms/flow/timeschedule.py
new file mode 100644
index 0000000..a33babb
--- /dev/null
+++ b/networkx/algorithms/flow/timeschedule.py
@@ -0,0 +1,84 @@
+"""
+Minimum cost schedules for temporal transshipment problems.
+"""
+
+from networkx.algorithms.flow.lowerbound import solve_bounded_flow
+from networkx.algorithms.flow.timeflow import expand
+
+__all__ = ["solve"]
+
+
+def _record(tail, head, hkey, amount):
+    """Return the schedule record of expanded arc ``(tail, head, hkey)``."""
+    return {
+        "kind": hkey[0],
+        "source": tail[0],
+        "target": head[0],
+        "key": hkey[3] if hkey[0] == "move" else None,
+        "depart": tail[1],
+        "arrive": head[1],
+        "amount": amount,
+    }
+
+
+def _record_order(record):
+    """Sort key of schedule records (and of expanded arcs in R5 order)."""
+    key = record["key"]
+    return (
+        record["depart"],
+        record["arrive"],
+        record["source"],
+        record["target"],
+        record["kind"],
+        "" if key is None else key,
+    )
+
+
+def solve(G, horizon, balances, storage=None):
+    """Returns a minimum cost schedule of a temporal transshipment problem.
+
+    The problem is expanded with :func:`~networkx.algorithms.flow.timeflow.expand`
+    and solved with
+    :func:`~networkx.algorithms.flow.lowerbound.solve_bounded_flow`.
+
+    Parameters
+    ----------
+    G, horizon, balances, storage
+        As in :func:`~networkx.algorithms.flow.timeflow.expand`.
+
+    Returns
+    -------
+    schedule : dict
+        ``{"cost": cost, "flow": records}`` where `records` lists every arc
+        with positive flow as a dict with keys ``kind`` (``"move"`` or
+        ``"hold"``), ``source``, ``target``, ``key`` (the physical edge key,
+        None for DiGraph edges and holds), ``depart``, ``arrive`` and
+        ``amount``, sorted by ``(depart, arrive, source, target, kind, key)``.
+
+    Raises
+    ------
+    ValueError
+        If any input is malformed.
+
+    NetworkXUnfeasible
+        If no schedule satisfies all balances and bounds.
+
+    Examples
+    --------
+    >>> from networkx.algorithms.flow.timeschedule import solve
+    >>> G = nx.DiGraph()
+    >>> G.add_edge("a", "b", capacity=2, weight=3)
+    >>> solve(G, 2, {("a", 0): -1, ("b", 2): 1}, storage={"b": {"capacity": 5}})
+    {'cost': 3, 'flow': [{'kind': 'move', 'source': 'a', 'target': 'b', 'key': None, 'depart': 0, 'arrive': 1, 'amount': 1}, {'kind': 'hold', 'source': 'b', 'target': 'b', 'key': None, 'depart': 1, 'arrive': 2, 'amount': 1}]}
+    """
+    H = expand(G, horizon, balances, storage)
+    cost, flow_dict = solve_bounded_flow(H)
+    records = [
+        _record(tail, head, hkey, amount)
+        for tail, nbrs in flow_dict.items()
+        for head, keyed in nbrs.items()
+        for hkey, amount in keyed.items()
+        if amount > 0
+    ]
+    records.sort(key=_record_order)
+    return {"cost": cost, "flow": records}
