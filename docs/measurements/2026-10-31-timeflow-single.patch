+    def test_r7_behavior(self):
+        analyze = timeaudit.analyze
+        M = nx.MultiDiGraph()
+        M.add_edge("a", "b", key="exp", capacity=1, lower=1, weight=5)
+        M.add_edge("a", "b", key="cheap", capacity=1, weight=1)
+        M.add_edge("a", "c", key="k", capacity=1, weight=1)
+        balances = {("a", 0): -1, ("b", 1): 1}
+        scenarios = {
+            "z-both": [("a", "b", "exp"), ["a", "b", "cheap"]],
+            "drop-exp": [["a", "b", "exp"], ("a", "b", "exp")],
+            "a-cheap": (("a", "b", "cheap"),),
+            "empty": [],
+        }
+        before = (_snapshot(M), copy.deepcopy(scenarios))
+        report = analyze(M, 1, balances, scenarios)
+        self.assertEqual(before, (_snapshot(M), scenarios))
+        self.assertEqual(
+            report,
+            {
+                "baseline_cost": 5,
+                "scenarios": {
+                    "a-cheap": {"feasible": True, "cost": 5, "delta": 0},
+                    "drop-exp": {"feasible": True, "cost": 1, "delta": -4},
+                    "empty": {"feasible": True, "cost": 5, "delta": 0},
+                    "z-both": {"feasible": False, "cost": None, "delta": None},
+                },
+            },
+        )
+        self.assertEqual(list(report["scenarios"]), sorted(scenarios))
+        self.assertEqual(analyze(M, 1, balances, {}), {"baseline_cost": 5, "scenarios": {}})
+
+        D = nx.DiGraph()
+        D.add_edge("a", "b", capacity=1, weight=1)
+        report = analyze(D, 1, {("a", 0): -1, ("b", 1): 1}, {"cut": [("a", "b", None)]})
+        self.assertEqual(report["scenarios"]["cut"], {"feasible": False, "cost": None, "delta": None})
+        with self.assertRaises(nx.NetworkXUnfeasible):
+            analyze(D, 1, {("a", 0): -2, ("b", 1): 2}, {"cut": [("a", "b", None)]})
+
+        bad = [
+            (D, {"cut": [("a", "b", "k")]}),
+            (D, {"cut": [("b", "a", None)]}),
+            (D, {"cut": [("a", "b")]}),
+            (D, {"cut": [("a", "b", None, 1)]}),
+            (D, {"cut": "ab"}),
+            (D, {"cut": [{"a", "b", None}]}),
+            (D, {"": []}),
+            (D, {1: []}),
+            (D, [("cut", [])]),
+            (M, {"cut": [("a", "b", None)]}),
+            (M, {"cut": [("a", "b", "nope")]}),
+            (M, {"cut": [(["a"], "b", "exp")]}),
+        ]
+        for G, scen in bad:
+            with self.subTest(scenarios=scen), self.assertRaises(ValueError):
+                analyze(G, 1, {}, scen)
+        with self.assertRaises(ValueError):
+            analyze(D, 1, {("q", 0): 0}, {})
