+        before = copy.deepcopy(schedule)
+        self.assertEqual(paths(D, 2, balances, schedule), expected)
+        self.assertEqual(schedule, before)
+        shuffled = {"cost": schedule["cost"], "flow": schedule["flow"][::-1]}
+        self.assertEqual(paths(D, 2, balances, shuffled), expected)
+        self.assertEqual(
+            [timeio.canonical_json(r) for r in expected],
+            sorted(timeio.canonical_json(r) for r in expected),
+        )
+
+        # Parallel movements and storage, consumed in R5 order.
+        M = nx.MultiDiGraph()
+        M.add_edge("a", "b", key="y", capacity=1, weight=2)
+        M.add_edge("a", "b", key="x", capacity=1, weight=1)
+        balances = {("a", 0): -2, ("a", 1): -1, ("b", 2): 3}
+        storage = {"b": {"capacity": 3}}
+        schedule = solve(M, 2, balances, storage)
+        shipments = paths(M, 2, balances, schedule, storage)
+        hold = {"kind": "hold", "key": None}
+        self.assertEqual(
+            shipments,
+            [
+                {
+                    "amount": 1,
+                    "route": [["a", 0], ["b", 1], ["b", 2]],
+                    "edges": [{"kind": "move", "key": "x"}, hold],
+                },
+                {
+                    "amount": 1,
+                    "route": [["a", 1], ["b", 2]],
+                    "edges": [{"kind": "move", "key": "x"}],
+                },
+                {
+                    "amount": 1,
+                    "route": [["a", 0], ["b", 1], ["b", 2]],
+                    "edges": [{"kind": "move", "key": "y"}, hold],
+                },
+            ],
+        )
+        total = sum(s["amount"] * len(s["edges"]) for s in shipments)
+        self.assertEqual(total, sum(r["amount"] for r in schedule["flow"]))
+        self.assertEqual(paths(nx.DiGraph(), 0, {}, {"cost": 0, "flow": []}), [])
+        self.assertEqual(paths(D, 1, {}, {"cost": 0, "flow": []}), [])
+
+        # A valid but non-optimal schedule is accepted.
+        balances = {("a", 0): -1, ("b", 2): 1}
+        other = {
+            "cost": 2,
+            "flow": [
+                {"kind": "move", "source": "a", "target": "b", "key": "y",
+                 "depart": 0, "arrive": 1, "amount": 1},
+                {"kind": "hold", "source": "b", "target": "b", "key": None,
+                 "depart": 1, "arrive": 2, "amount": 1},
+            ],
+        }  # fmt: skip
+        self.assertEqual(
+            paths(M, 2, balances, other, storage),
+            [
+                {
+                    "amount": 1,
+                    "route": [["a", 0], ["b", 1], ["b", 2]],
+                    "edges": [{"kind": "move", "key": "y"}, hold],
+                }
+            ],
+        )
+
+        def variant(**changes):
+            record = dict(other["flow"][0], **changes)
+            return {"cost": other["cost"], "flow": [record, other["flow"][1]]}
+
+        bad = [
+            {"cost": 2, "flow": other["flow"], "extra": 0},
+            {"cost": 2.0, "flow": other["flow"]},
+            {"cost": True, "flow": other["flow"]},
+            {"cost": 1, "flow": other["flow"]},
+            {"cost": 2, "flow": tuple(other["flow"])},
+            {"cost": 2, "flow": other["flow"][:1]},
+            {"cost": 4, "flow": other["flow"] + other["flow"][:1]},
+            {"cost": 2, "flow": [other["flow"][0], dict(other["flow"][1], amount=0)]},
+            variant(amount=True),
+            variant(amount=1.0),
+            variant(depart=False),
+            variant(key=None),
+            variant(key="z"),
+            variant(kind="hold"),
+            variant(kind="ship"),
+            variant(arrive=2),
+            variant(target="a"),
+            variant(source=["a"]),
+            {"cost": 2, "flow": [dict(other["flow"][0], note=1), other["flow"][1]]},
+            {"cost": 2, "flow": [other["flow"][0], dict(other["flow"][1], key="h")]},
+            [other],
+        ]
+        for schedule in bad:
+            with self.subTest(schedule=schedule), self.assertRaises(ValueError):
+                paths(M, 2, balances, schedule, storage)
+        # Bounds: lower bounds must be met even by unused arcs.
+        L = nx.DiGraph([("a", "b", {"capacity": 2, "lower": 1})])
+        with self.assertRaises(ValueError):
+            paths(L, 1, {}, {"cost": 0, "flow": []})
+        with self.assertRaises(ValueError):
+            paths(D, 1, {("a", 0): -9, ("b", 1): 9}, {"cost": 9, "flow": [
+                {"kind": "move", "source": "a", "target": "b", "key": None,
+                 "depart": 0, "arrive": 1, "amount": 9}]})  # fmt: skip
