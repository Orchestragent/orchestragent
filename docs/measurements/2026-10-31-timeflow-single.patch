+    def test_r8_behavior(self):
+        canonical_json = timeio.canonical_json
+        self.assertEqual(
+            canonical_json({"b": [1, None, True], "a": "é", "c": {"y": 1.5, "x": {}}}),
+            '{"a":"é","b":[1,null,true],"c":{"x":{},"y":1.5}}',
+        )
+        loop = []
+        loop.append(loop)
+        for bad in (float("nan"), float("inf"), {1: 2}, {("a",): 1}, {1, 2}, (1,), b"x", object(), loop):
+            with self.subTest(value=bad), self.assertRaises(ValueError):
+                canonical_json(bad)
+
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "out.json")
+            timeio.save_json(path, {"b": 1, "a": "ü"})
+            with open(path, "rb") as f:
+                self.assertEqual(f.read(), '{"a":"ü","b":1}\n'.encode())
+            with self.assertRaises(ValueError):
+                timeio.save_json(path, {"a": float("nan")})
+            with mock.patch.object(os, "replace", side_effect=OSError("boom")):
+                with self.assertRaises(OSError):
+                    timeio.save_json(path, {"new": 1})
+            with open(path, "rb") as f:
+                self.assertEqual(f.read(), '{"a":"ü","b":1}\n'.encode())
+            self.assertEqual(os.listdir(tmp), ["out.json"])
+            with self.assertRaises(OSError):
+                timeio.save_json(os.path.join(tmp, "missing", "x.json"), {})
+
+            def write(name, data):
+                p = os.path.join(tmp, name)
+                with open(p, "w", encoding="utf-8") as f:
+                    f.write(data if isinstance(data, str) else json.dumps(data))
+                return p
+
+            def run(*argv):
+                out, err = io.StringIO(), io.StringIO()
+                with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+                    code = timecli.main(list(argv))
+                return code, out.getvalue(), err.getvalue()
+
+            problem = {
+                "nodes": ["a", "b"],
+                "edges": [
+                    {"source": "a", "target": "b", "key": "exp", "capacity": 1,
+                     "lower": 1, "weight": 5},
+                    {"source": "a", "target": "b", "key": "cheap", "capacity": 1,
+                     "weight": 1, "transit": 1},
+                ],
+                "horizon": 2,
+                "balances": [
+                    {"node": "a", "time": 0, "demand": -1},
