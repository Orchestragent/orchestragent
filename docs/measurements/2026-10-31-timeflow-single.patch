+                "storage": {"b": {"capacity": 2}},
+                "scenarios": {"x": [["a", "b", "exp"]], "all": [["a", "b", "exp"], ["a", "b", "cheap"]]},
+            }  # fmt: skip
+            inp = write("in.json", problem)
+            G = nx.MultiDiGraph()
+            G.add_nodes_from(problem["nodes"])
+            for e in problem["edges"]:
+                attrs = {k: v for k, v in e.items() if k not in ("source", "target", "key")}
+                G.add_edge(e["source"], e["target"], key=e["key"], **attrs)
+            balances = {(b["node"], b["time"]): b["demand"] for b in problem["balances"]}
+            storage = problem["storage"]
+
+            out = os.path.join(tmp, "solve.json")
+            self.assertEqual(run("solve", inp, "--output", out), (0, "", ""))
+            schedule = timeschedule.solve(G, 2, balances, storage)
+            expected = {
