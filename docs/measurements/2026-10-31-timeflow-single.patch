@@ -0,0 +1,96 @@
+"""
+Maximum (s, t)-flow of minimum cost with lower bounds on edge flows.
+"""
+
+import networkx as nx
+from networkx.algorithms.flow.lowerbound import (
+    _check_digraph,
+    _check_names,
+    _exact_int,
+    _flow_dict,
+    _graph_edges,
+    _index_arcs,
+    _solve_indexed,
+)
+
+__all__ = ["max_flow"]
+
+
+def _check_terminal(G, node, what):
+    try:
+        present = node in G
+    except TypeError:
+        present = False
+    if not present:
+        raise ValueError(f"{what} {node!r} is not a node of G")
+
+
+def max_flow(G, s, t, capacity="capacity", weight="weight", lower="lower"):
+    """Returns a maximum (s, t)-flow of minimum cost respecting lower bounds.
+
+    The flow maximizes the nonnegative net outflow of `s`, conserving flow
+    at every other node except `t`, and minimizes the total cost among all
+    such maximum flows. Edge attributes follow the rules of
+    :func:`~networkx.algorithms.flow.lowerbound.solve_bounded_flow`.
+
+    The problem is solved by two polynomial reductions to bounded minimum
+    cost flow, with an auxiliary return arc ``t -> s``: the first maximizes
+    the return arc flow, the second fixes it and minimizes the cost.
+
+    Parameters
+    ----------
+    G : DiGraph or MultiDiGraph
+        Node ``"demand"`` attributes, if present, must be the exact int 0.
+
+    s, t : nodes
+        Distinct source and sink nodes of `G`.
+
+    capacity, weight, lower : string
+        Edge attribute names as in `solve_bounded_flow`.
+
+    Returns
+    -------
+    flow_dict : dict
+        Flow dict containing every edge of `G`, keyed by edge key for
+        multigraphs.
+
+    Raises
+    ------
+    ValueError
+        If the input is malformed.
+
+    NetworkXUnfeasible
+        If no flow with nonnegative net source outflow respects all bounds.
+
+    Examples
+    --------
+    >>> from networkx.algorithms.flow.lowerbound_max import max_flow
+    >>> G = nx.DiGraph()
+    >>> G.add_edge("s", "a", capacity=4, weight=1)
+    >>> G.add_edge("a", "t", capacity=3, weight=1)
+    >>> G.add_edge("a", "s", capacity=2, lower=1)
+    >>> max_flow(G, "s", "t")
+    {'s': {'a': 4}, 'a': {'t': 3, 's': 1}, 't': {}}
+    """
+    _check_digraph(G)
+    _check_names("demand", capacity, weight, lower)
+    _check_terminal(G, s, "source")
+    _check_terminal(G, t, "sink")
+    if s == t:
+        raise ValueError("source and sink must be distinct")
+    for u, d in G.nodes(data=True):
+        if _exact_int(d.get("demand", 0), f"demand of node {u!r}") != 0:
+            raise ValueError(f"demand of node {u!r} must be 0")
+    edges = _graph_edges(G, capacity, weight, lower)
+    index, arcs = _index_arcs(G, edges)
+    si, ti = index[s], index[t]
+    demands = [0] * len(index)
+    # The net outflow of s is bounded by the total capacity leaving s.
+    bound = sum(cap for u, v, _, _, cap, _ in edges if u == s and v != s)
+    # Phase 1: maximize the flow returning from t to s, ignoring costs.
+    phase1 = [(u, v, lo, cap, 0) for u, v, lo, cap, _ in arcs]
+    phase1.append((ti, si, 0, bound, -1))
+    value = _solve_indexed(demands, phase1)[-1]
+    # Phase 2: fix the flow value and minimize the cost.
+    flows = _solve_indexed(demands, arcs + [(ti, si, value, value, 0)])
+    return _flow_dict(G, edges, flows[:-1])
