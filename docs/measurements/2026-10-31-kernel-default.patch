+    def _active_entries(self):
+        "Return a new list of active entries sorted by priority then count."
+        entries = [entry for entry in self._pq if entry[-1] is not _REMOVED]
+        entries.sort(key=lambda entry: (entry[0], entry[1]))
+        return entries
+
+    def peek_many(self, count=None):
+        """Return up to *count* upcoming tasks in the order successive
+        :meth:`pop` calls would return them, without mutating the
+        queue. *count* is ``None`` (all) or a nonnegative :class:`int`.
+        """
+        if count is not None:
+            if type(count) is not int or count < 0:
+                raise ValueError('count must be None or a nonnegative int')
+            if not count:
+                return []
+        entries = self._active_entries()
+        if count is not None:
+            entries = entries[:count]
+        return [entry[-1] for entry in entries]
+
+    def compact(self):
+        """Remove tombstoned entries from the backend in place, returning
+        the number removed.
+        """
+        backend = self._pq
+        active = [entry for entry in backend if entry[-1] is not _REMOVED]
+        removed = len(backend) - len(active)
+        if not removed:
+            return 0
+        backend[:] = active
+        if isinstance(backend, list) and not isinstance(self, SortedPriorityQueue):
+            # restore the heap invariant for heap-backed queues
+            from heapq import heapify
+            heapify(backend)
+        return removed
+
     def __len__(self):
