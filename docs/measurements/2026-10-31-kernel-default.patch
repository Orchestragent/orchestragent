+class JSONLCheckpointIterator:
+    """Forward iterator over a seekable binary JSON Lines stream that
+    tracks an absolute byte checkpoint, suitable for resumable ingestion.
+
+    Args:
+        file_obj (file): An open, seekable binary file object.
+        offset (int): Absolute byte offset to start reading from. Must be
+            an exact, nonnegative :class:`int` no greater than the stream
+            length. It is used as given, never rounded to a line boundary.
+        ignore_errors (bool): Whether to skip over lines that fail UTF-8
+            decoding or JSON parsing, advancing past them.
+
+    The public :attr:`byte_offset` attribute is the byte position after
+    the last consumed complete line (blank and, when ignored, malformed
+    lines included). Incomplete trailing lines are not consumed.
+    """
+    def __init__(self, file_obj, offset=0, ignore_errors=False):
+        if type(offset) is not int or offset < 0:
+            raise ValueError("'offset' expected a nonnegative int, not %r"
+                             % (offset,))
+        self._file_obj = file_obj
+        file_obj.seek(0, os.SEEK_END)
+        length = file_obj.tell()
+        if offset > length:
+            raise ValueError("'offset' %r exceeds stream length %r"
+                             % (offset, length))
+        file_obj.seek(offset, os.SEEK_SET)
+        self.ignore_errors = bool(ignore_errors)
+        self.byte_offset = offset
+
+    def __iter__(self):
+        return self
+
+    def next(self):
+        fo = self._file_obj
+        while 1:
+            fo.seek(self.byte_offset, os.SEEK_SET)
+            line = fo.readline()
+            if not line.endswith(b'\n'):
+                # incomplete tail or EOF: leave it unconsumed
+                fo.seek(self.byte_offset, os.SEEK_SET)
+                raise StopIteration
+            new_offset = self.byte_offset + len(line)
+            content = line[:-1]
+            if content.endswith(b'\r'):
+                content = content[:-1]
+            if not content.strip():
+                self.byte_offset = new_offset
+                continue
+            try:
+                value = json.loads(content.decode('utf-8'))
+            except (UnicodeDecodeError, ValueError) as exc:
+                if not self.ignore_errors:
+                    fo.seek(self.byte_offset, os.SEEK_SET)
+                    raise ValueError('error parsing line at byte offset %r: %s'
+                                     % (self.byte_offset, exc)) from exc
+                self.byte_offset = new_offset
+                continue
+            self.byte_offset = new_offset
+            return value
+
+    __next__ = next
+
+
 if __name__ == '__main__':
     def _main():
         import sys
