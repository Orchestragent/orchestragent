diff --git a/boltons/taskqueueutils.py b/boltons/taskqueueutils.py
new file mode 100644
index 0000000..38e05be
--- /dev/null
+++ b/boltons/taskqueueutils.py
@@ -0,0 +1,223 @@
+"""Resumable, deduplicating work queue fed from append-only JSONL files.
+
+:class:`CheckpointQueue` combines :mod:`boltons.queueutils`,
+:mod:`boltons.jsonutils` and :mod:`boltons.fileutils` to provide a queue
+whose pending, in-flight and completed task IDs, insertion order and
+per-source input byte offsets can be checkpointed atomically to a JSON file.
+"""
+
+import os
+import json
+import math
+from typing import Any, BinaryIO, Dict, List, Optional, Union
+
+from boltons.queueutils import HeapPriorityQueue
+from boltons.jsonutils import JSONLCheckpointIterator
+from boltons.fileutils import atomic_save_json
+
+__all__ = ['CheckpointQueue']
+
+SCHEMA_VERSION = 1
+
+_STATE_KEYS = {'schema_version', 'next_seq', 'pending', 'in_flight',
+               'completed', 'offsets'}
+_ENTRY_KEYS = {'id', 'payload', 'priority', 'seq'}
+_RECORD_KEYS = {'id', 'payload', 'priority'}
+
+
+def _validate_id(task_id):
+    if not isinstance(task_id, str) or not task_id:
+        raise ValueError('task_id must be a nonempty str')
+
+
+def _snapshot_payload(payload):
+    try:
+        text = json.dumps(payload, allow_nan=False)
+        return json.loads(text)
+    except (TypeError, ValueError, RecursionError) as exc:
+        raise ValueError('payload must be JSON-serializable: %s' % (exc,))
+
+
+def _validate_priority(priority):
+    if type(priority) not in (int, float):
+        raise ValueError('priority must be an exact int or float')
+    if not math.isfinite(priority):
+        raise ValueError('priority must be finite')
+    return priority
+
+
+def _is_nonneg_int(value):
+    return type(value) is int and value >= 0
+
+
+class CheckpointQueue:
+    """Durable priority work queue with at-least-once redelivery of
+    unacknowledged work and permanent deduplication of task IDs.
+
+    Construction loads ``path`` if it exists (``ValueError`` on
+    unsupported or malformed state, file untouched); otherwise starts
+    empty. No method other than :meth:`save` writes to disk.
+    """
+
+    def __init__(self, path: Union[str, os.PathLike]) -> None:
+        self.path = path
+        self._heap = HeapPriorityQueue()
+        self._records = {}
+        self._in_flight = {}
+        self._completed = set()
+        self._next_seq = 0
+        self._offsets = {}
+        if not os.path.exists(path):
+            return
+        try:
+            with open(path, 'rb') as f:
+                raw = f.read()
+            text = raw.decode('utf-8')
+            state = json.loads(text)
+        except (OSError, UnicodeDecodeError, ValueError) as exc:
+            raise ValueError('malformed checkpoint: %s' % (exc,))
+        self._load_state(state)
+
+    def _load_state(self, state):
+        if not isinstance(state, dict) or set(state) != _STATE_KEYS:
+            raise ValueError('malformed checkpoint: bad top-level state')
+        version = state['schema_version']
+        if type(version) is not int or version != SCHEMA_VERSION:
+            raise ValueError('unsupported schema_version')
+        next_seq = state['next_seq']
+        if not _is_nonneg_int(next_seq):
+            raise ValueError('malformed checkpoint: bad next_seq')
+        pending = state['pending']
+        in_flight = state['in_flight']
+        completed = state['completed']
+        offsets = state['offsets']
+        for name, entries in (('pending', pending), ('in_flight', in_flight)):
+            if not isinstance(entries, list):
+                raise ValueError('malformed checkpoint: bad %s' % name)
+        if not isinstance(completed, list):
+            raise ValueError('malformed checkpoint: bad completed')
+        if not isinstance(offsets, dict):
+            raise ValueError('malformed checkpoint: bad offsets')
+        seen_ids = set()
+        seen_seqs = set()
+        loaded = []
+        for name, entries in (('pending', pending), ('in_flight', in_flight)):
+            for entry in entries:
+                if not isinstance(entry, dict) or set(entry) != _ENTRY_KEYS:
+                    raise ValueError('malformed checkpoint: bad %s entry' % name)
+                task_id = entry['id']
+                _validate_id(task_id)
+                snapshot = _snapshot_payload(entry['payload'])
+                priority = _validate_priority(entry['priority'])
+                seq = entry['seq']
+                if not _is_nonneg_int(seq) or seq >= next_seq:
+                    raise ValueError('malformed checkpoint: bad seq')
+                if task_id in seen_ids or seq in seen_seqs:
+                    raise ValueError('malformed checkpoint: duplicate id or seq')
+                seen_ids.add(task_id)
+                seen_seqs.add(seq)
+                loaded.append((seq, task_id, snapshot, priority))
+        for task_id in completed:
+            if not isinstance(task_id, str) or not task_id:
+                raise ValueError('malformed checkpoint: bad completed id')
+            if task_id in seen_ids:
+                raise ValueError('malformed checkpoint: duplicate id')
+            seen_ids.add(task_id)
+        for source_id, offset in offsets.items():
+            if not isinstance(source_id, str) or not source_id:
+                raise ValueError('malformed checkpoint: bad source id')
+            if not _is_nonneg_int(offset):
+                raise ValueError('malformed checkpoint: bad offset')
+        loaded.sort(key=lambda item: item[0])
+        for seq, task_id, snapshot, priority in loaded:
+            self._records[task_id] = {'payload': snapshot,
+                                      'priority': priority,
+                                      'seq': seq}
+            self._heap.add(task_id, priority)
+        self._completed = set(completed)
+        self._next_seq = next_seq
+        self._offsets = dict(offsets)
+
+    def enqueue(self, task_id: str, payload: Any,
+                priority: Union[int, float] = 0) -> bool:
+        """Validate then enqueue; True if accepted, False if the ID is
+        already pending, in-flight or completed. ValueError on invalid
+        input, with no state change."""
+        _validate_id(task_id)
+        payload_snapshot = _snapshot_payload(payload)
+        priority = _validate_priority(priority)
+        if (task_id in self._records or task_id in self._in_flight
+                or task_id in self._completed):
+            return False
+        seq = self._next_seq
+        self._next_seq += 1
+        self._records[task_id] = {'payload': payload_snapshot,
+                                  'priority': priority,
+                                  'seq': seq}
+        self._heap.add(task_id, priority)
+        return True
+
+    def peek(self, count: Optional[int] = None) -> List[str]:
+        """Pending task IDs in pop order, without consuming them."""
+        return self._heap.peek_many(count)
+
+    def pop(self) -> Dict[str, Any]:
+        """Move the top pending task to in-flight and return
+        ``{'id': ..., 'payload': ..., 'priority': ...}``. IndexError if
+        nothing is pending."""
+        task_id = self._heap.pop()
+        record = self._records.pop(task_id)
+        self._in_flight[task_id] = record
+        return {'id': task_id,
+                'payload': record['payload'],
+                'priority': record['priority']}
+
+    def ack(self, task_id: str) -> None:
+        """Mark an in-flight task completed. KeyError otherwise."""
+        if task_id not in self._in_flight:
+            raise KeyError(task_id)
+        del self._in_flight[task_id]
+        self._completed.add(task_id)
+
+    def save(self) -> None:
+        """Atomically persist the full queue state to ``path``."""
+        def _entries(records):
+            items = [{'id': task_id,
+                      'payload': record['payload'],
+                      'priority': record['priority'],
+                      'seq': record['seq']}
+                     for task_id, record in records.items()]
+            items.sort(key=lambda entry: entry['seq'])
+            return items
+
+        state = {'schema_version': SCHEMA_VERSION,
+                 'next_seq': self._next_seq,
+                 'pending': _entries(self._records),
+                 'in_flight': _entries(self._in_flight),
+                 'completed': sorted(self._completed),
+                 'offsets': dict(self._offsets)}
+        atomic_save_json(self.path, state)
+
+    def ingest(self, file_obj: BinaryIO, source_id: str) -> int:
+        """Enqueue complete JSONL records from ``file_obj`` starting at the
+        checkpointed offset for ``source_id``; return the number of newly
+        enqueued tasks."""
+        if not isinstance(source_id, str) or not source_id:
+            raise ValueError('source_id must be a nonempty str')
+        iterator = JSONLCheckpointIterator(
+            file_obj, self._offsets.get(source_id, 0))
+        count = 0
+        try:
+            for value in iterator:
+                if not isinstance(value, dict) or set(value) != _RECORD_KEYS:
+                    raise ValueError('ingest record must be a dict with '
+                                     'exactly id, payload and priority')
+                if self.enqueue(value['id'], value['payload'],
+                                value['priority']):
+                    count += 1
+                self._offsets[source_id] = iterator.byte_offset
+        except ValueError:
+            self._offsets[source_id] = iterator.byte_offset
+            raise
+        self._offsets[source_id] = iterator.byte_offset
+        return count
