+def atomic_save_json(dest_path, value):
+    """Atomically write *value* as a single deterministic UTF-8 JSON
+    document to *dest_path* (a str or :class:`os.PathLike`).
+
+    The document uses sorted keys, compact separators, retained Unicode
+    characters, and exactly one trailing newline. The value is fully
+    serialized before the filesystem is touched, so serialization errors
+    propagate unchanged and leave any existing destination (and any part
+    file) untouched. The write reuses :func:`atomic_save`.
+
+    Returns ``None``.
+    """
+    path = os.fspath(dest_path)
+    text = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False) + '\n'
+    data = text.encode('utf-8')
+    with atomic_save(path) as fo:
+        fo.write(data)
+    return None
+
