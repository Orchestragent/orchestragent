+import copy
+import doctest
+import hashlib
+import json
+import unittest
+
+from boltons.buildgraphutils import BuildGraph
+
+
+def task(deps=(), version='1', resources=None):
+    return {'deps': list(deps), 'version': version,
+            'resources': dict(resources or {})}
+
+
+def manual_fingerprint(task_id, version, resources, deps):
+    payload = {'id': task_id, 'version': version, 'resources': resources,
+               'dependencies': [[dep, key] for dep, key in deps]}
+    text = json.dumps(payload, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False)
+    return hashlib.sha256(text.encode('utf-8')).hexdigest()
+
+
+def all_keys(graph):
+    keys = {}
+    for layer in graph.layers():
+        for task_id in layer:
+            keys[task_id] = graph.fingerprint(
+                task_id, {dep: keys[dep] for dep in graph.spec(task_id)['deps']})
+    return keys
+
+
+class BuildGraphTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = {
+            'app': task(['lib', 'cfg'], resources={'cpu': 2}),
+            'lib': task(),
+            'cfg': task(['lib', 'lib']),
+            'docs': task([]),
+        }
+        self.graph = BuildGraph(self.tasks)
+
+    def test_docstring_examples(self):
+        runner = doctest.DocTestRunner()
+        for test in doctest.DocTestFinder().find(BuildGraph):
+            self.assertEqual(runner.run(test).failed, 0)
+
+    def test_ids_and_layers(self):
+        self.assertEqual(self.graph.ids, ('app', 'lib', 'cfg', 'docs'))
+        self.assertEqual(self.graph.layers(),
+                         [['lib', 'docs'], ['cfg'], ['app']])
+
+    def test_snapshot_of_caller_data(self):
+        self.tasks['app']['deps'].append('docs')
+        self.tasks['app']['resources']['cpu'] = 99
+        self.tasks['new'] = task()
+        self.assertEqual(self.graph.spec('app'),
+                         {'deps': ['lib', 'cfg'], 'version': '1',
+                          'resources': {'cpu': 2}})
+        self.assertEqual(len(self.graph.ids), 4)
+
+    def test_no_mutable_state_exposed(self):
+        spec = self.graph.spec('app')
+        spec['deps'].append('docs')
+        spec['resources']['gpu'] = 1
+        self.graph.layers()[0].append('junk')
+        self.assertEqual(self.graph.spec('app')['deps'], ['lib', 'cfg'])
+        self.assertEqual(self.graph.spec('app')['resources'], {'cpu': 2})
+        self.assertEqual(self.graph.layers()[0], ['lib', 'docs'])
+        with self.assertRaises(AttributeError):
+            self.graph.ids = ()
+
+    def test_spec_copy_matches_input(self):
+        tasks = {'a': {'deps': (), 'version': 'v', 'resources': {}},
+                 'b': {'deps': ['a', 'a'], 'version': 'v', 'resources': {}}}
+        graph = BuildGraph(tasks)
+        self.assertEqual(graph.spec('a'), tasks['a'])
+        self.assertEqual(graph.spec('b'), tasks['b'])
+
+    def test_affected(self):
+        self.assertEqual(self.graph.affected(['lib']), ['app', 'lib', 'cfg'])
+        self.assertEqual(self.graph.affected(['docs']), ['docs'])
+        self.assertEqual(self.graph.affected(['cfg', 'cfg']), ['app', 'cfg'])
+        self.assertEqual(self.graph.affected([]), [])
+
+    def test_unknown_ids_rejected(self):
+        with self.assertRaises(ValueError):
+            self.graph.affected(['nope'])
+        with self.assertRaises(ValueError):
+            self.graph.affected('lib')
+        with self.assertRaises(ValueError):
+            self.graph.spec('nope')
+        with self.assertRaises(ValueError):
+            self.graph.fingerprint('nope', {})
+
+    def test_invalid_tasks_rejected(self):
+        bad_tasks = [
+            {'': task()},
+            {1: task()},
+            {'a': ['deps']},
+            {'a': {'deps': [], 'version': '1'}},
+            {'a': dict(task(), extra=1)},
+            {'a': task(version='')},
+            {'a': task(version=1)},
+            {'a': {'deps': 'b', 'version': '1', 'resources': {}}},
+            {'a': {'deps': {'b'}, 'version': '1', 'resources': {}}},
+            {'a': task(resources={'cpu': True})},
+            {'a': task(resources={'cpu': 0})},
+            {'a': task(resources={'cpu': 1.0})},
+            {'a': task(resources={'': 1})},
+            {'a': {'deps': [], 'version': '1', 'resources': [('cpu', 1)]}},
+            {'a': task(['missing'])},
+            {'a': task(['a'])},
+            {'a': task(['b']), 'b': task(['a'])},
+            [('a', task())],
+        ]
+        for tasks in bad_tasks:
+            with self.subTest(tasks=tasks):
+                with self.assertRaises(ValueError):
+                    BuildGraph(tasks)
+
+    def test_fingerprint_matches_spec(self):
+        lib_key = self.graph.fingerprint('lib', {})
+        self.assertEqual(lib_key, manual_fingerprint('lib', '1', {}, []))
+        cfg_key = self.graph.fingerprint('cfg', {'lib': lib_key})
+        self.assertEqual(cfg_key, manual_fingerprint(
+            'cfg', '1', {}, [('lib', lib_key)]))
+        app_key = self.graph.fingerprint(
+            'app', {'cfg': cfg_key, 'lib': lib_key})
+        self.assertEqual(app_key, manual_fingerprint(
+            'app', '1', {'cpu': 2}, [('lib', lib_key), ('cfg', cfg_key)]))
+        self.assertRegex(app_key, '^[0-9a-f]{64}$')
+
+    def test_fingerprint_non_ascii(self):
+        graph = BuildGraph({'caf\xe9': task(version='☃')})
+        self.assertEqual(graph.fingerprint('caf\xe9', {}),
+                         manual_fingerprint('caf\xe9', '☃', {}, []))
+
+    def test_fingerprint_validates_dependency_keys(self):
+        key = 'a' * 64
+        bad = [
+            {},
+            {'lib': key, 'cfg': key},
+            {'lib': key, 'docs': key},
+            {'lib': key.upper()},
+            {'lib': key[:-1]},
+            {'lib': key + '\n'},
+            {'lib': 7},
+            None,
+        ]
+        for keys in bad:
+            with self.subTest(keys=keys):
+                with self.assertRaises(ValueError):
+                    self.graph.fingerprint('cfg', keys)
+
+    def test_version_change_affects_descendants_only(self):
+        before = all_keys(self.graph)
+        tasks = copy.deepcopy(self.tasks)
+        tasks['cfg']['version'] = '2'
+        after = all_keys(BuildGraph(tasks))
+        changed = sorted(k for k in before if before[k] != after[k])
+        self.assertEqual(changed, ['app', 'cfg'])
+
+
+if __name__ == '__main__':
+    unittest.main()
