+import copy
+import doctest
+import unittest
+
+from boltons.iterutils import dependency_layers
+
+
+class DependencyLayersTest(unittest.TestCase):
+    def test_layers_follow_insertion_order(self):
+        graph = {'app': ['lib', 'cfg'], 'lib': [], 'cfg': ['lib'],
+                 'tool': [], 'docs': ['tool', 'lib']}
+        self.assertEqual(dependency_layers(graph),
+                         [['lib', 'tool'], ['cfg', 'docs'], ['app']])
+
+    def test_empty_graph(self):
+        self.assertEqual(dependency_layers({}), [])
+
+    def test_duplicate_prerequisites_are_deduplicated(self):
+        self.assertEqual(dependency_layers({'b': ['a', 'a', 'a'], 'a': []}),
+                         [['a'], ['b']])
+
+    def test_accepts_any_noncharacter_iterables(self):
+        graph = {'a': (), 'b': iter(['a']), 'c': {'a': 1, 'b': 2}}
+        self.assertEqual(dependency_layers(graph), [['a'], ['b'], ['c']])
+
+    def test_returns_fresh_lists(self):
+        graph = {'a': [], 'b': ['a']}
+        first = dependency_layers(graph)
+        first[0].append('junk')
+        self.assertEqual(dependency_layers(graph), [['a'], ['b']])
+
+    def test_caller_data_unchanged(self):
+        graph = {'c': ['b', 'a', 'b'], 'a': [], 'b': ['a']}
+        before = copy.deepcopy(graph)
+        dependency_layers(graph)
+        self.assertEqual(graph, before)
+        self.assertEqual(list(graph), ['c', 'a', 'b'])
+
+    def test_rejects_malformed_input(self):
+        bad_graphs = [
+            {'': []},
+            {1: []},
+            {None: []},
+            {'a': 'b', 'b': []},
+            {'a': b'b'},
+            {'a': 5},
+            {'a': None},
+            {'a': ['']},
+            {'a': [1]},
+            {'a': ['missing']},
+            {'a': ['a']},
+            {'a': ['b'], 'b': ['a']},
+            {'a': [], 'b': ['c'], 'c': ['d'], 'd': ['b']},
+        ]
+        for graph in bad_graphs:
+            with self.subTest(graph=graph):
+                with self.assertRaises(ValueError):
+                    dependency_layers(graph)
+
+    def test_rejects_non_mapping(self):
+        with self.assertRaises(ValueError):
+            dependency_layers([('a', [])])
+
+    def test_whole_graph_validated(self):
+        # the valid portion is not returned when a later node is invalid
+        with self.assertRaises(ValueError):
+            dependency_layers({'a': [], 'b': ['a'], 'z': ['nope']})
+
+    def test_docstring_examples(self):
+        runner = doctest.DocTestRunner()
+        for test in doctest.DocTestFinder().find(dependency_layers):
+            self.assertEqual(runner.run(test).failed, 0)
+
+    def test_long_chain(self):
+        size = 3000
+        graph = {'n%d' % i: ['n%d' % (i - 1)] if i else []
+                 for i in range(size)}
+        layers = dependency_layers(graph)
+        self.assertEqual(len(layers), size)
+        self.assertEqual(layers[-1], ['n%d' % (size - 1)])
+
+
+if __name__ == '__main__':
+    unittest.main()
