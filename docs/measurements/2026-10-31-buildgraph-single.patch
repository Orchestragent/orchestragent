+"""*Experimental.* ``buildgraphutils`` describes incremental build
+graphs: named tasks, their prerequisites, a version string, and the
+resources each task needs while it runs.
+
+A :class:`BuildGraph` is an immutable, validated snapshot of such a
+description. Its :meth:`~BuildGraph.fingerprint` method derives
+content-addressed cache keys, so that changing one task's version
+changes the keys of that task and its descendants, and nothing else.
+See :mod:`boltons.buildrunutils` for executing a graph.
+"""
+
+import re
+import json
+import hashlib
+from collections.abc import Mapping
+
+from .iterutils import dependency_layers, is_iterable
+
+
+__all__ = ['BuildGraph', 'UnknownTaskError']
+
+
+_TASK_FIELDS = frozenset(['deps', 'version', 'resources'])
+_HEX_KEY_RE = re.compile('[0-9a-f]{64}')
+
+
+class UnknownTaskError(ValueError, KeyError):
+    """Raised when a task ID is not part of a :class:`BuildGraph`. It is
+    a :exc:`ValueError`, and also a :exc:`KeyError` for lookups.
+    """
+    __str__ = Exception.__str__
+
+
+def _is_exact_int(value):
+    return type(value) is int
+
+
+def _check_name(value, desc):
+    if not isinstance(value, str) or not value:
+        raise ValueError('expected nonempty string %s, not: %r'
+                         % (desc, value))
+    return value
+
+
+def _check_resources(task_id, resources):
+    if not isinstance(resources, Mapping):
+        raise ValueError('expected resources mapping for task %r, not: %r'
+                         % (task_id, resources))
+    ret = {}
+    for name, amount in resources.items():
+        _check_name(name, 'resource name')
+        if not _is_exact_int(amount) or amount < 1:
+            raise ValueError('expected positive integer amount of resource'
+                             ' %r for task %r, not: %r'
+                             % (name, task_id, amount))
+        ret[name] = amount
+    return ret
+
+
+class BuildGraph:
+    """An immutable, validated graph of build tasks.
+
+    Args:
+        tasks (dict): An insertion-ordered mapping of nonempty string
+            task IDs to dictionaries with exactly the keys ``deps`` (a
+            list or tuple of prerequisite IDs), ``version`` (a nonempty
+            string), and ``resources`` (a mapping of nonempty resource
+            names to positive integer demands).
+
+    >>> graph = BuildGraph({
+    ...     'compile': {'deps': ['fetch'], 'version': '1', 'resources': {'cpu': 2}},
+    ...     'fetch': {'deps': [], 'version': '1', 'resources': {}},
+    ...     'docs': {'deps': ['fetch'], 'version': '1', 'resources': {}}})
+    >>> graph.ids
+    ('compile', 'fetch', 'docs')
+    >>> graph.layers()
+    [['fetch'], ['compile', 'docs']]
+    >>> graph.affected(['fetch'])
+    ['compile', 'fetch', 'docs']
+
+    The caller's data is copied, so later changes to *tasks* do not
+    affect the graph. Malformed specs, unknown prerequisites,
+    self-dependencies and cycles raise :exc:`ValueError`.
+    """
+    def __init__(self, tasks):
+        if not isinstance(tasks, Mapping):
+            raise ValueError('expected mapping of task IDs to specs, not: %r'
+                             % type(tasks).__name__)
+        raw_deps, versions, resources = {}, {}, {}
+        for task_id, spec in tasks.items():
+            _check_name(task_id, 'task ID')
+            if not isinstance(spec, Mapping):
+                raise ValueError('expected spec mapping for task %r, not: %r'
+                                 % (task_id, spec))
+            fields = set(spec.keys())
+            if fields != _TASK_FIELDS:
+                raise ValueError('expected task %r spec to have exactly the'
+                                 ' fields %r, not: %r'
+                                 % (task_id, sorted(_TASK_FIELDS),
+                                    sorted(fields, key=repr)))
+            deps = spec['deps']
+            if not isinstance(deps, (list, tuple)):
+                raise ValueError('expected list or tuple of deps for task %r,'
+                                 ' not: %r' % (task_id, deps))
+            # remember the container type so spec() can round-trip it
+            raw_deps[task_id] = (list if isinstance(deps, list) else tuple,
+                                 tuple(deps))
+            versions[task_id] = _check_name(spec['version'], 'version')
+            resources[task_id] = _check_resources(task_id, spec['resources'])
+
+        prereqs = {task_id: deps for task_id, (_, deps) in raw_deps.items()}
+        self._layers = dependency_layers(prereqs)
+
+        self._ids = tuple(raw_deps)
+        self._index = {task_id: i for i, task_id in enumerate(self._ids)}
+        self._raw_deps = raw_deps
+        self._deps = {task_id: tuple(dict.fromkeys(deps))
+                      for task_id, deps in prereqs.items()}
+        self._versions = versions
+        self._resources = resources
+        self._dependents = {task_id: [] for task_id in self._ids}
+        for task_id, deps in self._deps.items():
+            for dep in deps:
+                self._dependents[dep].append(task_id)
+
+    @property
+    def ids(self):
+        "A tuple of all task IDs, in insertion order."
+        return self._ids
+
+    def __len__(self):
+        return len(self._ids)
+
+    def __contains__(self, task_id):
+        return isinstance(task_id, str) and task_id in self._index
+
+    def __iter__(self):
+        return iter(self._ids)
+
+    def __repr__(self):
+        return '%s(%r)' % (self.__class__.__name__,
+                           {task_id: self.spec(task_id)
+                            for task_id in self._ids})
+
+    def _check_known(self, task_id):
+        if task_id not in self:
+            raise UnknownTaskError('unknown task ID: %r' % (task_id,))
+        return task_id
+
+    def _check_known_ids(self, task_ids, desc):
+        if isinstance(task_ids, (str, bytes)) or not is_iterable(task_ids):
+            raise ValueError('expected an iterable of %s, not: %r'
+                             % (desc, task_ids))
+        return [self._check_known(task_id) for task_id in task_ids]
+
+    def layers(self):
+        """Return the dependency layers of the graph, as computed by
+        :func:`~boltons.iterutils.dependency_layers`.
+        """
+        return [list(layer) for layer in self._layers]
+
+    def spec(self, task_id):
+        "Return a copy of the spec of task *task_id*."
+        self._check_known(task_id)
+        deps_type, deps = self._raw_deps[task_id]
+        return {'deps': deps_type(deps),
+                'version': self._versions[task_id],
+                'resources': dict(self._resources[task_id])}
+
+    def deps(self, task_id):
+        """Return a tuple of the direct prerequisites of *task_id*,
+        deduplicated and in declared order.
+        """
+        return self._deps[self._check_known(task_id)]
+
+    def resources(self, task_id):
+        "Return a copy of the resource demands of *task_id*."
+        return dict(self._resources[self._check_known(task_id)])
+
+    def affected(self, changed):
+        """Return a list of the IDs in *changed*, plus all of their
+        transitive dependents, in graph insertion order.
+        """
+        to_visit = self._check_known_ids(changed, 'changed task IDs')
+        seen = set(to_visit)
+        while to_visit:
+            for dependent in self._dependents[to_visit.pop()]:
+                if dependent not in seen:
+                    seen.add(dependent)
+                    to_visit.append(dependent)
+        return [task_id for task_id in self._ids if task_id in seen]
+
+    def closure(self, targets):
+        """Return a list of the IDs in *targets*, plus all of their
+        transitive prerequisites, in graph insertion order.
+        """
+        to_visit = self._check_known_ids(targets, 'target task IDs')
+        seen = set(to_visit)
+        while to_visit:
+            for dep in self._deps[to_visit.pop()]:
+                if dep not in seen:
+                    seen.add(dep)
+                    to_visit.append(dep)
+        return [task_id for task_id in self._ids if task_id in seen]
+
+    def fingerprint(self, task_id, dependency_keys):
+        """Return the lowercase SHA-256 hex digest identifying the
+        result of *task_id*, given *dependency_keys*, a mapping of each
+        of the task's direct prerequisites to its own 64-character
+        lowercase hex key.
+
+        The digest covers the task's ID, version, resources and
+        prerequisite keys, so it changes whenever any of those, or any
+        transitive prerequisite's version, changes.
+        """
+        self._check_known(task_id)
+        deps = self._deps[task_id]
+        if not isinstance(dependency_keys, Mapping):
+            raise ValueError('expected mapping of dependency keys, not: %r'
+                             % (dependency_keys,))
+        if len(dependency_keys) != len(deps) \
+           or any(dep not in dependency_keys for dep in deps):
+            raise ValueError('expected dependency keys for exactly %r, not: %r'
+                             % (list(deps), list(dependency_keys)))
+        for dep in deps:
+            key = dependency_keys[dep]
+            if not isinstance(key, str) or not _HEX_KEY_RE.fullmatch(key):
+                raise ValueError('expected 64-character lowercase hex key for'
+                                 ' dependency %r, not: %r' % (dep, key))
+        payload = {'id': task_id,
+                   'version': self._versions[task_id],
+                   'resources': self._resources[task_id],
+                   'dependencies': [[dep, dependency_keys[dep]]
+                                    for dep in deps]}
+        text = json.dumps(payload, sort_keys=True, separators=(',', ':'),
+                          ensure_ascii=False, allow_nan=False)
+        return hashlib.sha256(text.encode('utf-8')).hexdigest()
