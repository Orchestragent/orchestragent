+import json
+import os
+import shutil
+import tempfile
+import unittest
+from unittest import mock
+
+from boltons.buildcacheutils import ResultStore
+
+KEY_A = 'a' * 64
+KEY_B = '0123456789abcdef' * 4
+
+
+class ResultStoreTest(unittest.TestCase):
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+        self.path = os.path.join(self.tmpdir, 'results.json')
+
+    def tearDown(self):
+        shutil.rmtree(self.tmpdir)
+
+    def write(self, data):
+        if isinstance(data, str):
+            data = data.encode('utf-8')
+        with open(self.path, 'wb') as f:
+            f.write(data)
+        return data
+
+    def read(self):
+        with open(self.path, 'rb') as f:
+            return f.read()
+
+    def test_missing_file_starts_empty_without_writing(self):
+        store = ResultStore(self.path)
+        with self.assertRaises(KeyError):
+            store.get(KEY_A)
+        store.put(KEY_A, 1)
+        store.invalidate([KEY_A])
+        self.assertFalse(os.path.exists(self.path))
+
+    def test_put_get_round_trip_copies(self):
+        store = ResultStore(self.path)
+        value = {'list': [1, 2.5, 'x'], 'tuple': (1, 2), 'none': None}
+        store.put(KEY_A, value)
+        value['list'].append('mutated')
+        got = store.get(KEY_A)
+        self.assertEqual(got, {'list': [1, 2.5, 'x'], 'tuple': [1, 2],
+                               'none': None})
+        got['list'].clear()
+        self.assertEqual(store.get(KEY_A)['list'], [1, 2.5, 'x'])
+
+    def test_invalid_keys_and_values(self):
+        store = ResultStore(self.path)
+        for key in ('A' * 64, 'a' * 63, 'g' * 64, None, 1, KEY_A + '\n'):
+            with self.subTest(key=key):
+                with self.assertRaises(ValueError):
+                    store.put(key, 1)
+        for value in (float('nan'), float('inf'), [float('-inf')], {1, 2},
+                      object(), {(1, 2): 'tuple key'}):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    store.put(KEY_A, value)
+        with self.assertRaises(KeyError):
+            store.get(KEY_A)
+
+    def test_failed_put_keeps_previous_value(self):
+        store = ResultStore(self.path)
+        store.put(KEY_A, 'old')
+        with self.assertRaises(ValueError):
+            store.put(KEY_A, float('nan'))
+        self.assertEqual(store.get(KEY_A), 'old')
+
+    def test_save_and_reopen(self):
+        store = ResultStore(self.path)
+        store.put(KEY_A, {'caf\xe9': [1, None, True]})
+        store.put(KEY_B, 'b')
+        store.save()
+        with open(self.path, encoding='utf-8') as f:
+            state = json.load(f)
+        self.assertEqual(state, {'schema_version': 1, 'values': {
+            KEY_A: {'caf\xe9': [1, None, True]}, KEY_B: 'b'}})
+        reopened = ResultStore(self.path)
+        self.assertEqual(reopened.get(KEY_A), {'caf\xe9': [1, None, True]})
+        self.assertEqual(reopened.get(KEY_B), 'b')
+        self.assertEqual(os.listdir(self.tmpdir), ['results.json'])
+
+    def test_invalidate(self):
+        store = ResultStore(self.path)
+        store.put(KEY_A, 1)
+        store.put(KEY_B, 2)
+        self.assertEqual(store.invalidate([KEY_A, KEY_A, 'c' * 64]), 1)
+        with self.assertRaises(KeyError):
+            store.get(KEY_A)
+        self.assertEqual(store.get(KEY_B), 2)
+        self.assertEqual(store.invalidate(iter([KEY_B])), 1)
+        self.assertEqual(store.invalidate([]), 0)
+        with self.assertRaises(ValueError):
+            store.invalidate(KEY_A)
+        with self.assertRaises(ValueError):
+            store.invalidate(['bad'])
+
+    def test_no_implicit_writes(self):
+        original = self.write(json.dumps(
+            {'schema_version': 1, 'values': {KEY_A: 1}}))
+        store = ResultStore(self.path)
+        store.put(KEY_B, 2)
+        store.invalidate([KEY_A])
+        self.assertEqual(self.read(), original)
+        store.save()
+        self.assertEqual(json.loads(self.read().decode('utf-8')),
+                         {'schema_version': 1, 'values': {KEY_B: 2}})
+
+    def test_malformed_files_rejected_and_preserved(self):
+        bad_states = [
+            '',
+            'not json',
+            '[]',
+            '{"values": {}}',
+            '{"schema_version": 1}',
+            '{"schema_version": 1, "values": {}, "extra": 1}',
+            '{"schema_version": 2, "values": {}}',
+            '{"schema_version": true, "values": {}}',
+            '{"schema_version": 1.0, "values": {}}',
+            '{"schema_version": "1", "values": {}}',
+            '{"schema_version": 1, "values": []}',
+            '{"schema_version": 1, "values": {"short": 1}}',
+            '{"schema_version": 1, "values": {"%s": NaN}}' % KEY_A,
+            '{"schema_version": 1, "values": {"%s": 1e999}}' % KEY_A,
+            b'\xff\xfe{}',
+        ]
+        for state in bad_states:
+            with self.subTest(state=state):
+                original = self.write(state)
+                with self.assertRaises(ValueError):
+                    ResultStore(self.path)
+                self.assertEqual(self.read(), original)
+
+    def test_failed_save_preserves_destination(self):
+        original = self.write(json.dumps(
+            {'schema_version': 1, 'values': {KEY_A: 'keep'}}))
+        store = ResultStore(self.path)
+        store.put(KEY_B, 'new')
+        with mock.patch('boltons.fileutils.atomic_rename',
+                        side_effect=OSError('disk on fire')):
+            with self.assertRaises(OSError):
+                store.save()
+        self.assertEqual(self.read(), original)
+        self.assertEqual(os.listdir(self.tmpdir), ['results.json'])
+        store.save()  # a later save still works
+        self.assertEqual(ResultStore(self.path).get(KEY_B), 'new')
+
+
+if __name__ == '__main__':
+    unittest.main()
