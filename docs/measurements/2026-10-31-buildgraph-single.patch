@@ -0,0 +1,190 @@
+import threading
+import time
+import unittest
+
+from boltons.buildgraphutils import BuildGraph
+from boltons.buildrunutils import BuildRunner
+
+TIMEOUT = 5
+
+
+def task(deps=(), version='1', resources=None):
+    return {'deps': list(deps), 'version': version,
+            'resources': dict(resources or {})}
+
+
+class ActiveCounter:
+    "Records the peak concurrency of callbacks, overall and per group."
+    def __init__(self, delay=0.03):
+        self.lock = threading.Lock()
+        self.delay = delay
+        self.active = {}
+        self.peak = {}
+        self.order = []
+
+    def fn(self, name, groups=(), value=None):
+        def callback(deps):
+            with self.lock:
+                self.order.append(name)
+                for group in ('all',) + tuple(groups):
+                    self.active[group] = self.active.get(group, 0) + 1
+                    self.peak[group] = max(self.peak.get(group, 0),
+                                           self.active[group])
+            time.sleep(self.delay)
+            with self.lock:
+                for group in ('all',) + tuple(groups):
+                    self.active[group] -= 1
+            return name if value is None else value
+        return callback
+
+
+class BuildRunnerConfigTest(unittest.TestCase):
+    def setUp(self):
+        self.graph = BuildGraph({'a': task(resources={'gpu': 1}),
+                                 'b': task(['a'])})
+        self.calls = []
+        self.functions = {'a': lambda deps: self.calls.append('a'),
+                          'b': lambda deps: self.calls.append('b')}
+
+    def make(self, **kw):
+        kw.setdefault('capacities', {'gpu': 1})
+        return BuildRunner(self.graph, kw.pop('functions', self.functions),
+                           **kw)
+
+    def test_valid_configuration(self):
+        runner = self.make(max_workers=1, retries=0, capacities={'gpu': 2})
+        self.assertEqual(runner.run()['states'], {'a': 'done', 'b': 'done'})
+
+    def test_invalid_configuration(self):
+        bad = [
+            dict(functions={'a': len}),
+            dict(functions={'a': len, 'b': len, 'c': len}),
+            dict(functions={'a': len, 'b': 'not callable'}),
+            dict(functions=[('a', len), ('b', len)]),
+            dict(max_workers=0),
+            dict(max_workers=True),
+            dict(max_workers=2.0),
+            dict(retries=-1),
+            dict(retries=False),
+            dict(retries=1.0),
+            dict(capacities=None),
+            dict(capacities={}),
+            dict(capacities={'gpu': 0}),
+            dict(capacities={'gpu': True}),
+            dict(capacities={'gpu': 1, '': 1}),
+            dict(capacities=[('gpu', 1)]),
+        ]
+        for kwargs in bad:
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    self.make(**kwargs)
+        with self.assertRaises(ValueError):
+            BuildRunner({'a': task()}, {'a': len})
+        greedy = BuildGraph({'a': task(resources={'gpu': 3})})
+        with self.assertRaises(ValueError):
+            BuildRunner(greedy, {'a': len}, capacities={'gpu': 2})
+        self.assertEqual(self.calls, [])
+
+    def test_unused_capacities_allowed(self):
+        runner = self.make(capacities={'gpu': 1, 'disk': 4})
+        self.assertEqual(runner.run()['states']['b'], 'done')
+
+
+class BuildRunnerSchedulingTest(unittest.TestCase):
+    def test_independent_nodes_run_concurrently(self):
+        names = ['n%d' % i for i in range(4)]
+        graph = BuildGraph({name: task() for name in names})
+        barrier = threading.Barrier(4, timeout=TIMEOUT)
+
+        def fn(deps):
+            barrier.wait()  # only passes if all four run at once
+            return 1
+
+        report = BuildRunner(graph, {name: fn for name in names},
+                             max_workers=4).run()
+        self.assertEqual(report['max_active'], 4)
+        self.assertEqual(set(report['states'].values()), {'done'})
+
+    def test_max_workers_bound(self):
+        names = ['n%d' % i for i in range(6)]
+        graph = BuildGraph({name: task() for name in names})
+        counter = ActiveCounter()
+        report = BuildRunner(graph, {n: counter.fn(n) for n in names},
+                             max_workers=2).run()
+        self.assertEqual(counter.peak['all'], 2)
+        self.assertEqual(report['max_active'], 2)
+
+    def test_resource_capacity_bound(self):
+        tasks = {'g%d' % i: task(resources={'gpu': 1}) for i in range(4)}
+        tasks.update({'big': task(resources={'gpu': 2, 'cpu': 1}),
+                      'c1': task(resources={'cpu': 1}),
+                      'c2': task(resources={'cpu': 1})})
+        graph = BuildGraph(tasks)
+        counter = ActiveCounter()
+        functions = {}
+        for name, spec in tasks.items():
+            functions[name] = counter.fn(name, groups=spec['resources'])
+        report = BuildRunner(graph, functions, max_workers=8,
+                             capacities={'gpu': 2, 'cpu': 1}).run()
+        self.assertEqual(set(report['states'].values()), {'done'})
+        self.assertLessEqual(counter.peak['gpu'], 2)
+        self.assertEqual(counter.peak['cpu'], 1)
+        self.assertLessEqual(report['max_active'], 3)
+        self.assertEqual(report['max_active'], counter.peak['all'])
+
+    def test_resource_demand_sum_is_respected(self):
+        graph = BuildGraph({'big': task(resources={'mem': 3}),
+                            'small': task(resources={'mem': 2})})
+        counter = ActiveCounter()
+        BuildRunner(graph, {'big': counter.fn('big'),
+                            'small': counter.fn('small')},
+                    capacities={'mem': 4}).run()
+        self.assertEqual(counter.peak['all'], 1)
+
+    def test_ready_admission_follows_insertion_order(self):
+        graph = BuildGraph({'z': task(), 'b': task(['m']), 'm': task(),
+                            'a': task()})
+        counter = ActiveCounter(delay=0)
+        BuildRunner(graph, {n: counter.fn(n) for n in graph.ids},
+                    max_workers=1).run()
+        self.assertEqual(counter.order, ['z', 'm', 'b', 'a'])
+
+    def test_resources_released_after_failures(self):
+        graph = BuildGraph({'bad': task(resources={'lock': 1}),
+                            'bad_json': task(resources={'lock': 1}),
+                            'good': task(resources={'lock': 1})})
+
+        def raise_error(deps):
+            raise RuntimeError('nope')
+
+        report = BuildRunner(graph, {'bad': raise_error,
+                                     'bad_json': lambda deps: {1, 2},
+                                     'good': lambda deps: 'ok'},
+                             capacities={'lock': 1}).run()
+        self.assertEqual(report['states'], {'bad': 'failed',
+                                            'bad_json': 'failed',
+                                            'good': 'done'})
+
+    def test_constrained_graph_does_not_deadlock(self):
+        tasks = {}
+        for i in range(20):
+            deps = ['t%d' % (i - 1)] if i % 3 else []
+            tasks['t%d' % i] = task(deps, resources={'r': 1 + i % 2})
+        graph = BuildGraph(tasks)
+        result = {}
+
+        def run():
+            result['report'] = BuildRunner(
+                graph, {name: (lambda deps: 0) for name in tasks},
+                max_workers=3, capacities={'r': 2}).run()
+
+        thread = threading.Thread(target=run)
+        thread.daemon = True
+        thread.start()
+        thread.join(TIMEOUT * 2)
+        self.assertFalse(thread.is_alive())
+        self.assertEqual(set(result['report']['states'].values()), {'done'})
+
+
+if __name__ == '__main__':
+    unittest.main()
