+import doctest
+import threading
+import unittest
+
+from boltons import buildrunutils
+from boltons.buildgraphutils import BuildGraph
+from boltons.buildrunutils import BuildRunner
+
+REPORT_KEYS = {'results', 'states', 'errors', 'attempts', 'max_active'}
+
+
+def task(deps=(), version='1', resources=None):
+    return {'deps': list(deps), 'version': version,
+            'resources': dict(resources or {})}
+
+
+class BuildRunnerRunTest(unittest.TestCase):
+    def setUp(self):
+        # two components: d <- b <- a, d <- c ... and x <- y
+        self.graph = BuildGraph({
+            'a': task(['b', 'c']),
+            'b': task(['d']),
+            'c': task(['d']),
+            'd': task(),
+            'y': task(['x']),
+            'x': task(),
+        })
+        self.calls = []
+        self.lock = threading.Lock()
+
+    def fn(self, name, fail=False):
+        def callback(deps):
+            with self.lock:
+                self.calls.append(name)
+            if fail:
+                raise ValueError('%s exploded' % name)
+            return {'name': name, 'deps': deps}
+        return callback
+
+    def functions(self, failing=()):
+        return {name: self.fn(name, fail=name in failing)
+                for name in self.graph.ids}
+
+    def test_docstring_examples(self):
+        runner = doctest.DocTestRunner()
+        tests = doctest.DocTestFinder().find(buildrunutils)
+        self.assertTrue(any(test.examples for test in tests))
+        for test in tests:
+            self.assertEqual(runner.run(test).failed, 0)
+
+    def test_full_run_report(self):
+        report = BuildRunner(self.graph, self.functions()).run()
+        self.assertEqual(set(report), REPORT_KEYS)
+        ids = list(self.graph.ids)
+        for field in ('results', 'states', 'attempts'):
+            self.assertEqual(list(report[field]), ids)
+        self.assertEqual(report['errors'], {})
+        self.assertEqual(set(report['states'].values()), {'done'})
+        self.assertEqual(report['attempts'], dict.fromkeys(ids, 1))
+        self.assertGreaterEqual(report['max_active'], 1)
+        d_result = {'name': 'd', 'deps': {}}
+        self.assertEqual(report['results']['b'],
+                         {'name': 'b', 'deps': {'d': d_result}})
+        self.assertEqual(list(report['results']['a']['deps']), ['b', 'c'])
+
+    def test_targets_select_prerequisite_closure(self):
+        report = BuildRunner(self.graph, self.functions()).run(['b', 'y', 'b'])
+        self.assertEqual(list(report['states']), ['b', 'd', 'y', 'x'])
+        self.assertEqual(sorted(self.calls), ['b', 'd', 'x', 'y'])
+
+    def test_generator_targets(self):
+        report = BuildRunner(self.graph, self.functions()).run(
+            name for name in ['c'])
+        self.assertEqual(list(report['results']), ['c', 'd'])
+
+    def test_invalid_targets_rejected_before_callbacks(self):
+        runner = BuildRunner(self.graph, self.functions())
+        for targets in ('a', ['a', 'nope'], [None], 5):
+            with self.subTest(targets=targets):
+                with self.assertRaises(ValueError):
+                    runner.run(targets)
+        self.assertEqual(self.calls, [])
+
+    def test_empty_selection(self):
+        runner = BuildRunner(self.graph, self.functions())
+        self.assertEqual(runner.run([]), {
+            'results': {}, 'states': {}, 'errors': {}, 'attempts': {},
+            'max_active': 0})
+        empty = BuildRunner(BuildGraph({}), {})
+        self.assertEqual(empty.run(), {
+            'results': {}, 'states': {}, 'errors': {}, 'attempts': {},
+            'max_active': 0})
+
+    def test_failure_blocks_dependents_only(self):
+        report = BuildRunner(self.graph, self.functions(failing=['b'])).run()
+        self.assertEqual(report['states'], {
+            'a': 'blocked', 'b': 'failed', 'c': 'done', 'd': 'done',
+            'y': 'done', 'x': 'done'})
+        self.assertEqual(report['errors'], {'b': 'ValueError: b exploded'})
+        self.assertEqual(list(report['results']), ['c', 'd', 'y', 'x'])
+        self.assertEqual(report['attempts'], {
+            'a': 0, 'b': 1, 'c': 1, 'd': 1, 'y': 1, 'x': 1})
+        self.assertNotIn('a', self.calls)
+
+    def test_transitive_blocking(self):
+        report = BuildRunner(self.graph, self.functions(failing=['d'])).run()
+        self.assertEqual(report['states'], {
+            'a': 'blocked', 'b': 'blocked', 'c': 'blocked', 'd': 'failed',
+            'y': 'done', 'x': 'done'})
+
+    def test_dependency_results_visible_only_after_success(self):
+        started = threading.Event()
+        seen = {}
+
+        def slow_d(deps):
+            started.set()
+            return 'd-result'
+
+        def b(deps):
+            seen['b'] = dict(deps)
+            return 'b'
+
+        functions = self.functions()
+        functions.update({'d': slow_d, 'b': b})
+        BuildRunner(self.graph, functions).run(['b'])
+        self.assertEqual(seen['b'], {'d': 'd-result'})
+
+    def test_max_active_zero_when_all_reused(self):
+        runner = BuildRunner(self.graph, self.functions())
+        runner.run()
+        report = runner.run()
+        self.assertEqual(set(report['states'].values()), {'cached'})
+        self.assertEqual(report['max_active'], 0)
+        self.assertEqual(set(report['attempts'].values()), {0})
+
+
+if __name__ == '__main__':
+    unittest.main()
