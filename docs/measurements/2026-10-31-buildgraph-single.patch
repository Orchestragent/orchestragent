@@ -0,0 +1,154 @@
+import copy
+import json
+import os
+import shutil
+import tempfile
+import threading
+import unittest
+from unittest import mock
+
+from boltons.buildcacheutils import ResultStore
+from boltons.buildgraphutils import BuildGraph
+from boltons.buildrunutils import BuildRunner
+
+
+def task(deps=(), version='1', resources=None):
+    return {'deps': list(deps), 'version': version,
+            'resources': dict(resources or {})}
+
+
+TASKS = {
+    'fetch': task(),
+    'compile': task(['fetch']),
+    'test': task(['compile']),
+    'lint': task(['fetch']),
+    'docs': task(),
+    'site': task(['docs']),
+}
+
+
+class CountingStore(ResultStore):
+    def __init__(self, path):
+        super().__init__(path)
+        self.saves = 0
+
+    def save(self):
+        self.saves += 1
+        return super().save()
+
+
+class BuildRunnerStoreTest(unittest.TestCase):
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+        self.path = os.path.join(self.tmpdir, 'build-cache.json')
+        self.calls = []
+        self.lock = threading.Lock()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmpdir)
+
+    def functions(self, failing=()):
+        def make(name):
+            def callback(deps):
+                with self.lock:
+                    self.calls.append(name)
+                if name in failing:
+                    raise RuntimeError('%s failed' % name)
+                return {'name': name, 'inputs': sorted(deps)}
+            return callback
+        return {name: make(name) for name in TASKS}
+
+    def run_build(self, tasks=TASKS, failing=(), targets=None, store=None):
+        store = store if store is not None else CountingStore(self.path)
+        runner = BuildRunner(BuildGraph(tasks), self.functions(failing),
+                             store=store)
+        return runner.run(targets), store
+
+    def test_successes_persist_and_are_reused(self):
+        first, store = self.run_build()
+        self.assertEqual(store.saves, 1)
+        self.assertEqual(set(first['states'].values()), {'done'})
+        with open(self.path, encoding='utf-8') as f:
+            self.assertEqual(len(json.load(f)['values']), len(TASKS))
+
+        self.calls[:] = []
+        second, _ = self.run_build()
+        self.assertEqual(self.calls, [])
+        self.assertEqual(set(second['states'].values()), {'cached'})
+        self.assertEqual(second['results'], first['results'])
+        self.assertEqual(second['max_active'], 0)
+
+    def test_partial_failure_persists_successes_only(self):
+        first, store = self.run_build(failing=['compile'])
+        self.assertEqual(store.saves, 1)
+        self.assertEqual(first['states'], {
+            'fetch': 'done', 'compile': 'failed', 'test': 'blocked',
+            'lint': 'done', 'docs': 'done', 'site': 'done'})
+        with open(self.path, encoding='utf-8') as f:
+            self.assertEqual(len(json.load(f)['values']), 4)
+
+        self.calls[:] = []
+        second, _ = self.run_build()
+        self.assertEqual(sorted(self.calls), ['compile', 'test'])
+        self.assertEqual(second['states'], {
+            'fetch': 'cached', 'compile': 'done', 'test': 'done',
+            'lint': 'cached', 'docs': 'cached', 'site': 'cached'})
+        self.assertEqual(second['attempts'], {
+            'fetch': 0, 'compile': 1, 'test': 1,
+            'lint': 0, 'docs': 0, 'site': 0})
+
+    def test_version_change_recomputes_exact_descendants(self):
+        self.run_build()
+        tasks = copy.deepcopy(TASKS)
+        tasks['compile']['version'] = '2'
+        self.calls[:] = []
+        report, _ = self.run_build(tasks=tasks)
+        self.assertEqual(sorted(self.calls), ['compile', 'test'])
+        self.assertEqual(
+            sorted(k for k, v in report['states'].items() if v == 'done'),
+            sorted(BuildGraph(tasks).affected(['compile'])))
+
+        # the old version's results are still in the store as well
+        self.calls[:] = []
+        self.run_build()
+        self.assertEqual(self.calls, [])
+
+    def test_version_change_with_targets(self):
+        self.run_build()
+        tasks = copy.deepcopy(TASKS)
+        tasks['fetch']['version'] = '2'
+        self.calls[:] = []
+        report, _ = self.run_build(tasks=tasks, targets=['lint', 'site'])
+        self.assertEqual(report['states'], {
+            'fetch': 'done', 'lint': 'done', 'docs': 'cached',
+            'site': 'cached'})
+        self.assertEqual(sorted(self.calls), ['fetch', 'lint'])
+
+    def test_store_lookup_skips_dependency_reuse_when_upstream_fails(self):
+        self.run_build()
+        tasks = copy.deepcopy(TASKS)
+        tasks['fetch']['version'] = '2'
+        report, _ = self.run_build(tasks=tasks, failing=['fetch'])
+        self.assertEqual(report['states']['compile'], 'blocked')
+        self.assertEqual(report['states']['site'], 'cached')
+
+    def test_save_failure_propagates_and_preserves_file(self):
+        self.run_build(targets=['docs'])
+        with open(self.path, 'rb') as f:
+            original = f.read()
+        with mock.patch('boltons.fileutils.atomic_rename',
+                        side_effect=OSError('no space')):
+            with self.assertRaises(OSError):
+                self.run_build()
+        with open(self.path, 'rb') as f:
+            self.assertEqual(f.read(), original)
+        self.assertEqual(os.listdir(self.tmpdir), ['build-cache.json'])
+
+    def test_empty_selection_saves_once(self):
+        report, store = self.run_build(targets=[])
+        self.assertEqual(report['states'], {})
+        self.assertEqual(store.saves, 1)
+
+
+if __name__ == '__main__':
+    unittest.main()
