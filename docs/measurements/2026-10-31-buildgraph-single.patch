+class SingleFlightCache:
+    """A threadsafe, :class:`LRU`-backed cache which makes sure that
+    concurrent misses for the same key share a single computation.
+
+    Args:
+        max_size (int): Max number of computed values to keep. Defaults
+            to ``128``.
+
+    >>> cache = SingleFlightCache(max_size=2)
+    >>> cache.get_or_compute('answer', lambda: 42)
+    42
+    >>> cache.get_or_compute('answer', lambda: 0)  # cached, not recomputed
+    42
+    >>> cache.invalidate('answer'), cache.invalidate('answer')
+    (True, False)
+
+    While one thread runs the *factory* for a key, other threads asking
+    for that key wait for and receive the very same result object (or
+    exception). Different keys compute concurrently, and no
+    cache-wide lock is held while user code runs or callers wait.
+    Exceptions are never cached, so a later call retries the
+    computation.
+    """
+    def __init__(self, max_size=DEFAULT_MAX_SIZE):
+        if (isinstance(max_size, bool) or not isinstance(max_size, int)
+                or max_size < 1):
+            raise ValueError('expected integer max_size >= 1, not %r'
+                             % (max_size,))
+        self.max_size = max_size
+        self._cache = LRU(max_size=max_size)
+        self._in_flight = {}
+        self._lock = threading.Lock()
+        self._local = threading.local()
+
+    def get_or_compute(self, key, factory):
+        """Return the value cached for *key*, computing it with the
+        zero-argument callable *factory* on a miss. If another thread
+        is already computing *key*, wait for and share its outcome.
+
+        Raises :exc:`RuntimeError` if *factory* recursively requests
+        the key it is computing, rather than deadlocking.
+        """
+        hash(key)  # fail fast, before registering anything
+        if not callable(factory):
+            raise TypeError('expected callable factory, not: %r' % (factory,))
+        computing = self._local.__dict__.setdefault('computing', set())
+        with self._lock:
+            if key in computing:
+                raise RuntimeError('recursive computation of key %r' % (key,))
+            if key in self._cache:
+                return self._cache[key]
+            flight = self._in_flight.get(key)
+            is_owner = flight is None
+            if is_owner:
+                flight = self._in_flight[key] = _Flight()
+
+        if not is_owner:
+            flight.done.wait()
+            if flight.error is not None:
+                raise flight.error
+            return flight.value
+
+        computing.add(key)
+        try:
+            flight.value = factory()
+        except BaseException as e:
+            flight.error = e
+            raise
+        finally:
+            computing.discard(key)
+            with self._lock:
+                # an invalidated flight's result is shared with its
+                # existing callers but must not enter the cache
+                if self._in_flight.get(key) is flight:
+                    del self._in_flight[key]
+                    if flight.error is None:
+                        self._cache[key] = flight.value
+            flight.done.set()
+        return flight.value
+
+    def get(self, key, default=None):
+        """Return the completed value cached for *key*, or *default*.
+        Never computes and never waits on in-flight work.
+        """
+        with self._lock:
+            return self._cache.get(key, default)
+
+    def invalidate(self, key):
+        """Drop *key* from the cache, and keep any in-flight computation
+        of it from being cached. Callers already waiting on that
+        computation still receive its outcome. Returns whether *key*
+        was cached or in flight.
+        """
+        with self._lock:
+            cached = key in self._cache
+            if cached:
+                del self._cache[key]
+            in_flight = self._in_flight.pop(key, None) is not None
+            return cached or in_flight
+
+    def clear(self):
+        "Invalidate every cached and in-flight key."
+        with self._lock:
+            self._cache.clear()
+            self._in_flight.clear()
+
+    def __len__(self):
+        with self._lock:
+            return len(self._cache)
+
+    def __contains__(self, key):
+        with self._lock:
+            return key in self._cache
+
+    def __repr__(self):
+        cn = self.__class__.__name__
+        return '%s(max_size=%r)' % (cn, self.max_size)
+
