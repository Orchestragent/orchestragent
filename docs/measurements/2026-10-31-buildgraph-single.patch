+def dependency_layers(graph):
+    """Group the nodes of a dependency graph into layers, where every
+    node in a layer depends only on nodes in earlier layers.
+
+    *graph* maps nonempty string IDs to iterables of prerequisite
+    IDs. Each layer contains all of the IDs whose prerequisites have
+    been satisfied by previous layers, in the original insertion order
+    of *graph*.
+
+    >>> dependency_layers({'app': ['lib', 'cfg'], 'lib': [], 'cfg': ['lib']})
+    [['lib'], ['cfg'], ['app']]
+    >>> dependency_layers({'b': ['a', 'a'], 'c': [], 'a': []})
+    [['c', 'a'], ['b']]
+    >>> dependency_layers({})
+    []
+
+    The whole graph is validated before any layers are computed. A
+    :exc:`ValueError` is raised for malformed IDs, string
+    prerequisite "iterables", unknown prerequisites, self-dependencies,
+    and cycles. *graph* itself is never modified.
+    """
+    if not isinstance(graph, Mapping):
+        raise ValueError('expected a mapping of IDs to prerequisites, not: %r'
+                         % type(graph).__name__)
+    prereqs = {}
+    for node_id, deps in graph.items():
+        if not isinstance(node_id, str) or not node_id:
+            raise ValueError('expected nonempty string ID, not: %r'
+                             % (node_id,))
+        if isinstance(deps, (str, bytes)) or not is_iterable(deps):
+            raise ValueError('expected an iterable of prerequisite IDs for %r,'
+                             ' not: %r' % (node_id, deps))
+        node_prereqs = {}  # dict as an insertion-ordered set
+        for dep in deps:
+            if not isinstance(dep, str) or not dep:
+                raise ValueError('expected nonempty string prerequisite ID'
+                                 ' for %r, not: %r' % (node_id, dep))
+            node_prereqs[dep] = None
+        prereqs[node_id] = list(node_prereqs)
+
+    order = {node_id: i for i, node_id in enumerate(prereqs)}
+    dependents = {node_id: [] for node_id in prereqs}
+    for node_id, node_prereqs in prereqs.items():
+        for dep in node_prereqs:
+            if dep == node_id:
+                raise ValueError('%r depends on itself' % node_id)
+            if dep not in prereqs:
+                raise ValueError('%r depends on unknown ID %r'
+                                 % (node_id, dep))
+            dependents[dep].append(node_id)
+
+    remaining = {node_id: len(deps) for node_id, deps in prereqs.items()}
+    layer = [node_id for node_id, count in remaining.items() if not count]
+    layers = []
+    while layer:
+        layers.append(layer)
+        next_layer = []
+        for node_id in layer:
+            for dependent in dependents[node_id]:
+                remaining[dependent] -= 1
+                if not remaining[dependent]:
+                    next_layer.append(dependent)
+        layer = sorted(next_layer, key=order.__getitem__)
+
+    if sum(len(layer) for layer in layers) < len(prereqs):
+        cyclic = [node_id for node_id, count in remaining.items() if count]
+        raise ValueError('dependency cycle among: %r' % cyclic)
+    return layers
+
+
