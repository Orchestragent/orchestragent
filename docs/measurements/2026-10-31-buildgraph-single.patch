+import doctest
+import threading
+import time
+import unittest
+
+from boltons.cacheutils import SingleFlightCache
+
+TIMEOUT = 5
+
+
+def _start(target, *args):
+    thread = threading.Thread(target=target, args=args)
+    thread.daemon = True
+    thread.start()
+    return thread
+
+
+class SingleFlightCacheTest(unittest.TestCase):
+    def test_docstring_examples(self):
+        runner = doctest.DocTestRunner()
+        for test in doctest.DocTestFinder().find(SingleFlightCache):
+            self.assertEqual(runner.run(test).failed, 0)
+
+    def test_compute_then_hit(self):
+        cache = SingleFlightCache()
+        calls = []
+
+        def factory():
+            calls.append(1)
+            return ['value']
+
+        first = cache.get_or_compute('k', factory)
+        second = cache.get_or_compute('k', factory)
+        self.assertIs(first, second)
+        self.assertEqual(len(calls), 1)
+
+    def test_hashable_keys_and_unhashable_rejected(self):
+        cache = SingleFlightCache()
+        self.assertEqual(cache.get_or_compute(('a', 1), lambda: 1), 1)
+        with self.assertRaises(TypeError):
+            cache.get_or_compute(['a'], lambda: 1)
+
+    def test_invalid_max_size(self):
+        for bad in (True, False, 0, -1, 1.5, '3', None):
+            with self.subTest(max_size=bad):
+                with self.assertRaises(ValueError):
+                    SingleFlightCache(max_size=bad)
+        SingleFlightCache(max_size=1)
+
+    def test_lru_eviction(self):
+        cache = SingleFlightCache(max_size=1)
+        cache.get_or_compute('a', lambda: 1)
+        cache.get_or_compute('b', lambda: 2)
+        self.assertEqual(cache.get_or_compute('a', lambda: 3), 3)
+
+    def test_concurrent_misses_share_one_result(self):
+        cache = SingleFlightCache()
+        started, release = threading.Event(), threading.Event()
+        calls = []
+
+        def factory():
+            calls.append(1)
+            started.set()
+            release.wait(TIMEOUT)
+            return object()
+
+        results = []
+        threads = [_start(lambda: results.append(
+            cache.get_or_compute('k', factory)))]
+        self.assertTrue(started.wait(TIMEOUT))
+        threads += [_start(lambda: results.append(
+            cache.get_or_compute('k', factory))) for _ in range(5)]
+        time.sleep(0.05)
+        release.set()
+        for thread in threads:
+            thread.join(TIMEOUT)
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(len(results), 6)
+        self.assertTrue(all(result is results[0] for result in results))
+
+    def test_different_keys_compute_concurrently(self):
+        cache = SingleFlightCache()
+        barrier = threading.Barrier(2, timeout=TIMEOUT)
+        results = {}
+
+        def compute(key):
+            def factory():
+                barrier.wait()  # breaks unless both run at once
+                return key
+            results[key] = cache.get_or_compute(key, factory)
+
+        threads = [_start(compute, 'a'), _start(compute, 'b')]
+        for thread in threads:
+            thread.join(TIMEOUT)
+        self.assertEqual(results, {'a': 'a', 'b': 'b'})
+
+    def test_no_global_lock_while_computing(self):
+        cache = SingleFlightCache()
+        inner = []
+
+        def factory():
+            thread = _start(lambda: inner.append(
+                cache.get_or_compute('other', lambda: 'o')))
+            thread.join(TIMEOUT)
+            return 'outer'
+
+        self.assertEqual(cache.get_or_compute('k', factory), 'outer')
+        self.assertEqual(inner, ['o'])
+
+    def test_exceptions_reach_waiters_and_are_not_cached(self):
+        cache = SingleFlightCache()
+        started, release = threading.Event(), threading.Event()
+
+        def failing():
+            started.set()
+            release.wait(TIMEOUT)
+            raise KeyError('boom')
+
+        errors = []
+
+        def call():
+            try:
+                cache.get_or_compute('k', failing)
+            except Exception as e:
+                errors.append(e)
+
+        threads = [_start(call)]
+        self.assertTrue(started.wait(TIMEOUT))
+        threads += [_start(call) for _ in range(3)]
+        time.sleep(0.05)
+        release.set()
+        for thread in threads:
+            thread.join(TIMEOUT)
+        self.assertEqual(len(errors), 4)
+        for error in errors:
+            self.assertIsInstance(error, KeyError)
+            self.assertEqual(error.args, ('boom',))
+        self.assertEqual(cache.get_or_compute('k', lambda: 'retried'),
+                         'retried')
+
+    def test_recursive_same_key_raises(self):
+        cache = SingleFlightCache()
+
+        def recursive():
+            return cache.get_or_compute('k', recursive)
+
+        with self.assertRaises(RuntimeError):
+            cache.get_or_compute('k', recursive)
+        # nothing stays in flight after the failure
+        self.assertEqual(cache.get_or_compute('k', lambda: 1), 1)
+
+    def test_nested_different_key_allowed(self):
+        cache = SingleFlightCache()
+        result = cache.get_or_compute(
+            'outer', lambda: cache.get_or_compute('inner', lambda: 2) + 1)
+        self.assertEqual(result, 3)
+
+    def test_invalidate(self):
+        cache = SingleFlightCache()
+        self.assertFalse(cache.invalidate('k'))
+        cache.get_or_compute('k', lambda: 1)
+        self.assertTrue(cache.invalidate('k'))
+        self.assertFalse(cache.invalidate('k'))
+        self.assertEqual(cache.get_or_compute('k', lambda: 2), 2)
+
+    def test_invalidate_in_flight(self):
+        cache = SingleFlightCache()
+        started, release = threading.Event(), threading.Event()
+        results = []
+
+        def slow():
+            started.set()
+            release.wait(TIMEOUT)
+            return 'stale'
+
+        thread = _start(lambda: results.append(
+            cache.get_or_compute('k', slow)))
+        self.assertTrue(started.wait(TIMEOUT))
+        self.assertTrue(cache.invalidate('k'))
+        release.set()
+        thread.join(TIMEOUT)
+        self.assertEqual(results, ['stale'])
+        self.assertEqual(cache.get_or_compute('k', lambda: 'fresh'), 'fresh')
+
+    def test_clear(self):
+        cache = SingleFlightCache()
+        started, release = threading.Event(), threading.Event()
+
+        def slow():
+            started.set()
+            release.wait(TIMEOUT)
+            return 'stale'
+
+        cache.get_or_compute('a', lambda: 1)
+        thread = _start(lambda: cache.get_or_compute('b', slow))
+        self.assertTrue(started.wait(TIMEOUT))
+        cache.clear()
+        release.set()
+        thread.join(TIMEOUT)
+        self.assertEqual(cache.get_or_compute('a', lambda: 'a2'), 'a2')
+        self.assertEqual(cache.get_or_compute('b', lambda: 'b2'), 'b2')
+
+
+if __name__ == '__main__':
+    unittest.main()
