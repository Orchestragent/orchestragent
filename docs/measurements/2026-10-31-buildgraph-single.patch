@@ -0,0 +1,148 @@
+import threading
+import unittest
+
+from boltons.buildgraphutils import BuildGraph
+from boltons.buildrunutils import BuildRunner
+
+
+def task(deps=(), version='1', resources=None):
+    return {'deps': list(deps), 'version': version,
+            'resources': dict(resources or {})}
+
+
+class Flaky:
+    "A callback which fails a given number of times before succeeding."
+    def __init__(self, failures, error=None, value='ok'):
+        self.failures = failures
+        self.error = error or RuntimeError('flaky')
+        self.value = value
+        self.calls = 0
+        self.lock = threading.Lock()
+
+    def __call__(self, deps):
+        with self.lock:
+            self.calls += 1
+            calls = self.calls
+        if calls <= self.failures:
+            if self.error == 'nan':
+                return float('nan')
+            raise self.error
+        return self.value
+
+
+class BuildRunnerRetryTest(unittest.TestCase):
+    def test_retries_until_success(self):
+        graph = BuildGraph({'a': task(), 'b': task(['a'])})
+        flaky = Flaky(2)
+        report = BuildRunner(graph, {'a': flaky, 'b': lambda d: d},
+                             retries=2).run()
+        self.assertEqual(report['states'], {'a': 'done', 'b': 'done'})
+        self.assertEqual(report['attempts'], {'a': 3, 'b': 1})
+        self.assertEqual(report['results']['b'], {'a': 'ok'})
+        self.assertEqual(report['errors'], {})
+
+    def test_exhausted_retries(self):
+        graph = BuildGraph({'a': task(), 'b': task(['a']), 'c': task()})
+        flaky = Flaky(10, error=KeyError('missing thing'))
+        report = BuildRunner(graph, {'a': flaky, 'b': lambda d: d,
+                                     'c': lambda d: 'c'}, retries=1).run()
+        self.assertEqual(report['states'],
+                         {'a': 'failed', 'b': 'blocked', 'c': 'done'})
+        self.assertEqual(report['attempts'], {'a': 2, 'b': 0, 'c': 1})
+        self.assertEqual(report['errors'], {'a': "KeyError: 'missing thing'"})
+        self.assertEqual(flaky.calls, 2)
+
+    def test_non_json_results_are_failures(self):
+        graph = BuildGraph({'nan': task(), 'set': task(), 'retry': task()})
+        report = BuildRunner(graph, {
+            'nan': lambda d: [float('inf')],
+            'set': lambda d: {1},
+            'retry': Flaky(1, error='nan', value=[1, 2]),
+        }, retries=1).run()
+        self.assertEqual(report['states'], {'nan': 'failed', 'set': 'failed',
+                                            'retry': 'done'})
+        self.assertTrue(report['errors']['nan'].startswith('ValueError: '))
+        self.assertTrue(report['errors']['set'].startswith('TypeError: '))
+        self.assertEqual(report['results'], {'retry': [1, 2]})
+
+    def test_retry_releases_resources_for_others(self):
+        graph = BuildGraph({'flaky': task(resources={'lock': 1}),
+                            'other': task(resources={'lock': 1})})
+        other_ran = threading.Event()
+        attempts = []
+
+        def flaky(deps):
+            attempts.append(1)
+            if len(attempts) == 1:
+                raise RuntimeError('first try fails')
+            return other_ran.is_set()
+
+        report = BuildRunner(graph, {'flaky': flaky,
+                                     'other': lambda d: other_ran.set()},
+                             capacities={'lock': 1}, retries=1).run()
+        self.assertEqual(report['states'], {'flaky': 'done', 'other': 'done'})
+        self.assertEqual(report['results']['flaky'], True)
+
+    def test_failures_not_cached_and_runner_reusable(self):
+        graph = BuildGraph({'a': task(), 'b': task(['a'])})
+        flaky = Flaky(1)
+        runner = BuildRunner(graph, {'a': flaky, 'b': lambda d: d['a'] * 2})
+        first = runner.run()
+        self.assertEqual(first['states'], {'a': 'failed', 'b': 'blocked'})
+        second = runner.run()
+        self.assertEqual(second['states'], {'a': 'done', 'b': 'done'})
+        self.assertEqual(second['results'], {'a': 'ok', 'b': 'okok'})
+        third = runner.run()
+        self.assertEqual(third['states'], {'a': 'cached', 'b': 'cached'})
+        self.assertEqual(flaky.calls, 2)
+
+    def test_memory_reuse_skips_callbacks(self):
+        graph = BuildGraph({'a': task(), 'b': task(['a'])})
+        calls = []
+
+        def fn(name):
+            def callback(deps):
+                calls.append(name)
+                return {'name': name, 'deps': deps}
+            return callback
+
+        runner = BuildRunner(graph, {'a': fn('a'), 'b': fn('b')})
+        first = runner.run(['a'])
+        second = runner.run()
+        self.assertEqual(first['states'], {'a': 'done'})
+        self.assertEqual(second['states'], {'a': 'cached', 'b': 'done'})
+        self.assertEqual(calls, ['a', 'b'])
+
+    def test_defensive_copies(self):
+        graph = BuildGraph({'a': task(), 'b': task(['a']), 'c': task(['a'])})
+
+        def mutating(deps):
+            deps['a']['items'].append('mutated')
+            deps['injected'] = True
+            return sorted(deps)
+
+        def reader(deps):
+            return deps['a']
+
+        runner = BuildRunner(graph, {'a': lambda d: {'items': [1, (2, 3)]},
+                                     'b': mutating, 'c': reader},
+                             max_workers=1)
+        report = runner.run()
+        self.assertEqual(report['results']['a'], {'items': [1, [2, 3]]})
+        self.assertEqual(report['results']['c'], {'items': [1, [2, 3]]})
+        report['results']['a']['items'].clear()
+        again = runner.run()
+        self.assertEqual(again['results']['a'], {'items': [1, [2, 3]]})
+        self.assertEqual(again['results']['c'], {'items': [1, [2, 3]]})
+
+    def test_returned_value_mutation_after_callback(self):
+        graph = BuildGraph({'a': task()})
+        shared = {'x': [1]}
+        runner = BuildRunner(graph, {'a': lambda d: shared})
+        runner.run()
+        shared['x'].append(2)
+        self.assertEqual(runner.run()['results']['a'], {'x': [1]})
+
+
+if __name__ == '__main__':
+    unittest.main()
