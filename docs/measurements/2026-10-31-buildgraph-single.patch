+"""*Experimental.* ``buildrunutils`` executes a
+:class:`~boltons.buildgraphutils.BuildGraph` incrementally.
+
+:class:`BuildRunner` runs task callbacks on a thread pool for the
+duration of each :meth:`~BuildRunner.run` call, admitting ready tasks
+in graph insertion order (via
+:class:`~boltons.queueutils.HeapPriorityQueue`) as long as worker
+slots and resource capacities allow. Results are keyed by
+:meth:`BuildGraph.fingerprint <boltons.buildgraphutils.BuildGraph.fingerprint>`,
+reused from memory (a :class:`~boltons.cacheutils.SingleFlightCache`)
+and, optionally, from a persistent
+:class:`~boltons.buildcacheutils.ResultStore`.
+
+>>> from boltons.buildgraphutils import BuildGraph
+>>> graph = BuildGraph({
+...     'base': {'deps': [], 'version': '1', 'resources': {}},
+...     'twice': {'deps': ['base'], 'version': '1', 'resources': {}}})
+>>> runner = BuildRunner(graph, {'base': lambda deps: 21,
+...                              'twice': lambda deps: deps['base'] * 2})
+>>> report = runner.run()
+>>> report['results'], report['states']
+({'base': 21, 'twice': 42}, {'base': 'done', 'twice': 'done'})
+>>> runner.run(['twice'])['states']
+{'base': 'cached', 'twice': 'cached'}
+"""
+
+import json
+import threading
+from collections.abc import Mapping
+from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED
+
+from .cacheutils import SingleFlightCache, DEFAULT_MAX_SIZE
+from .queueutils import HeapPriorityQueue
+from .buildgraphutils import BuildGraph
+
+
+__all__ = ['BuildRunner', 'DONE', 'CACHED', 'FAILED', 'BLOCKED']
+
+
+DONE, CACHED, FAILED, BLOCKED = 'done', 'cached', 'failed', 'blocked'
+
+
+def _check_count(value, name, minimum):
+    if type(value) is not int or value < minimum:
+        raise ValueError('expected integer %s >= %d, not: %r'
+                         % (name, minimum, value))
+    return value
+
+
+def _format_error(exc):
+    return '%s: %s' % (type(exc).__name__, exc)
+
+
+class _ActivityTracker:
+    "Tracks how many callbacks are active at once during one run."
+    def __init__(self):
+        self._lock = threading.Lock()
+        self.active = 0
+        self.max_active = 0
+
+    def call(self, func, arg):
+        with self._lock:
+            self.active += 1
+            self.max_active = max(self.max_active, self.active)
+        try:
+            return func(arg)
+        finally:
+            with self._lock:
+                self.active -= 1
+
+
+def _attempt(tracker, func, inputs):
+    """Make one callback attempt in a worker thread. Returns ``(True,
+    result_json)`` on success, or ``(False, error_message)`` if the
+    callback raised or returned a value which is not strict JSON.
+    """
+    try:
+        value = tracker.call(func, inputs)
+        return True, json.dumps(value, allow_nan=False)
+    except Exception as e:
+        return False, _format_error(e)
+
+
+class BuildRunner:
+    """Run the tasks of a :class:`~boltons.buildgraphutils.BuildGraph`,
+    reusing previously computed results whenever their fingerprints
+    match.
+
+    Args:
+        graph (BuildGraph): The graph to run.
+        functions (dict): Maps every task ID in *graph* to a callable.
+            Each callable receives a fresh dict of its direct
+            prerequisites' results, and must return a value
+            serializable by ``json.dumps(allow_nan=False)``.
+        store (ResultStore): Optional persistent result store. Defaults
+            to ``None``, for in-memory reuse only.
+        max_workers (int): Max number of callbacks to run at once.
+            Defaults to ``4``.
+        capacities (dict): Maps resource names to the total amount
+            available to concurrently-running tasks. Every resource
+            demanded by a task must be declared here, with at least
+            that task's demand. Defaults to ``{}``.
+        retries (int): Number of additional attempts for a task whose
+            callback raises or returns a non-JSON value. Defaults to
+            ``0``.
+
+    All arguments are validated before any callback runs, raising
+    :exc:`ValueError` when invalid.
+    """
+    def __init__(self, graph, functions, store=None, max_workers=4,
+                 capacities=None, retries=0):
+        if not isinstance(graph, BuildGraph):
+            raise ValueError('expected BuildGraph, not: %r'
+                             % type(graph).__name__)
+        if not isinstance(functions, Mapping):
+            raise ValueError('expected mapping of task IDs to functions,'
+                             ' not: %r' % type(functions).__name__)
+        functions = dict(functions)
+        unknown = [task_id for task_id in functions if task_id not in graph]
+        missing = [task_id for task_id in graph.ids
+                   if task_id not in functions]
+        if unknown or missing:
+            raise ValueError('expected functions for exactly the graph IDs'
+                             ' (missing: %r, unknown: %r)'
+                             % (missing, unknown))
+        for task_id, func in functions.items():
+            if not callable(func):
+                raise ValueError('expected callable for task %r, not: %r'
+                                 % (task_id, func))
+        _check_count(max_workers, 'max_workers', 1)
+        _check_count(retries, 'retries', 0)
+
+        if capacities is None:
+            capacities = {}
+        if not isinstance(capacities, Mapping):
+            raise ValueError('expected mapping of resource capacities, not: %r'
+                             % type(capacities).__name__)
+        capacities = dict(capacities)
+        for name, amount in capacities.items():
+            if not isinstance(name, str) or not name:
+                raise ValueError('expected nonempty string resource name,'
+                                 ' not: %r' % (name,))
+            _check_count(amount, 'capacity of resource %r' % name, 1)
+
+        demands = {}
+        for task_id in graph.ids:
+            demands[task_id] = graph.resources(task_id)
+            for name, amount in demands[task_id].items():
+                if name not in capacities:
+                    raise ValueError('task %r requires undeclared resource %r'
+                                     % (task_id, name))
+                if amount > capacities[name]:
+                    raise ValueError('task %r requires %d of resource %r,'
+                                     ' exceeding its capacity of %d'
+                                     % (task_id, amount, name,
+                                        capacities[name]))
+
+        if store is not None and not all(
+                callable(getattr(store, attr, None))
+                for attr in ('get', 'put', 'save')):
+            raise ValueError('expected ResultStore or None, not: %r'
+                             % (store,))
+
+        self.graph = graph
+        self.store = store
+        self.max_workers = max_workers
+        self.retries = retries
+        self._functions = functions
+        self._capacities = capacities
+        self._demands = demands
+        self._memory = SingleFlightCache(
+            max_size=max(DEFAULT_MAX_SIZE, len(graph.ids)))
+
+    @property
+    def capacities(self):
+        "A copy of the resource capacities."
+        return dict(self._capacities)
+
+    def __repr__(self):
+        return ('%s(%r, max_workers=%r, capacities=%r, retries=%r)'
+                % (self.__class__.__name__, self.graph, self.max_workers,
+                   self._capacities, self.retries))
+
+    def run(self, targets=None):
+        """Synchronously run the tasks needed for *targets*, an iterable
+        of task IDs, and their transitive prerequisites. Runs every
+        task by default.
+
+        Returns a dict with:
+
+          * ``results`` - results of successful tasks
+          * ``states`` - ``'done'``, ``'cached'``, ``'failed'``, or
+            ``'blocked'`` (by a failed transitive prerequisite)
+          * ``errors`` - ``'ClassName: message'`` for failed tasks
+          * ``attempts`` - the number of callback invocations per task
+          * ``max_active`` - peak number of concurrently active
+            callbacks
+
+        Per-task dicts cover the selected tasks, in graph insertion
+        order. Every successful result is put into the store (if any),
+        which is then saved once.
+        """
+        if targets is None:
+            selected = list(self.graph.ids)
+        else:
+            selected = self.graph.closure(targets)
+        return _BuildRun(self, selected).execute()
+
+
+class _BuildRun:
+    "The state of a single BuildRunner.run() call."
+    def __init__(self, runner, selected):
+        graph = runner.graph
+        self.runner = runner
+        self.graph = graph
+        self.selected = selected
+        self.index = {task_id: i for i, task_id in enumerate(graph.ids)}
+
+        # derive keys in dependency order; selections are closed under
+        # prerequisites, so every needed dependency key is available
+        in_selection = set(selected)
+        self.keys = {}
+        for layer in graph.layers():
+            for task_id in layer:
+                if task_id in in_selection:
+                    self.keys[task_id] = graph.fingerprint(
+                        task_id, {dep: self.keys[dep]
+                                  for dep in graph.deps(task_id)})
+
+        self.waiting_on = {task_id: len(graph.deps(task_id))
+                           for task_id in selected}
+        self.dependents = {task_id: [] for task_id in selected}
+        for task_id in selected:
+            for dep in graph.deps(task_id):
+                self.dependents[dep].append(task_id)
+
+        self.texts = {}  # task_id -> result JSON, once successful
+        self.states = {}
+        self.errors = {}
+        self.attempts = dict.fromkeys(selected, 0)
+
+        # tasks with fewer attempts go first, so retries yield to other
+        # ready work; ties follow graph insertion order
+        self.ready = HeapPriorityQueue(priority_key=self._priority)
+        self.in_use = dict.fromkeys(runner._capacities, 0)
+        self.running = {}  # future -> task_id
+        self.tracker = _ActivityTracker()
+
+    def execute(self):
+        self._resolve([task_id for task_id in self.selected
+                       if not self.waiting_on[task_id]])
+        max_workers = self.runner.max_workers
+        executor = None
+        try:
+            while True:
+                if len(self.ready) and len(self.running) < max_workers:
+                    if executor is None:
+                        executor = ThreadPoolExecutor(
+                            max_workers=max_workers,
+                            thread_name_prefix='BuildRunner')
+                    self._admit(executor)
+                if not self.running:
+                    if len(self.ready):  # unreachable given init checks
+                        raise RuntimeError('ready tasks cannot be admitted')
+                    break
+                done, _ = wait(list(self.running),
+                               return_when=FIRST_COMPLETED)
+                for future in sorted(done, key=self._future_order):
+                    self._finish(future)
+        finally:
+            if executor is not None:
+                executor.shutdown(wait=True)
+        self._persist()
+        return self._report()
+
+    def _priority(self, task_id):
+        return (self.attempts[task_id], self.index[task_id])
+
+    def _future_order(self, future):
+        return self.index[self.running[future]]
+
+    def _lookup(self, task_id):
+        "Return the reusable result JSON for *task_id*, or None."
+        key = self.keys[task_id]
+        memory, store = self.runner._memory, self.runner.store
+        text = memory.get(key)
+        if text is None and store is not None:
+            try:
+                value = store.get(key)
+            except KeyError:
+                return None
+            text = json.dumps(value, allow_nan=False)
+            memory.get_or_compute(key, lambda: text)
+        return text
+
+    def _resolve(self, task_ids):
+        "Reuse cached results where possible, queueing the rest to run."
+        to_resolve = list(task_ids)
+        while to_resolve:
+            task_id = to_resolve.pop()
+            text = self._lookup(task_id)
+            if text is None:
+                self.ready.add(task_id, task_id)
+                continue
+            self.states[task_id] = CACHED
+            self.texts[task_id] = text
+            to_resolve.extend(self._unblock_dependents(task_id))
+
+    def _unblock_dependents(self, task_id):
+        ret = []
+        for dependent in self.dependents[task_id]:
+            self.waiting_on[dependent] -= 1
+            if not self.waiting_on[dependent]:
+                ret.append(dependent)
+        return ret
+
+    def _fits(self, task_id):
+        capacities = self.runner._capacities
+        return all(self.in_use[name] + amount <= capacities[name]
+                   for name, amount in self.runner._demands[task_id].items())
+
+    def _admit(self, executor):
+        """Start as many ready tasks as worker slots and resources
+        allow, in priority order. Tasks which do not currently fit stay
+        queued without holding back smaller tasks behind them.
+        """
+        deferred = []
+        while len(self.ready) and len(self.running) < self.runner.max_workers:
+            task_id = self.ready.pop()
+            if not self._fits(task_id):
+                deferred.append(task_id)
+                continue
+            inputs = {dep: json.loads(self.texts[dep])
+                      for dep in self.graph.deps(task_id)}
+            future = executor.submit(_attempt, self.tracker,
+                                     self.runner._functions[task_id], inputs)
+            self.running[future] = task_id
+            for name, amount in self.runner._demands[task_id].items():
+                self.in_use[name] += amount
+        for task_id in deferred:
+            self.ready.add(task_id, task_id)
+
+    def _finish(self, future):
+        task_id = self.running.pop(future)
+        for name, amount in self.runner._demands[task_id].items():
+            self.in_use[name] -= amount
+        self.attempts[task_id] += 1
+        ok, payload = future.result()
+        if ok:
+            self.states[task_id] = DONE
+            self.texts[task_id] = payload
+            self.runner._memory.get_or_compute(self.keys[task_id],
+                                               lambda: payload)
+            self._resolve(self._unblock_dependents(task_id))
+        elif self.attempts[task_id] <= self.runner.retries:
+            self.ready.add(task_id, task_id)
+        else:
+            self.states[task_id] = FAILED
+            self.errors[task_id] = payload
+
+    def _persist(self):
+        store = self.runner.store
+        if store is None:
+            return
+        for task_id in self.selected:
+            if task_id in self.texts:
+                store.put(self.keys[task_id], json.loads(self.texts[task_id]))
+        store.save()
+
+    def _report(self):
+        selected = self.selected
+        return {'results': {task_id: json.loads(self.texts[task_id])
+                            for task_id in selected
+                            if task_id in self.texts},
+                'states': {task_id: self.states.get(task_id, BLOCKED)
+                           for task_id in selected},
+                'errors': {task_id: self.errors[task_id]
+                           for task_id in selected
+                           if task_id in self.errors},
+                'attempts': {task_id: self.attempts[task_id]
+                             for task_id in selected},
+                'max_active': self.tracker.max_active}
