+"""*Experimental.* ``buildcacheutils`` provides :class:`ResultStore`, a
+small persistent mapping of build cache keys to JSON results.
+
+The store lives in a single UTF-8 JSON file, which is only ever
+written by an explicit :meth:`ResultStore.save`, using
+:func:`boltons.fileutils.atomic_save` so that a failed save never
+leaves a partially-written store behind.
+"""
+
+import re
+import json
+
+from .fileutils import atomic_save
+from .iterutils import is_iterable
+
+
+__all__ = ['ResultStore', 'InvalidResultKeyError', 'SCHEMA_VERSION']
+
+
+SCHEMA_VERSION = 1
+_HEX_KEY_RE = re.compile('[0-9a-f]{64}')
+
+
+class InvalidResultKeyError(ValueError, KeyError):
+    """Raised for keys which are not 64-character lowercase hex
+    strings. Such a key can never be present, so this is also a
+    :exc:`KeyError`.
+    """
+    __str__ = Exception.__str__
+
+
+def _is_valid_key(key):
+    return isinstance(key, str) and _HEX_KEY_RE.fullmatch(key) is not None
+
+
+def _check_key(key):
+    if not _is_valid_key(key):
+        raise InvalidResultKeyError('expected 64-character lowercase hex key,'
+                                    ' not: %r' % (key,))
+    return key
+
+
+def _to_json(value):
+    try:
+        return json.dumps(value, allow_nan=False)
+    except (TypeError, ValueError, RecursionError) as e:
+        raise ValueError('expected JSON-serializable value: %s' % e)
+
+
+def _reject_constant(name):
+    raise ValueError('unsupported JSON constant: %s' % name)
+
+
+def _unique_object(pairs):
+    ret = {}
+    for key, value in pairs:
+        if key in ret:
+            raise ValueError('duplicate JSON object key: %r' % key)
+        ret[key] = value
+    return ret
+
+
+class ResultStore:
+    """A persistent mapping of 64-character lowercase hex keys to JSON
+    values, stored in the file at *path*.
+
+    A nonexistent file starts empty. An existing file must contain a
+    JSON object with exactly a ``schema_version`` of ``1`` and a
+    ``values`` object, otherwise :exc:`ValueError` is raised (and the
+    file is left untouched).
+
+    Values are copied in and out by JSON round trip, so caller
+    mutations never affect stored values. Changes stay in memory
+    until :meth:`save` is called.
+    """
+    def __init__(self, path):
+        self.path = path
+        self._values = {}  # key -> JSON text
+        try:
+            with open(path, 'rb') as f:
+                data = f.read()
+        except FileNotFoundError:
+            return
+        self._values = self._parse(data)
+
+    @staticmethod
+    def _parse(data):
+        try:
+            state = json.loads(data.decode('utf-8'),
+                               parse_constant=_reject_constant,
+                               object_pairs_hook=_unique_object)
+        except (UnicodeDecodeError, ValueError, RecursionError) as e:
+            raise ValueError('malformed result store: %s' % e)
+        if not isinstance(state, dict) \
+           or set(state) != {'schema_version', 'values'}:
+            raise ValueError('expected result store object with exactly'
+                             ' schema_version and values')
+        version = state['schema_version']
+        if type(version) is not int or version != SCHEMA_VERSION:
+            raise ValueError('unsupported result store schema_version: %r'
+                             % (version,))
+        values = state['values']
+        if not isinstance(values, dict):
+            raise ValueError('expected result store values object, not: %r'
+                             % type(values).__name__)
+        for key in values:
+            if not _is_valid_key(key):
+                raise ValueError('invalid result store key: %r' % (key,))
+        return {key: _to_json(value) for key, value in values.items()}
+
+    def __repr__(self):
+        return '%s(%r)' % (self.__class__.__name__, self.path)
+
+    def __len__(self):
+        return len(self._values)
+
+    def __contains__(self, key):
+        return _is_valid_key(key) and key in self._values
+
+    def keys(self):
+        "Return a list of the stored keys."
+        return list(self._values)
+
+    def get(self, key):
+        """Return a copy of the value stored under *key*. Raises
+        :exc:`KeyError` if *key* is absent.
+        """
+        _check_key(key)
+        try:
+            text = self._values[key]
+        except KeyError:
+            raise KeyError(key)
+        return json.loads(text)
+
+    def put(self, key, value):
+        """Store a copy of the JSON-serializable *value* under *key*.
+        Invalid keys, and values which cannot be serialized (including
+        NaN and infinite floats), raise :exc:`ValueError` and leave the
+        store unchanged.
+        """
+        _check_key(key)
+        self._values[key] = _to_json(value)
+
+    def invalidate(self, keys):
+        """Remove each of *keys* from the store, returning the number of
+        keys which were removed.
+        """
+        if isinstance(keys, (str, bytes)) or not is_iterable(keys):
+            raise ValueError('expected an iterable of keys, not: %r'
+                             % (keys,))
+        keys = [_check_key(key) for key in keys]
+        return sum(self._values.pop(key, None) is not None for key in keys)
+
+    def save(self):
+        """Atomically write the complete store to its path, as UTF-8
+        JSON. On failure, an existing file is left untouched.
+        """
+        state = {'schema_version': SCHEMA_VERSION,
+                 'values': {key: json.loads(text)
+                            for key, text in self._values.items()}}
+        data = json.dumps(state, ensure_ascii=False, allow_nan=False,
+                          sort_keys=True, indent=1).encode('utf-8')
+        with atomic_save(self.path) as f:
+            f.write(data)
+        return
