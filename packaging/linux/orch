#!/bin/sh
# orch launcher for the Linux package: ./orch --repo ~/code/app plan spec.md
here="$(cd "$(dirname "$0")" && pwd)"
if [ ! -x "$here/.venv/bin/python" ]; then
  echo "orch: run $here/install.sh first" >&2
  exit 1
fi
if [ "${1:-}" = "demo" ]; then
  shift
  exec "$here/scripts/orch_demo.sh" "$@"
fi
exec env PYTHONPATH="$here/src" "$here/.venv/bin/python" -m orchestragent.orch_cli "$@"
